@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteSupplyRequest>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    ViewData["Title"] = $"طلبات التوريد - {site?.Name}";
   
    var canApprove = await PermissionService.HasPermissionAsync(User, "Supply.Approve");
    var canCreate = await PermissionService.HasPermissionAsync(User, "Supply.Create");

    string StatusLabel(SiteSupplyStatus s) => s switch
    {
        SiteSupplyStatus.Pending => "معلق",
        SiteSupplyStatus.Approved => "تمت الموافقة",
        SiteSupplyStatus.Delivered => "تم التسليم",
        SiteSupplyStatus.Rejected => "مرفوض",
        _ => s.ToString()
    };

    string StatusTagClass(SiteSupplyStatus s) => s switch
    {
        SiteSupplyStatus.Approved => "tag-accent",
        SiteSupplyStatus.Delivered => "tag-success",
        SiteSupplyStatus.Rejected => "tag-danger",
        _ => "tag-muted"
    };
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@site?.Code</div>
        <h1 class="athar-page-title" style="margin-top:2px;">طلبات التوريد - @site?.Name</h1>
    </div>
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn-line">العودة للموقع</a>
</div>


<div class="data-table" style="--cols: 1.2fr 100px 90px 90px 1fr 130px @(canApprove ? "230px" : "");">
    <div class="data-table-head">
        <div class="cell">المادة</div>
        <div class="cell">الأبعاد</div>
        <div class="cell">الكمية</div>
        <div class="cell">الوحدة</div>
        <div class="cell">طلبه</div>
        <div class="cell">الحالة</div>
        @if (canApprove)
        {
            <div class="cell">إجراء</div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد طلبات توريد بعد</div></div>
    }
    else
    {
        @foreach (var r in Model)
        {
            <div class="data-table-row">
                <div class="cell">@r.MaterialName</div>
                <div class="cell">@(r.Dimensions ?? "-")</div>
                <div class="cell cell-num">@r.Quantity.ToString("N2")</div>
                <div class="cell">@r.Unit</div>
                <div class="cell">@(r.RequestedBy?.FullName ?? r.RequestedByContractor?.Name ?? "-")</div>
                <div class="cell"><span class="tag @StatusTagClass(r.Status)">@StatusLabel(r.Status)</span></div>
                @if (canApprove)
                {
                    <div class="cell" style="display:flex; gap:4px; align-items:center;">
                        <form method="post" asp-action="UpdateStatus" style="display:flex; gap:4px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <select name="status" class="form-select form-select-sm">
                                <option value="Pending" selected="@(r.Status == SiteSupplyStatus.Pending)">معلق</option>
                                <option value="Approved" selected="@(r.Status == SiteSupplyStatus.Approved)">تمت الموافقة</option>
                                <option value="Delivered" selected="@(r.Status == SiteSupplyStatus.Delivered)">تم التسليم</option>
                                <option value="Rejected" selected="@(r.Status == SiteSupplyStatus.Rejected)">مرفوض</option>
                            </select>
                            <button type="submit" class="btn-line btn-line-accent">تحديث</button>
                        </form>
                        @if (r.Status == SiteSupplyStatus.Approved)
                        {
                            <a asp-action="RegisterExpense" asp-route-id="@r.Id" class="btn-line" style="color:#2f8a57;">تسجيل الصرف</a>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@if (canCreate && site?.Status != SiteStatus.Completed)
{
    <div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px; margin-top:12px;">
        <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">+ طلب توريد جديد</div>
        <form method="post" asp-action="Create" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site?.Id" />
            <div style="flex:1; min-width:160px;">
                <label class="form-label" style="font-size:11px;">المادة</label>
                <input type="text" name="materialName" class="form-control form-control-sm" required />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">الأبعاد</label>
                <input type="text" name="dimensions" class="form-control form-control-sm" style="max-width:110px;" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">الكمية</label>
                <input type="number" step="0.01" name="quantity" class="form-control form-control-sm" style="max-width:90px;" required />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">الوحدة</label>
                <input type="text" name="unit" class="form-control form-control-sm" style="max-width:90px;" required />
            </div>
            <div style="flex:1; min-width:160px;">
                <label class="form-label" style="font-size:11px;">ملاحظات</label>
                <input type="text" name="notes" class="form-control form-control-sm" />
            </div>
            <button type="submit" class="btn-line btn-line-accent">+ إرسال الطلب</button>
        </form>
    </div>
}