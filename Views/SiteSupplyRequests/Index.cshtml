@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@using System.Text.Json
@model List<SiteSupplyRequest>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    var materialCategories = ViewBag.MaterialCategories as List<MaterialCategory> ?? new List<MaterialCategory>();
    var materialCategoryId = ViewBag.MaterialCategoryId as int?;
    ViewData["Title"] = $"طلبات التوريد - {site?.Name}";

    var canApprove = await PermissionService.HasPermissionAsync(User, "Supply.Approve");

    string StatusLabel(SiteSupplyStatus s) => s switch
    {
        SiteSupplyStatus.Pending => "معلق",
        SiteSupplyStatus.Approved => "تمت الموافقة",
        SiteSupplyStatus.Delivered => "تم التسليم",
        SiteSupplyStatus.Rejected => "مرفوض",
        _ => s.ToString()
    };

    string StatusTagClass(SiteSupplyStatus s) => s switch
    {
        SiteSupplyStatus.Approved => "tag-accent",
        SiteSupplyStatus.Delivered => "tag-success",
        SiteSupplyStatus.Rejected => "tag-danger",
        _ => "tag-muted"
    };
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@site?.Code</div>
        <h1 class="athar-page-title" style="margin-top:2px;">طلبات التوريد - @site?.Name</h1>
    </div>
    <div style="display:flex; gap:8px;">
        @if (canApprove)
        {
            <a asp-action="AllRequests" class="btn-line">عرض طلبات كل المواقع</a>
        }
        <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn-line">العودة للموقع</a>
    </div>
</div>

<div class="athar-card" style="margin-bottom:12px;">
    <form method="get" style="display:flex; gap:8px; align-items:end;">
        <input type="hidden" name="siteId" value="@site?.Id" />
        <div style="min-width:200px;">
            <label class="form-label" style="font-size:11px;">تصنيف المادة</label>
            <select name="materialCategoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- الكل --</option>
                @foreach (var cat in materialCategories)
                {
                    <option value="@cat.Id" selected="@(materialCategoryId == cat.Id)">@cat.NameAr</option>
                }
            </select>
        </div>
        <button type="submit" class="btn-line btn-line-accent">تصفية</button>
    </form>
</div>

<form method="post" asp-action="ExportSelectedPdf" id="exportForm">
    @Html.AntiForgeryToken()
</form>
<div style="margin-bottom:10px;">
    <button type="submit" form="exportForm" class="btn-line btn-line-accent">🖨 طباعة المحدد</button>
</div>
<div class="data-table" style="--cols: 36px 70px 1.2fr 90px 90px 1fr 1fr 130px @(canApprove ? "260px" : "");">
        <div class="data-table-head">
            <div class="cell"></div>
            <div class="cell">#الطلب</div>
            <div class="cell">المادة</div>
            <div class="cell">الكمية</div>
            <div class="cell">الوحدة</div>
            <div class="cell">المورّد</div>
            <div class="cell">طلبه</div>
            <div class="cell">الحالة</div>
            @if (canApprove)
            {
                <div class="cell">إجراء</div>
            }
        </div>

        @{
            var anyRows = false;
        }
        @foreach (var r in Model)
        {
            @foreach (var item in r.Items)
            {
                if (materialCategoryId.HasValue && (item.MaterialItem == null || item.MaterialItem.MaterialCategoryId != materialCategoryId.Value))
                {
                    continue;
                }
                anyRows = true;
            <div class="data-table-row">
                <div class="cell"><input type="checkbox" name="itemIds" value="@item.Id" form="exportForm" /></div>
                    <div class="cell cell-num">@r.Id</div>
                    <div class="cell">
                        @item.MaterialName
                        @if (!string.IsNullOrEmpty(item.PhotoPath))
                        {
                            <br />
                            <a href="@item.PhotoPath" target="_blank">
                                <img src="@item.PhotoPath" style="max-width:60px; max-height:40px; margin-top:4px; border-radius:4px;" />
                            </a>
                        }
                    </div>
                    <div class="cell cell-num">@item.Quantity.ToString("N2")</div>
                    <div class="cell">@item.Unit</div>
                    <div class="cell">@(item.Vendor?.Name ?? "-")</div>
                    <div class="cell">@(r.RequestedBy?.FullName ?? r.RequestedByContractor?.Name ?? "-")</div>
                    <div class="cell"><span class="tag @StatusTagClass(r.Status)">@StatusLabel(r.Status)</span></div>
                    @if (canApprove)
                    {
                        <div class="cell" style="display:flex; gap:4px; align-items:center;">
                        <form method="post" asp-action="UpdateStatus" style="display:flex; gap:4px; flex-wrap:nowrap;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <select name="status" class="form-select form-select-sm" style="max-width:105px; flex-shrink:0;">
                                <option value="Pending" selected="@(r.Status == SiteSupplyStatus.Pending)">معلق</option>
                                <option value="Approved" selected="@(r.Status == SiteSupplyStatus.Approved)">تمت الموافقة</option>
                                <option value="Rejected" selected="@(r.Status == SiteSupplyStatus.Rejected)">مرفوض</option>
                            </select>
                            <button type="submit" class="btn-line btn-line-accent" style="white-space:nowrap; flex-shrink:0;">تحديث</button>
                        </form>
                            @if (r.Status == SiteSupplyStatus.Approved)
                            {
                                <a asp-action="RegisterExpense" asp-route-id="@r.Id" class="btn-line" style="color:#2f8a57;">تسجيل الصرف</a>
                            }
                        </div>
                    }
                </div>
            }
        }
    @if (!anyRows)
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد طلبات توريد ضمن هذه الفلترة</div></div>
    }
</div>

