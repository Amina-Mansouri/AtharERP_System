@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteSupplyRequest>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    ViewData["Title"] = $"طلبات التوريد - {site?.Name}";
    var canCreate = await PermissionService.HasPermissionAsync(User, "Supply.Create");
    var canApprove = await PermissionService.HasPermissionAsync(User, "Supply.Approve");

    string StatusLabel(SiteSupplyStatus s) => s switch
    {
        SiteSupplyStatus.Pending => "معلق",
        SiteSupplyStatus.Approved => "تمت الموافقة",
        SiteSupplyStatus.Delivered => "تم التسليم",
        SiteSupplyStatus.Rejected => "مرفوض",
        _ => s.ToString()
    };
}

<h1 class="athar-page-title">طلبات التوريد - @site?.Name</h1>

<div class="athar-card mt-3">
    @if (canCreate)
    {
        <form method="post" asp-action="Create" class="row g-2 align-items-end mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SiteId" value="@site?.Id" />
            <div class="col-md-3">
                <label class="form-label">اسم المادة</label>
                <input type="text" name="MaterialName" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">الأبعاد</label>
                <input type="text" name="Dimensions" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label">الكمية</label>
                <input type="number" step="0.01" min="0" name="Quantity" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">الوحدة</label>
                <input type="text" name="Unit" class="form-control form-control-sm" placeholder="متر / قطعة..." required />
            </div>
            <div class="col-md-3">
                <label class="form-label">ملاحظات</label>
                <input type="text" name="Notes" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 mt-2">
                <button type="submit" class="btn btn-sm athar-btn w-100">+ إرسال طلب</button>
            </div>
        </form>
    }

    <div class="table-responsive">
        <table class="table athar-table align-middle">
            <thead>
                <tr>
                    <th>المادة</th>
                    <th>الأبعاد</th>
                    <th>الكمية</th>
                    <th>الوحدة</th>
                    <th>طلبه</th>
                    <th>الحالة</th>
                    @if (canApprove)
                    {
                        <th>إجراء</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">لا توجد طلبات توريد بعد</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.MaterialName</td>
                        <td>@(r.Dimensions ?? "-")</td>
                        <td>@r.Quantity.ToString("N2")</td>
                        <td>@r.Unit</td>
                        <td>@r.RequestedBy.FullName</td>
                        <td><span class="badge athar-status-badge athar-status-@r.Status">@StatusLabel(r.Status)</span></td>
                        @if (canApprove)
                        {
                            <td>
                                <form method="post" asp-action="UpdateStatus" class="d-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <select name="status" class="form-select form-select-sm">
                                        <option value="Pending" selected="@(r.Status == SiteSupplyStatus.Pending)">معلق</option>
                                        <option value="Approved" selected="@(r.Status == SiteSupplyStatus.Approved)">تمت الموافقة</option>
                                        <option value="Delivered" selected="@(r.Status == SiteSupplyStatus.Delivered)">تم التسليم</option>
                                        <option value="Rejected" selected="@(r.Status == SiteSupplyStatus.Rejected)">مرفوض</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm athar-btn">تحديث</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn athar-btn-outline">العودة للموقع</a>
</div>