@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model ApplicationUser
@{
    ViewData["Title"] = "ملفي الشخصي";
  
}

<div class="profile-head">
    @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
    {
        <img src="@Model.ProfilePhotoPath" class="profile-avatar" alt="" />
    }
    else
    {
        <div class="profile-avatar" style="display:flex; align-items:center; justify-content:center; background:#f1eefc; color:#7b6bd6; font-weight:700; font-size:20px;">
            @(Model.FirstName.Length > 0 ? Model.FirstName.Substring(0, 1) : "")@(Model.LastName.Length > 0 ? Model.LastName.Substring(0, 1) : "")
        </div>
    }
    <div>
        <h1>@Model.FullName</h1>
        <div style="font-size:11.5px; color:var(--sys-text-light); margin-top:2px;">@Model.Email</div>
    </div>
</div>

<div class="side-panel" style="margin-bottom:12px;">
    <div class="side-panel-title">بياناتي الوظيفية</div>
    <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; font-size:11.5px;">
        <div><span style="color:var(--sys-text-light);">رقم الهاتف</span><div style="font-weight:600; margin-top:2px;">@(Model.PhoneNumber ?? "-")</div></div>
        <div><span style="color:var(--sys-text-light);">الرقم الوظيفي</span><div style="font-weight:600; margin-top:2px;">@(Model.JobNumber ?? "-")</div></div>
        <div><span style="color:var(--sys-text-light);">القسم</span><div style="font-weight:600; margin-top:2px;">@(Model.Department?.Name ?? "-")</div></div>
        <div><span style="color:var(--sys-text-light);">الرتبة الوظيفية</span><div style="font-weight:600; margin-top:2px;">@(Model.JobRankRef?.NameAr ?? "-")</div></div>
        <div><span style="color:var(--sys-text-light);">المسار المهني</span><div style="font-weight:600; margin-top:2px;">@(Model.JobRankRef?.CareerTrack?.NameAr ?? "-")</div></div>        <div><span style="color:var(--sys-text-light);">الراتب التعاقدي</span><div style="font-weight:600; margin-top:2px;">@Model.ContractSalary.ToString("N0") د.ل</div></div>
        <div><span style="color:var(--sys-text-light);">بداية العقد</span><div style="font-weight:600; margin-top:2px;">@(Model.ContractStartDate?.ToString("yyyy-MM-dd") ?? "-")</div></div>
        <div><span style="color:var(--sys-text-light);">نهاية العقد</span><div style="font-weight:600; margin-top:2px;">@(Model.ContractEndDate?.ToString("yyyy-MM-dd") ?? "-")</div></div>
        <div><span style="color:var(--sys-text-light);">تاريخ الانضمام</span><div style="font-weight:600; margin-top:2px;">@Model.CreatedAt.ToString("yyyy-MM-dd")</div></div>
        <div><span style="color:var(--sys-text-light);">آخر تسجيل دخول</span><div style="font-weight:600; margin-top:2px;">@(Model.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div></div>
        <div><span style="color:var(--sys-text-light);">حالة الحساب</span><div style="margin-top:2px;"><span class="tag @(Model.IsActive ? "tag-success" : "tag-danger")">@(Model.IsActive ? "نشط" : "غير نشط")</span></div></div>
    </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
    <div class="side-panel">
        <div class="side-panel-title">الصورة الشخصية</div>
        <form asp-controller="Profile" asp-action="UpdatePhoto" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="file" name="profilePhoto" accept="image/*" style="width:100%; font-size:12.5px; font-family:inherit; margin-bottom:10px;" />
            <button type="submit" class="btn-line btn-line-accent">حفظ الصورة</button>
        </form>
    </div>

    <div class="side-panel">
        <div class="side-panel-title">تغيير كلمة المرور</div>
        <form asp-controller="Profile" asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div style="display:grid; gap:10px; margin-bottom:10px;">
                <div>
                    <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">كلمة المرور الحالية</div>
                    <input type="password" name="currentPassword" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
                </div>
                <div>
                    <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">كلمة المرور الجديدة</div>
                    <input type="password" name="newPassword" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
                </div>
                <div>
                    <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">تأكيد كلمة المرور الجديدة</div>
                    <input type="password" name="confirmPassword" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
                </div>
            </div>
            <button type="submit" class="btn-line btn-line-accent">تغيير كلمة المرور</button>
        </form>
    </div>
</div>