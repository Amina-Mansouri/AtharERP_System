@using AtharERP_System.Models.Entities
@model List<SiteDailyReport>
@{
    var site = ViewBag.Site as Site;
    ViewData["Title"] = $"التقارير اليومية - {site?.Name}";
    var fromDate = ViewBag.FromDate as DateTime?;
    var toDate = ViewBag.ToDate as DateTime?;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="athar-page-title">التقارير اليومية - @site?.Name</h1>
    <a asp-action="Create" asp-route-siteId="@site?.Id" class="btn athar-btn">+ تقرير جديد</a>
</div>

<div class="athar-card mt-3">
    <form method="get" asp-action="Index" class="row g-2 mb-3">
        <input type="hidden" name="siteId" value="@site?.Id" />
        <div class="col-md-4">
            <label class="form-label">من تاريخ</label>
            <input type="date" name="fromDate" class="form-control" value="@(fromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-4">
            <label class="form-label">إلى تاريخ</label>
            <input type="date" name="toDate" class="form-control" value="@(toDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn athar-btn w-100">تصفية</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table athar-table align-middle">
            <thead>
                <tr>
                    <th>التاريخ</th>
                    <th>الطقس</th>
                    <th>عدد العمال</th>
                    <th>الصور</th>
                    <th>أُنشئ بواسطة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">لا توجد تقارير مطابقة</td>
                    </tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.ReportDate.ToString("yyyy-MM-dd")</td>
                        <td>@(r.Weather ?? "-")</td>
                        <td>@r.WorkersCount</td>
                        <td>@r.Photos.Count</td>
                        <td>@r.CreatedBy.FullName</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm athar-btn-outline">عرض</a>
                            <form method="post" asp-action="Delete" asp-route-id="@r.Id" class="d-inline"
                                  onsubmit="return confirm('حذف هذا التقرير؟');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn athar-btn-outline">العودة للموقع</a>
</div>