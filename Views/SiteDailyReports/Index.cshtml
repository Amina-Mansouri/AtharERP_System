@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteDailyReport>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    ViewData["Title"] = $"التقارير اليومية - {site?.Name}";
    var fromDate = ViewBag.FromDate as DateTime?;
    var toDate = ViewBag.ToDate as DateTime?;
    var canManage = await PermissionService.HasPermissionAsync(User, "Sites.Manage");
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@site?.Code</div>
        <h1 class="athar-page-title" style="margin-top:2px;">التقارير اليومية - @site?.Name</h1>
    </div>
    <div style="display:flex; gap:8px;">
        <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn-line">العودة للموقع</a>
     
    </div>
</div>

<form method="get" asp-action="Index" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:10px;">
    <input type="hidden" name="siteId" value="@site?.Id" />
    <input type="date" name="fromDate" class="form-control" style="max-width:170px;" value="@(fromDate?.ToString("yyyy-MM-dd"))" />
    <input type="date" name="toDate" class="form-control" style="max-width:170px;" value="@(toDate?.ToString("yyyy-MM-dd"))" />
    <button type="submit" class="btn-line">تصفية</button>
</form>

<div class="data-table" style="--cols: 100px 110px 96px 80px 1fr 140px;">
    <div class="data-table-head">
        <div class="cell">التاريخ</div>
        <div class="cell">الطقس</div>
        <div class="cell">عدد العمال</div>
        <div class="cell">الصور</div>
        <div class="cell">أُنشئ بواسطة</div>
        <div class="cell">إجراءات</div>
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد تقارير مطابقة</div></div>
    }
    else
    {
        @foreach (var r in Model)
        {
            <div class="data-table-row">
                <div class="cell cell-num">@r.ReportDate.ToString("yyyy-MM-dd")</div>
                <div class="cell">@(r.Weather ?? "-")</div>
                <div class="cell cell-num">@r.WorkersCount</div>
                <div class="cell cell-num">@r.Photos.Count</div>
                <div class="cell">@(r.CreatedBy?.FullName ?? r.CreatedByContractor?.Name ?? "-")</div>
                <div class="cell" style="display:flex; gap:6px;">
                    <a asp-action="Details" asp-route-id="@r.Id" class="btn-line">عرض</a>
                    <form method="post" asp-action="Delete" asp-route-id="@r.Id" onsubmit="return confirm('حذف هذا التقرير؟');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-line" style="color:#c94a42;">حذف</button>
                    </form>
                </div>
            </div>
        }
    }
</div>

                
@if (canManage && site?.Status != SiteStatus.Completed)
{
    <div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px; margin-top:12px;">
        <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">+ إضافة تقرير يومي</div>
        <form method="post" asp-action="Create" enctype="multipart/form-data" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site?.Id" />
            <input type="hidden" name="fromDate" value="@(fromDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="toDate" value="@(toDate?.ToString("yyyy-MM-dd"))" />
            <div>
                <label class="form-label" style="font-size:11px;">التاريخ</label>
                <input type="date" name="reportDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">الطقس</label>
                <input type="text" name="weather" class="form-control form-control-sm" style="max-width:110px;" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">عدد العمال</label>
                <input type="number" name="workersCount" class="form-control form-control-sm" style="max-width:90px;" min="0" value="0" required />
            </div>
            <div style="flex:1; min-width:160px;">
                <label class="form-label" style="font-size:11px;">الأعمال المنفذة</label>
                <input type="text" name="workCompleted" class="form-control form-control-sm" />
            </div>
            <div style="flex:1; min-width:140px;">
                <label class="form-label" style="font-size:11px;">ملاحظات / مشاكل</label>
                <input type="text" name="issues" class="form-control form-control-sm" />
            </div>
            <div style="flex:1; min-width:140px;">
                <label class="form-label" style="font-size:11px;">المواد المستخدمة</label>
                <input type="text" name="materialsUsed" class="form-control form-control-sm" />
            </div>
            <div style="flex:1; min-width:140px;">
                <label class="form-label" style="font-size:11px;">المعدات المستخدمة</label>
                <input type="text" name="equipmentUsed" class="form-control form-control-sm" />
            </div>
            <div style="flex:1; min-width:140px;">
                <label class="form-label" style="font-size:11px;">الزيارات</label>
                <input type="text" name="visits" class="form-control form-control-sm" />
            </div>
            <div style="flex:1; min-width:140px;">
                <label class="form-label" style="font-size:11px;">ملاحظات عامة</label>
                <input type="text" name="notes" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">الصور</label>
                <input type="file" name="photos" class="form-control form-control-sm" multiple accept="image/*" />
            </div>
            <button type="submit" class="btn-line btn-line-accent">+ إضافة</button>
        </form>
    </div>
}