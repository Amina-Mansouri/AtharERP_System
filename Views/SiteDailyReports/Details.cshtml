@using AtharERP_System.Models.Entities
@model SiteDailyReport
@{
    ViewData["Title"] = $"تقرير يومي - {Model.ReportDate:yyyy-MM-dd}";
}

<h1 class="athar-page-title">تقرير يومي - @Model.Site.Name - @Model.ReportDate.ToString("yyyy-MM-dd")</h1>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:16px; margin-top:12px;">
    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; font-size:12px;">
        <div><strong>الطقس:</strong> @(Model.Weather ?? "-")</div>
        <div><strong>عدد العمال:</strong> @Model.WorkersCount</div>
        <div><strong>أُنشئ بواسطة:</strong> @Model.CreatedBy.FullName</div>
        @if (!string.IsNullOrEmpty(Model.WorkCompleted))
        {
            <div style="grid-column:1/-1;"><strong>الأعمال المنجزة:</strong> @Model.WorkCompleted</div>
        }
        @if (!string.IsNullOrEmpty(Model.Issues))
        {
            <div style="grid-column:1/-1;"><strong>المشاكل والعوائق:</strong> @Model.Issues</div>
        }
        @if (!string.IsNullOrEmpty(Model.MaterialsUsed))
        {
            <div style="grid-column:span 1/1;"><strong>المواد المستخدمة:</strong> @Model.MaterialsUsed</div>
        }
        @if (!string.IsNullOrEmpty(Model.EquipmentUsed))
        {
            <div><strong>المعدات المستخدمة:</strong> @Model.EquipmentUsed</div>
        }
        @if (!string.IsNullOrEmpty(Model.Visits))
        {
            <div style="grid-column:1/-1;"><strong>الزيارات:</strong> @Model.Visits</div>
        }
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div style="grid-column:1/-1;"><strong>ملاحظات:</strong> @Model.Notes</div>
        }
    </div>
</div>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:16px; margin-top:12px;">
    <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">الصور (@Model.Photos.Count)</div>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:10px;">
        @foreach (var photo in Model.Photos)
        {
            <div style="border:1px solid var(--sys-border); border-radius:8px; padding:8px;">
                <img src="@photo.FilePath" style="width:100%; border-radius:6px; margin-bottom:6px;" alt="صورة تقرير" />
                @if (!string.IsNullOrEmpty(photo.Description))
                {
                    <div style="font-size:10.5px; color:var(--sys-text-light);">@photo.Description</div>
                }
                <form method="post" asp-action="DeletePhoto" style="margin-top:6px;" onsubmit="return confirm('حذف هذه الصورة؟');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@photo.Id" />
                    <input type="hidden" name="reportId" value="@Model.Id" />
                    <button type="submit" class="btn-line" style="width:100%; color:#c94a42;">حذف</button>
                </form>
            </div>
        }
    </div>

    <form method="post" asp-action="UploadPhoto" enctype="multipart/form-data" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end; margin-top:14px; padding-top:14px; border-top:1px solid var(--sys-border);">
        @Html.AntiForgeryToken()
        <input type="hidden" name="reportId" value="@Model.Id" />
        <input type="file" name="file" class="form-control" style="max-width:260px;" accept="image/*" required />
        <input type="text" name="description" class="form-control" style="max-width:220px;" placeholder="وصف الصورة (اختياري)" />
        <button type="submit" class="btn-line btn-line-accent">+ إضافة صورة</button>
    </form>
</div>

<div class="mt-3">
    <a asp-action="Index" asp-route-siteId="@Model.SiteId" class="btn-line">العودة للتقارير</a>
</div>