@using AtharERP_System.Models.Entities
@model SiteDailyReport
@{
    ViewData["Title"] = $"تقرير يومي - {Model.ReportDate:yyyy-MM-dd}";
}

<h1 class="athar-page-title">تقرير يومي - @Model.Site.Name - @Model.ReportDate.ToString("yyyy-MM-dd")</h1>

<div class="athar-card mt-3">
    <div class="row">
        <div class="col-md-4 mb-3"><strong>الطقس:</strong> @(Model.Weather ?? "-")</div>
        <div class="col-md-4 mb-3"><strong>عدد العمال:</strong> @Model.WorkersCount</div>
        <div class="col-md-4 mb-3"><strong>أُنشئ بواسطة:</strong> @Model.CreatedBy.FullName</div>
        @if (!string.IsNullOrEmpty(Model.WorkCompleted))
        {
            <div class="col-12 mb-3"><strong>الأعمال المنجزة:</strong><p>@Model.WorkCompleted</p></div>
        }
        @if (!string.IsNullOrEmpty(Model.Issues))
        {
            <div class="col-12 mb-3"><strong>المشاكل والعوائق:</strong><p>@Model.Issues</p></div>
        }
        @if (!string.IsNullOrEmpty(Model.MaterialsUsed))
        {
            <div class="col-md-6 mb-3"><strong>المواد المستخدمة:</strong><p>@Model.MaterialsUsed</p></div>
        }
        @if (!string.IsNullOrEmpty(Model.EquipmentUsed))
        {
            <div class="col-md-6 mb-3"><strong>المعدات المستخدمة:</strong><p>@Model.EquipmentUsed</p></div>
        }
        @if (!string.IsNullOrEmpty(Model.Visits))
        {
            <div class="col-12 mb-3"><strong>الزيارات:</strong><p>@Model.Visits</p></div>
        }
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="col-12 mb-3"><strong>ملاحظات:</strong><p>@Model.Notes</p></div>
        }
    </div>
</div>

<div class="athar-card mt-3">
    <h5>الصور (@Model.Photos.Count)</h5>
    <div class="row mt-2">
        @foreach (var photo in Model.Photos)
        {
            <div class="col-md-3 mb-3">
                <div class="athar-permission-group p-2">
                    <img src="@photo.FilePath" class="img-fluid rounded mb-1" alt="صورة تقرير" />
                    @if (!string.IsNullOrEmpty(photo.Description))
                    {
                        <small class="d-block text-muted">@photo.Description</small>
                    }
                    <form method="post" asp-action="DeletePhoto" class="mt-1" onsubmit="return confirm('حذف هذه الصورة؟');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@photo.Id" />
                        <input type="hidden" name="reportId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">حذف</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <hr />
    <form method="post" asp-action="UploadPhoto" enctype="multipart/form-data" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="reportId" value="@Model.Id" />
        <div class="col-md-6">
            <input type="file" name="file" class="form-control" accept="image/*" required />
        </div>
        <div class="col-md-4">
            <input type="text" name="description" class="form-control" placeholder="وصف الصورة (اختياري)" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة صورة</button>
        </div>
    </form>
</div>

<div class="mt-3">
    <a asp-action="Index" asp-route-siteId="@Model.SiteId" class="btn athar-btn-outline">العودة للتقارير</a>
</div>