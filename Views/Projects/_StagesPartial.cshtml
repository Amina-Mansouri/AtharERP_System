@using AtharERP_System.Models.Entities
@model Project
@{
    var engineers = ViewBag.Engineers as List<ApplicationUser>;
    var departments = ViewBag.Departments as List<Department>;
    string StageStatusLabel(StageStatus s) => s switch
    {
        StageStatus.New => "جديدة",
        StageStatus.InProgress => "قيد التنفيذ",
        StageStatus.ClientReview => "مراجعة العميل",
        StageStatus.Completed => "مكتملة",
        StageStatus.Delayed => "متأخرة",
        _ => s.ToString()
    };
    string StepStatusLabel(StepStatus s) => s switch
    {
        StepStatus.NotStarted => "لم تبدأ",
        StepStatus.InProgress => "قيد التنفيذ",
        StepStatus.Completed => "مكتملة",
        _ => s.ToString()
    };
    var totalStageWeight = Model.Stages.Sum(s => s.Weight);
}

<div class="athar-card mt-3">
    <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">مراحل المشروع</h5>
        <span class="text-muted small">مجموع الأوزان: @totalStageWeight.ToString("N0")% / 100%</span>
    </div>

    @if (!Model.Stages.Any())
    {
        <p class="text-muted mt-2">لا توجد مراحل مضافة بعد</p>
    }

    @foreach (var stage in Model.Stages.OrderBy(s => s.Sequence))
    {
        <div class="athar-permission-group mt-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <strong>@stage.Sequence. @stage.Name</strong>
                    <span class="text-muted">(وزن @stage.Weight.ToString("N0")% من المشروع)</span>
                    @if (stage.Department != null)
                    {
                        <span class="text-muted">- @stage.Department.Name</span>
                    }
                </div>
                <div>
                    <span class="badge athar-status-badge athar-status-@stage.Status">@StageStatusLabel(stage.Status)</span>
                    <a asp-controller="ProjectStages" asp-action="Edit" asp-route-id="@stage.Id" class="btn btn-sm athar-btn-outline">تعديل</a>
                    <form method="post" asp-controller="ProjectStages" asp-action="Delete" asp-route-id="@stage.Id" class="d-inline"
                          onsubmit="return confirm('حذف هذه المرحلة سيحذف خطواتها أيضاً. متابعة؟');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                    </form>
                </div>
            </div>

            <div class="progress mt-2" style="height: 10px;">
                <div class="progress-bar athar-progress-bar" style="width: @stage.CompletionPercentage.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
            <small class="text-muted">نسبة الإنجاز: @stage.CompletionPercentage.ToString("N1")% - المهندس المسؤول: @(stage.AssignedEngineer?.FullName ?? "-")</small>

            <table class="table table-sm mt-2 mb-1">
                <thead>
                    <tr>
                        <th>الخطوة</th>
                        <th>الوزن</th>
                        <th>الحالة</th>
                        <th>التكلفة الفعلية</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var step in stage.Steps)
                    {
                        <tr>
                            <td>@step.Name</td>
                            <td>@step.Weight.ToString("N0")%</td>
                            <td>@StepStatusLabel(step.Status)</td>
                            <td>@step.ActualCost.ToString("N2")</td>
                            <td>
                                <a asp-controller="ProjectStages" asp-action="EditStep" asp-route-id="@step.Id" class="btn btn-sm athar-btn-outline">تعديل</a>
                                <form method="post" asp-controller="ProjectStages" asp-action="DeleteStep" asp-route-id="@step.Id" class="d-inline"
                                      onsubmit="return confirm('حذف هذه الخطوة؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <form method="post" asp-controller="ProjectStages" asp-action="CreateStep" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="StageId" value="@stage.Id" />
                <div class="col-md-4">
                    <label class="form-label">اسم خطوة جديدة</label>
                    <input type="text" name="Name" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">الوزن %</label>
                    <input type="number" step="0.01" min="0" max="100" name="Weight" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">التكلفة</label>
                    <input type="number" step="0.01" min="0" name="ActualCost" class="form-control form-control-sm" value="0" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة خطوة</button>
                </div>
            </form>
        </div>
    }

    <hr />
    <h6>إضافة مرحلة جديدة</h6>
    <form method="post" asp-controller="ProjectStages" asp-action="Create" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ProjectId" value="@Model.Id" />
        <div class="col-md-3">
            <label class="form-label">اسم المرحلة</label>
            <input type="text" name="Name" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-1">
            <label class="form-label">الترتيب</label>
            <input type="number" name="Sequence" class="form-control form-control-sm" value="@(Model.Stages.Any() ? Model.Stages.Max(s => s.Sequence) + 1 : 1)" required />
        </div>
        <div class="col-md-2">
            <label class="form-label">الوزن % من المشروع</label>
            <input type="number" step="0.01" min="0" max="100" name="Weight" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-2">
            <label class="form-label">القسم</label>
            <select name="DepartmentId" class="form-select form-select-sm">
                <option value="">-- لا يوجد --</option>
                @if (departments != null)
                {
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">المهندس المسؤول</label>
            <select name="AssignedEngineerId" class="form-select form-select-sm">
                <option value="">-- لا يوجد --</option>
                @if (engineers != null)
                {
                    @foreach (var eng in engineers)
                    {
                        <option value="@eng.Id">@eng.FullName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة</button>
        </div>
    </form>
</div>