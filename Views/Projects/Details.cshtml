@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model Project
@inject PermissionService PermissionService
@{
    ViewData["Title"] = $"تفاصيل المشروع - {Model.Name}";
    var canEdit = await PermissionService.HasPermissionAsync(User, "Projects.Edit");
    string StatusLabel(ProjectStatus s) => s switch
    {
        ProjectStatus.New => "جديد",
        ProjectStatus.InProgress => "قيد التنفيذ",
        ProjectStatus.ClientReview => "مراجعة العميل",
        ProjectStatus.Completed => "مكتمل",
        _ => s.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="athar-page-title">@Model.Name <small class="text-muted">(@Model.Code)</small></h1>
    @if (canEdit)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn athar-btn">تعديل المشروع</a>
    }
</div>

<div class="athar-card mt-3">
    <div class="row">
        <div class="col-md-6 mb-3">
            <strong>الحالة:</strong>
            <span class="badge athar-status-badge athar-status-@Model.Status">@StatusLabel(Model.Status)</span>
        </div>
        <div class="col-md-6 mb-3">
            <strong>نسبة الإنجاز الكلية:</strong>
            <div class="progress mt-1" style="height: 10px; max-width: 300px;">
                <div class="progress-bar athar-progress-bar" style="width: @Model.CompletionPercentage.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
            <small>@Model.CompletionPercentage.ToString("N1")%</small>
        </div>
        <div class="col-md-6 mb-3">
            <strong>العميل:</strong>
            @if (Model.Client != null)
            {
                @(Model.Client.Name)
                @(string.IsNullOrEmpty(Model.Client.CompanyName) ? "" : $" - {Model.Client.CompanyName}")
            }
            else
            {
                @:-
            }
        </div>
        <div class="col-md-6 mb-3">
            <strong>الموقع:</strong> @(Model.Location ?? "-")
        </div>
        <div class="col-md-6 mb-3">
            <strong>مدير المشروع:</strong> @(Model.ProjectManager?.FullName ?? "-")
        </div>
        <div class="col-md-6 mb-3">
            <strong>تاريخ البدء:</strong> @Model.StartDate.ToString("yyyy-MM-dd")
        </div>
        <div class="col-md-6 mb-3">
            <strong>تاريخ الانتهاء المتوقع:</strong> @(Model.EndDate?.ToString("yyyy-MM-dd") ?? "-")
        </div>
        <div class="col-md-6 mb-3">
            <strong>الميزانية:</strong> @Model.Budget.ToString("N2")
        </div>
        <div class="col-md-6 mb-3">
            <strong>المشروع الرئيسي:</strong> @(Model.ParentProject != null ? $"{Model.ParentProject.Code} - {Model.ParentProject.Name}" : "-")
        </div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="col-12 mb-3">
                <strong>الوصف:</strong>
                <p class="mb-0">@Model.Description</p>
            </div>
        }
    </div>

    @if (Model.ChildProjects.Any())
    {
        <hr />
        <h5>المشاريع الفرعية</h5>
        <ul>
            @foreach (var child in Model.ChildProjects)
            {
                <li><a asp-action="Details" asp-route-id="@child.Id">@child.Code - @child.Name</a></li>
            }
        </ul>
    }

    @if (Model.ProjectEngineers.Any())
    {
        <hr />
        <h5>المهندسون المكلفون</h5>
        <ul>
            @foreach (var pe in Model.ProjectEngineers)
            {
                <li>@pe.User.FullName</li>
            }
        </ul>
    }
</div>

@if (canEdit)
{
    <partial name="_StagesPartial" model="Model" />

    @foreach (var stage in Model.Stages)
    {
        <partial name="_TasksPartial" model="stage" />
    }
}
else
{
    <div class="athar-card mt-3">
        <h5>مراحل المشروع</h5>
        @if (!Model.Stages.Any())
        {
            <p class="text-muted">لا توجد مراحل مضافة بعد</p>
        }
        else
        {
            @foreach (var stage in Model.Stages)
            {
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span>@stage.Order. @stage.Name (@stage.Weight.ToString("N0")%)</span>
                        <span>@stage.CompletionPercentage.ToString("N1")%</span>
                    </div>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar athar-progress-bar" style="width: @stage.CompletionPercentage.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                </div>
            }
        }
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn athar-btn-outline">العودة إلى القائمة</a>
</div>