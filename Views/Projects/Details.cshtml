@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model Project
@inject PermissionService PermissionService
@{
    ViewData["Title"] = $"تفاصيل المشروع - {Model.Name}";
    var canEdit = ViewBag.CanEdit as bool? ?? false;
    var canViewClient = ViewBag.CanViewClient as bool? ?? false;
    var canViewCosts = ViewBag.CanViewCosts as bool? ?? false;
    var canManageStages = canEdit || await PermissionService.HasPermissionAsync(User, "Projects.Stages.Manage");
    var canManageTasks = canEdit || await PermissionService.HasPermissionAsync(User, "Projects.Tasks.Manage");
    var canManageTeam = canEdit || canManageStages || canManageTasks;
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
    var allEmployees = ViewBag.AllEmployees as List<ApplicationUser> ?? new List<ApplicationUser>();
    var aggregatedTasks = ViewBag.AggregatedSubProjectTasks as List<ProjectTask>;
    var aggregatedActualCost = ViewBag.AggregatedActualCost as decimal?;

    string StatusLabel(ProjectStatus s) => s switch
    {
        ProjectStatus.New => "جديد",
        ProjectStatus.InProgress => "قيد التنفيذ",
        ProjectStatus.OnHold => "متوقف مؤقتاً",
        ProjectStatus.Completed => "مكتمل",
        ProjectStatus.Cancelled => "ملغى",
        _ => s.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="athar-page-title">@Model.Name <small class="text-muted">(@Model.Code)</small></h1>
    @if (canEdit)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn athar-btn">تعديل المشروع</a>
    }
</div>

<div class="athar-card mt-3">
    <div class="row">
        <div class="col-md-6 mb-3">
            <strong>الحالة:</strong>
            <span class="badge athar-status-badge athar-status-@Model.Status">@StatusLabel(Model.Status)</span>
        </div>
        <div class="col-md-6 mb-3">
            <strong>نسبة الإنجاز الكلية:</strong>
            <div class="progress mt-1" style="height: 10px; max-width: 300px;">
                <div class="progress-bar athar-progress-bar" style="width: @Model.CompletionPercentage.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
            <small>@Model.CompletionPercentage.ToString("N1")%</small>

        </div>

        @if (canViewClient)
        {
            <div class="col-md-6 mb-3">
                <strong>العميل:</strong>
                @if (Model.Client != null)
                {
                    @(Model.Client.Name)
                    @(string.IsNullOrEmpty(Model.Client.CompanyName) ? "" : $" - {Model.Client.CompanyName}")
                }
                else
                {
                    @:-
                }
            </div>
        }
        <div class="col-md-6 mb-3">
            <strong>تاريخ البدء المخطط:</strong> @(Model.PlannedStartDate?.ToString("yyyy-MM-dd") ?? "-")
        </div>
        <div class="col-md-6 mb-3">
            <strong>تاريخ الانتهاء المخطط:</strong> @(Model.PlannedEndDate?.ToString("yyyy-MM-dd") ?? "-")
        </div>
        @if (canViewClient)
        {
            <div class="col-md-6 mb-3">
                <strong>الميزانية:</strong> @(Model.Budget?.ToString("N2") ?? "-")
            </div>
        }
        @if (canViewCosts)
        {
            <div class="col-md-6 mb-3">
                <strong>التكلفة الفعلية:</strong> @((aggregatedActualCost ?? Model.ActualCost).ToString("N2")) د.ل
            </div>
        }
        <div class="col-md-6 mb-3">
            <strong>المشروع الرئيسي:</strong> @(Model.ParentProject != null ? $"{Model.ParentProject.Code} - {Model.ParentProject.Name}" : "-")
        </div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="col-12 mb-3">
                <strong>الوصف:</strong>
                <p class="mb-0">@Model.Description</p>
            </div>
        }
    </div>

    @if (Model.ChildProjects.Any())
    {
        <hr />
        <h5>المشاريع الفرعية</h5>
        <ul>
            @foreach (var child in Model.ChildProjects)
            {
                <li><a asp-action="Details" asp-route-id="@child.Id">@child.Code - @child.Name</a></li>
            }
        </ul>
    }

    <hr />
    <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">فريق المشروع</h5>
    </div>
    <ul class="list-group my-2">
        @foreach (var tm in Model.TeamMembers)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                @tm.User.FullName <span class="badge athar-badge-active">@tm.Role</span>
                @if (canEdit)
                {
                    <form method="post" asp-action="RemoveTeamMember" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@tm.Id" />
                        <input type="hidden" name="projectId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">إزالة</button>
                    </form>
                }
            </li>
        }
    </ul>
    @if (canEdit)
    {
        <form method="post" asp-action="AddTeamMember" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="projectId" value="@Model.Id" />
            <div class="col-md-6">
                <select name="userId" class="form-select form-select-sm">
                    @foreach (var eng in allEmployees)
                    {
                        <option value="@eng.Id">@eng.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="role" class="form-select form-select-sm">
                    <option value="ProjectManager">مدير المشروع</option>
                    <option value="LeadEngineer">مهندس رئيسي</option>
                    <option value="Engineer">مهندس</option>
                    <option value="Member" selected>عضو</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة</button>
            </div>
        </form>
    }

    @if (aggregatedTasks != null && aggregatedTasks.Any())
    {
        <hr />
        <h5>مهام المشاريع الفرعية (تجميع حي)</h5>
        <ul>
            @foreach (var t in aggregatedTasks)
            {
                <li>@t.Title - @t.Status</li>
            }
        </ul>
    }
</div>

<div class="athar-card mt-3">
    <h5>مراحل المشروع</h5>
    @if (!Model.Stages.Any())
    {
        <p class="text-muted">لا توجد مراحل مضافة بعد</p>
    }
    else
    {
        @foreach (var stage in Model.Stages.OrderBy(s => s.Sequence))
        {
            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <span>@stage.Sequence. @stage.Name (@stage.Weight.ToString("N0")%)</span>
                    <span>@stage.CompletionPercentage.ToString("N1")%</span>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar athar-progress-bar" style="width: @stage.CompletionPercentage.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                </div>
                @if (stage.Cost.HasValue && stage.ActualCost > stage.Cost.Value)
                {
                    <div class="alert alert-warning py-1 px-2 mt-1 mb-0 small">
                        ⚠ تجاوزت التكلفة الفعلية الميزانية المخصصة لهذه المرحلة
                    </div>
                }
            </div>
        }
    }
</div>

@if (canManageStages)
{
    <partial name="_StagesPartial" model="Model" />
}

@if (canManageTasks)
{
    @foreach (var stage in Model.Stages.OrderBy(s => s.Sequence))
    {
        <partial name="_TasksPartial" model="stage" />
    }
}

<div class="mt-3">
    <a asp-action="Index" class="btn athar-btn-outline">العودة إلى القائمة</a>
</div>

                        
@section Scripts {
    <form id="atharKanbanForm" method="post" asp-controller="ProjectTasks" asp-action="UpdateStatus" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="atharKanbanTaskId" />
        <input type="hidden" name="status" id="atharKanbanStatus" />
    </form>
    <script>
        function atharKanbanDragStart(ev, taskId) {
            ev.dataTransfer.setData("text/plain", taskId);
        }
        function atharKanbanDrop(ev, status) {
            ev.preventDefault();
            var taskId = ev.dataTransfer.getData("text/plain");
            if (!taskId) return;
            document.getElementById("atharKanbanTaskId").value = taskId;
            document.getElementById("atharKanbanStatus").value = status;
            document.getElementById("atharKanbanForm").submit();
        }
    </script>
}