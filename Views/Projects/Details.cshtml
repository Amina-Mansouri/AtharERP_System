@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model Project
@inject PermissionService PermissionService
@{
    var isNew = Model.Id == 0;
    var isSysAdmin = User.IsInRole("مدير النظام");
    ViewData["Title"] = isNew ? "مشروع جديد" : $"تفاصيل المشروع - {Model.Name}";
    var canEdit = ViewBag.CanEdit as bool? ?? false;
    var canViewClient = ViewBag.CanViewClient as bool? ?? false;
    var canViewCosts = ViewBag.CanViewCosts as bool? ?? false;
    var canManageStages = canEdit || await PermissionService.HasPermissionAsync(User, "Projects.Stages.Manage");
    var canManageAssignments = canEdit || await PermissionService.HasPermissionAsync(User, "Projects.Assignments.Edit");
    var canDelete = !isNew && await PermissionService.HasPermissionAsync(User, "Projects.Delete");
    var assignmentStatusLabels = EnumDisplayHelper.GetDisplayList<AssignmentStatus>();
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
    var stageTemplates = ViewBag.StageTemplates as List<StageTemplate> ?? new List<StageTemplate>();
    var aggregatedActualCost = ViewBag.AggregatedActualCost as decimal?;
    var clients = ViewBag.Clients as List<Client> ?? new List<Client>();
    var parentProjects = ViewBag.ParentProjects as List<Project> ?? new List<Project>();
    var projectCategories = ViewBag.ProjectCategories as List<ProjectCategory> ?? new List<ProjectCategory>();
    var lastSubProjectByParent = ViewBag.LastSubProjectByParent as Dictionary<int, string> ?? new Dictionary<int, string>();
    var documents = ViewBag.Documents as List<ProjectDocument> ?? new List<ProjectDocument>();

    var projectStatusLabels = EnumDisplayHelper.GetDisplayList<ProjectStatus>();
    var stageStatusLabels = EnumDisplayHelper.GetDisplayList<StageStatus>();
    var failedTemplateId = TempData.Peek("FailedTemplateId") as int?;
      var failedWeightStr = TempData.Peek("FailedWeight") as string;
    var failedAreaStr = TempData.Peek("FailedArea") as string;
    var failedPricePerMeterStr = TempData.Peek("FailedPricePerMeter") as string;
    decimal? failedWeight = failedWeightStr != null ? decimal.Parse(failedWeightStr, System.Globalization.CultureInfo.InvariantCulture) : (decimal?)null;
    decimal? failedArea = failedAreaStr != null ? decimal.Parse(failedAreaStr, System.Globalization.CultureInfo.InvariantCulture) : (decimal?)null;
    decimal? failedPricePerMeter = failedPricePerMeterStr != null ? decimal.Parse(failedPricePerMeterStr, System.Globalization.CultureInfo.InvariantCulture) : (decimal?)null;
    var failedEngineerId = TempData.Peek("FailedEngineerId") as string;
    var failedExtraTasks = TempData.Peek("FailedExtraTasks") as string;
    var typeLabels = EnumDisplayHelper.GetDisplayList<ProjectType>();

    var priorityLabels = EnumDisplayHelper.GetDisplayList<Priority>();
    var weightSum = Model.Stages.Sum(s => s.Weight);

    string StageTagClass(StageStatus s) => s switch
    {
        StageStatus.Completed => "tag-success",
        StageStatus.Delayed => "tag-danger",
        StageStatus.InProgress => "tag-accent",
        StageStatus.ClientReview => "tag-info",
        _ => ""
    };

    var allAssignments = Model.Stages
        .SelectMany(s => s.Assignments.Select(a => new { Stage = s, Assignment = a }))
        .OrderByDescending(x => x.Assignment.CreatedAt)
        .ToList();
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px;">
    <div>
        <div style="font-size:11px; color:#8a83a0; font-weight:500;">المشاريع</div>
        <div style="font-size:19px; font-weight:600; margin-top:2px;">
            @(isNew ? "مشروع جديد" : Model.Name)
            @if (!isNew)
            {
                <span class="stat-sub">(@Model.Code)</span>
            }
        </div>
    </div>
       <div class="page-head-actions">
        <a asp-action="Index" class="btn-line">رجوع للقائمة</a>
    </div>
</div>

@if (!isNew)
{
   var stagesForCircles = Model.Stages.OrderBy(s => s.Sequence).ToList();
   
    <div style="display:flex; gap:16px; align-items:flex-start; flex-wrap:wrap; margin-bottom:14px;">
        <div class="stat-strip" style="flex-direction:column; padding:2px 0; flex:1 1 260px; margin-bottom:0;">
            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 16px; border-bottom:1px solid var(--sys-row-line);">
                <span class="kicker">الحالة</span><span class="stat-value" style="font-size:13px;">@projectStatusLabels.FirstOrDefault(x => x.Value == Model.Status.ToString()).Label</span>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 16px; border-bottom:1px solid var(--sys-row-line);">
                <span class="kicker">نسبة الإنجاز</span><span class="stat-value" style="font-size:13px;">@Model.CompletionPercentage.ToString("N1")%</span>
            </div>
            @if (canViewClient)
            {
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 16px; border-bottom:1px solid var(--sys-row-line);">
                    <span class="kicker">العميل</span><span class="stat-value" style="font-size:13px;">@(Model.Client?.Name ?? "-")</span>
                </div>
            }
            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 16px; border-bottom:1px solid var(--sys-row-line);">
                <span class="kicker">البدء المخطط</span><span class="stat-value" style="font-size:13px;">@(Model.PlannedStartDate?.ToString("yyyy-MM-dd") ?? "-")</span>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 16px; @(canViewCosts ? "border-bottom:1px solid var(--sys-row-line);" : "")">
                <span class="kicker">التسليم المتفق عليه</span><span class="stat-value" style="font-size:13px;">@(Model.PlannedEndDate?.ToString("yyyy-MM-dd") ?? "-")</span>
            </div>
            @if (canViewCosts)
            {
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 16px;">
                    <span class="kicker">التكلفة الفعلية</span><span class="stat-value" style="font-size:13px;">@((aggregatedActualCost ?? Model.ActualCost).ToString("N0")) د.ل</span>
                </div>
            }
        </div>
        @if (stagesForCircles.Any())
        {
            <div style="flex:2 1 420px; background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
                <div style="font-size:13.5px; font-weight:600; margin-bottom:12px;">إحصائيات التكليفات لكل مرحلة</div>
                <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; max-height:240px; overflow-y:auto; padding-left:4px;">
                    @foreach (var stage in stagesForCircles)
                    {
                        var stageAssignments = stage.Assignments.ToList();
                        var totalAssignments = stageAssignments.Count;
                        var completedAssignments = stageAssignments.Count(a => a.Status == AssignmentStatus.Completed);
                        var ratio = totalAssignments > 0 ? (decimal)completedAssignments / totalAssignments : 0m;
                        const int circleR = 30;
                        var circleCircumference = 2 * Math.PI * circleR;
                        var circleDash = ratio * (decimal)circleCircumference;
                        var circleGap = (decimal)circleCircumference - circleDash;
                        var circleDashArray = circleDash.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + " " + circleGap.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                        var engineerNames = stageAssignments.SelectMany(a => a.Engineers.Select(e => e.User?.FullName)).Where(n => !string.IsNullOrEmpty(n)).Distinct().ToList();
                        <div style="display:flex; flex-direction:column; align-items:center; border:1px solid #ecebf2; border-radius:11px; padding:12px 10px; text-align:center;">
                            <div style="position:relative; width:64px; height:64px;">
                                <svg width="64" height="64" viewBox="0 0 84 84" style="transform:rotate(-90deg); position:absolute; inset:0;">
                                    <circle cx="42" cy="42" r="@circleR" fill="none" stroke="#f1f0f6" stroke-width="9" />
                                    @if (totalAssignments > 0)
                                    {
                                        <circle cx="42" cy="42" r="@circleR" fill="none" stroke="#7b6bd6" stroke-width="9" stroke-linecap="round" stroke-dasharray="@circleDashArray" />
                                    }
                                </svg>
                                <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; color:#3a3450;">@completedAssignments/@totalAssignments</div>
                            </div>
                            <div style="font-size:11.5px; font-weight:600; text-align:center; margin-top:8px;">@stage.Name</div>
                            <div style="font-size:9.5px; color:#8a83a0; margin-top:2px; text-align:center;">@totalAssignments تكليف · @completedAssignments مكتمل</div>
                            <div style="font-size:9.5px; color:#5a5370; margin-top:5px; text-align:center; line-height:1.6;">@(engineerNames.Any() ? string.Join("، ", engineerNames) : "لا يوجد مكلَّفون بعد")</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
@if (isNew)
{
    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
        <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">بيانات المشروع</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            @{
                var lastCode = ViewBag.LastProjectCode as string;
            }
            <div style="margin-bottom:8px;">
                <label style="font-size:11px; color:#8a83a0;">رمز المشروع</label>
                <input type="text" name="Code" value="@Model.Code" placeholder="رمز المشروع" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                @if (!string.IsNullOrEmpty(lastCode))
                {
                    <div class="stat-sub" style="margin-top:3px;">آخر رمز مسجَّل: @lastCode</div>
                }
            </div>
            <div style="display:grid; grid-template-columns:2fr 1fr; gap:8px; margin-bottom:8px;">
                <div>
                    <label style="font-size:11px; color:#8a83a0;">اسم المشروع</label>
                    <input type="text" name="Name" value="@Model.Name" required style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                </div>
                <div>
                    <label style="font-size:11px; color:#8a83a0;">نطاق المشروع</label>
                    <input type="text" value="مشروع رئيسي" disabled style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px; padding:0 8px; background:#f6f5fa; color:#6b6680;" />
                    <input type="hidden" name="Scope" value="Main" />
                </div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                <div>
                    <label style="font-size:11px; color:#8a83a0;">ملكية المشروع</label>
                    <select name="Type" id="typeSelect" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                        <option value="">--</option>
                        @foreach (var t in typeLabels)
                        {
                            <option value="@t.Value" selected="@(Model.Type.HasValue && Model.Type.Value.ToString() == t.Value)">@t.Label</option>
                        }
                    </select>
                    <input type="hidden" id="typeHidden" name="Type" disabled />
                </div>
                <div>
                    <label style="font-size:11px; color:#8a83a0;">نوع المشروع</label>
                    <select name="ProjectCategoryId" id="categorySelect" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                        <option value="">-- غير محدد --</option>
                        @foreach (var pc in projectCategories)
                        {
                            <option value="@pc.Id" selected="@(Model.ProjectCategoryId == pc.Id)">@pc.DisplayName</option>
                        }
                    </select>
                    <input type="hidden" id="categoryHidden" name="ProjectCategoryId" disabled />
                    <a asp-controller="Admin" asp-action="ProjectCategories" target="_blank" style="font-size:10px;">+ إدارة الخيارات</a>
                </div>
            </div>
            <div style="margin-bottom:8px;">
                <label style="font-size:11px; color:#8a83a0;">الوصف</label>
                <textarea name="Description" rows="2" style="width:100%; border:1px solid #e4e2ec; border-radius:8px; padding:6px 8px; font-size:12px;">@Model.Description</textarea>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                @if (canViewClient)
                {
                    <div>
                        <label style="font-size:11px; color:#8a83a0;">العميل</label>
                        <select name="ClientId" id="clientSelect" required style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                            <option value="">-- اختر العميل --</option>
                            @foreach (var c in clients)
                            {
                                <option value="@c.Id" selected="@(Model.ClientId == c.Id)">@c.Name@(string.IsNullOrEmpty(c.CompanyName) ? "" : $" - {c.CompanyName}")</option>
                            }
                        </select>
                        <input type="hidden" id="clientHidden" name="ClientId" disabled />
                    </div>
                }
                else
                {
                    <input type="hidden" name="ClientId" value="@Model.ClientId" />
                }
                <div>
                    <label style="font-size:11px; color:#8a83a0;">الأولوية</label>
                    <select name="Priority" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                        @foreach (var pr in priorityLabels)
                        {
                            <option value="@pr.Value" selected="@(Model.Priority.ToString() == pr.Value)">@pr.Label</option>
                        }
                    </select>
                    <a asp-controller="Admin" asp-action="ProjectCategories" target="_blank" style="font-size:10px;">+ إدارة الخيارات</a>
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                <div>
                    <label style="font-size:11px; color:#8a83a0;">تاريخ البدء</label>
                    <input type="date" name="PlannedStartDate" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                </div>
                <div>
                    <label style="font-size:11px; color:#8a83a0;">تاريخ التسليم المتفق عليه</label>
                    <input type="date" name="PlannedEndDate" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                </div>
            </div>

            <div style="display:flex; align-items:center; gap:6px; margin-bottom:8px;">
                <input type="checkbox" class="chk-gold" name="AutoTransferToSite" value="true" checked="@Model.AutoTransferToSite" />
                <input type="hidden" name="AutoTransferToSite" value="false" />
                <label style="font-size:11.5px;">ترحيل تلقائي إلى إدارة المواقع عند بدء التنفيذ</label>
            </div>

            <button type="submit" style="height:34px; padding:0 18px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:12.5px; font-weight:600;">إنشاء المشروع</button>
        </form>
    </div>
}
else
{
    <div class="tabs" role="tablist">
        <a class="tab-item active" data-bs-toggle="tab" href="#pane-data">بيانات المشروع</a>
        <a class="tab-item" data-bs-toggle="tab" href="#pane-stages">مراحل المشروع (@Model.Stages.Count)</a>
        <a class="tab-item" data-bs-toggle="tab" href="#pane-assignments">التكليفات (@allAssignments.Count)</a>
        <a class="tab-item" data-bs-toggle="tab" href="#pane-documents">وثائق المشروع (@documents.Count)</a>
        <a class="tab-item" data-bs-toggle="tab" href="#pane-timeline">الجدول الزمني</a>
        
        @if (Model.Scope == ProjectScope.Main)
        {
            <a class="tab-item" data-bs-toggle="tab" href="#pane-subprojects">المشاريع الفرعية (@Model.ChildProjects.Count)</a>
        }
    </div>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="pane-data">
            <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px; margin-bottom:12px;">
                             <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; flex-wrap:wrap; gap:8px;">
                    <div style="font-size:13.5px; font-weight:600;">بيانات المشروع</div>
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        @if (canEdit)
                        {
                            <div id="projDangerZone" hidden style="display:flex; gap:8px; flex-wrap:wrap;">
                                @if (Model.Status == ProjectStatus.OnHold || Model.Status == ProjectStatus.Cancelled)
                                {
                                    <form method="post" asp-action="Reactivate" asp-route-id="@Model.Id" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-line btn-line-accent">إعادة تفعيل</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="Hold" asp-route-id="@Model.Id" style="display:inline;" onsubmit="return confirm('إيقاف المشروع مؤقتاً؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-line">إيقاف مؤقت</button>
                                    </form>
                                    <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" style="display:inline;" onsubmit="return confirm('إلغاء المشروع؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-line" style="color:#c94a42;">إلغاء المشروع</button>
                                    </form>
                                }
                                @if (canDelete)
                                {
                                    <form method="post" asp-action="Delete" asp-route-id="@Model.Id" style="display:inline;" onsubmit="return confirm('تحذير: سيتم حذف هذا المشروع نهائياً مع كل ما يتبعه بلا استثناء — مراحله، مهامه، تكليفاته، مواقعه الميدانية (بمقاوليها وتقاريرها وفحوصاتها وطلبات التوريد فيها)، سجلاته المالية، وأي مشاريع فرعية تابعة له وكل بياناتها. لا يمكن التراجع عن هذا الإجراء إطلاقاً. هل أنتِ متأكدة من المتابعة؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-line" style="color:#fff; background:#c94a42; border-color:#c94a42;">حذف المشروع نهائياً</button>
                                    </form>
                                }
                            </div>
                            <button type="button" id="projEditBtn" onclick="enableProjectEdit()" class="btn-line btn-line-accent">تعديل</button>
                        }
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post" asp-action="Edit" asp-route-id="@Model.Id" id="projectDataForm">
                    @Html.AntiForgeryToken()
                    <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:8px; margin-bottom:8px;">
                        <div>
                            <label style="font-size:11px; color:#8a83a0;">اسم المشروع</label>
                            <input type="text" name="Name" value="@Model.Name" required style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                        </div>
                                              <div>
                            <label style="font-size:11px; color:#8a83a0;">نطاق المشروع</label>
                            <input type="text" value="@(Model.Scope == ProjectScope.Main ? "مشروع رئيسي" : "مشروع فرعي")" disabled style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px; padding:0 8px; background:#f6f5fa; color:#6b6680;" />
                            <input type="hidden" name="Scope" value="@Model.Scope" />
                        </div>
                        <div>
                            <label style="font-size:11px; color:#8a83a0;">المشروع الرئيسي التابع له</label>
                            <input type="text" value="@(Model.ParentProject != null ? $"{Model.ParentProject.Code} - {Model.ParentProject.Name}" : "-- لا يوجد --")" disabled style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px; padding:0 8px; background:#f6f5fa; color:#6b6680;" />
                            <select name="ParentProjectId" id="parentProjectSelect" onchange="toggleParentDependentFields()" style="display:none;">
                                <option value="">-- لا يوجد --</option>
                                @foreach (var p in parentProjects)
                                {
                                    <option value="@p.Id" data-code="@p.Code" data-client="@p.ClientId" data-type="@(p.Type.HasValue ? p.Type.Value.ToString() : "")" data-category="@(p.ProjectCategoryId?.ToString() ?? "")" selected="@(Model.ParentProjectId == p.Id)">@p.Code - @p.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                        <div>
                            <label style="font-size:11px; color:#8a83a0;">ملكية المشروع</label>
                            <select name="Type" id="typeSelect" disabled class="proj-editable" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                                <option value="">--</option>
                                @foreach (var t in typeLabels)
                                {
                                    <option value="@t.Value" selected="@(Model.Type.HasValue && Model.Type.Value.ToString() == t.Value)">@t.Label</option>
                                }
                            </select>
                            <input type="hidden" id="typeHidden" name="Type" disabled />
                        </div>
                        <div>
                            <label style="font-size:11px; color:#8a83a0;">نوع المشروع</label>
                            <select name="ProjectCategoryId" id="categorySelect" disabled class="proj-editable" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                                <option value="">-- غير محدد --</option>
                                @foreach (var pc in projectCategories)
                                {
                                    <option value="@pc.Id" selected="@(Model.ProjectCategoryId == pc.Id)">@pc.DisplayName</option>
                                }
                            </select>
                            <input type="hidden" id="categoryHidden" name="ProjectCategoryId" disabled />
                            <a asp-controller="Admin" asp-action="ProjectCategories" target="_blank" style="font-size:10px;">+ إدارة الخيارات</a>
                        </div>
                    </div>

                    <div style="margin-bottom:8px;">
                        <label style="font-size:11px; color:#8a83a0;">الوصف</label>
                        <textarea name="Description" rows="2" disabled class="proj-editable" style="width:100%; border:1px solid #e4e2ec; border-radius:8px; padding:6px 8px; font-size:12px;">@Model.Description</textarea>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                        @if (canViewClient)
                        {
                            <div>
                                <label style="font-size:11px; color:#8a83a0;">العميل</label>
                                <select name="ClientId" id="clientSelect" required disabled class="proj-editable" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                                    <option value="">-- اختر العميل --</option>
                                    @foreach (var c in clients)
                                    {
                                        <option value="@c.Id" selected="@(Model.ClientId == c.Id)">@c.Name@(string.IsNullOrEmpty(c.CompanyName) ? "" : $" - {c.CompanyName}")</option>
                                    }
                                </select>
                                <input type="hidden" id="clientHidden" name="ClientId" disabled />
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="ClientId" value="@Model.ClientId" />
                        }
                        <div>
                            <label style="font-size:11px; color:#8a83a0;">الأولوية</label>
                            <select name="Priority" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                                @foreach (var pr in priorityLabels)
                                {
                                    <option value="@pr.Value" selected="@(Model.Priority.ToString() == pr.Value)">@pr.Label</option>
                                }
                            </select>
                            <a asp-controller="Admin" asp-action="ProjectCategories" target="_blank" style="font-size:10px;">+ إدارة الخيارات</a>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:8px;">
                        <div>
                            <label style="font-size:11px; color:#8a83a0;">تاريخ البدء</label>
                            <input type="date" name="PlannedStartDate" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" disabled class="proj-editable" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                        </div>
                        <div>
                            <label style="font-size:11px; color:#8a83a0;">تاريخ التسليم المتفق عليه</label>
                            <input type="date" name="PlannedEndDate" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" disabled class="proj-editable" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                        </div>
                        @{
                            var actualDeliveryClass = Model.Status == ProjectStatus.Completed ? "proj-editable" : "";
                        }
                        <div>
                            <label style="font-size:11px; color:#8a83a0;">تاريخ التسليم الفعلي</label>
                            <input type="date" name="ActualDeliveryDate" value="@(Model.ActualDeliveryDate?.ToString("yyyy-MM-dd"))" disabled class="@actualDeliveryClass" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 2fr; gap:8px; align-items:center; margin-bottom:8px;">
                        @if (canViewCosts)
                        {
                            <div>
                                <label style="font-size:11px; color:#8a83a0;">الميزانية (سعر البيع)</label>
                                <input type="text" value="@(Model.Budget?.ToString("N2") ?? "0")" disabled style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px; background:#f7f6fb;" />
                            </div>
                        }
                        <div style="display:flex; align-items:center; gap:6px; margin-top:16px;">
                            <input type="checkbox" class="chk-gold proj-editable" name="AutoTransferToSite" value="true" disabled checked="@Model.AutoTransferToSite" />
                            <input type="hidden" name="AutoTransferToSite" value="false" />
                            <label style="font-size:11.5px;">ترحيل تلقائي إلى إدارة المواقع عند بدء التنفيذ</label>
                        </div>
                    </div>

                    @if (canEdit)
                    {
                        <button type="submit" id="projSaveBtn" hidden style="height:34px; padding:0 18px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:12.5px; font-weight:600;">حفظ التعديلات</button>
                    }
                </form>
            </div>

        </div>

        <div class="tab-pane fade" id="pane-stages">
         
            <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); margin-bottom:12px;">
                <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px 10px; border-bottom:1px solid #f1f0f6;">
                    <div style="font-size:13.5px; font-weight:600;">مراحل المشروع</div>
                    <span class="tag @(weightSum == 100 ? "tag-success" : "tag-warning")">مجموع الأوزان @weightSum.ToString("N0")%@(weightSum == 100 ? " ✓" : "")</span>
                </div>

                <div class="data-table" style="--cols: 30px minmax(0,1.2fr) 56px 90px 110px 70px 96px 92px 160px">
                    <div class="data-table-head">
                        <div class="cell">ت</div>
                        <div class="cell">المرحلة</div>
                        <div class="cell">الوزن</div>
                        <div class="cell">التخصص</div>
                        <div class="cell">المهندس المشرف</div>
                        <div class="cell">التكليفات</div>
                        <div class="cell">نسبة الإنجاز</div>
                        <div class="cell">الحالة</div>
                        <div class="cell"></div>
                    </div>
                    @if (!Model.Stages.Any())
                    {
                        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مراحل مضافة بعد</div></div>
                    }
                    else
                    {
                        @foreach (var stage in Model.Stages.OrderBy(s => s.Sequence))
                        {
                            <div class="data-table-row">
                                <div class="cell cell-num">@stage.Sequence</div>
                                <div class="cell" style="white-space:normal; overflow:visible; text-overflow:clip;">
                                    <a href="#" data-bs-toggle="collapse" data-bs-target="#stage-tasks-@stage.Id" style="text-decoration:none; color:inherit;">
                                        ▾ @stage.Name
                                    </a>
                                    <span class="stat-sub">(@stage.Tasks.Count مهمة)</span>
                                   @if (stage.Assignments.Any(a => a.IsRedesign && a.Status != AssignmentStatus.Completed && a.Status != AssignmentStatus.Cancelled))
                                    {
                                        <span class="tag tag-accent" title="يوجد تكليف إعادة تصميم قيد التنفيذ على هذه المرحلة">🔁 إعادة تصميم</span>
                                    }
                                    @if (stage.ActualCost > stage.SaleValue)
                                    {
                                        <span class="tag tag-danger">خسارة في المرحلة</span>
                                    }
                                    @if (stage.CompletionPercentage >= 100 && stage.Status != StageStatus.Completed && stage.Tasks.Any(t => t.Status == ProjectTaskStatus.Blocked))
                                    {
                                        <span class="tag tag-warning">100% — توجد مهام محظورة</span>
                                    }
                                    @if (stage.Tasks.Any(t => t.Status == ProjectTaskStatus.Blocked || (t.ProjectAssignment != null && t.ProjectAssignment.Status == AssignmentStatus.Cancelled)))
                                    {
                                        <span class="tag tag-warning">⚠ توجد مهام محظورة أو تابعة لتكليف متوقف</span>
                                    }
                                </div>
                                <div class="cell cell-num">@stage.Weight.ToString("N0")%</div>
                                <div class="cell">@(stageTemplates.FirstOrDefault(t => t.Name == stage.Name)?.Discipline?.Name ?? "-")</div>
                                <div class="cell">@(stage.AssignedEngineer?.FullName ?? "-")</div>
                                <div class="cell cell-num">@stage.Assignments.Count</div>
                                <div class="cell cell-num">@stage.CompletionPercentage.ToString("N0")%</div>
                                <div class="cell"><span class="tag @StageTagClass(stage.Status)">@stageStatusLabels.FirstOrDefault(x => x.Value == stage.Status.ToString()).Label</span></div>
                                <div class="cell" style="display:flex; flex-wrap:wrap; gap:6px; align-items:center;">
                                    @if (canManageStages)
                                    {
                                        <a asp-controller="ProjectStages" asp-action="Edit" asp-route-id="@stage.Id" style="font-size:11px; white-space:nowrap;">تعديل</a>
                                        @if (stage.Status == StageStatus.Completed)
                                        {
                                            <a asp-controller="ClientRedesignRequests" asp-action="Index" asp-route-stageId="@stage.Id" style="font-size:11px; white-space:nowrap;">إعادة تصميم</a>
                                        }
                                        <form method="post" asp-controller="ProjectStages" asp-action="Delete" asp-route-id="@stage.Id" onsubmit="return confirm('حذف هذه المرحلة سيحذف تكليفاتها أيضاً. متابعة؟');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-line" style="height:22px; padding:0 6px; font-size:10px; color:#c94a42; white-space:nowrap;">حذف</button>
                                        </form>
                                    }
                                    @if (isSysAdmin && stage.Status != StageStatus.Completed)
                                    {
                                        <form method="post" asp-controller="ProjectStages" asp-action="ArchiveStage" asp-route-id="@stage.Id" onsubmit="return confirm('سيُنهى جميع تكليفات هذه المرحلة غير المكتملة مباشرة بدون المرور بالمراجعات، وتُرحَّل فوراً للمالية. إن كانت آخر مرحلة ناقصة، سيكتمل المشروع بالكامل تلقائياً. هل تريدين المتابعة؟');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-line" style="height:22px; padding:0 6px; font-size:10px; color:#c9a15a; white-space:nowrap;">إنهاء مرحلة</button>
                                        </form>
                                    }
                                </div>
                            </div>
                            <div class="collapse" id="stage-tasks-@stage.Id" style="grid-column:1/-1;">
                                <div style="background:#faf9fc; border-bottom:1px solid #f1f0f6; padding:8px 14px 12px;">
                                    <div style="font-size:11.5px; font-weight:600; margin-bottom:6px;">مهام هذه المرحلة</div>
                                    @if (!stage.Tasks.Any())
                                    {
                                        <div class="stat-sub">لا توجد مهام في هذه المرحلة بعد</div>
                                    }
                                    else
                                    {
                                        <div style="display:grid; gap:6px;">
                                            @foreach (var t in stage.Tasks.OrderBy(t => t.Title))
                                            {
                                                var taskTagClass = t.Status == ProjectTaskStatus.Completed ? "tag-success"
                                                    : (t.Status == ProjectTaskStatus.PendingReview ? "tag-warning"
                                                    : (t.Status == ProjectTaskStatus.Blocked ? "tag-danger" : ""));
                                                <div style="display:flex; align-items:center; justify-content:space-between; border:1px solid #ecebf2; border-radius:8px; padding:6px 10px; background:#fff;">
                                                    @{
                                                        var taskAssignment = t.ProjectAssignmentId.HasValue
                                                            ? stage.Assignments.FirstOrDefault(a => a.Id == t.ProjectAssignmentId.Value)
                                                            : null;
                                                        var taskHasNoEngineer = taskAssignment == null || !taskAssignment.Engineers.Any();
                                                    }
                                                    @if (taskHasNoEngineer)
                                                    {
                                                        <span style="font-size:11.5px; color:#8a83a0;" title="لا يمكن الدخول — لا يوجد مهندس مرتبط بعد">@t.Title</span>
                                                    }
                                                    else
                                                    {
                                                        <a asp-controller="ProjectTasks" asp-action="Edit" asp-route-id="@t.Id" style="font-size:11.5px; color:inherit; text-decoration:underline;">@t.Title</a>
                                                    }
                                                    <div style="display:flex; align-items:center; gap:8px;">
                                                        <span class="stat-sub">الوزن: @t.Weight.ToString("N0")%</span>
                                                        @if (t.ProjectAssignmentId == null)
                                                        {
                                                            <span class="tag tag-warning">غير مرتبطة بتكليف</span>
                                                        }
                                                        <span class="tag @taskTagClass">@(t.Status == ProjectTaskStatus.PendingReview ? "قيد المراجعة" : t.CompletionPercentage.ToString("N0") + "%")</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                             @if (canManageStages)
                {
                    <div style="padding:14px 16px; border-top:1px solid #f1f0f6;">
                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
                            <div style="font-size:12px; font-weight:600;">قوالب المراحل</div>
                            <a asp-controller="StageTemplates" asp-action="Index" style="font-size:11px;">+ إدارة القوالب</a>
                        </div>
                        <div style="display:flex; gap:14px; align-items:flex-start; flex-wrap:wrap;">
                            <div style="display:flex; flex-direction:column; gap:4px; min-width:170px;">
                                @foreach (var tpl in stageTemplates.Where(t => t.IsActive))
                                {
                                    var isUsedNav = Model.Stages.Any(s => s.Name == tpl.Name);
                                    <a href="#" id="tpl-nav-@tpl.Id" data-bs-toggle="collapse" data-bs-target="#tpl-card-@tpl.Id" onclick="try { sessionStorage.setItem('openStageTemplateId', '@tpl.Id'); } catch(e) {}" class="tpl-nav-link" style="display:flex; align-items:center; justify-content:space-between; gap:6px; padding:7px 10px; border:1px solid @(isUsedNav ? "#c9c2e6" : "#ecebf2"); border-radius:8px; background:@(isUsedNav ? "rgba(123,107,214,.05)" : "#fff"); text-decoration:none; color:inherit; font-size:11.5px;">
                                        <span>@tpl.Name</span>
                                        @if (isUsedNav)
                                        {
                                            <span class="tag tag-accent" style="font-size:9px;">مفعّلة</span>
                                        }
                                    </a>
                                }
                            </div>
                               <div id="tplCardsAccordion" style="flex:1 1 320px; min-width:260px;">
                                @foreach (var tpl in stageTemplates.Where(t => t.IsActive))
                                {
                                    var isUsed = Model.Stages.Any(s => s.Name == tpl.Name);
                                    var usedStage = isUsed ? Model.Stages.First(s => s.Name == tpl.Name) : null;
                                    var isFailedTemplate = failedTemplateId == tpl.Id;
                               <div class="collapse" id="tpl-card-@tpl.Id" data-bs-parent="#tplCardsAccordion">
                                        <div style="border:1px solid @(isUsed ? "#c9c2e6" : "#ecebf2"); border-radius:9px; padding:10px 12px; background:@(isUsed ? "rgba(123,107,214,.03)" : "#fff"); margin-bottom:10px;">
                                            <div style="display:flex; align-items:center; justify-content:space-between;">
                                                <div style="font-size:12px; font-weight:600;">@tpl.Name</div>
                                                @if (isUsed)
                                                {
                                                    <span class="tag tag-accent">مفعّلة</span>
                                                }
                                            </div>
                                            <div style="font-size:10px; color:#8a83a0; margin-top:4px;">@tpl.DefaultTasks.Count مهام افتراضية</div>

                                            @if (!isUsed)
                                            {
                                                @if (isFailedTemplate && !string.IsNullOrEmpty(TempData.Peek("Error") as string))
                                                {
                                                    <div style="background:#fdecea; border:1px solid #e35d54; color:#c94a42; border-radius:7px; padding:6px 8px; margin-top:8px; font-size:10.5px; font-weight:600;">@(TempData.Peek("Error") as string)</div>
                                                }
                                                <form method="post" asp-controller="ProjectStages" asp-action="ActivateTemplate" style="margin-top:8px;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="projectId" value="@Model.Id" />
                                                    <input type="hidden" name="stageTemplateId" value="@tpl.Id" />
                                                    <div style="margin-bottom:6px;">
                                                        <input type="number" step="0.01" min="0" max="100" name="weight" placeholder="الوزن %" required value="@(isFailedTemplate ? failedWeight : tpl.DefaultWeight)" style="width:100%; height:28px; border:1px solid #e4e2ec; border-radius:7px; padding:0 8px; font-size:11px;" />
                                                    </div>
                                                  
                                                    <div style="margin-bottom:6px;">
                                                        <div class="stat-sub">التخصص: @(tpl.Discipline?.Name ?? "غير محدَّد لهذا القالب")</div>
                                                    </div>
                                                    <div style="margin-bottom:6px;">
                                                        <div>
                                                            <label style="font-size:10px; color:#8a83a0;">المهندس المشرف</label>
                                                            <select name="assignedEngineerId" style="width:100%; height:28px; border:1px solid #e4e2ec; border-radius:7px; font-size:11px;">
                                                                <option value="">-- المهندس المشرف --</option>
                                                                @foreach (var eng in engineers)
                                                                {
                                                                    <option value="@eng.Id" selected="@(isFailedTemplate && failedEngineerId == eng.Id)">@eng.FullName</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div style="display:grid; gap:4px; margin-bottom:6px;">
                                                        @foreach (var t in tpl.DefaultTasks.OrderBy(x => x.Order))
                                                        {
                                                            <div style="display:flex; align-items:center; gap:5px;">
                                                                <input type="checkbox" class="chk-gold" name="selectedTaskIds" value="@t.Id" checked />
                                                                <span style="font-size:10.5px; color:#5a5370; flex:1;">@t.TaskName</span>
                                                                <input type="number" step="0.01" min="0" max="100" name="taskWeight_@t.Id" placeholder="الوزن %" value="@t.DefaultWeight" style="width:60px; height:22px; border:1px solid #e4e2ec; border-radius:5px; padding:0 4px; font-size:10px;" />
                                                            </div>
                                                        }
                                                    </div>
                                                    <textarea name="extraTasks" placeholder="مهام إضافية (سطر لكل مهمة)" rows="2" style="width:100%; border:1px solid #e4e2ec; border-radius:7px; padding:6px 8px; font-size:10.5px; margin-bottom:6px;">@(isFailedTemplate ? failedExtraTasks : "")</textarea>
                                                    <button type="submit" style="width:100%; height:28px; border:none; border-radius:7px; background:#7b6bd6; color:#fff; font-size:11px; font-weight:600;">+ تفعيل</button>
                                                </form>
                                            }
                                                                                                                                 else if (usedStage != null)
                                            {
                                                @if (canManageStages)
                                                {
                                                    var otherStagesWeightTotal = Model.Stages.Where(s => s.Id != usedStage.Id).Sum(s => s.Weight);
                                                    var canEditStageWeight = otherStagesWeightTotal < 100;
                                                    <form method="post" asp-controller="ProjectStages" asp-action="Edit" asp-route-id="@usedStage.Id" style="margin-top:8px; border:1px solid #ecebf2; border-radius:8px; padding:8px; background:#faf9fc;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="Name" value="@usedStage.Name" />
                                                        <input type="hidden" name="Sequence" value="@usedStage.Sequence" />
                                                        <input type="hidden" name="PlannedStartDate" value="@(usedStage.PlannedStartDate?.ToString("yyyy-MM-dd"))" />
                                                        <input type="hidden" name="PlannedEndDate" value="@(usedStage.PlannedEndDate?.ToString("yyyy-MM-dd"))" />
                                                        <input type="hidden" name="ActualDeliveryDate" value="@(usedStage.ActualDeliveryDate?.ToString("yyyy-MM-dd"))" />
                                                        <input type="hidden" name="WorkDocumentation" value="@usedStage.WorkDocumentation" />
                                                        <div style="margin-bottom:6px;">
                                                            <label style="font-size:10px; color:#8a83a0;">الوزن %</label>
                                                            @if (canEditStageWeight)
                                                            {
                                                                <input type="number" step="0.01" min="0" max="100" name="Weight" required value="@usedStage.Weight.ToString("N2")" style="width:100%; height:28px; border:1px solid #e4e2ec; border-radius:7px; padding:0 8px; font-size:11px;" />
                                                            }
                                                            else
                                                            {
                                                                <input type="text" value="@usedStage.Weight.ToString("N0")%" disabled style="width:100%; height:28px; border:1px solid #e4e2ec; border-radius:7px; padding:0 8px; font-size:11px; background:#f1f0f6;" />
                                                                <input type="hidden" name="Weight" value="@usedStage.Weight" />
                                                                <div class="stat-sub">مقفل — أوزان بقية المراحل وصلت 100%</div>
                                                            }
                                                        </div>
                                                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-bottom:6px;">
                                                                <div>
                                                                    <label style="font-size:10px; color:#8a83a0;">المساحة (م²)</label>
                                                                    <input type="number" step="0.01" min="0" name="Area" value="@usedStage.Area" style="width:100%; height:28px; border:1px solid #e4e2ec; border-radius:7px; padding:0 8px; font-size:11px;" />
                                                                </div>
                                                            <div>
                                                                <label style="font-size:10px; color:#8a83a0;">المهندس المشرف</label>
                                                                <select name="AssignedEngineerId" style="width:100%; height:28px; border:1px solid #e4e2ec; border-radius:7px; font-size:11px;">
                                                                    <option value="">-- المهندس المشرف --</option>
                                                                    @foreach (var eng in engineers)
                                                                    {
                                                                        <option value="@eng.Id" selected="@(usedStage.AssignedEngineerId == eng.Id)">@eng.FullName</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <button type="submit" style="width:100%; height:28px; border:none; border-radius:7px; background:#7b6bd6; color:#fff; font-size:11px; font-weight:600;">حفظ تعديلات المرحلة</button>
                                                    </form>
                                                }
                                                <div style="margin-top:8px; display:grid; gap:5px;">
                                                    @foreach (var t in tpl.DefaultTasks.OrderBy(x => x.Order))
                                                    {
                                                        var existingTask = usedStage.Tasks.FirstOrDefault(pt => pt.Title == t.TaskName);
                                                        <div style="display:flex; align-items:center; gap:6px; border:1px solid #ecebf2; border-radius:7px; padding:5px 8px; background:#fff;">
                                                            @if (existingTask != null)
                                                            {
                                                                <input type="checkbox" class="chk-gold" checked disabled />
                                                                <span style="font-size:10.5px; color:#5a5370; flex:1;">@t.TaskName</span>
                                                                <span class="stat-sub">@existingTask.Weight.ToString("N0")%</span>
                                                            }
                                                            else
                                                            {
                                                                <form method="post" asp-controller="ProjectTasks" asp-action="Create" style="display:flex; align-items:center; gap:6px; flex:1;">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="StageId" value="@usedStage.Id" />
                                                                    <input type="hidden" name="Title" value="@t.TaskName" />
                                                                    <input type="checkbox" disabled style="opacity:.4;" />
                                                                    <span style="font-size:10.5px; color:#8a83a0; flex:1;">@t.TaskName</span>
                                                                    <input type="number" step="0.01" min="0" max="100" name="Weight" placeholder="الوزن %" required style="width:60px; height:24px; border:1px solid #e4e2ec; border-radius:5px; padding:0 4px; font-size:10px;" />
                                                                    <button type="submit" style="height:24px; padding:0 8px; border:none; border-radius:5px; background:#7b6bd6; color:#fff; font-size:10px; white-space:nowrap;">+ إضافة</button>
                                                                </form>
                                                            }
                                                                                                               </div>
                                                                                                      }
                                                    @foreach (var extraTask in usedStage.Tasks.Where(pt => !tpl.DefaultTasks.Any(dt => dt.TaskName == pt.Title)))
                                                    {
                                                        <div style="display:flex; align-items:center; gap:6px; border:1px solid #ecebf2; border-radius:7px; padding:5px 8px; background:#fff;">
                                                            <input type="checkbox" class="chk-gold" checked disabled />
                                                            <span style="font-size:10.5px; color:#5a5370; flex:1;">@extraTask.Title</span>
                                                            <span class="tag tag-accent" style="font-size:9px;">إضافية</span>
                                                            <span class="stat-sub">@extraTask.Weight.ToString("N0")%</span>
                                                        </div>
                                                    }
                                                    @{
                                                        var remainingStageWeight = usedStage.Weight - usedStage.Tasks.Sum(t => t.Weight);
                                                    }
                                                    @if (remainingStageWeight > 0)
                                                    {
                                                        <form method="post" asp-controller="ProjectTasks" asp-action="Create" style="display:flex; align-items:center; gap:6px; border:1px dashed #c9c2e6; border-radius:7px; padding:5px 8px; background:#faf9fc; margin-top:4px;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="StageId" value="@usedStage.Id" />
                                                            <input type="text" name="Title" placeholder="اسم مهمة جديدة" required style="flex:1; height:24px; border:1px solid #e4e2ec; border-radius:5px; padding:0 6px; font-size:10.5px;" />
                                                            <input type="number" step="0.01" min="0" max="@remainingStageWeight" name="Weight" placeholder="الوزن %" required style="width:60px; height:24px; border:1px solid #e4e2ec; border-radius:5px; padding:0 4px; font-size:10px;" />
                                                            <button type="submit" style="height:24px; padding:0 8px; border:none; border-radius:5px; background:#7b6bd6; color:#fff; font-size:10px; white-space:nowrap;">+ إضافة مهمة جديدة</button>
                                                        </form>
                                                        <div class="stat-sub" style="margin-top:2px;">الوزن المتبقي القابل للتوزيع: @remainingStageWeight.ToString("N0")%</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="pane-assignments">
            <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); margin-bottom:12px;">
