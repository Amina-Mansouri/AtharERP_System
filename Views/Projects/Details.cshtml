        <div class="tab-pane fade" id="pane-documents">
            <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
                <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">مستندات المشروع</div>
                @if (!documents.Any())
                {
                    <div class="stat-sub" style="margin-bottom:10px;">لا توجد مستندات مرفوعة بعد</div>
                }
                else
                {
                    <div style="display:grid; gap:8px; margin-bottom:10px;">
                        @foreach (var doc in documents)
                        {
                            <div style="display:flex; align-items:center; justify-content:space-between; border:1px solid #f1f0f6; border-radius:8px; padding:6px 10px;">
                                <div>
                                    <a href="@doc.FilePath" target="_blank" style="font-size:11.5px;">@doc.FileName</a>
                                    <div class="stat-sub">@(doc.UploadedBy?.FullName ?? "-") · @doc.UploadedAt.ToString("yyyy-MM-dd")</div>
                                </div>
                                @if (canEdit)
                                {
                                    <form method="post" asp-controller="ProjectDocuments" asp-action="Delete" asp-route-id="@doc.Id" onsubmit="return confirm('حذف هذا المستند؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-line" style="height:24px; padding:0 8px; font-size:10px; color:#c94a42;">حذف</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
                @if (canEdit)
                {
                    <form method="post" asp-controller="ProjectDocuments" asp-action="Upload" enctype="multipart/form-data" style="display:grid; gap:6px; max-width:360px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@Model.Id" />
                        <input type="file" name="file" required style="font-size:11px;" />
                        <input type="text" name="description" placeholder="وصف مختصر (اختياري)" style="height:30px; border:1px solid #e4e2ec; border-radius:7px; padding:0 8px; font-size:11px;" />
                        <button type="submit" style="height:30px; border:none; border-radius:7px; background:#7b6bd6; color:#fff; font-size:11px; font-weight:600;">+ رفع مستند</button>
                    </form>
                }
            </div>

            @{
                string DocsProposalTagClass(ProposalStatus s) => (s == ProposalStatus.Approved || s == ProposalStatus.ApprovedWithModification) ? "tag-success" : ((s == ProposalStatus.Resubmission || s == ProposalStatus.Redesign) ? "tag-danger" : "tag-warning");
                string DocsProposalLabel(ProposalStatus s) => s switch
                {
                    ProposalStatus.Approved => "معتمد",
                    ProposalStatus.ApprovedWithModification => "معتمد مع تعديل",
                    ProposalStatus.Resubmission => "إعادة تقديم",
                    ProposalStatus.Redesign => "إعادة تصميم",
                    _ => "بانتظار الاعتماد"
                };
                var assignmentDocsGroups = allAssignments
                    .Select(x => new
                    {
                        x.Stage,
                        x.Assignment,
                        Docs = x.Assignment.Tasks.SelectMany(t => t.Todos).SelectMany(td => td.DesignProposals).OrderByDescending(d => d.SubmittedDate).ToList()
                    })
                    .Where(x => x.Docs.Any())
                    .ToList();
            }

            <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px; margin-top:12px;">
                <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">وثائق التكليفات</div>
                @if (!assignmentDocsGroups.Any())
                {
                    <div class="stat-sub">لا توجد وثائق مرفوعة ضمن أي تكليف بعد</div>
                }
                else
                {
                    <div style="display:grid; gap:12px;">
                        @foreach (var grp in assignmentDocsGroups)
                        {
                            <div style="border:1px solid #ecebf2; border-radius:9px; padding:10px 12px;">
                                <div style="font-size:11.5px; font-weight:700; margin-bottom:6px;">@grp.Stage.Name — @grp.Assignment.AssignmentType</div>
                                <div style="display:grid; gap:6px;">
                                    @foreach (var doc in grp.Docs)
                                    {
                                        <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; border:1px solid #f1f0f6; border-radius:8px; padding:6px 10px; flex-wrap:wrap;">
                                            <div>
                                                <a href="@doc.FilePath" target="_blank" download="@($"{doc.Code}.{doc.FileType}")" style="font-size:11.5px; font-weight:600;">@doc.Code — @doc.Name (v@doc.Revision)</a>
                                                <div class="stat-sub">@(doc.PreparedBy?.FullName ?? "-") · @doc.FileType · @(doc.SubmittedDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                                            </div>
                                            <span class="tag @DocsProposalTagClass(doc.Status)">@DocsProposalLabel(doc.Status)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="pane-timeline">
            <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:16px;">
                <div style="font-size:13.5px; font-weight:600; margin-bottom:14px;">الجدول الزمني للمشروع</div>
                @{
                    var timelineStages = Model.Stages.OrderBy(s => s.Sequence).ToList();
                    var datedStages = timelineStages.Where(s => s.PlannedStartDate.HasValue && s.PlannedEndDate.HasValue).ToList();
                }
                @if (!datedStages.Any())
                {
                    <div class="stat-sub">لم يتم تحديد تواريخ بدء/انتهاء مخططة للمراحل بعد</div>
                }
                else
                {
                    var minDate = datedStages.Min(s => s.PlannedStartDate!.Value);
                    var maxDate = datedStages.Max(s => s.PlannedEndDate!.Value);
                    var maxActual = timelineStages.Where(s => s.ActualDeliveryDate.HasValue).Select(s => s.ActualDeliveryDate!.Value).DefaultIfEmpty(maxDate).Max();
                    if (maxActual > maxDate) { maxDate = maxActual; }
                    var totalDays = Math.Max(1, (maxDate - minDate).Days);

                    var today = DateTime.UtcNow.Date;
                    var todayInRange = today >= minDate && today <= maxDate;
                    var todayPct = Math.Max(0, Math.Min(100, (today - minDate).TotalDays / totalDays * 100));
                    var todayPctStr = todayPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

                    (string Solid, string Tint) GetStageColors(StageStatus s) => s switch
                    {
                        StageStatus.Completed => ("#2f8a57", "rgba(47,138,87,.16)"),
                        StageStatus.Delayed => ("#c94a42", "rgba(201,74,66,.16)"),
                        StageStatus.InProgress => ("#7b6bd6", "rgba(123,107,214,.16)"),
                        StageStatus.ClientReview => ("#5090b0", "rgba(80,144,176,.16)"),
                        _ => ("#8a83a0", "rgba(138,131,160,.16)")
                    };

                    <div style="display:flex; justify-content:flex-end; gap:6px; margin-bottom:10px;">
                        <button type="button" class="btn-line" onclick="adjustTimelineZoom(-25)" style="height:28px; padding:0 10px; font-size:12px;">－</button>
                        <button type="button" class="btn-line" onclick="adjustTimelineZoom(0)" style="height:28px; padding:0 10px; font-size:11px;">إعادة ضبط</button>
                        <button type="button" class="btn-line" onclick="adjustTimelineZoom(25)" style="height:28px; padding:0 10px; font-size:12px;">＋</button>
                    </div>
                    <div style="overflow-x:auto;">
                        <div id="timelineZoomInner" data-zoom="100" style="zoom:1;">
                            <div style="display:flex; gap:0; margin-bottom:8px;">
                                <div style="width:180px; flex-shrink:0;"></div>
                        <div style="flex:1; position:relative; height:16px;">
                            <span style="position:absolute; right:0; font-size:10.5px; color:#8a83a0;">@minDate.ToString("yyyy/MM/dd")</span>
                            <span style="position:absolute; left:0; font-size:10.5px; color:#8a83a0;">@maxDate.ToString("yyyy/MM/dd")</span>
                            @if (todayInRange)
                            {
                                <span style="position:absolute; right:@todayPctStr%; transform:translateX(50%); font-size:9.5px; font-weight:700; color:#c9700f; white-space:nowrap;">اليوم @today.ToString("MM/dd")</span>
                            }
                        </div>
                    </div>
                    <div style="display:grid; gap:32px; margin-top:26px;">
                        @foreach (var stage in timelineStages)
                        {
                            var (barColor, tint) = GetStageColors(stage.Status);
                            var completionClamped = Math.Max(0m, Math.Min(100m, stage.CompletionPercentage));
                            var completionStr = completionClamped.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);
                            <div style="display:flex; align-items:center; gap:10px;">
                                <div style="width:170px; flex-shrink:0; font-size:11.5px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@stage.Name">@stage.Sequence. @stage.Name</div>
                                <div style="flex:1; position:relative;">
                                    @if (stage.PlannedStartDate.HasValue && stage.PlannedEndDate.HasValue)
                                    {
                                        var leftPct = Math.Max(0, Math.Min(100, (stage.PlannedStartDate.Value - minDate).TotalDays / totalDays * 100));
                                        var rightPct = Math.Max(0, Math.Min(100, (stage.PlannedEndDate.Value - minDate).TotalDays / totalDays * 100));
                                        var widthPct = Math.Max(6.0, rightPct - leftPct);
                                        var endRightPct = leftPct + widthPct;
                                        var leftPctStr = leftPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                        var widthPctStr = widthPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                        var endRightPctStr = endRightPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                        <div style="position:absolute; right:@leftPctStr%; bottom:100%; transform:translateX(50%); display:flex; flex-direction:column; align-items:center; margin-bottom:1px; z-index:2;">
                                            <span style="font-size:9.5px; font-weight:700; color:@barColor; white-space:nowrap; line-height:1.3;">@stage.PlannedStartDate.Value.ToString("yyyy/MM/dd")</span>
                                            <span style="width:1px; height:9px; background:@barColor; opacity:.45;"></span>
                                        </div>
                                        <div style="position:absolute; right:@endRightPctStr%; bottom:100%; transform:translateX(50%); display:flex; flex-direction:column; align-items:center; margin-bottom:1px; z-index:2;">
                                            <span style="font-size:9.5px; font-weight:700; color:@barColor; white-space:nowrap; line-height:1.3;">@stage.PlannedEndDate.Value.ToString("yyyy/MM/dd")</span>
                                            <span style="width:1px; height:9px; background:@barColor; opacity:.45;"></span>
                                        </div>
                                        <div style="position:relative; height:26px; background:#f7f6fb; border-radius:6px;">
                                            <div style="position:absolute; right:@leftPctStr%; width:@widthPctStr%; top:3px; bottom:3px; background:@tint; border-radius:5px; overflow:hidden;">
                                                <div style="position:absolute; top:0; bottom:0; right:0; width:@completionStr%; background:@barColor; border-radius:5px 0 0 5px;"></div>
                                            </div>
                                        </div>
                                        @if (todayInRange)
                                        {
                                            <div style="position:absolute; right:@todayPctStr%; top:-22px; bottom:0; width:0; border-right:1px dashed #c9700f; opacity:.7; z-index:1;"></div>
                                        }
                                    }
                                    else
                                    {
                                        <div style="position:relative; height:26px; background:#f7f6fb; border-radius:6px; display:flex; align-items:center; padding-right:8px;">
                                            <span class="stat-sub" style="font-size:10px;">لا توجد تواريخ محددة</span>
                                        </div>
                                    }
                                                </div>
                                        <span style="font-size:11px; font-weight:700; color:@barColor; flex-shrink:0; width:34px; text-align:center;">@completionStr%</span>
                                        <span class="tag @StageTagClass(stage.Status)" style="flex-shrink:0;">@stageStatusLabels.FirstOrDefault(x => x.Value == stage.Status.ToString()).Label</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.Scope == ProjectScope.Main)
        {
            <div class="tab-pane fade" id="pane-subprojects">
                <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
              

                    <div style="margin-bottom:16px; padding-bottom:14px; border-bottom:1px dashed #ecebf2;">
                        <div style="font-size:13px; font-weight:600; margin-bottom:8px;">+ إضافة مبنى جديد</div>
                        @{
                            var lastSubHere = lastSubProjectByParent.ContainsKey(Model.Id) ? lastSubProjectByParent[Model.Id] : null;
                            var parentTypeLabel = Model.Type.HasValue ? typeLabels.FirstOrDefault(x => x.Value == Model.Type.Value.ToString()).Label : "-";
                            var parentCategoryLabel = Model.ProjectCategory?.DisplayName ?? "-";
                        }
                        <form method="post" asp-controller="Projects" asp-action="Create">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Scope" value="Sub" />
                            <input type="hidden" name="ParentProjectId" value="@Model.Id" />
                            <input type="hidden" name="ClientId" value="@Model.ClientId" />
                            <input type="hidden" name="Type" value="@(Model.Type?.ToString() ?? "")" />
                            <input type="hidden" name="ProjectCategoryId" value="@(Model.ProjectCategoryId?.ToString() ?? "")" />

                            <div style="display:grid; grid-template-columns:160px 1fr; gap:10px; align-items:center; margin-bottom:8px;">
                                <div>
                                    <label style="font-size:11px; color:#8a83a0;">رقم المبنى</label>
                                    <input type="text" name="Code" required style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                                </div>
                                @if (!string.IsNullOrEmpty(lastSubHere))
                                {
                                    <div class="stat-sub">آخر مبنى أُضيف تحت هذا المشروع: @lastSubHere</div>
                                }
                                else
                                {
                                    <div class="stat-sub">هذا أول مبنى يُضاف تحت المشروع الرئيسي (@Model.Code)</div>
                                }
                            </div>

                            <div style="display:grid; grid-template-columns:2fr 1fr; gap:8px; margin-bottom:8px;">
                                <div>
                                    <label style="font-size:11px; color:#8a83a0;">اسم المبنى</label>
                                    <input type="text" name="Name" required style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                                </div>
                                <div>
                                    <label style="font-size:11px; color:#8a83a0;">نطاق المشروع</label>
                                    <input type="text" value="مشروع فرعي" disabled style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px; padding:0 8px; background:#f6f5fa; color:#6b6680;" />
                                </div>
                            </div>

                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                                <div>
                                    <label style="font-size:11px; color:#8a83a0;">ملكية المشروع</label>
                                    <select disabled style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px; background:#f6f5fa; color:#6b6680;">
                                        <option selected>@parentTypeLabel</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="font-size:11px; color:#8a83a0;">نوع المشروع</label>
                                    <select disabled style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px; background:#f6f5fa; color:#6b6680;">
                                        <option selected>@parentCategoryLabel</option>
                                    </select>
                                </div>
                            </div>

                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                                <div>
                                    <label style="font-size:11px; color:#8a83a0;">العميل</label>
                                    <select disabled style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px; background:#f6f5fa; color:#6b6680;">
                                        <option selected>@(Model.Client?.Name ?? "-")</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="font-size:11px; color:#8a83a0;">الأولوية</label>
                                    <select name="Priority" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                                        @foreach (var pr in priorityLabels)
                                        {
                                            <option value="@pr.Value" selected="@(Model.Priority.ToString() == pr.Value)">@pr.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                                <div>
                                    <label style="font-size:11px; color:#8a83a0;">تاريخ البداية</label>
                                    <input type="date" name="PlannedStartDate" min="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" max="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                                </div>
                                <div>
                                    <label style="font-size:11px; color:#8a83a0;">تاريخ النهاية</label>
                                    <input type="date" name="PlannedEndDate" min="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" max="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                                </div>
                                @if (Model.PlannedStartDate.HasValue || Model.PlannedEndDate.HasValue)
                                {
                                    <div class="stat-sub" style="grid-column:1/-1;">يجب أن يقع تاريخا المبنى ضمن نطاق المشروع الرئيسي: @(Model.PlannedStartDate?.ToString("yyyy-MM-dd") ?? "بلا بداية محددة") → @(Model.PlannedEndDate?.ToString("yyyy-MM-dd") ?? "بلا نهاية محددة")</div>
                                }
                            </div>

                            <div>
                                <button type="submit" class="btn-line btn-line-accent">+ إضافة المبنى</button>
                            </div>
                        </form>
                    </div>

                          <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">المشاريع الفرعية</div>
                    @if (!Model.ChildProjects.Any())
                    {
                        <div class="stat-sub">لا توجد مشاريع فرعية</div>
                    }
                    else
                    {
                        <div style="display:grid; gap:6px;">
                            @foreach (var child in Model.ChildProjects)
                            {
                                var hasStages = child.Stages.Any();
                                var projKey = "proj-" + child.Id;
                                <div style="border:1px solid #ecebf2; border-radius:8px; padding:8px 10px;">
                                    <div style="display:flex; align-items:center; gap:6px;">
                                        @if (hasStages)
                                        {
                                            <span data-target="@projKey" aria-expanded="true" onclick="toggleTreeChildren(this)" style="display:inline-flex; align-items:center; justify-content:center; cursor:pointer; font-size:14px; font-weight:700; color:#5a5370; background:#efedf7; border-radius:5px; width:18px; height:18px;">▾</span>
                                        }
                                        <a asp-action="Details" asp-route-id="@child.Id" style="font-size:12px; font-weight:600; text-decoration:underline; color:inherit;">@child.Code - @child.Name</a>
                                        <span class="tag">@child.Stages.Count مرحلة</span>
                                    </div>
                                    @if (hasStages)
                                    {
                                        <div style="display:grid; gap:5px; margin-top:6px; padding-right:22px;" data-parent-key="@projKey">
                                            @foreach (var stage in child.Stages.OrderBy(s => s.Sequence))
                                            {
                                                var hasTasks = stage.Tasks.Any();
                                                var stageKey = "stage-" + stage.Id;
                                                <div>
                                                    <div style="display:flex; align-items:center; gap:6px;">
                                                        @if (hasTasks)
                                                        {
                                                            <span data-target="@stageKey" aria-expanded="true" onclick="toggleTreeChildren(this)" style="display:inline-flex; align-items:center; justify-content:center; cursor:pointer; font-size:12px; font-weight:700; color:#5a5370; background:#f1f0f6; border-radius:5px; width:16px; height:16px;">▾</span>
                                                        }
                                                        <a asp-controller="ProjectStages" asp-action="Edit" asp-route-id="@stage.Id" style="font-size:11.5px; text-decoration:underline; color:inherit;">@stage.Name</a>
                                                        <span class="tag">@stage.Tasks.Count مهمة</span>
                                                        @if (stage.Assignments.Any(a => a.IsRedesign && a.Status != AssignmentStatus.Completed && a.Status != AssignmentStatus.Cancelled))
                                                        {
                                                            <span class="tag tag-accent" style="font-size:9px;">🔁</span>
                                                        }
                                                    </div>
                                                    @if (hasTasks)
                                                    {
                                                        <div style="display:grid; gap:3px; margin-top:4px; padding-right:20px;" data-parent-key="@stageKey">
                                                            @foreach (var t in stage.Tasks)
                                                            {
                                                                <a asp-controller="ProjectTasks" asp-action="Edit" asp-route-id="@t.Id" style="font-size:11px; color:inherit; text-decoration:none; display:block;">↳ @t.Title</a>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
@section Scripts {
    <style>
    .tpl-nav-link.tpl-nav-active {
        background: #7b6bd6 !important;
        border-color: #7b6bd6 !important;
        color: #fff !important;
    }
</style>
        <script src="~/js/tab-persist.js" asp-append-version="true"></script>
    <script>
        function adjustTimelineZoom(delta) {
            var el = document.getElementById('timelineZoomInner');
            if (!el) return;
            var current = parseInt(el.getAttribute('data-zoom') || '100', 10);
            var next = delta === 0 ? 100 : Math.max(50, Math.min(250, current + delta));
            el.setAttribute('data-zoom', next);
            el.style.zoom = (next / 100);
        }

        function toggleParentDependentFields() {
            var parentSelect = document.getElementById('parentProjectSelect');
            var typeSelect = document.getElementById('typeSelect');
            var typeHidden = document.getElementById('typeHidden');
            var clientSelect = document.getElementById('clientSelect');
            var clientHidden = document.getElementById('clientHidden');
            if (!parentSelect || !typeSelect) return;

            var opt = parentSelect.options[parentSelect.selectedIndex];
            var hasParent = parentSelect.value !== '';

            if (hasParent) {
                typeSelect.disabled = true;
                typeSelect.value = opt.getAttribute('data-type') || '';
                typeHidden.disabled = false;
                typeHidden.value = opt.getAttribute('data-type') || '';
            } else {
                typeHidden.disabled = true;
            }

            if (clientSelect) {
                if (hasParent) {
                    clientSelect.disabled = true;
                    clientSelect.value = opt.getAttribute('data-client') || '';
                    clientHidden.disabled = false;
                    clientHidden.value = opt.getAttribute('data-client') || '';
                } else {
                    clientHidden.disabled = true;
                }
            }

            var categorySelect = document.getElementById('categorySelect');
            var categoryHidden = document.getElementById('categoryHidden');
            if (categorySelect) {
                if (hasParent) {
                    categorySelect.disabled = true;
                    categorySelect.value = opt.getAttribute('data-category') || '';
                    categoryHidden.disabled = false;
                    categoryHidden.value = opt.getAttribute('data-category') || '';
                } else {
                    categoryHidden.disabled = true;
                }
            }
        }
        toggleParentDependentFields();

               function enableProjectEdit() {
            document.querySelectorAll('#projectDataForm .proj-editable').forEach(function (el) {
                el.disabled = false;
            });
            toggleParentDependentFields();
            var editBtn = document.getElementById('projEditBtn');
            var saveBtn = document.getElementById('projSaveBtn');
            if (editBtn) editBtn.hidden = true;
            if (saveBtn) saveBtn.hidden = false;
            var dangerZone = document.getElementById('projDangerZone');
            if (dangerZone) dangerZone.hidden = false;
        }

           function toggleTreeChildren(el) {
            var key = el.getAttribute('data-target');
            var expanded = el.getAttribute('aria-expanded') !== 'false';
            document.querySelectorAll('[data-parent-key="' + key + '"]').forEach(function (row) {
                row.style.display = expanded ? 'none' : '';
            });
            el.setAttribute('aria-expanded', expanded ? 'false' : 'true');
            el.textContent = expanded ? '▸' : '▾';
        }

        document.addEventListener('DOMContentLoaded', function () {
            try {
                var openTplId = sessionStorage.getItem('openStageTemplateId');
                if (openTplId) {
                    var tplEl = document.getElementById('tpl-card-' + openTplId);
                    if (tplEl && window.bootstrap) {
                        new bootstrap.Collapse(tplEl, { show: true });
                    }
                }
            } catch (e) {}

            document.querySelectorAll('[id^="tpl-card-"]').forEach(function (cardEl) {
                cardEl.addEventListener('shown.bs.collapse', function () {
                    document.querySelectorAll('[id^="tpl-nav-"]').forEach(function (navEl) {
                        navEl.classList.remove('tpl-nav-active');
                    });
                    var navLink = document.getElementById('tpl-nav-' + cardEl.id.replace('tpl-card-', ''));
                    if (navLink) navLink.classList.add('tpl-nav-active');
                });
            });
        });

        function filterAssignmentsByStage() {
            var val = document.getElementById('stageFilter').value;
            document.querySelectorAll('[data-stage]').forEach(function (row) {
                row.hidden = val !== '' && row.getAttribute('data-stage') !== val;
            });
        }
              function filterUnassignedTasksByStage() {
            var val = document.getElementById('newAssignmentStage').value;
            document.querySelectorAll('#newAssignmentTasks option[data-stage]').forEach(function (opt) {
                opt.hidden = val === '' || opt.getAttribute('data-stage') !== val;
                if (opt.hidden) opt.selected = false;
            });
        }
    </script>
}
