@using AtharERP_System.Models.Entities
@model ProjectStage
@{
    var engineers = ViewBag.Engineers as List<ApplicationUser>;

    string PriorityLabel(TaskPriority p) => p switch
    {
        TaskPriority.Low => "منخفضة",
        TaskPriority.Medium => "متوسطة",
        TaskPriority.High => "عالية",
        TaskPriority.Critical => "حرجة",
        _ => p.ToString()
    };

    var columns = new[]
    {
        (Status: ProjectTaskStatus.NotStarted, Label: "لم تبدأ"),
        (Status: ProjectTaskStatus.InProgress, Label: "قيد التنفيذ"),
        (Status: ProjectTaskStatus.Completed, Label: "مكتملة"),
        (Status: ProjectTaskStatus.Blocked, Label: "محظورة")
    };
}

<div class="athar-card mt-3">
    <h5>مهام مرحلة: @Model.Name</h5>

    <div class="row athar-kanban-board">
        @foreach (var col in columns)
        {
            <div class="col-md-3 mb-3">
                <div class="athar-kanban-column" data-status="@col.Status" ondragover="event.preventDefault()" ondrop="atharKanbanDrop(event, '@col.Status')">
                    <div class="athar-kanban-header">@col.Label (@Model.Tasks.Count(t => t.Status == col.Status))</div>
                    @foreach (var task in Model.Tasks.Where(t => t.Status == col.Status))
                    {
                        <div class="athar-kanban-card" draggable="true" data-task-id="@task.Id" ondragstart="atharKanbanDragStart(event, @task.Id)">
                            <div class="d-flex justify-content-between">
                                <strong>@task.Title</strong>
                                <span class="badge athar-priority-@task.Priority">@PriorityLabel(task.Priority)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(task.Description))
                            {
                                <p class="small text-muted mb-1">@task.Description</p>
                            }
                            <div class="small">
                                المكلَّفون:
                                @(task.Assignees.Any() ? string.Join("، ", task.Assignees.Select(a => a.User.FullName)) : "-")
                            </div>
                            @if (task.DueDate.HasValue)
                            {
                                <div class="small">الاستحقاق: @task.DueDate.Value.ToString("yyyy-MM-dd")</div>
                            }
                            @if (task.DelayDays > 0)
                            {
                                <div class="small text-danger">متأخرة @task.DelayDays يوم</div>
                            }
                            @if (task.Dependencies.Any())
                            {
                                <div class="small text-muted">
                                    يعتمد على: @string.Join("، ", task.Dependencies.Select(d => d.DependsOnTask.Title))
                                </div>
                            }

                            <div class="mt-1">
                                <a asp-controller="ProjectTasks" asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm athar-btn-outline w-100">تعديل / التبعيات / المكلَّفون</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <hr />
    <h6>إضافة مهمة جديدة</h6>
    <form method="post" asp-controller="ProjectTasks" asp-action="Create" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="StageId" value="@Model.Id" />
        <div class="col-md-3">
            <label class="form-label">العنوان</label>
            <input type="text" name="Title" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-3">
            <label class="form-label">الوصف</label>
            <input type="text" name="Description" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label">تاريخ الاستحقاق</label>
            <input type="date" name="DueDate" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label">الأولوية</label>
            <select name="Priority" class="form-select form-select-sm">
                <option value="Low">منخفضة</option>
                <option value="Medium" selected>متوسطة</option>
                <option value="High">عالية</option>
                <option value="Critical">حرجة</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة</button>
        </div>
    </form>
</div>

@section Scripts {
    <form id="atharKanbanForm" method="post" asp-controller="ProjectTasks" asp-action="UpdateStatus" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="atharKanbanTaskId" />
        <input type="hidden" name="status" id="atharKanbanStatus" />
    </form>
    <script>
        function atharKanbanDragStart(ev, taskId) {
            ev.dataTransfer.setData("text/plain", taskId);
        }
        function atharKanbanDrop(ev, status) {
            ev.preventDefault();
            var taskId = ev.dataTransfer.getData("text/plain");
            if (!taskId) return;
            document.getElementById("atharKanbanTaskId").value = taskId;
            document.getElementById("atharKanbanStatus").value = status;
            document.getElementById("atharKanbanForm").submit();
        }
    </script>
}