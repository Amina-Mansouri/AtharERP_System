@using AtharERP_System.Models.Entities
@model Project
@{
    ViewData["Title"] = "تعديل المشروع";
    var parentProjects = ViewBag.ParentProjects as List<Project> ?? new List<Project>();
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
    var clients = ViewBag.Clients as List<Client> ?? new List<Client>();
    var selectedEngineerIds = ViewBag.SelectedEngineerIds as List<string> ?? new List<string>();
}

<h1 class="athar-page-title">تعديل المشروع: @Model.Code</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-8 mb-3">
                <label class="form-label">اسم المشروع</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="New" selected="@(Model.Status == ProjectStatus.New)">جديد</option>
                    <option value="InProgress" selected="@(Model.Status == ProjectStatus.InProgress)">قيد التنفيذ</option>
                    <option value="ClientReview" selected="@(Model.Status == ProjectStatus.ClientReview)">مراجعة العميل</option>
                    <option value="Completed" selected="@(Model.Status == ProjectStatus.Completed)">مكتمل</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">الوصف</label>
                <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">الموقع</label>
                <input type="text" name="Location" class="form-control" value="@Model.Location" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء</label>
                <input type="date" name="StartDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء المتوقع</label>
                <input type="date" name="EndDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">الميزانية</label>
                <input type="number" step="0.01" min="0" name="Budget" class="form-control" value="@Model.Budget" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">العميل</label>
                <select name="ClientId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var c in clients)
                    {
                        <option value="@c.Id" selected="@(Model.ClientId == c.Id)">@c.Name@(string.IsNullOrEmpty(c.CompanyName) ? "" : $" - {c.CompanyName}")</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">المشروع الرئيسي (اختياري)</label>
                <select name="ParentProjectId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var p in parentProjects)
                    {
                        <option value="@p.Id" selected="@(Model.ParentProjectId == p.Id)">@p.Code - @p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">مدير المشروع</label>
                <select name="ProjectManagerId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var eng in engineers)
                    {
                        <option value="@eng.Id" selected="@(Model.ProjectManagerId == eng.Id)">@eng.FullName</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3 form-check form-switch">
            <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="isActive" checked="@Model.IsActive" />
            <input type="hidden" name="IsActive" value="false" />
            <label class="form-check-label" for="isActive">نشط</label>
        </div>

        <div class="mb-3">
            <label class="form-label">المهندسون المكلفون بالمشروع</label>
            <div class="athar-permission-group">
                <div class="row">
                    @foreach (var eng in engineers)
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="assignedEngineerIds" value="@eng.Id"
                                       id="eng_@eng.Id" checked="@selectedEngineerIds.Contains(eng.Id)" />
                                <label class="form-check-label" for="eng_@eng.Id">@eng.FullName</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
        <a asp-action="Index" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>