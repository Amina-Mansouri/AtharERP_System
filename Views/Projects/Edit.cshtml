@using AtharERP_System.Models.Entities
@model Project
@{
    ViewData["Title"] = "تعديل المشروع";
    var parentProjects = ViewBag.ParentProjects as List<Project> ?? new List<Project>();
    var clients = ViewBag.Clients as List<Client> ?? new List<Client>();
}

<h1 class="athar-page-title">تعديل المشروع: @Model.Code</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">اسم المشروع</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">النوع</label>
                <select name="Type" class="form-select">
                    <option value="Main" selected="@(Model.Type == ProjectType.Main)">مشروع رئيسي</option>
                    <option value="Sub" selected="@(Model.Type == ProjectType.Sub)">مشروع فرعي</option>
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="New" selected="@(Model.Status == ProjectStatus.New)">جديد</option>
                    <option value="InProgress" selected="@(Model.Status == ProjectStatus.InProgress)">قيد التنفيذ</option>
                    <option value="OnHold" selected="@(Model.Status == ProjectStatus.OnHold)">متوقف مؤقتاً</option>
                    <option value="Completed" selected="@(Model.Status == ProjectStatus.Completed)">مكتمل</option>
                    <option value="Cancelled" selected="@(Model.Status == ProjectStatus.Cancelled)">ملغى</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">الوصف</label>
                <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">العميل</label>
                <select name="ClientId" class="form-select" required>
                    @foreach (var c in clients)
                    {
                        <option value="@c.Id" selected="@(Model.ClientId == c.Id)">@c.Name@(string.IsNullOrEmpty(c.CompanyName) ? "" : $" - {c.CompanyName}")</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">المشروع الرئيسي (للمشاريع الفرعية فقط)</label>
                <select name="ParentProjectId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var p in parentProjects)
                    {
                        <option value="@p.Id" selected="@(Model.ParentProjectId == p.Id)">@p.Code - @p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">الأولوية</label>
                <select name="Priority" class="form-select">
                    <option value="Low" selected="@(Model.Priority == Priority.Low)">منخفضة</option>
                    <option value="Normal" selected="@(Model.Priority == Priority.Normal)">عادية</option>
                    <option value="High" selected="@(Model.Priority == Priority.High)">عالية</option>
                    <option value="Critical" selected="@(Model.Priority == Priority.Critical)">حرجة</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء المخطط</label>
                <input type="date" name="PlannedStartDate" class="form-control" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء المخطط</label>
                <input type="date" name="PlannedEndDate" class="form-control" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء الفعلي</label>
                <input type="date" name="ActualStartDate" class="form-control" value="@(Model.ActualStartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء الفعلي</label>
                <input type="date" name="ActualEndDate" class="form-control" value="@(Model.ActualEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">الميزانية</label>
                <input type="number" step="0.01" min="0" name="Budget" class="form-control" value="@Model.Budget" />
            </div>
            <div class="col-md-3 mb-3 form-check form-switch mt-4">
                <input type="checkbox" name="IsUrgent" value="true" class="form-check-input" id="isUrgent" checked="@Model.IsUrgent" />
                <input type="hidden" name="IsUrgent" value="false" />
                <label class="form-check-label" for="isUrgent">عاجل</label>
            </div>
        </div>

        <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
        <a asp-action="Index" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>