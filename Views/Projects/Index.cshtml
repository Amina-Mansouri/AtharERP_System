@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<Project>
@inject PermissionService PermissionService
@{
    ViewData["Title"] = "المشاريع";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as ProjectStatus?;
    var scope = ViewBag.Scope as ProjectScope?;
    var canCreate = await PermissionService.HasPermissionAsync(User, "Projects.Create");
    var canViewClient = ViewBag.CanViewClient as bool? ?? false;

    var statusLabels = EnumDisplayHelper.GetDisplayList<ProjectStatus>();
    var typeLabels = EnumDisplayHelper.GetDisplayList<ProjectType>();
    var priorityLabels = EnumDisplayHelper.GetDisplayList<Priority>();
    var priority = ViewBag.Priority as Priority?;

    int totalProjects = ViewBag.TotalProjects as int? ?? 0;
    int inProgressProjects = ViewBag.InProgressProjects as int? ?? 0;
    int completedProjects = ViewBag.CompletedProjects as int? ?? 0;
    int onHoldProjects = ViewBag.OnHoldProjects as int? ?? 0;
    int soonDeliveryProjects = ViewBag.SoonDeliveryProjects as int? ?? 0;
    int delayedProjects = ViewBag.DelayedProjects as int? ?? 0;

    var today = DateTime.UtcNow.Date;
    var mainProjects = Model.Where(p => p.ParentProjectId == null).ToList();
    var mainIds = mainProjects.Select(p => p.Id).ToHashSet();
    var childrenByParent = Model
        .Where(p => p.ParentProjectId.HasValue && mainIds.Contains(p.ParentProjectId.Value))
        .GroupBy(p => p.ParentProjectId!.Value)
        .ToDictionary(g => g.Key, g => g.ToList());
    var nestedChildIds = childrenByParent.Values.SelectMany(v => v).Select(p => p.Id).ToHashSet();
    var orphanChildren = Model.Where(p => p.ParentProjectId.HasValue && !nestedChildIds.Contains(p.Id)).ToList();

    var orderedProjects = new List<(Project Project, bool IsNestedChild)>();
    foreach (var mp in mainProjects)
    {
        orderedProjects.Add((mp, false));
        if (childrenByParent.TryGetValue(mp.Id, out var kids))
        {
            foreach (var kid in kids)
            {
                orderedProjects.Add((kid, true));
            }
        }
    }
    foreach (var orphan in orphanChildren)
    {
        orderedProjects.Add((orphan, false));
    }
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px;">
    <div>
        <div style="font-size:11px; color:#8a83a0; font-weight:500;">الإدارة</div>
        <div style="font-size:19px; font-weight:600; margin-top:2px;">المشاريع</div>
    </div>
    <div class="page-head-actions">
        @if (canCreate)
        {
            <a asp-action="Create" class="btn-line btn-line-accent">+ مشروع جديد</a>
        }
    </div>
</div>

<div class="stat-strip stat-strip-text">
    <div class="stat-item"><span class="kicker">الإجمالي</span><span class="stat-value">@totalProjects</span></div>
    <div class="stat-item"><span class="kicker">قيد التنفيذ</span><span class="stat-value">@inProgressProjects</span></div>
    <div class="stat-item"><span class="kicker">المنجزة</span><span class="stat-value">@completedProjects</span></div>
    <div class="stat-item"><span class="kicker">متوقفة أو مؤجلة</span><span class="stat-value">@onHoldProjects</span></div>
    <div class="stat-item"><span class="kicker">اقترب تسليمها</span><span class="stat-value" style="color:#c9700f;">@soonDeliveryProjects</span></div>
    <div class="stat-item"><span class="kicker">متأخرة</span><span class="stat-value" style="color:#c94a42;">@delayedProjects</span></div>
</div>

<form method="get" class="filter-bar">
    <input type="text" name="search" class="filter-search" placeholder="الكود أو الاسم…" value="@search" />

    <select name="status" class="filter-chip" onchange="this.form.submit()">
        <option value="">الحالة ▾</option>
        @foreach (var s in statusLabels)
        {
            <option value="@s.Value" selected="@(status?.ToString() == s.Value)">@s.Label</option>
        }
    </select>

    <select name="scope" class="filter-chip" onchange="this.form.submit()">
        <option value="">النوع ▾</option>
        <option value="Main" selected="@(scope == ProjectScope.Main)">رئيسي</option>
        <option value="Sub" selected="@(scope == ProjectScope.Sub)">فرعي</option>
    </select>

    <select name="priority" class="filter-chip" onchange="this.form.submit()">
        <option value="">الأولوية ▾</option>
        @foreach (var p in priorityLabels)
        {
            <option value="@p.Value" selected="@(priority?.ToString() == p.Value)">@p.Label</option>
        }
    </select>

    @if (!string.IsNullOrEmpty(search) || status.HasValue || scope.HasValue || priority.HasValue)
    {
        <a asp-action="Index" class="filter-clear">مسح التصفية</a>
    }
</form>

<div class="data-table" style="--cols: 92px minmax(0,1.6fr) 122px 62px 108px 112px 88px 62px 96px">
    <div class="data-table-head">
        <div class="cell">الرمز</div>
        <div class="cell">المشروع</div>
        @if (canViewClient)
        {
            <div class="cell">العميل</div>
        }
        <div class="cell">النوع</div>
        @if (canViewClient)
        {
            <div class="cell">القيمة</div>
        }
        <div class="cell">نسبة الإنجاز</div>
        <div class="cell">التسليم</div>
        <div class="cell">تأخير</div>
        <div class="cell">الحالة</div>
    </div>
    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مشاريع مطابقة</div></div>
    }
    else
    {
        @foreach (var item in orderedProjects)
        {
            var project = item.Project;
            var isNestedChild = item.IsNestedChild;
            var delayDays = project.Status == ProjectStatus.InProgress && project.PlannedEndDate.HasValue && project.PlannedEndDate.Value.Date < today
                ? (today - project.PlannedEndDate.Value.Date).Days
                : 0;
            var nameCellStyle = isNestedChild ? "padding-right:24px;" : "";
            var showToggle = !isNestedChild && project.ChildProjects.Any();
            var parentIdAttr = isNestedChild ? project.ParentProjectId : (int?)null;
            var rowStyle = isNestedChild ? "text-decoration:none; color:inherit; background:#faf9fc;" : "text-decoration:none; color:inherit;";
            <a asp-action="Details" asp-route-id="@project.Id" class="data-table-row" data-parent-id="@parentIdAttr" style="@rowStyle">
                <div class="cell cell-num">@project.Code</div>
                <div class="cell" style="@nameCellStyle">
                    @if (isNestedChild)
                    {
                        <span style="color:#8a83a0;">↳</span>
                    }
                    @if (showToggle)
                    {
                        <span data-target="@project.Id" aria-expanded="true" onclick="event.preventDefault(); event.stopPropagation(); toggleProjectChildren(this);" style="cursor:pointer; font-size:10px; color:#8a83a0; padding:0 4px 0 0; vertical-align:middle;">▾</span>
                    }
                    @project.Name
                    @if (project.ChildProjects.Any())
                    {
                        <span class="tag tag-accent">@project.ChildProjects.Count مشاريع فرعية</span>
                    }
                    @if (project.ParentProject != null && !isNestedChild)
                    {
                        <div class="stat-sub">فرعي من: @project.ParentProject.Name</div>
                    }
                </div>
                @section Scripts {
                    <script>
                                function toggleProjectChildren(btn) {
                                    var id = btn.getAttribute('data-target');
                                    var expanded = btn.getAttribute('aria-expanded') !== 'false';
                                    document.querySelectorAll('[data-parent-id="' + id + '"]').forEach(function(row) {
                                        row.style.display = expanded ? 'none' : '';
                                    });
                                    btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
                                    btn.textContent = expanded ? '▸' : '▾';
                                }
                    </script>
                }
                @if (canViewClient)
                {
                    <div class="cell">@(project.Client?.Name ?? "-")</div>
                }
                <div class="cell">@(project.Type.HasValue ? typeLabels.FirstOrDefault(x => x.Value == project.Type.Value.ToString()).Label : "-")</div>
                @if (canViewClient)
                {
                    <div class="cell cell-num">@(project.Budget?.ToString("N0") ?? "-")</div>
                }
                <div class="cell cell-num">@project.CompletionPercentage.ToString("N0")%</div>
                <div class="cell cell-num">@(project.PlannedEndDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                <div class="cell cell-num">@(delayDays > 0 ? delayDays + " يوم" : "-")</div>
                <div class="cell"><span class="tag @(project.Status == ProjectStatus.Completed ? "tag-success" : delayDays > 0 ? "tag-danger" : "")">@statusLabels.FirstOrDefault(x => x.Value == project.Status.ToString()).Label</span></div>
            </a>
        }
    }
</div>