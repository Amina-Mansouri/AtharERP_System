@using AtharERP_System.Models.Entities
@model Project
@{
    ViewData["Title"] = "مشروع جديد";
    var parentProjects = ViewBag.ParentProjects as List<Project> ?? new List<Project>();
    var clients = ViewBag.Clients as List<Client> ?? new List<Client>();
}

<h1 class="athar-page-title">إنشاء مشروع جديد</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">اسم المشروع</label>
                <input type="text" name="Name" class="form-control" value="@Model?.Name" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">النوع</label>
                <select name="Type" class="form-select">
                    <option value="Main">مشروع رئيسي</option>
                    <option value="Sub">مشروع فرعي</option>
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="New">جديد</option>
                    <option value="InProgress">قيد التنفيذ</option>
                    <option value="OnHold">متوقف مؤقتاً</option>
                    <option value="Completed">مكتمل</option>
                    <option value="Cancelled">ملغى</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">الوصف</label>
                <textarea name="Description" class="form-control" rows="3">@Model?.Description</textarea>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">العميل</label>
                <select name="ClientId" class="form-select" required>
                    <option value="">-- اختر العميل --</option>
                    @foreach (var c in clients)
                    {
                        <option value="@c.Id">@c.Name@(string.IsNullOrEmpty(c.CompanyName) ? "" : $" - {c.CompanyName}")</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">المشروع الرئيسي (للمشاريع الفرعية فقط)</label>
                <select name="ParentProjectId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var p in parentProjects)
                    {
                        <option value="@p.Id">@p.Code - @p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">الأولوية</label>
                <select name="Priority" class="form-select">
                    <option value="Low">منخفضة</option>
                    <option value="Normal" selected>عادية</option>
                    <option value="High">عالية</option>
                    <option value="Critical">حرجة</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء المخطط</label>
                <input type="date" name="PlannedStartDate" class="form-control" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء المخطط</label>
                <input type="date" name="PlannedEndDate" class="form-control" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء الفعلي</label>
                <input type="date" name="ActualStartDate" class="form-control" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء الفعلي</label>
                <input type="date" name="ActualEndDate" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">الميزانية</label>
                <input type="number" step="0.01" min="0" name="Budget" class="form-control" value="@Model?.Budget" />
            </div>
            <div class="col-md-3 mb-3 form-check form-switch mt-4">
                <input type="checkbox" name="IsUrgent" value="true" class="form-check-input" id="isUrgent" />
                <input type="hidden" name="IsUrgent" value="false" />
                <label class="form-check-label" for="isUrgent">عاجل</label>
            </div>
        </div>

        <button type="submit" class="btn athar-btn">إنشاء المشروع</button>
        <a asp-action="Index" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>