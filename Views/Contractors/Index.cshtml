@using AtharERP_System.Models.Entities
@model List<Contractor>
@{
    ViewData["Title"] = "حسابات المقاولين";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
    <h1 class="athar-page-title">حسابات المقاولين</h1>
    <a asp-action="Create" class="btn-line btn-line-accent">+ إضافة مقاول</a>
</div>
<div class="data-table" style="--cols: 1.2fr 1.1fr 1.3fr 110px 100px 90px 100px;">
    <div class="data-table-head">
        <div class="cell">الاسم</div>
        <div class="cell">الشركة</div>
        <div class="cell">البريد الإلكتروني</div>
        <div class="cell">الهاتف</div>
        <div class="cell">المواقع</div>
        <div class="cell">الحالة</div>
        <div class="cell">إجراءات</div>
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا يوجد مقاولون مسجَّلون بعد</div></div>
    }
    else
    {
        @foreach (var c in Model)
        {
            <div class="data-table-row">
                <div class="cell">@c.Name</div>
                <div class="cell">@(c.CompanyName ?? "-")</div>
                <div class="cell">@c.Email</div>
                <div class="cell cell-num">@(c.Phone ?? "-")</div>
                <div class="cell cell-num">@c.SiteAssignments.Count</div>
                <div class="cell"><span class="tag @(c.IsActive ? "tag-success" : "tag-muted")">@(c.IsActive ? "نشط" : "معطّل")</span></div>
                <div class="cell">
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn-line">تعديل</a>
                </div>
            </div>
        }
    }
</div>

@{
    int pagerPage = ViewBag.Page as int? ?? 1;
    int pagerTotalPages = ViewBag.TotalPages as int? ?? 1;
    int pagerTotalCount = ViewBag.TotalCount as int? ?? 0;
    int pagerPageSize = ViewBag.PageSize as int? ?? 20;
}
<div class="pager">
    <span class="cell-num">@(pagerTotalCount == 0 ? 0 : (pagerPage - 1) * pagerPageSize + 1)–@Math.Min(pagerPage * pagerPageSize, pagerTotalCount)</span> من <span class="cell-num">@pagerTotalCount</span>
    <div class="pager-pages">
        @if (pagerPage > 1)
        {
            <a href="@Url.Action("Index", new { page = pagerPage - 1 })" class="pager-page">‹ السابق</a>
        }
        <span class="stat-sub">صفحة @(pagerPage) من @(pagerTotalPages)</span>
        @if (pagerPage < pagerTotalPages)
        {
            <a href="@Url.Action("Index", new { page = pagerPage + 1 })" class="pager-page">التالي ›</a>
        }
    </div>
</div>