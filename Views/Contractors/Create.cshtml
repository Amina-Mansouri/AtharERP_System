@{
    ViewData["Title"] = "مقاول جديد";
}

<h1 class="athar-page-title">إنشاء حساب مقاول جديد</h1>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:16px; margin-top:12px; max-width:600px;">
    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">الاسم</label>
            <input type="text" name="name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">الشركة</label>
            <input type="text" name="companyName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">الهاتف</label>
            <input type="text" name="phone" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">البريد الإلكتروني (يُستخدم لتسجيل الدخول)</label>
            <input type="email" name="email" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">كلمة المرور</label>
            <div class="pwd-wrap">
                <input type="password" name="password" class="form-control" minlength="6" required style="padding-left:34px;" />
                <button type="button" tabindex="-1" class="pwd-toggle" onclick="togglePwd(this)">
                    <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <svg class="eye-off" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0112 20c-7 0-11-8-11-8a21.8 21.8 0 015.06-6.06M9.9 4.24A10.94 10.94 0 0112 4c7 0 11 8 11 8a21.77 21.77 0 01-3.22 4.53M14.12 14.12a3 3 0 11-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                </button>
            </div>
        </div>

        <div style="font-size:11px; color:var(--sys-text-light); margin-bottom:14px;">
            بعد الإنشاء، يمكنك ربط هذا المقاول بموقع من صفحة "إدارة المواقع" ← الموقع المطلوب ← "المقاولون".
        </div>

        <button type="submit" class="btn-line btn-line-accent">إنشاء الحساب</button>
        <a asp-action="Index" class="btn-line">إلغاء</a>
    </form>
</div>