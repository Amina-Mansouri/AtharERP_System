@using AtharERP_System.Models.Entities
@model List<ResignationRequest>
@{
    ViewData["Title"] = "طلبات الاستقالة";
    bool canManage = (bool)ViewBag.CanManage;
    bool hasPending = (bool)ViewBag.HasPending;
    var pending = ViewBag.PendingRequests as List<ResignationRequest> ?? new List<ResignationRequest>();
    bool canFinalApprove = ViewBag.CanFinalApprove as bool? ?? false;
    var pendingFinal = ViewBag.PendingFinalRequests as List<ResignationRequest> ?? new List<ResignationRequest>();
    var approvedRequests = ViewBag.ApprovedRequests as List<ResignationRequest> ?? new List<ResignationRequest>();
    var openTasksByRequest = ViewBag.OpenTasksByRequest as Dictionary<int, List<ProjectAssignment>> ?? new Dictionary<int, List<ProjectAssignment>>();
    var allEmployees = ViewBag.AllEmployees as List<ApplicationUser> ?? new List<ApplicationUser>();
    string? filterEmployeeId = ViewBag.FilterEmployeeId as string;
    DateTime? filterFrom = ViewBag.FilterFrom as DateTime?;
    DateTime? filterTo = ViewBag.FilterTo as DateTime?;
}

<div class="page-head">
    <div>
        <span class="kicker">شؤون إدارية</span>
        <h1>طلبات الاستقالة</h1>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="athar-card" style="margin-bottom:12px; padding:12px 14px;">
    <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">تقديم طلب استقالة</div>
    @if (hasPending)
    {
        <p class="stat-sub">لديك طلب استقالة بانتظار الاعتماد بالفعل — لا يمكن تقديم طلب جديد حتى يُبتّ فيه.</p>
    }
    else
    {
        <form method="post" asp-action="Create" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;" onsubmit="return confirm('سيتم إرسال طلب استقالتك للإدارة. متابعة؟');">
            @Html.AntiForgeryToken()
            <div style="min-width:260px;">
                <label class="form-label" style="font-size:11px;">السبب (اختياري)</label>
                <input type="text" name="reason" class="form-control form-control-sm" />
            </div>
            <button type="submit" class="btn-line btn-line-accent">إرسال الطلب</button>
        </form>
        <div class="stat-sub" style="margin-top:6px;">سيُحدَّد تاريخ إيقاف العمل لاحقاً من الإدارة بعد مراجعة تكليفاتك المفتوحة.</div>
    }
</div>

<div class="athar-card" style="margin-bottom:12px;">
    <div class="nav-group-header collapsed" data-bs-toggle="collapse" data-bs-target="#myResignationsSection" style="cursor:pointer; display:flex; justify-content:space-between; align-items:center; padding:10px 14px; font-size:12.5px; font-weight:600;">
        <span>طلباتي</span>
        <span class="nav-group-caret">▾</span>
    </div>
    <div class="collapse" id="myResignationsSection">
        <div class="data-table" style="--cols: 150px 1fr 130px">
            <div class="data-table-head">
                <div class="cell">تاريخ إيقاف العمل المتوقع</div>
                <div class="cell">السبب</div>
                <div class="cell">الحالة</div>
            </div>
            @if (!Model.Any())
            {
                <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد طلبات استقالة سابقة</div></div>
            }
            else
            {
                @foreach (var r in Model)
                {
                    <div class="data-table-row">
                        <div class="cell cell-num">@(r.EffectiveLastWorkingDay?.ToString("yyyy-MM-dd") ?? "-")</div>
                        <div class="cell">@(r.Reason ?? "-")</div>
                        <div class="cell">
                            @if (r.Status == ResignationStatus.Pending)
                            {
                                <span class="tag tag-warning">بانتظار اعتماد الشؤون الإدارية</span>
                            }
                            else if (r.Status == ResignationStatus.PendingGeneralManager)
                            {
                                <span class="tag tag-warning">بانتظار اعتماد المدير العام</span>
                            }
                            else if (r.Status == ResignationStatus.Approved)
                            {
                                <span class="tag tag-success">معتمدة</span>
                            }
                            else
                            {
                                <span class="tag tag-danger">مرفوضة</span>
                            }
                            @if (!string.IsNullOrEmpty(r.PdfFilePath))
                            {
                                <a href="/Resignations/Download/@r.Id" target="_blank" style="margin-right:6px; font-size:11px;">📄</a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@if (canManage || canFinalApprove)
{
    <div style="padding:6px 2px; font-size:12.5px; font-weight:700; color:#5a5370;">طلبات المهندسات</div>

    <div class="athar-card" style="margin-bottom:12px;">
        <form method="get" asp-action="Index" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end; padding:10px 14px;">
            <div style="min-width:180px;">
                <label class="form-label" style="font-size:11px;">الموظفة</label>
                <select name="filterEmployeeId" class="form-select form-select-sm">
                    <option value="">-- الكل --</option>
                    @foreach (var u in allEmployees)
                    {
                        <option value="@u.Id" selected="@(u.Id == filterEmployeeId ? "selected" : null)">@u.FullName</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">من تاريخ</label>
                <input type="date" name="filterFrom" class="form-control form-control-sm" value="@(filterFrom?.ToString("yyyy-MM-dd"))" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">إلى تاريخ</label>
                <input type="date" name="filterTo" class="form-control form-control-sm" value="@(filterTo?.ToString("yyyy-MM-dd"))" />
            </div>
            <button type="submit" class="btn-line btn-line-accent">تصفية</button>
            <a class="btn-line" asp-action="Index">إعادة تعيين</a>
        </form>
    </div>

    @if (canManage)
    {
        <div class="athar-card" style="margin-bottom:12px;">
            <div style="padding:10px 14px; font-size:12.5px; font-weight:600; border-bottom:1px solid #f1f0f6;">طلبات بانتظار الاعتماد (@pending.Count)</div>
            @if (!pending.Any())
            {
                <div class="stat-sub" style="padding:14px;">لا توجد طلبات مطابقة</div>
            }
            @foreach (var r in pending)
            {
                var openTasks = openTasksByRequest.ContainsKey(r.Id) ? openTasksByRequest[r.Id] : new List<ProjectAssignment>();
                <div style="padding:12px 14px; border-bottom:1px solid #f1f0f6;">
                    <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:6px;">
                        <div style="font-size:12.5px;"><strong>@r.User?.FullName</strong> — @r.RequestedAt.ToString("yyyy-MM-dd")</div>
                        @if (!string.IsNullOrEmpty(r.PdfFilePath))
                        {
                            <a href="/Resignations/Download/@r.Id" target="_blank" style="font-size:11px;">📄 PDF</a>
                        }
                    </div>
                    <div style="font-size:12px; color:#5a5370; margin-bottom:8px;">السبب: @(r.Reason ?? "-")</div>

                    @if (openTasks.Any())
                    {
                        <div style="font-size:11.5px; font-weight:600; margin-bottom:6px;">التكليفات المفتوحة — حددي تاريخ إنهاء كل منها:</div>
                        @foreach (var a in openTasks)
                        {
                            <div style="display:flex; gap:8px; align-items:center; margin-bottom:4px;">
                                <input type="hidden" name="assignmentIds" value="@a.Id" form="approveForm-@r.Id" />
                                <div style="flex:1; font-size:12px;">@a.Project?.Code - @a.Project?.Name</div>
                                <input type="date" name="taskEndDates" class="form-control form-control-sm" style="max-width:160px;" required form="approveForm-@r.Id" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="stat-sub" style="margin-bottom:6px;">لا توجد تكليفات مفتوحة لهذه الموظفة — سيكون تاريخ إيقاف العمل اليوم عند الاعتماد.</div>
                    }

                    <div style="display:flex; gap:6px; margin-top:8px;">
                        <form id="approveForm-@r.Id" method="post" asp-action="Decide" onsubmit="return confirm('اعتماد الاستقالة سيُحدِّد تاريخ إيقاف العمل من التواريخ المدخلة أعلاه. متابعة؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <input type="hidden" name="approved" value="true" />
                            <button type="submit" class="btn-line btn-line-accent" style="font-size:10px;">اعتماد</button>
                        </form>
                        <form method="post" asp-action="Decide" onsubmit="return confirm('رفض هذا الطلب؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <input type="hidden" name="approved" value="false" />
                            <button type="submit" class="btn-line" style="font-size:10px; color:#c94a42; border-color:#c94a42;">رفض</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }

    @if (canFinalApprove)
    {
        <div class="athar-card" style="margin-bottom:12px;">
            <div style="padding:10px 14px; font-size:12.5px; font-weight:600; border-bottom:1px solid #f1f0f6;">طلبات بانتظار الاعتماد النهائي من المدير العام (@pendingFinal.Count)</div>
            <div class="data-table" style="--cols: 1.2fr 130px 1fr 150px">
                <div class="data-table-head">
                    <div class="cell">الموظف</div>
                    <div class="cell">تاريخ الإيقاف المتوقع</div>
                    <div class="cell">السبب</div>
                    <div class="cell">إجراء</div>
                </div>
                @if (!pendingFinal.Any())
                {
                    <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد طلبات مطابقة</div></div>
                }
                @foreach (var r in pendingFinal)
                {
                    <div class="data-table-row">
                        <div class="cell">@r.User?.FullName</div>
                        <div class="cell cell-num">@(r.EffectiveLastWorkingDay?.ToString("yyyy-MM-dd") ?? "-")</div>
                        <div class="cell">@(r.Reason ?? "-")</div>
                        <div class="cell" style="display:flex; gap:6px;">
                            <form method="post" asp-action="FinalDecide" style="display:inline;" onsubmit="return confirm('اعتماد الاستقالة نهائياً سيُعطِّل حساب الموظف تلقائياً في تاريخ الإيقاف المتوقع. متابعة؟');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="approved" value="true" />
                                <button type="submit" class="btn-line btn-line-accent" style="font-size:10px;">اعتماد نهائي</button>
                            </form>
                            <form method="post" asp-action="FinalDecide" style="display:inline;" onsubmit="return confirm('رفض هذا الطلب؟');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="approved" value="false" />
                                <button type="submit" class="btn-line" style="font-size:10px; color:#c94a42; border-color:#c94a42;">رفض</button>
                            </form>
                            @if (!string.IsNullOrEmpty(r.PdfFilePath))
                            {
                                <a href="/Resignations/Download/@r.Id" target="_blank" class="btn-line" style="font-size:10px;">PDF</a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (approvedRequests.Any())
    {
        <div class="athar-card" style="margin-bottom:12px;">
            <div style="padding:10px 14px; font-size:12.5px; font-weight:600; border-bottom:1px solid #f1f0f6;">استقالات معتمدة — تعديل تاريخ إيقاف العمل</div>
            <div class="data-table" style="--cols: 1.2fr 130px 220px">
                <div class="data-table-head">
                    <div class="cell">الموظف</div>
                    <div class="cell">تاريخ الإيقاف الحالي</div>
                    <div class="cell">تعديل التاريخ</div>
                </div>
                @foreach (var r in approvedRequests)
                {
                    <div class="data-table-row">
                        <div class="cell">@r.User?.FullName</div>
                        <div class="cell cell-num">@(r.EffectiveLastWorkingDay?.ToString("yyyy-MM-dd") ?? "-")</div>
                        <div class="cell">
                            <form method="post" asp-action="AdjustEffectiveDate" style="display:flex; gap:6px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="date" name="newDate" class="form-control form-control-sm" style="max-width:150px;" required />
                                <button type="submit" class="btn-line" style="font-size:10px;">حفظ</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}