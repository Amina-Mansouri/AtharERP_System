@using AtharERP_System.Models.Entities
@model Site
@{
    ViewData["Title"] = $"تفاصيل الموقع - {Model.Name}";
    var canManage = ViewBag.CanManage as bool? ?? false;

    var completion = ViewBag.CompletionPercentage as decimal? ?? 0;
    var hasTodayReport = ViewBag.HasTodayReport as bool? ?? false;
    var pendingNeeds = ViewBag.PendingNeedsCount as int? ?? 0;
    var activeContractor = Model.Contractors.FirstOrDefault(sc => sc.Status == ContractorStatus.Active);

    string StatusLabel(SiteStatus s) => s switch
    {
        SiteStatus.Active => "نشط",
        SiteStatus.OnHold => "متوقف",
        SiteStatus.Completed => "مكتمل",
        _ => s.ToString()
    };

    string StatusTagClass(SiteStatus s) => s switch
    {
        SiteStatus.Active => "tag-success",
        SiteStatus.OnHold => "tag-warning",
        SiteStatus.Completed => "tag-accent",
        _ => ""
    };

    string OpStatusLabel(OperationStatus s) => s switch
    {
        OperationStatus.NotStarted => "لم تبدأ",
        OperationStatus.InProgress => "قيد التنفيذ",
        OperationStatus.Completed => "مكتملة",
        OperationStatus.Delayed => "متأخرة",
        OperationStatus.OnHold => "متوقفة",
        _ => s.ToString()
    };

    string OpStatusTagClass(OperationStatus s) => s switch
    {
        OperationStatus.Completed => "tag-success",
        OperationStatus.Delayed => "tag-danger",
        OperationStatus.InProgress => "tag-accent",
        OperationStatus.OnHold => "tag-warning",
        _ => "tag-muted"
    };
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@Model.Code</div>
        <h1 class="athar-page-title" style="margin-top:2px;">@Model.Name</h1>
    </div>
    <div style="display:flex; gap:8px; align-items:center;">
        <span class="tag @StatusTagClass(Model.Status)">@StatusLabel(Model.Status)</span>
        @if (canManage)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-line btn-line-accent">تعديل الموقع</a>
            <form method="post" asp-action="ToggleHold" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-line">@(Model.Status == SiteStatus.OnHold ? "استئناف" : "إيقاف")</button>
            </form>
        }
    </div>
</div>

<div class="stat-strip stat-strip-text">
    <div class="stat-item"><span class="kicker">نسبة الإنجاز</span><span class="stat-value">@completion.ToString("N0")%</span></div>
    <div class="stat-item"><span class="kicker">تقرير اليوم</span><span class="stat-value" style="@(hasTodayReport ? "color:#2f8a57;" : "color:#c9700f;")">@(hasTodayReport ? "تم الرفع" : "لم يُرفع")</span></div>
    <div class="stat-item"><span class="kicker">احتياجات معلّقة</span><span class="stat-value" style="@(pendingNeeds > 0 ? "color:#c94a42;" : "")">@pendingNeeds</span></div>
    <div class="stat-item"><span class="kicker">المقاول المسؤول</span><span class="stat-value">@(activeContractor?.Contractor.Name ?? "غير مرتبط")</span></div>
</div>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:14px 16px; margin-bottom:12px;">
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; font-size:12px;">
        <div><strong>المشروع:</strong> <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">@Model.Project.Code - @Model.Project.Name</a></div>
        <div><strong>العنوان:</strong> @(Model.Address ?? "-")</div>
        <div><strong>الإحداثيات:</strong> @(Model.Latitude.HasValue ? $"{Model.Latitude}, {Model.Longitude}" : "-")</div>
        <div><strong>تاريخ البدء:</strong> @(Model.StartDate?.ToString("yyyy-MM-dd") ?? "-")</div>
        <div><strong>تاريخ الانتهاء المتوقع:</strong> @(Model.ExpectedEndDate?.ToString("yyyy-MM-dd") ?? "-")</div>
        <div><strong>تاريخ الانتهاء الفعلي:</strong> @(Model.ActualEndDate?.ToString("yyyy-MM-dd") ?? "-")</div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div style="grid-column:1/-1;"><strong>الوصف:</strong> @Model.Description</div>
        }
        @if (!string.IsNullOrEmpty(Model.Requirements))
        {
            <div style="grid-column:1/-1;"><strong>متطلبات الموقع:</strong> @Model.Requirements</div>
        }
    </div>
</div>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px; margin-bottom:12px;">
    <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">روابط سريعة</div>
    <div style="display:flex; flex-wrap:wrap; gap:8px;">
        <a asp-controller="SiteDailyReports" asp-action="Index" asp-route-siteId="@Model.Id" class="btn-line">التقارير اليومية</a>
        <a asp-controller="SiteChecks" asp-action="Index" asp-route-siteId="@Model.Id" class="btn-line">فحوصات الجودة والسلامة</a>
        <a asp-controller="SiteContractors" asp-action="Index" asp-route-siteId="@Model.Id" class="btn-line">المقاولون</a>
        <a asp-controller="SiteMaintenance" asp-action="Index" asp-route-siteId="@Model.Id" class="btn-line">الصيانة</a>
        <a asp-controller="SiteDocuments" asp-action="Index" asp-route-siteId="@Model.Id" class="btn-line">المستندات</a>
        <a asp-controller="SiteSupplyRequests" asp-action="Index" asp-route-siteId="@Model.Id" class="btn-line">طلبات التوريد</a>
    </div>
</div>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px;">
    <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">مراحل العمل</div>

    @if (!Model.Operations.Any())
    {
        <p style="color:var(--sys-text-light); font-size:12px;">لا توجد مراحل عمل مضافة بعد</p>
    }
    @foreach (var op in Model.Operations.OrderBy(o => o.Sequence))
    {
        <div style="border:1px solid var(--sys-border); border-radius:8px; padding:10px 12px; margin-bottom:8px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                <div style="font-size:12.5px; font-weight:600;">@op.Sequence. @op.Name <span class="tag @OpStatusTagClass(op.Status)">@OpStatusLabel(op.Status)</span></div>
                @if (canManage)
                {
                    <div style="display:flex; gap:6px;">
                        <a asp-action="EditOperation" asp-route-id="@op.Id" class="btn-line">تعديل</a>
                        <form method="post" asp-action="ToggleOperationHold" asp-route-id="@op.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-line">@(op.Status == OperationStatus.OnHold ? "استئناف" : "إيقاف")</button>
                        </form>
                        <form method="post" asp-action="DeleteOperation" asp-route-id="@op.Id" onsubmit="return confirm('حذف هذه المرحلة؟');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-line" style="color:#c94a42;">حذف</button>
                        </form>
                    </div>
                }
            </div>
            <div style="background:var(--sys-row-line-light); border-radius:6px; height:8px; margin-top:8px; overflow:hidden;">
                <div style="background:var(--sys-primary); height:100%; width:@op.CompletionPercentage.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
            </div>
            <div style="font-size:10.5px; color:var(--sys-text-light); margin-top:4px;">@op.CompletionPercentage.ToString("N1")%</div>
        </div>
    }

    @if (canManage)
    {
        <form method="post" asp-action="CreateOperation" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end; margin-top:12px; padding-top:12px; border-top:1px solid var(--sys-border);">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SiteId" value="@Model.Id" />
            <div>
                <label class="form-label" style="font-size:11px;">اسم المرحلة</label>
                <input type="text" name="Name" class="form-control form-control-sm" required />
            </div>
            <div style="width:80px;">
                <label class="form-label" style="font-size:11px;">الترتيب</label>
                <input type="number" name="Sequence" class="form-control form-control-sm" value="@(Model.Operations.Any() ? Model.Operations.Max(o => o.Sequence) + 1 : 1)" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">بدء مخطط</label>
                <input type="date" name="PlannedStartDate" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">انتهاء مخطط</label>
                <input type="date" name="PlannedEndDate" class="form-control form-control-sm" />
            </div>
           
            <button type="submit" class="btn-line btn-line-accent">+ إضافة مرحلة</button>
        </form>
    }
</div>