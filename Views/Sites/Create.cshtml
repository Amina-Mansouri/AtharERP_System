@using AtharERP_System.Models.Entities
@model Site
@{
    ViewData["Title"] = "موقع جديد";
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
}

<h1 class="athar-page-title">إنشاء موقع جديد</h1>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:16px; margin-top:12px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label" style="font-size:11px; color:var(--sys-text-light);">رمز الموقع (اختياري — يُنشأ تلقائياً إن تُرك فارغاً)</label>
                <input type="text" name="Code" class="form-control" placeholder="رمز الموقع" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">اسم الموقع</label>
                <input type="text" name="Name" class="form-control" value="@Model?.Name" required />
            </div>
            <div class="col-md-5 mb-3">
                <label class="form-label">المشروع</label>
                <select name="ProjectId" class="form-select" required>
                    <option value="">-- اختر المشروع --</option>
                    @foreach (var p in projects)
                    {
                        <option value="@p.Id">@p.Code - @p.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">مسؤول الموقع</label>
                <select name="ResponsibleId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var eng in engineers)
                    {
                        <option value="@eng.Id">@eng.FullName</option>
                    }
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">الوصف</label>
                <textarea name="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-12 mb-3">
                <label class="form-label">متطلبات الموقع</label>
                <textarea name="Requirements" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="athar-map-section mb-3">
            <label class="form-label d-block">تحديد موقع الموقع</label>
            <p class="athar-map-hint">ابحثي عن عنوان لتقريب الخريطة تلقائياً، أو انقري مباشرة لتحديد الموقع، أو اسحبي العلامة بعد وضعها لتعديله</p>

            <div class="mb-2">
                <label class="form-label">بحث عن عنوان</label>
                <input type="text" id="site-create-address-search" class="form-control" placeholder="اكتب اسم منطقة أو شارع..." autocomplete="off" />
            </div>

            <div class="mb-2">
                <label class="form-label">العنوان</label>
                <input type="text" id="siteCreateAddress" name="Address" class="form-control" readonly
                       placeholder="يُعبَّأ تلقائياً بعد البحث أو اختيار نقطة على الخريطة" />
            </div>

            <div id="site-create-map" class="athar-map"></div>

            <div class="athar-coords-display mt-2" id="site-create-coords-display">لم يتم تحديد موقع بعد</div>

            <input type="hidden" id="siteCreateLatitude" name="Latitude" />
            <input type="hidden" id="siteCreateLongitude" name="Longitude" />
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="Active">نشط</option>
                    <option value="OnHold">متوقف</option>
                    <option value="Completed">مكتمل</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">تاريخ البدء</label>
                <input type="date" name="StartDate" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">تاريخ الانتهاء المتوقع</label>
                <input type="date" name="ExpectedEndDate" class="form-control" />
            </div>
        </div>

        <button type="submit" class="btn-line btn-line-accent">إنشاء الموقع</button>
        <a asp-action="Index" class="btn-line">إلغاء</a>
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/location-picker.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initAtharLocationPicker({
                mapId: 'site-create-map',
                searchInputId: 'site-create-address-search',
                latInputId: 'siteCreateLatitude',
                lngInputId: 'siteCreateLongitude',
                nameInputId: 'siteCreateAddress',
                coordsDisplayId: 'site-create-coords-display'
            });
        });
    </script>
}