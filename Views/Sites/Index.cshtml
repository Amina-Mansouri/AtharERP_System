@using AtharERP_System.Models.Entities
@model List<Site>
@{
    ViewData["Title"] = "المواقع";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as SiteStatus?;
    var canManage = ViewBag.CanManage as bool? ?? false;
    var completionBySite = ViewBag.CompletionBySite as Dictionary<int, decimal> ?? new();
    var sitesWithTodayReport = ViewBag.SitesWithTodayReport as List<int> ?? new();
    var pendingNeedsBySite = ViewBag.PendingNeedsBySite as Dictionary<int, int> ?? new();

    var mainSites = Model.Where(s => s.Project.ParentProjectId == null).ToList();
    var mainProjectIds = mainSites.Select(s => s.ProjectId).ToHashSet();
    var childSitesByParentProject = Model
        .Where(s => s.Project.ParentProjectId.HasValue && mainProjectIds.Contains(s.Project.ParentProjectId.Value))
        .GroupBy(s => s.Project.ParentProjectId!.Value)
        .ToDictionary(g => g.Key, g => g.ToList());
    var nestedChildSiteIds = childSitesByParentProject.Values.SelectMany(v => v).Select(s => s.Id).ToHashSet();
    var orphanChildSites = Model.Where(s => s.Project.ParentProjectId.HasValue && !nestedChildSiteIds.Contains(s.Id)).ToList();

    var siteGroups = new List<List<(Site Site, bool IsNestedChild)>>();
    foreach (var ms in mainSites)
    {
        var group = new List<(Site, bool)> { (ms, false) };
        if (childSitesByParentProject.TryGetValue(ms.ProjectId, out var kids))
        {
            foreach (var kid in kids)
            {
                group.Add((kid, true));
            }
        }
        siteGroups.Add(group);
    }
    foreach (var orphan in orphanChildSites)
    {
        siteGroups.Add(new List<(Site, bool)> { (orphan, false) });
    }

    const int sitePagerPageSize = 20;
    int sitePagerPage = ViewBag.Page as int? ?? 1;
    int sitePagerTotalCount = siteGroups.Count;
    int sitePagerTotalPages = Math.Max(1, (int)Math.Ceiling(sitePagerTotalCount / (double)sitePagerPageSize));
    sitePagerPage = Math.Max(1, Math.Min(sitePagerPage, sitePagerTotalPages));

    var orderedSites = siteGroups
        .Skip((sitePagerPage - 1) * sitePagerPageSize)
        .Take(sitePagerPageSize)
        .SelectMany(g => g)
        .ToList();

    string StatusLabel(SiteStatus s) => s switch
    {
        SiteStatus.Active => "نشط",
        SiteStatus.OnHold => "متوقف",
        SiteStatus.Completed => "مكتمل",
        _ => s.ToString()
    };

    string StatusTagClass(SiteStatus s) => s switch
    {
        SiteStatus.Active => "tag-success",
        SiteStatus.OnHold => "tag-warning",
        SiteStatus.Completed => "tag-accent",
        _ => ""
    };
}

@{
    int activeSitesCount = (int)ViewBag.ActiveCount;
    int onHoldSitesCount = (int)ViewBag.OnHoldCount;
    int completedSitesCount = (int)ViewBag.CompletedCount;
    int totalSitesCount = activeSitesCount + onHoldSitesCount + completedSitesCount;
    var siteSlices = new List<(string Label, int Value, string Color)>
    {
        ("نشطة", activeSitesCount, "#7b6bd6"),
        ("متوقفة", onHoldSitesCount, "#c94a42"),
        ("مكتملة", completedSitesCount, "#2f8a57")
    };

    var siteAlertSlices = new List<(string Label, int Value, string Color)>
    {
        ("بانتظار ربط مقاول", (int)ViewBag.AwaitingResponsibleCount, "#8a83a0"),
        ("تقارير اليوم الناقصة", (int)ViewBag.MissingTodayReportCount, "#c9700f"),
        ("احتياجات معلّقة", (int)ViewBag.PendingNeedsCount, "#c94a42")
    };
}
<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">التنفيذ الميداني</div>
        <h1 class="athar-page-title" style="margin-top:2px;">إدارة المواقع</h1>
    </div>
    <div style="display:flex; align-items:center; gap:12px;">
        <div style="display:inline-flex; align-items:center; gap:10px; background:#f1eefc; border-radius:12px; padding:8px 16px;">
            <span style="font-size:12px; font-weight:600; color:#7b6bd6;">إجمالي المواقع</span>
            <span style="font-size:18px; font-weight:700; color:#3a3450; font-variant-numeric:tabular-nums;">@totalSitesCount</span>
        </div>
        @if (canManage)
        {
            <a asp-action="Create" class="btn-line btn-line-accent">+ موقع جديد</a>
        }
    </div>
</div>

<div style="display:flex; align-items:flex-start; gap:56px; flex-wrap:wrap; margin-bottom:10px;">
    <div>
        <div style="font-size:11.5px; font-weight:600; color:var(--sys-text-light); margin-bottom:6px;">حالة المواقع</div>
        @await Html.PartialAsync("_StatDonutChart", siteSlices)
    </div>
    <div>
        <div style="font-size:11.5px; font-weight:600; color:var(--sys-text-light); margin-bottom:6px;">تنبيهات المواقع</div>
        @await Html.PartialAsync("_StatDonutChart", siteAlertSlices)
    </div>
</div>
<form method="get" asp-action="Index" class="filter-bar">
    <input type="text" name="search" value="@search" class="filter-search" placeholder="ابحث بالرمز أو اسم الموقع أو المشروع..." />
    <select name="status" class="filter-chip" onchange="this.form.submit()">
        <option value="">-- كل الحالات --</option>
        <option value="Active" selected="@(status == SiteStatus.Active)">نشط</option>
        <option value="OnHold" selected="@(status == SiteStatus.OnHold)">متوقف</option>
        <option value="Completed" selected="@(status == SiteStatus.Completed)">مكتمل</option>
    </select>
    <button type="submit" class="btn-line">بحث</button>
    @if (!string.IsNullOrEmpty(search) || status.HasValue)
    {
        <a asp-action="Index" class="filter-clear">مسح التصفية</a>
    }
</form>

<div class="data-table" style="--cols: 82px 1.3fr 92px 158px 122px 92px 100px 84px 78px 74px;">
    <div class="data-table-head">
        <div class="cell">الرمز</div>
        <div class="cell">الموقع</div>
        <div class="cell">المشروع</div>
        <div class="cell">العنوان</div>
        <div class="cell">المقاول</div>
        <div class="cell">البدء</div>
        <div class="cell">نسبة الإنجاز</div>
        <div class="cell">تقرير اليوم</div>
        <div class="cell">الاحتياجات</div>
        <div class="cell">الحالة</div>
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مواقع مطابقة</div></div>
    }
    else
    {
        @foreach (var item in orderedSites)
        {
            var site = item.Site;
            var isNestedChild = item.IsNestedChild;
            var completion = completionBySite.TryGetValue(site.Id, out var c) ? c : 0;
            var hasTodayReport = sitesWithTodayReport.Contains(site.Id);
            var pendingNeeds = pendingNeedsBySite.TryGetValue(site.Id, out var n) ? n : 0;
            var activeContractor = site.Contractors.FirstOrDefault(sc => sc.Status == ContractorStatus.Active);
            var siteHasKids = !isNestedChild && childSitesByParentProject.ContainsKey(site.ProjectId);
            var siteNameCellStyle = isNestedChild ? "padding-right:24px;" : "";
            if (siteHasKids) { siteNameCellStyle += "position:relative; padding-right:26px;"; }
            var siteParentIdAttr = isNestedChild ? site.Project.ParentProjectId : (int?)null;
            var siteRowStyle = isNestedChild ? "text-decoration:none; color:inherit; background:#faf9fc; display:none;" : "text-decoration:none; color:inherit;";

            <a asp-action="Details" asp-route-id="@site.Id" class="data-table-row" data-parent-id="@siteParentIdAttr" style="@siteRowStyle">
                <div class="cell cell-num">@site.Code</div>
                <div class="cell" style="@siteNameCellStyle">
                    @if (siteHasKids)
                    {
                        <span data-target="@site.ProjectId" aria-expanded="false" onclick="event.preventDefault(); event.stopPropagation(); toggleSiteChildren(this);" style="position:absolute; top:9px; right:0; display:inline-flex; align-items:center; justify-content:center; cursor:pointer; font-size:16px; font-weight:700; color:#7b6bd6; background:#efedf7; border-radius:5px; width:18px; height:18px;">▸</span>
                    }
                    @if (isNestedChild)
                    {
                        <span style="color:#8a83a0;">↳</span>
                    }
                    @site.Name
                    @if (siteHasKids)
                    {
                        <span class="tag tag-accent">@childSitesByParentProject[site.ProjectId].Count مواقع فرعية</span>
                    }
                </div>
                <div class="cell cell-num">@site.Project.Code</div>
                <div class="cell">@(site.Address ?? "-")</div>
                <div class="cell">
                    @if (activeContractor != null)
                    {
                        @activeContractor.Contractor.Name
                    }
                    else
                    {
                        <span class="tag tag-muted">غير مرتبط</span>
                    }
                </div>
                <div class="cell cell-num">@(site.StartDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                <div class="cell cell-num">@completion.ToString("N0")%</div>
                <div class="cell">
                    @if (site.Status != SiteStatus.Active)
                    {
                        <span>-</span>
                    }
                    else if (hasTodayReport)
                    {
                        <span class="tag tag-success">✓</span>
                    }
                    else
                    {
                        <span class="tag tag-warning">لم يُرفع</span>
                    }
                </div>
                <div class="cell">
                    @if (pendingNeeds > 0)
                    {
                        <span class="tag tag-danger">@pendingNeeds</span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
                <div class="cell"><span class="tag @StatusTagClass(site.Status)">@StatusLabel(site.Status)</span></div>
            </a>
        }
    }
</div>

<div class="pager">
    <span class="cell-num">@(sitePagerTotalCount == 0 ? 0 : (sitePagerPage - 1) * sitePagerPageSize + 1)–@Math.Min(sitePagerPage * sitePagerPageSize, sitePagerTotalCount)</span> من <span class="cell-num">@sitePagerTotalCount</span>
    <div class="pager-pages">
        @if (sitePagerPage > 1)
        {
            <a href="@Url.Action("Index", new { search, status, page = sitePagerPage - 1 })" class="pager-page">‹ السابق</a>
        }
        <span class="stat-sub">صفحة @(sitePagerPage) من @(sitePagerTotalPages)</span>
        @if (sitePagerPage < sitePagerTotalPages)
        {
            <a href="@Url.Action("Index", new { search, status, page = sitePagerPage + 1 })" class="pager-page">التالي ›</a>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleSiteChildren(btn) {
            var id = btn.getAttribute('data-target');
            var expanded = btn.getAttribute('aria-expanded') !== 'false';
            document.querySelectorAll('[data-parent-id="' + id + '"]').forEach(function (row) {
                row.style.display = expanded ? 'none' : '';
            });
            btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
            btn.textContent = expanded ? '▸' : '▾';
        }
    </script>
}