@using AtharERP_System.Models.Entities
@model Site
@{
    ViewData["Title"] = "تعديل الموقع";
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
    var initialLat = Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null";
    var initialLng = Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null";
}

<h1 class="athar-page-title">تعديل الموقع: @Model.Name</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">اسم الموقع</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">المشروع</label>
                <select name="ProjectId" class="form-select" required>
                    @foreach (var p in projects)
                    {
                        <option value="@p.Id" selected="@(Model.ProjectId == p.Id)">@p.Code - @p.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">الوصف</label>
                <textarea name="Description" class="form-control" rows="2">@Model.Description</textarea>
            </div>
        </div>

        <div class="athar-map-section mb-3">
            <label class="form-label d-block">تحديد موقع الموقع</label>
            <p class="athar-map-hint">ابحثي عن عنوان لتقريب الخريطة تلقائياً، أو انقري مباشرة لتحديد الموقع، أو اسحبي العلامة بعد وضعها لتعديله</p>

            <div class="mb-2">
                <label class="form-label">بحث عن عنوان</label>
                <input type="text" id="site-edit-address-search" class="form-control" placeholder="اكتب اسم منطقة أو شارع..." autocomplete="off" />
            </div>

            <div class="mb-2">
                <label class="form-label">العنوان</label>
                <input type="text" id="siteEditAddress" name="Address" class="form-control" value="@Model.Address" readonly
                       placeholder="يُعبَّأ تلقائياً بعد البحث أو اختيار نقطة على الخريطة" />
            </div>

            <div id="site-edit-map" class="athar-map"></div>

            <div class="athar-coords-display mt-2" id="site-edit-coords-display">لم يتم تحديد موقع بعد</div>

            <input type="hidden" id="siteEditLatitude" name="Latitude" value="@Model.Latitude" />
            <input type="hidden" id="siteEditLongitude" name="Longitude" value="@Model.Longitude" />
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="Active" selected="@(Model.Status == SiteStatus.Active)">نشط</option>
                    <option value="OnHold" selected="@(Model.Status == SiteStatus.OnHold)">متوقف</option>
                    <option value="Completed" selected="@(Model.Status == SiteStatus.Completed)">مكتمل</option>
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء</label>
                <input type="date" name="StartDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء المتوقع</label>
                <input type="date" name="ExpectedEndDate" class="form-control" value="@(Model.ExpectedEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء الفعلي</label>
                <input type="date" name="ActualEndDate" class="form-control" value="@(Model.ActualEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="mb-3 form-check form-switch">
            <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="isActive" checked="@Model.IsActive" />
            <input type="hidden" name="IsActive" value="false" />
            <label class="form-check-label" for="isActive">نشط</label>
        </div>

        <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/location-picker.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initAtharLocationPicker({
                mapId: 'site-edit-map',
                searchInputId: 'site-edit-address-search',
                latInputId: 'siteEditLatitude',
                lngInputId: 'siteEditLongitude',
                nameInputId: 'siteEditAddress',
                coordsDisplayId: 'site-edit-coords-display',
                initialLat: @initialLat,
                initialLng: @initialLng
            });
        });
    </script>
}