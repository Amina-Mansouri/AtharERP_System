@using AtharERP_System.Models.Entities
@model SiteOperation
@{
    ViewData["Title"] = "تعديل مرحلة العمل";
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
}

<h1 class="athar-page-title">تعديل مرحلة العمل: @Model.Name</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="EditOperation" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">اسم المرحلة</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الترتيب</label>
                <input type="number" name="Sequence" class="form-control" value="@Model.Sequence" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="NotStarted" selected="@(Model.Status == OperationStatus.NotStarted)">لم تبدأ</option>
                    <option value="InProgress" selected="@(Model.Status == OperationStatus.InProgress)">قيد التنفيذ</option>
                    <option value="Completed" selected="@(Model.Status == OperationStatus.Completed)">مكتملة</option>
                    <option value="Delayed" selected="@(Model.Status == OperationStatus.Delayed)">متأخرة</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">الوصف</label>
            <textarea name="Description" class="form-control" rows="2">@Model.Description</textarea>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء المخطط</label>
                <input type="date" name="PlannedStartDate" class="form-control" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء المخطط</label>
                <input type="date" name="PlannedEndDate" class="form-control" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء الفعلي</label>
                <input type="date" name="ActualStartDate" class="form-control" value="@(Model.ActualStartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء الفعلي</label>
                <input type="date" name="ActualEndDate" class="form-control" value="@(Model.ActualEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">نسبة الإنجاز %</label>
                <input type="number" step="0.01" min="0" max="100" name="CompletionPercentage" class="form-control" value="@Model.CompletionPercentage" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">المسؤول</label>
                <select name="ResponsibleId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var eng in engineers)
                    {
                        <option value="@eng.Id" selected="@(Model.ResponsibleId == eng.Id)">@eng.FullName</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">ملاحظات</label>
            <textarea name="Notes" class="form-control" rows="2">@Model.Notes</textarea>
        </div>

        <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
        <a asp-action="Details" asp-route-id="@Model.SiteId" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>