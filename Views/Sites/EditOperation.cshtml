@using AtharERP_System.Models.Entities
@model SiteOperation
@{
    ViewData["Title"] = "تعديل مرحلة العمل";
  

    string OpStatusLabel(OperationStatus s) => s switch
    {
        OperationStatus.NotStarted => "لم تبدأ",
        OperationStatus.InProgress => "قيد التنفيذ",
        OperationStatus.Completed => "مكتملة",
        OperationStatus.Delayed => "متأخرة",
        OperationStatus.OnHold => "متوقفة",
        _ => s.ToString()
    };
}

<h1 class="athar-page-title">تعديل مرحلة العمل: @Model.Name</h1>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:16px; margin-top:12px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div style="font-size:11px; color:var(--sys-text-light); margin-bottom:12px;">
        الحالة الحالية: <strong>@OpStatusLabel(Model.Status)</strong> — تُحسب تلقائياً من التواريخ أدناه (تحديد تاريخ البدء الفعلي = قيد التنفيذ، تحديد تاريخ الانتهاء الفعلي = مكتملة). للإيقاف اليدوي استخدمي زر "إيقاف" في شاشة تفاصيل الموقع.
    </div>

    <form method="post" asp-action="EditOperation" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-8 mb-3">
                <label class="form-label">اسم المرحلة</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">الترتيب</label>
                <input type="number" name="Sequence" class="form-control" value="@Model.Sequence" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">الوصف</label>
            <textarea name="Description" class="form-control" rows="2">@Model.Description</textarea>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء المخطط</label>
                <input type="date" name="PlannedStartDate" class="form-control" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء المخطط</label>
                <input type="date" name="PlannedEndDate" class="form-control" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء الفعلي</label>
                <input type="date" name="ActualStartDate" class="form-control" value="@(Model.ActualStartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء الفعلي</label>
                <input type="date" name="ActualEndDate" class="form-control" value="@(Model.ActualEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" style="font-size:11px; color:var(--sys-text-light);">نسبة الإنجاز % (تلقائية)</label>
                <input type="text" class="form-control" value="@Model.CompletionPercentage.ToString("N0")%" disabled />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">ملاحظات</label>
            <textarea name="Notes" class="form-control" rows="2">@Model.Notes</textarea>
        </div>

        <button type="submit" class="btn-line btn-line-accent">حفظ التعديلات</button>
        <a asp-action="Details" asp-route-id="@Model.SiteId" class="btn-line">إلغاء</a>
    </form>
</div>