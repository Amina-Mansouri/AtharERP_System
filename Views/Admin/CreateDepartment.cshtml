@using AtharERP_System.Models.Entities
@model Department
@{
    ViewData["Title"] = "قسم جديد";
    var parentDepartments = ViewBag.ParentDepartments as List<Department> ?? new List<Department>();
}

<h1 class="athar-page-title">إنشاء قسم جديد</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="CreateDepartment">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">اسم القسم</label>
                <input type="text" name="Name" class="form-control" value="@Model?.Name" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">القسم الرئيسي (اختياري)</label>
                <select name="ParentDepartmentId" class="form-select">
                    <option value="">-- لا يوجد (قسم رئيسي) --</option>
                    @foreach (var d in parentDepartments)
                    {
                        <option value="@d.Id" selected="@(Model != null && Model.ParentDepartmentId == d.Id)">@d.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">الوصف</label>
                <textarea name="Description" class="form-control" rows="3">@Model?.Description</textarea>
            </div>
        </div>

        <button type="submit" class="btn athar-btn">حفظ</button>
        <a asp-action="Departments" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>