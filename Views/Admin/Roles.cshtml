@using AtharERP_System.Models.Entities
@model List<ApplicationRole>
@{
    ViewData["Title"] = "إدارة الأدوار";
    var permCounts = ViewBag.PermissionCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var userCounts = ViewBag.UserCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="athar-page-title">الأدوار والصلاحيات</h1>
    <a asp-action="CreateRole" class="btn athar-btn">+ دور جديد</a>
</div>

<div class="athar-card mt-3">
    <div class="table-responsive">
        <table class="table athar-table align-middle">
            <thead>
                <tr>
                    <th>اسم الدور</th>
                    <th>الوصف</th>
                    <th>عدد الصلاحيات</th>
                    <th>عدد المستخدمين</th>
                    <th>الحالة</th>
                    <th>قالب جاهز</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>@role.Name</td>
                        <td>@(role.Description ?? "-")</td>
                        <td>@(permCounts.ContainsKey(role.Id) ? permCounts[role.Id] : 0)</td>
                        <td>@(userCounts.ContainsKey(role.Id) ? userCounts[role.Id] : 0)</td>
                        <td>
                            @if (role.IsActive)
                            {
                                <span class="badge athar-badge-active">نشط</span>
                            }
                            else
                            {
                                <span class="badge athar-badge-inactive">معطل</span>
                            }
                        </td>
                        <td>@(role.IsTemplate ? "نعم" : "لا")</td>
                        <td>
                            <a asp-action="EditRole" asp-route-id="@role.Id" class="btn btn-sm athar-btn-outline">تعديل</a>
                            @if (!role.IsTemplate)
                            {
                                <form method="post" asp-action="DeleteRole" asp-route-id="@role.Id" class="d-inline"
                                      onsubmit="return confirm('هل أنت متأكد من حذف هذا الدور؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>