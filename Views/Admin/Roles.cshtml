@using AtharERP_System.Models.Entities
@model List<ApplicationRole>
@{
    ViewData["Title"] = "الأدوار والصلاحيات";
    var permCounts = ViewBag.PermissionCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var userCounts = ViewBag.UserCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var selectedRole = ViewBag.SelectedRole as ApplicationRole;
    var allPermissions = ViewBag.AllPermissions as List<Permission> ?? new List<Permission>();
    var selectedIds = ViewBag.SelectedPermissionIds as List<int> ?? new List<int>();
}

<div class="page-head">
    <div>
        <span class="kicker">الصلاحيات والمصادقة</span>
        <h1>الأدوار والصلاحيات</h1>
    </div>
    <div class="page-head-actions">
        <button type="button" class="btn-line btn-line-accent" onclick="openRoleModal()">+ دور مخصص</button>
    </div>
</div>

<div style="display:grid; grid-template-columns: 236px 1fr; gap:12px; align-items:start;">
    <div>
        <div class="side-panel-title">الأدوار · @Model.Count</div>
        <div class="role-list">
            @foreach (var role in Model)
            {
                <a class="role-card @(selectedRole?.Id == role.Id ? "selected" : "")" href="@Url.Action("Roles", new { roleId = role.Id })">
                    <div class="role-card-name">
                        @role.Name
                        <span class="tag @(role.IsTemplate ? "" : "tag-accent")">@(role.IsTemplate ? "قالب" : "مخصص")</span>
                        @if (!role.IsActive)
                        {
                            <span class="tag" style="color:#c94a42;">معطّل</span>
                        }
                    </div>
                    <div class="role-card-sub">@(permCounts.ContainsKey(role.Id) ? permCounts[role.Id] : 0) صلاحية · @(userCounts.ContainsKey(role.Id) ? userCounts[role.Id] : 0) مستخدماً</div>
                </a>
            }
        </div>
        
    </div>

    <div class="side-panel">
        @if (selectedRole == null)
        {
            <p class="mb-0">لا توجد أدوار بعد</p>
        }
        else
        {
            var totalCount = allPermissions.Count;
            var selectedCount = selectedIds.Count;
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; flex-wrap:wrap; gap:8px;">
                <div class="side-panel-title" style="margin:0;">صلاحيات «@selectedRole.Name» · مجمّعة بالوحدة</div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <span class="stat-sub"><span class="cell-num">@selectedCount</span> من <span class="cell-num">@totalCount</span></span>
                    <button type="button" class="btn-line" style="font-size:11px; padding:4px 10px;"
                            onclick='openRoleModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedRole.Id)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedRole.Name)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedRole.Description)), @selectedRole.IsActive.ToString().ToLower())'>
                        تعديل
                    </button>
                    @if (selectedRole.CanDelete)
                    {
                        <form method="post" asp-action="DeleteRole" asp-route-id="@selectedRole.Id" onsubmit="return confirm('حذف هذا الدور؟')" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-line" style="font-size:11px; padding:4px 10px; color:#c94a42;">حذف</button>
                        </form>
                    }
                </div>
            </div>

          

            <form method="post" asp-action="EditRole" asp-route-id="@selectedRole.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Name" value="@selectedRole.Name" />
                <input type="hidden" name="Description" value="@selectedRole.Description" />
                <input type="hidden" name="IsActive" value="@selectedRole.IsActive.ToString().ToLower()" />

                <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap:10px;">
                    @foreach (var group in allPermissions.GroupBy(p => p.Module).OrderBy(g => g.Key))
                    {
                        var groupSelected = group.Count(p => selectedIds.Contains(p.Id));
                        <div style="border:1px solid #ecebf2; border-radius:9px; padding:10px 12px; background:rgba(123,107,214,.02);">
                            <div style="display:flex; justify-content:space-between; align-items:center; font-size:10px; font-weight:700; text-transform:uppercase; color:#8a83a0; margin-bottom:6px;">
                                <span>@group.Key</span>
                                <span class="cell-num">@groupSelected@("/")@group.Count()</span>
                            </div>
                            @foreach (var p in group)
                            {
                                <div style="display:flex; align-items:flex-start; gap:6px; padding:3px 0;">
                                    <input type="checkbox" class="chk-gold" name="selectedPermissions" value="@p.Id" checked="@selectedIds.Contains(p.Id)" id="rp_@p.Id" style="margin-top:3px;" />
                                    <label for="rp_@p.Id" style="font-size:12px; cursor:pointer;">@p.Name <span class="stat-sub">(@p.Code)</span></label>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:10px;">
                    <a asp-action="Roles" class="btn-line">إلغاء</a>
                    <button type="submit" class="btn-line btn-line-accent">حفظ الصلاحيات</button>
                </div>
            </form>
        }
    </div>
</div>

<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="roleForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="role-modal-title">دور جديد</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="display:grid; gap:10px;">
                    <div>
                        <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">اسم الدور</div>
                        <input type="text" name="Name" id="role-name" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
                    </div>
                    <div>
                        <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الوصف</div>
                        <textarea name="Description" id="role-description" rows="3" style="width:100%; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:8px 11px; font-size:12.5px; font-family:inherit;"></textarea>
                    </div>
                    <div id="role-active-wrapper" style="display:none; align-items:center; gap:8px;">
                        <input type="checkbox" name="IsActive" id="role-isActive" value="true" />
                        <input type="hidden" name="IsActive" value="false" />
                        <label for="role-isActive" style="font-size:11.5px;">نشط</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn-line btn-line-accent">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRoleModal(id, name, description, isActive) {
            const form = document.getElementById('roleForm');
            const isEdit = id !== undefined && id !== null;
            form.action = isEdit ? '@Url.Action("EditRoleDetails")' + '?id=' + encodeURIComponent(id) : '@Url.Action("CreateRole")';
            document.getElementById('role-name').value = name ?? '';
            document.getElementById('role-description').value = description ?? '';
            document.getElementById('role-modal-title').textContent = isEdit ? 'تعديل بيانات الدور' : 'دور جديد';
            document.getElementById('role-active-wrapper').style.display = isEdit ? 'flex' : 'none';
            if (isEdit) {
                document.getElementById('role-isActive').checked = !!isActive;
            }
            new bootstrap.Modal(document.getElementById('roleModal')).show();
        }
    </script>
}
