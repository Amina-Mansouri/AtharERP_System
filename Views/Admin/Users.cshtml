@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<ApplicationUser>
@{
    ViewData["Title"] = "إدارة الموظفين";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>> ?? new Dictionary<string, IList<string>>();
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
    var roles = ViewBag.Roles as List<ApplicationRole> ?? new List<ApplicationRole>();
    var roleOptions = ViewBag.RoleOptions as List<string> ?? new List<string>();
    var rankOptions = EnumDisplayHelper.GetDisplayList<JobRank>();
    var trackOptions = EnumDisplayHelper.GetDisplayList<CareerTrack>();

    string q = ViewBag.CurrentQ as string ?? "";
    int? departmentId = ViewBag.CurrentDepartmentId as int?;
    JobRank? rank = ViewBag.CurrentRank as JobRank?;
    CareerTrack? track = ViewBag.CurrentTrack as CareerTrack?;
    string? roleFilter = ViewBag.CurrentRoleFilter as string;
    string status = ViewBag.CurrentStatus as string ?? "all";
    int page = ViewBag.Page as int? ?? 1;
    int pageSize = ViewBag.PageSize as int? ?? 20;
    int totalCount = ViewBag.TotalCount as int? ?? 0;
    int countAll = ViewBag.CountAll as int? ?? 0;
    int countActive = ViewBag.CountActive as int? ?? 0;
    int countInactive = ViewBag.CountInactive as int? ?? 0;
    int totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);

    int totalEmployees = ViewBag.TotalEmployees as int? ?? 0;
    int totalActiveEmployees = ViewBag.TotalActiveEmployees as int? ?? 0;
    int totalContractsSoon = ViewBag.TotalContractsSoon as int? ?? 0;
    int totalContractsExpired = ViewBag.TotalContractsExpired as int? ?? 0;

    string TabUrl(string s) => Url.Action("Users", new { q, departmentId, rank, track, role = roleFilter, status = s, page = 1 })!;

    string DeptLabel(ApplicationUser u) => u.Department == null ? "-" : (u.Department.ParentDepartmentId == null ? u.Department.Name : (u.Department.ParentDepartment?.Name ?? "-"));
    string SectionLabel(ApplicationUser u) => u.Department == null || u.Department.ParentDepartmentId == null ? "-" : u.Department.Name;
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px;">
    <div>
        <div style="font-size:11px; color:#8a83a0; font-weight:500;">الإدارة</div>
        <div style="font-size:19px; font-weight:600; margin-top:2px;">إدارة الموظفين</div>
    </div>
    <div style="display:flex; gap:8px;">
        <button type="button" style="height:32px; padding:0 13px; border:1px solid #e4e2ec; border-radius:8px; background:#fff; font-size:12px; color:#5a5370;">تصدير</button>
    </div>
</div>

<div style="display:grid; grid-template-columns:1.35fr 1fr; gap:12px; margin-bottom:12px;">
    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04);">
        <div style="padding:12px 16px 10px; border-bottom:1px solid #f1f0f6;">
            <div style="font-size:13.5px; font-weight:600;">نموذج إضافة موظف</div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="margin:12px 16px 0; padding:9px 12px; border:1px solid rgba(227,93,84,.35); background:rgba(227,93,84,.06); border-radius:8px; font-size:11.5px; color:#c94a42;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" asp-controller="Account" asp-action="Register" enctype="multipart/form-data" style="padding:14px 16px; display:grid; grid-template-columns:1fr 1fr; gap:13px 14px;">
            @Html.AntiForgeryToken()
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الاسم <span style="color:#e35d54;">*</span></div>
                <input name="firstName" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">اللقب <span style="color:#e35d54;">*</span></div>
                <input name="lastName" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">رقم أقرب الأقارب <span style="color:#e35d54;">*</span></div>
                <input name="nextOfKinPhone" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">البريد الإلكتروني</div>
                <input type="email" name="email" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit; direction:ltr; text-align:right;" />
            </div>
            <div style="grid-column:span 2;">
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">كلمة المرور <span style="color:#e35d54;">*</span></div>
                <input type="password" name="password" required style="width:100%; height:34px; border:1px solid #7b6bd6; border-radius:8px; background:#fff; padding:0 11px; font-size:12.5px; font-family:inherit;" />
                <div style="margin-top:6px; font-size:10.5px; color:#6455c4; background:rgba(123,107,214,.06); border:1px solid #e0dbf2; border-radius:7px; padding:7px 9px; line-height:1.6;">ثمانية خانات على الأقل، وتبقى شروط الأمان (حرف كبير وحرف صغير ورقم ورمز)</div>
            </div>
            <div style="grid-column:span 2;">
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">تأكيد كلمة المرور <span style="color:#e35d54;">*</span></div>
                <input type="password" name="confirmPassword" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الرتبة الوظيفية</div>
                <select name="rank" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px;">
                    @foreach (var jr in rankOptions)
                    {
                        <option value="@jr.Value">@jr.Label</option>
                    }
                </select>
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">المسار الوظيفي</div>
                <select name="careerTrack" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px;">
                    @foreach (var ct in trackOptions)
                    {
                        <option value="@ct.Value">@ct.Label</option>
                    }
                </select>
            </div>
            <div>
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:5px;">
                    <span style="font-size:11px; color:#5a5370;">القسم</span>
                    <a asp-action="CreateDepartment" style="font-size:10px;">+ إدارة الخيارات</a>
                </div>
                <select name="departmentId" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px;">
                    <option value="">-- اختر القسم --</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الدور</div>
                <select name="role" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px;">
                    <option value="">-- اختر --</option>
                    @foreach (var r in roleOptions)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الرقم الوظيفي</div>
                <input name="jobNumber" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">رقم الهاتف</div>
                <input name="phoneNumber" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الراتب التعاقدي</div>
                <input type="number" step="0.01" min="0" name="contractSalary" value="0" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">بداية العقد</div>
                <input type="date" name="contractStartDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#fff; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
                      <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">نهاية العقد</div>
                <input type="date" name="contractEndDate" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#fff; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الصورة الشخصية</div>
                <input type="file" name="profilePhoto" accept="image/*" style="width:100%; font-size:11.5px;" />
            </div>
            <div style="grid-column:span 2;">
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">صورة العقد</div>
                <input type="file" name="contractImage" accept="image/*,application/pdf" style="width:100%; font-size:11.5px;" />
            </div>

            <div style="grid-column:span 2;">
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">موقع الحضور المتوقع</div>
                <input type="text" id="register-address-search" placeholder="اكتب اسم منطقة أو شارع..." autocomplete="off" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit; margin-bottom:8px;" />
                <div id="register-map" style="direction:ltr; height:220px; width:100%; border-radius:8px; border:1px solid #e4e2ec;"></div>
                <input type="hidden" id="expectedLocationName" name="expectedLocationName" />
                <input type="hidden" id="expectedLatitude" name="expectedLatitude" />
                <input type="hidden" id="expectedLongitude" name="expectedLongitude" />
                               <div id="register-coords-display" style="font-size:10.5px; color:#8a83a0; margin-top:6px;">لم يتم تحديد موقع بعد</div>
                <div style="margin-top:8px; max-width:220px;">
                    <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">نصف القطر المسموح (متر)</div>
                    <input type="number" min="1" name="allowedRadiusMeters" id="allowedRadiusMeters" value="100" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#fff; padding:0 11px; font-size:12.5px; font-family:inherit;" />
                </div>
            </div>

            <div style="grid-column:span 2;">
                <button type="submit" style="height:36px; padding:0 20px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:12.5px; font-weight:600;">+ إنشاء الموظف</button>
            </div>
        </form>
    </div>

    <div style="display:grid; gap:12px; align-content:start;">
        <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04);">
            <div style="padding:12px 16px 10px; border-bottom:1px solid #f1f0f6; font-size:13.5px; font-weight:600;">موقع الحضور</div>
            <div style="padding:13px 16px; display:grid; gap:9px; font-size:11.5px;">
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">الموقع</span><span id="loc-approved" style="font-weight:500;">—</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">الإحداثيات</span><span id="loc-coords" style="font-weight:500;">—</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">النطاق المسموح</span><span id="loc-radius" style="font-weight:500;">—</span></div>
            </div>
        </div>
        <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04);">
            <div style="padding:12px 16px 10px; border-bottom:1px solid #f1f0f6; font-size:13.5px; font-weight:600;">إجماليات الموظفين</div>
            <div style="display:grid; grid-template-columns:1fr 1fr;">
                <div style="padding:12px 16px; border-left:1px solid #f1f0f6; border-bottom:1px solid #f1f0f6;">
                    <div style="font-size:10.5px; color:#8a83a0;">الإجمالي</div>
                    <div style="font-size:20px; font-weight:700;">@totalEmployees</div>
                </div>
                <div style="padding:12px 16px; border-bottom:1px solid #f1f0f6;">
                    <div style="font-size:10.5px; color:#8a83a0;">نشط</div>
                    <div style="font-size:20px; font-weight:700; color:#3fae6f;">@totalActiveEmployees</div>
                </div>
                <div style="padding:12px 16px; border-left:1px solid #f1f0f6;">
                    <div style="font-size:10.5px; color:#8a83a0;">عقود تنتهي قريباً</div>
                    <div style="font-size:20px; font-weight:700; color:#ff9130;">@totalContractsSoon</div>
                </div>
                <div style="padding:12px 16px;">
                    <div style="font-size:10.5px; color:#8a83a0;">عقود منتهية</div>
                    <div style="font-size:20px; font-weight:700; color:#e35d54;">@totalContractsExpired</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="tabs">
    <a class="tab-item @(status == "all" ? "active" : "")" href="@TabUrl("all")">الكل @countAll</a>
    <a class="tab-item @(status == "active" ? "active" : "")" href="@TabUrl("active")">نشط @countActive</a>
    <a class="tab-item @(status == "inactive" ? "active" : "")" href="@TabUrl("inactive")">غير نشط @countInactive</a>
</div>

<div style="display:flex; align-items:center; gap:6px; padding:8px 16px; border-bottom:1px solid #f1f0f6; background:#fcfbfe; margin-bottom:0;">
    <a href="#add-employee-form" class="btn-line" style="height:26px; padding:0 10px; font-size:11px;">+ إضافة</a>
    <a id="btn-view-user" class="btn-line" style="height:26px; padding:0 10px; font-size:11px; pointer-events:none; opacity:.4;">عرض</a>
    <a id="btn-edit-user" class="btn-line" style="height:26px; padding:0 10px; font-size:11px; pointer-events:none; opacity:.4;">تعديل</a>
    <form method="post" asp-action="ToggleUserStatus" id="toggle-status-form" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="toggle-status-id" value="" />
        <button type="submit" id="btn-toggle-user" class="btn-line" style="height:26px; padding:0 10px; font-size:11px; color:#c94a42; opacity:.4;" disabled>تعطيل</button>
    </form>
</div>
<form method="get" class="filter-bar">    <input type="hidden" name="status" value="@status" />
    <input type="text" name="q" class="filter-search" placeholder="الاسم أو اللقب أو الرقم الوظيفي…" value="@q" />

    <select name="departmentId" class="filter-chip" onchange="this.form.submit()">
        <option value="">القسم ▾</option>
        @foreach (var d in departments)
        {
            <option value="@d.Id" selected="@(departmentId == d.Id)">@d.Name</option>
        }
    </select>

    <select name="rank" class="filter-chip" onchange="this.form.submit()">
        <option value="">الرتبة ▾</option>
        @foreach (var r in rankOptions)
        {
            <option value="@r.Value" selected="@(rank?.ToString() == r.Value)">@r.Label</option>
        }
    </select>

    <select name="track" class="filter-chip" onchange="this.form.submit()">
        <option value="">المسار ▾</option>
        @foreach (var t in trackOptions)
        {
            <option value="@t.Value" selected="@(track?.ToString() == t.Value)">@t.Label</option>
        }
    </select>

    <select name="role" class="filter-chip" onchange="this.form.submit()">
        <option value="">الدور ▾</option>
        @foreach (var r in roles)
        {
            <option value="@r.Name" selected="@(roleFilter == r.Name)">@r.Name</option>
        }
    </select>

    @if (!string.IsNullOrEmpty(q) || departmentId.HasValue || rank.HasValue || track.HasValue || !string.IsNullOrEmpty(roleFilter))
    {
        <a href="@Url.Action("Users", new { status })" class="filter-clear">مسح التصفية</a>
    }
</form>

<div class="data-table" style="--cols: 26px minmax(0,1.3fr) 86px 108px 132px 140px 118px 74px 118px 98px 74px">
    <div class="data-table-head">
        <div class="cell"></div>
        <div class="cell">الاسم واللقب</div>
        <div class="cell">الرقم</div>
        <div class="cell">أقرب الأقارب</div>
        <div class="cell">الإدارة</div>
        <div class="cell">القسم</div>
        <div class="cell">الرتبة</div>
        <div class="cell">المسار</div>
        <div class="cell">الدور</div>
        <div class="cell">نهاية العقد</div>
        <div class="cell">الحالة</div>
    </div>
    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا يوجد موظفون مطابقون</div></div>
    }
    else
    {
        @foreach (var user in Model)
        {
            var rankLabel = rankOptions.FirstOrDefault(x => x.Value == user.Rank.ToString()).Label;
            var rankCode = user.Rank.ToString().Split('_')[0];
            var trackLabel = trackOptions.FirstOrDefault(x => x.Value == user.CareerTrack.ToString()).Label;
            <div class="data-table-row @(user.IsActive ? "" : "row-faded")">
            <div class="cell"><input type="checkbox" class="row-select" data-id="@user.Id" data-active="@user.IsActive.ToString().ToLower()" /></div>
                <div class="cell">
                    @user.FullName
                    @if (user.EmployeePositions.Count > 1)
                    {
                        <span class="tag tag-accent">وظيفتان</span>
                    }
                </div>
                <div class="cell cell-num">@(user.JobNumber ?? "-")</div>
                <div class="cell cell-num">@(user.NextOfKinPhone ?? "-")</div>
                <div class="cell">@DeptLabel(user)</div>
                <div class="cell">@SectionLabel(user)</div>
                <div class="cell">@rankCode <span class="stat-sub">@rankLabel</span></div>
                <div class="cell">@trackLabel</div>
                <div class="cell">@string.Join("، ", userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>())</div>
                <div class="cell cell-num">@(user.ContractEndDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                <div class="cell">
                    @if (user.IsSuspended)
                    {
                        <span class="tag" style="color:#c94a42;">موقوف</span>
                    }
                    else if (user.IsActive)
                    {
                        <span class="tag tag-accent">نشط</span>
                    }
                    else
                    {
                        <span class="tag">معطل</span>
                    }
                </div>
            </div>
        }
    }
</div>

<div class="pager">
    <span class="cell-num">@(totalCount == 0 ? 0 : (page - 1) * pageSize + 1)–@Math.Min(page * pageSize, totalCount) من @totalCount</span>
    <div class="pager-pages">
        @for (int p = 1; p <= totalPages; p++)
        {
            <a href="@Url.Action("Users", new { q, departmentId, rank, track, role = roleFilter, status, page = p })" class="pager-page @(p == page ? "active" : "")">@p</a>
        }
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/location-picker.js"></script>
    <script>
               document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.row-select').forEach(function (cb) {
                cb.addEventListener('change', function () {
                    document.querySelectorAll('.row-select').forEach(function (other) {
                        if (other !== cb) other.checked = false;
                    });
                    var viewBtn = document.getElementById('btn-view-user');
                    var editBtn = document.getElementById('btn-edit-user');
                    var toggleBtn = document.getElementById('btn-toggle-user');
                    var toggleId = document.getElementById('toggle-status-id');
                    if (cb.checked) {
                        var id = cb.getAttribute('data-id');
                        var isActive = cb.getAttribute('data-active') === 'true';
                        viewBtn.href = '@Url.Action("UserDetails", new { id = "__ID__" })'.replace('__ID__', id);
                        editBtn.href = '@Url.Action("EditUser", new { id = "__ID__" })'.replace('__ID__', id);
                        viewBtn.style.pointerEvents = 'auto'; viewBtn.style.opacity = '1';
                        editBtn.style.pointerEvents = 'auto'; editBtn.style.opacity = '1';
                        toggleBtn.disabled = false; toggleBtn.style.opacity = '1';
                        toggleBtn.textContent = isActive ? 'تعطيل' : 'تفعيل';
                        toggleId.value = id;
                    } else {
                        viewBtn.removeAttribute('href'); viewBtn.style.pointerEvents = 'none'; viewBtn.style.opacity = '.4';
                        editBtn.removeAttribute('href'); editBtn.style.pointerEvents = 'none'; editBtn.style.opacity = '.4';
                        toggleBtn.disabled = true; toggleBtn.style.opacity = '.4'; toggleBtn.textContent = 'تعطيل';
                        toggleId.value = '';
                    }
                });
            });

            initAtharLocationPicker({
                mapId: 'register-map',
                latInputId: 'expectedLatitude',
                lngInputId: 'expectedLongitude',
                nameInputId: 'expectedLocationName',
                coordsDisplayId: 'register-coords-display',
                searchInputId: 'register-address-search'
            });

            setInterval(function () {
                var lat = document.getElementById('expectedLatitude').value;
                var lng = document.getElementById('expectedLongitude').value;
                var radius = document.getElementById('allowedRadiusMeters').value;
                var name = document.getElementById('expectedLocationName').value;
                document.getElementById('loc-approved').textContent = name || '—';
                document.getElementById('loc-coords').textContent = (lat && lng) ? (lat + '، ' + lng) : '—';
                document.getElementById('loc-radius').textContent = radius ? (radius + ' م') : '—';
            }, 500);
        });
    </script>
}