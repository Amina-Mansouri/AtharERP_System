@using AtharERP_System.Models.Entities
@model List<ApplicationUser>
@{
    ViewData["Title"] = "إدارة المستخدمين";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>> ?? new Dictionary<string, IList<string>>();
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="athar-page-title">إدارة المستخدمين</h1>
    <a asp-controller="Account" asp-action="Register" class="btn athar-btn">+ مستخدم جديد</a>
</div>

<div class="athar-card mt-3">
    <div class="table-responsive">
        <table class="table athar-table align-middle">
            <thead>
                <tr>
                    <th>الاسم الكامل</th>
                    <th>البريد الإلكتروني</th>
                    <th>القسم</th>
                    <th>الدور</th>
                    <th>الحالة</th>
                    <th>آخر دخول</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@(user.Department ?? "-")</td>
                        <td>@string.Join("، ", userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>())</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge athar-badge-active">نشط</span>
                            }
                            else
                            {
                                <span class="badge athar-badge-inactive">معطل</span>
                            }
                        </td>
                        <td>@(user.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "لم يسجل بعد")</td>
                        <td>
                            <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm athar-btn-outline">تعديل</a>
                            <form method="post" asp-action="ToggleUserStatus" asp-route-id="@user.Id" class="d-inline"
                                  onsubmit="return confirm('هل أنت متأكد من @(user.IsActive ? "تعطيل" : "تفعيل") هذا المستخدم؟');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(user.IsActive ? "تعطيل" : "تفعيل")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>