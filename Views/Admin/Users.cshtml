@using AtharERP_System.Models.Entities
@model List<ApplicationUser>
@{
    ViewData["Title"] = "إدارة الموظفين";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>> ?? new Dictionary<string, IList<string>>();
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
    var roles = ViewBag.Roles as List<ApplicationRole> ?? new List<ApplicationRole>();
    var roleOptions = ViewBag.RoleOptions as List<string> ?? new List<string>();
     var rankOptions = ViewBag.JobRanks as List<JobRank> ?? new List<JobRank>();
    var trackOptions = ViewBag.CareerTracks as List<CareerTrack> ?? new List<CareerTrack>();

    string q = ViewBag.CurrentQ as string ?? "";
    int? departmentId = ViewBag.CurrentDepartmentId as int?;
    int? rankId = ViewBag.CurrentRank as int?;
    int? trackId = ViewBag.CurrentTrack as int?;
    string? roleFilter = ViewBag.CurrentRoleFilter as string;
    string status = ViewBag.CurrentStatus as string ?? "all";
    int page = ViewBag.Page as int? ?? 1;
    int pageSize = ViewBag.PageSize as int? ?? 20;
    int totalCount = ViewBag.TotalCount as int? ?? 0;
    int countAll = ViewBag.CountAll as int? ?? 0;
    int countActive = ViewBag.CountActive as int? ?? 0;
    int countInactive = ViewBag.CountInactive as int? ?? 0;
    int totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);

    int totalEmployees = ViewBag.TotalEmployees as int? ?? 0;
    int totalActiveEmployees = ViewBag.TotalActiveEmployees as int? ?? 0;
    int totalContractsSoon = ViewBag.TotalContractsSoon as int? ?? 0;
    int totalContractsExpired = ViewBag.TotalContractsExpired as int? ?? 0;

          string TabUrl(string s) => Url.Action("Users", new { q, departmentId, rankId, trackId, role = roleFilter, status = s, page = 1 })! + "#employee-list";

    string DeptLabel(ApplicationUser u) => u.Department == null ? "-" : (u.Department.ParentDepartmentId == null ? u.Department.Name : (u.Department.ParentDepartment?.Name ?? "-"));
    string SectionLabel(ApplicationUser u) => u.Department == null || u.Department.ParentDepartmentId == null ? "-" : u.Department.Name;
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px;">
    <div>
        <div style="font-size:11px; color:#8a83a0; font-weight:500;">الإدارة</div>
        <div style="font-size:19px; font-weight:600; margin-top:2px;">إدارة الموظفين</div>
    </div>
    <div class="page-head-actions">
        <a asp-action="CreateUser" class="btn-line btn-line-accent">+ موظف جديد</a>
    </div>
</div>

<div class="stat-strip stat-strip-text">
    <div class="stat-item"><span class="kicker">الإجمالي</span><span class="stat-value">@totalEmployees</span></div>
    <div class="stat-item"><span class="kicker">نشط</span><span class="stat-value" style="color:#3fae6f;">@totalActiveEmployees</span></div>
    <div class="stat-item"><span class="kicker">عقود تنتهي قريباً</span><span class="stat-value" style="color:#ff9130;">@totalContractsSoon</span></div>
    <div class="stat-item"><span class="kicker">عقود منتهية</span><span class="stat-value" style="color:#e35d54;">@totalContractsExpired</span></div>
</div>

<div style="display:flex; align-items:center; gap:6px; padding:8px 16px; border-bottom:1px solid #f1f0f6; background:#fcfbfe; margin-bottom:0;">
   
    <a id="btn-view-user" class="btn-line" style="height:26px; padding:0 10px; font-size:11px; pointer-events:none; opacity:.4;">عرض</a>
    <a id="btn-edit-user" class="btn-line" style="height:26px; padding:0 10px; font-size:11px; pointer-events:none; opacity:.4;">تعديل</a>
    <form method="post" asp-action="ToggleUserStatus" id="toggle-status-form" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="toggle-status-id" value="" />
        <button type="submit" id="btn-toggle-user" class="btn-line" style="height:26px; padding:0 10px; font-size:11px; color:#c94a42; opacity:.4;" disabled>تعطيل</button>
    </form>
</div>
<form method="get" class="filter-bar" action="@Url.Action("Users")#employee-list">    
    <input type="hidden" name="status" value="@status" />    <input type="text" name="q" class="filter-search" placeholder="الرقم الوظيفي" value="@q" />

    <select name="departmentId" class="filter-chip" onchange="this.form.submit()">
        <option value="">القسم ▾</option>
        @foreach (var d in departments)
        {
            <option value="@d.Id" selected="@(departmentId == d.Id)">@d.Name</option>
        }
    </select>

       <select name="rankId" class="filter-chip" onchange="this.form.submit()">
        <option value="">الرتبة ▾</option>
        @foreach (var r in rankOptions)
        {
            <option value="@r.Id" selected="@(rankId == r.Id)">@r.Code - @r.NameAr</option>
        }
    </select>

    <select name="trackId" class="filter-chip" onchange="this.form.submit()">
        <option value="">المسار ▾</option>
        @foreach (var t in trackOptions)
        {
            <option value="@t.Id" selected="@(trackId == t.Id)">@t.NameAr</option>
        }
    </select>

    <select name="role" class="filter-chip" onchange="this.form.submit()">
        <option value="">الدور ▾</option>
        @foreach (var r in roles)
        {
            <option value="@r.Name" selected="@(roleFilter == r.Name)">@r.Name</option>
        }
    </select>

    @if (!string.IsNullOrEmpty(q) || departmentId.HasValue || rankId.HasValue || trackId.HasValue || !string.IsNullOrEmpty(roleFilter))
    {
        <a href="@Url.Action("Users", new { status })" class="filter-clear">مسح التصفية</a>
    }
</form>

<div class="data-table" style="--cols: 26px minmax(0,1.3fr) 86px 108px 132px 140px 118px 74px 118px 98px 74px">
    <div class="data-table-head">
        <div class="cell"></div>
        <div class="cell">الاسم واللقب</div>
        <div class="cell">الرقم</div>
        <div class="cell">أقرب الأقارب</div>
        <div class="cell">الإدارة</div>
        <div class="cell">القسم</div>
        <div class="cell">الرتبة</div>
        <div class="cell">المسار</div>
        <div class="cell">الدور</div>
        <div class="cell">نهاية العقد</div>
        <div class="cell">الحالة</div>
    </div>
    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا يوجد موظفون مطابقون</div></div>
    }
    else
    {
        @foreach (var user in Model)
        {
                               var rankLabel = user.JobRankRef?.NameAr ?? "-";
            var rankCode = user.JobRankRef?.Code ?? "-";
            var trackLabel = user.JobRankRef?.CareerTrack?.NameAr ?? "-";
            var contractSoon = !user.IsSuspended && user.ContractEndDate.HasValue
                && user.ContractEndDate.Value.Date >= DateTime.UtcNow.Date
                && user.ContractEndDate.Value.Date <= DateTime.UtcNow.Date.AddDays(30);
            <div class="data-table-row @(user.IsActive ? "" : "row-faded") @(contractSoon ? "row-contract-soon" : "")">
            <div class="cell"><input type="checkbox" class="row-select" data-id="@user.Id" data-active="@user.IsActive.ToString().ToLower()" /></div>
                               <div class="cell">
                    @user.FullName
                </div>
                <div class="cell cell-num">@(user.JobNumber ?? "-")</div>
                <div class="cell cell-num">@(user.NextOfKinPhone ?? "-")</div>
                <div class="cell">@DeptLabel(user)</div>
                <div class="cell">@SectionLabel(user)</div>
                <div class="cell">@rankCode <span class="stat-sub">@rankLabel</span></div>
                <div class="cell">@trackLabel</div>
                <div class="cell">@string.Join("، ", userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>())</div>
                            <div class="cell cell-num">
                    @(user.ContractEndDate?.ToString("yyyy-MM-dd") ?? "-")
                    @if (contractSoon)
                    {
                        <span class="tag tag-warning">قريب الانتهاء</span>
                    }
                </div>
                <div class="cell">
                    @if (user.IsSuspended)
                    {
                        <span class="tag" style="color:#c94a42;">موقوف</span>
                    }
                    else if (user.IsActive)
                    {
                        <span class="tag tag-accent">نشط</span>
                    }
                    else
                    {
                        <span class="tag">معطل</span>
                    }
                </div>
            </div>
        }
    }
</div>

<div class="pager">
      <span class="cell-num">@(totalCount == 0 ? 0 : (page - 1) * pageSize + 1)–@Math.Min(page * pageSize, totalCount)</span> من <span class="cell-num">@totalCount</span>
    <div class="pager-pages">
        @for (int p = 1; p <= totalPages; p++)
        {
            <a href="@Url.Action("Users", new { q, departmentId, rankId, trackId, role = roleFilter, status, page = p })#employee-list" class="pager-page @(p == page ? "active" : "")">@p</a>
        }
    </div>
</div>

@section Scripts {
    <script>
            document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.row-select').forEach(function (cb) {
                cb.addEventListener('change', function () {
                    document.querySelectorAll('.row-select').forEach(function (other) {
                        if (other !== cb) other.checked = false;
                        });
                    var viewBtn = document.getElementById('btn-view-user');
                    var editBtn = document.getElementById('btn-edit-user');
                    var toggleBtn = document.getElementById('btn-toggle-user');
                    var toggleId = document.getElementById('toggle-status-id');
                    if (cb.checked) {
                        var id = cb.getAttribute('data-id');
                        var isActive = cb.getAttribute('data-active') === 'true';
                        viewBtn.href = '@Url.Action("UserDetails", new { id = "__ID__" })'.replace('__ID__', id);
                        editBtn.href = '@Url.Action("EditUser", new { id = "__ID__" })'.replace('__ID__', id);
                        viewBtn.style.pointerEvents = 'auto'; viewBtn.style.opacity = '1';
                        editBtn.style.pointerEvents = 'auto'; editBtn.style.opacity = '1';
                        toggleBtn.disabled = false; toggleBtn.style.opacity = '1';
                        toggleBtn.textContent = isActive ? 'تعطيل' : 'تفعيل';
                toggleId.value = id;
           } else {
                viewBtn.removeAttribute('href'); viewBtn.style.pointerEvents = 'none'; viewBtn.style.opacity = '.4';
                editBtn.removeAttribute('href'); editBtn.style.pointerEvents = 'none'; editBtn.style.opacity = '.4';
                toggleBtn.disabled = true; toggleBtn.style.opacity = '.4'; toggleBtn.textContent = 'تعطيل';
                toggleId.value = '';
            }
                });
            });
        });
    </script>
}