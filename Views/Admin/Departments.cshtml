@using AtharERP_System.Models.Entities
@model List<Department>
@{
    ViewData["Title"] = "الأقسام";
    var roots = Model.Where(d => d.ParentDepartmentId == null).OrderBy(d => d.Name).ToList();
}

<div class="page-head">
    <div>
        <span class="kicker">الصلاحيات والمصادقة</span>
        <h1>الأقسام</h1>
    </div>
    <div class="page-head-actions">
        <button type="button" class="btn-line" onclick="document.querySelectorAll('.dept-children').forEach(function(c){ new bootstrap.Collapse(c, {toggle:false}).show(); })">توسيع الكل</button>
        <a asp-action="CreateDepartment" class="btn-line btn-line-accent">+ قسم</a>
    </div>
</div>

<div class="side-panel" style="max-width:600px;">
    <div class="side-panel-title">الإدارة العليا</div>
    <div class="dept-tree">
        @{
            async Task RenderNode(Department d)
            {
                var children = Model.Where(x => x.ParentDepartmentId == d.Id).OrderBy(x => x.Name).ToList();
                var activeUsers = d.Users.Count(u => u.IsActive);
                var nodeId = "dept-children-" + d.Id;
                <div class="dept-node">
                    <span>
                        @if (children.Any())
                        {
                            <button type="button" class="dept-toggle" data-bs-toggle="collapse" data-bs-target="#@nodeId">▾</button>
                        }
                        <a asp-action="EditDepartment" asp-route-id="@d.Id" style="color:inherit; text-decoration:none; font-weight:@(d.ParentDepartmentId == null ? "600" : "400")">@d.Name</a>
                    </span>
                    <span class="cell-num stat-sub">@activeUsers</span>
                </div>
                if (children.Any())
                {
                    <div class="collapse show dept-children" id="@nodeId">
                        @foreach (var c in children)
                        {
                            await RenderNode(c);
                        }
                    </div>
                }
            }
        }
        @foreach (var root in roots)
        {
            await RenderNode(root);
        }
    </div>
</div>