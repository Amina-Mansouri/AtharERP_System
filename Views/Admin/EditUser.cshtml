@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model ApplicationUser
@{
    ViewData["Title"] = "تعديل الموظف";
       var roles = ViewBag.RoleOptions as List<string> ?? new List<string>();
    var currentRole = ViewBag.CurrentRole as string;
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
    var jobRanks = EnumDisplayHelper.GetDisplayList<JobRank>();
    var careerTracks = EnumDisplayHelper.GetDisplayList<CareerTrack>();
    var initialLat = Model.ExpectedLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null";
    var initialLng = Model.ExpectedLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null";
    var currentDept = departments.FirstOrDefault(d => d.Id == Model.DepartmentId);
    int? currentTopId = currentDept == null ? (int?)null : (currentDept.ParentDepartmentId ?? currentDept.Id);
    var rankLabel = jobRanks.FirstOrDefault(x => x.Value == Model.Rank.ToString()).Label;
    var trackLabel = careerTracks.FirstOrDefault(x => x.Value == Model.CareerTrack.ToString()).Label;
    string DeptLabel() => Model.Department == null ? "-" : (Model.Department.ParentDepartmentId == null ? Model.Department.Name : (Model.Department.ParentDepartment?.Name ?? "-"));
    string SectionLabel() => Model.Department == null || Model.Department.ParentDepartmentId == null ? "-" : Model.Department.Name;
    int projectCount = ViewBag.ProjectCount as int? ?? 0;
    int activeAssignmentCount = ViewBag.ActiveAssignmentCount as int? ?? 0;
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px;">
    <div>
        <div style="font-size:11px; color:#8a83a0; font-weight:500;">الإدارة</div>
        <div style="font-size:19px; font-weight:600; margin-top:2px;">تعديل بيانات: @Model.FullName</div>
    </div>
    <div style="display:flex; gap:8px;">
        <a asp-controller="EmployeeDocuments" asp-action="Index" asp-route-userId="@Model.Id" class="btn-line">مستندات الموظف</a>
        <a asp-action="Users" class="btn-line">إلغاء</a>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 2fr; gap:12px; margin-bottom:12px;">
    <div style="display:grid; gap:12px; align-content:start;">
        <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:16px; text-align:center;">
            @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
            {
                <img src="@Model.ProfilePhotoPath" alt="" style="width:64px; height:64px; border-radius:50%; object-fit:cover; margin:0 auto 10px;" />
            }
            else
            {
                <div style="width:64px; height:64px; border-radius:50%; background:rgba(123,107,214,.1); color:#6455c4; font-size:20px; font-weight:600; display:flex; align-items:center; justify-content:center; margin:0 auto 10px;">
                    @(Model.FirstName.Length > 0 ? Model.FirstName.Substring(0, 1) : "")@(Model.LastName.Length > 0 ? Model.LastName.Substring(0, 1) : "")
                </div>
            }
            <div style="font-size:14.5px; font-weight:600;">@Model.FullName</div>
            <div style="margin-top:4px;">
                @if (Model.IsSuspended)
                {
                    <span class="tag" style="color:#c94a42;">موقوف@(string.IsNullOrEmpty(Model.SuspendedReason) ? "" : $" — {Model.SuspendedReason}")</span>
                }
                else if (Model.IsActive)
                {
                    <span class="tag tag-accent">نشط</span>
                }
                else
                {
                    <span class="tag">معطل</span>
                }
            </div>
        </div>

        <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04);">
            <div style="padding:12px 16px 10px; border-bottom:1px solid #f1f0f6; font-size:13.5px; font-weight:600;">ملخّص الموظف</div>
            <div style="padding:13px 16px; display:grid; gap:9px; font-size:11.5px;">
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">الرتبة</span><span style="font-weight:500;">@rankLabel</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">المسار</span><span style="font-weight:500;">@trackLabel</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">الإدارة</span><span style="font-weight:500;">@DeptLabel()</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">القسم</span><span style="font-weight:500;">@SectionLabel()</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">الدور</span><span style="font-weight:500;">@currentRole</span></div>
                <div style="display:flex; justify-content:space-between; padding-top:9px; border-top:1px solid #f1f0f6;"><span style="color:#8a83a0;">تاريخ الانضمام</span><span class="n" style="font-weight:500;">@Model.CreatedAt.ToString("yyyy-MM-dd")</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">بداية العقد</span><span class="n" style="font-weight:500;">@(Model.ContractStartDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">نهاية العقد</span><span class="n" style="font-weight:500;">@(Model.ContractEndDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
                <div style="display:flex; justify-content:space-between; padding-top:9px; border-top:1px solid #f1f0f6;"><span style="color:#8a83a0;">مشاريعه الحالية</span><span class="n" style="font-weight:600;">@projectCount</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">تكليفاته النشطة</span><span class="n" style="font-weight:600;">@activeAssignmentCount</span></div>
                <div style="display:flex; justify-content:space-between; padding-top:9px; border-top:1px solid #f1f0f6;"><span style="color:#8a83a0;">البريد</span><span style="font-weight:500; direction:ltr;">@Model.Email</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">الهاتف</span><span class="n" style="font-weight:500;">@(Model.PhoneNumber ?? "-")</span></div>
                <div style="display:flex; justify-content:space-between;"><span style="color:#8a83a0;">أقرب الأقارب</span><span class="n" style="font-weight:500;">@(Model.NextOfKinPhone ?? "-")</span></div>
            </div>
        </div>
    </div>

    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04);">
        @if (!ViewData.ModelState.IsValid)
        {
            <div style="margin:12px 16px 0; padding:9px 12px; border:1px solid rgba(227,93,84,.35); background:rgba(227,93,84,.06); border-radius:8px; font-size:11.5px; color:#c94a42;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" asp-action="EditUser" asp-route-id="@Model.Id" enctype="multipart/form-data" style="padding:14px 16px; display:grid; grid-template-columns:1fr 1fr; gap:13px 14px;">
            @Html.AntiForgeryToken()

            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الاسم <span style="color:#e35d54;">*</span></div>
                <input type="text" name="FirstName" required value="@Model.FirstName" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">اللقب <span style="color:#e35d54;">*</span></div>
                <input type="text" name="LastName" required value="@Model.LastName" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">رقم أقرب الأقارب</div>
                <input type="text" name="NextOfKinPhone" value="@Model.NextOfKinPhone" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">البريد الإلكتروني</div>
                <input type="email" value="@Model.Email" disabled style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#f1f0f6; padding:0 11px; font-size:12.5px; font-family:inherit; direction:ltr; text-align:right;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الرقم الوظيفي</div>
                <input type="text" name="JobNumber" value="@Model.JobNumber" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">رقم الهاتف</div>
                <input type="tel" name="PhoneNumber" value="@Model.PhoneNumber" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الرتبة الوظيفية</div>
                <select name="Rank" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px;">
                    @foreach (var jr in jobRanks)
                    {
                        <option value="@jr.Value" selected="@(Model.Rank.ToString() == jr.Value)">@jr.Label</option>
                    }
                </select>
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">المسار الوظيفي</div>
                <select name="CareerTrack" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px;">
                    @foreach (var ct in careerTracks)
                    {
                        <option value="@ct.Value" selected="@(Model.CareerTrack.ToString() == ct.Value)">@ct.Label</option>
                    }
                </select>
            </div>
            <div>
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:5px;">
                    <span style="font-size:11px; color:#5a5370;">الإدارة</span>
                    <a asp-action="CreateDepartment" style="font-size:10px;">+ إدارة الخيارات</a>
                </div>
                <select id="edit-dept-parent" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px;">
                    <option value="">-- اختر الإدارة --</option>
                    @foreach (var top in departments.Where(x => x.ParentDepartmentId == null))
                    {
                        <option value="@top.Id" selected="@(top.Id == currentTopId)">@top.Name</option>
                    }
                </select>
            </div>
            <div>
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:5px;">
                    <span style="font-size:11px; color:#5a5370;">القسم</span>
                    <a asp-action="Departments" style="font-size:10px;">+ إدارة الخيارات</a>
                </div>
                <select name="DepartmentId" id="edit-dept-child" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px;">
                    @foreach (var top in departments.Where(x => x.ParentDepartmentId == null))
                    {
                        <option value="@top.Id" data-group="@top.Id" selected="@(top.Id == Model.DepartmentId)" style="display:@(top.Id == currentTopId ? "block" : "none")">(الإدارة مباشرة) @top.Name</option>
                        @foreach (var child in departments.Where(x => x.ParentDepartmentId == top.Id))
                        {
                            <option value="@child.Id" data-group="@top.Id" selected="@(child.Id == Model.DepartmentId)" style="display:@(top.Id == currentTopId ? "block" : "none")">@child.Name</option>
                        }
                    }
                </select>
            </div>
            <div>
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:5px;">
                    <span style="font-size:11px; color:#5a5370;">الدور</span>
                    <a asp-action="Roles" style="font-size:10px;">+ إدارة الخيارات</a>
                </div>
                <select name="role" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px;">
                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(r == currentRole)">@r</option>
                    }
                </select>
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الراتب التعاقدي</div>
                <input type="number" step="0.01" min="0" name="ContractSalary" value="@Model.ContractSalary" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">بداية العقد</div>
                <input type="date" name="ContractStartDate" value="@(Model.ContractStartDate?.ToString("yyyy-MM-dd"))" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#fff; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">نهاية العقد</div>
                <input type="date" name="ContractEndDate" value="@(Model.ContractEndDate?.ToString("yyyy-MM-dd"))" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#fff; padding:0 11px; font-size:12.5px; font-family:inherit;" />
            </div>
            <div>
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">الصورة الشخصية</div>
                @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
                {
                    <img src="@Model.ProfilePhotoPath" alt="" style="max-width:60px; max-height:60px; border-radius:6px; display:block; margin-bottom:5px;" />
                }
                <input type="file" name="profilePhoto" accept="image/*" style="width:100%; font-size:11.5px;" />
            </div>
            <div style="grid-column:span 2;">
                                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">صورة العقد</div>
                @if (!string.IsNullOrEmpty(Model.ContractImagePath))
                {
                    <div style="font-size:10.5px; margin-bottom:5px;">
                        <a href="@Model.ContractImagePath" target="_blank">عرض العقد الحالي</a>
                        <span style="color:#8a83a0;"> — اختاري ملفاً أدناه لاستبدالها</span>
                    </div>
                }
                <input type="file" name="contractImage" accept="image/*,application/pdf" style="width:100%; font-size:11.5px;" />       </div>

            <div style="grid-column:span 2;">
                <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">موقع الحضور المتوقع</div>
                <input type="text" id="edituser-address-search" placeholder="اكتب اسم منطقة أو شارع..." autocomplete="off" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit; margin-bottom:8px;" />
                <div id="edituser-map" style="direction:ltr; height:220px; width:100%; border-radius:8px; border:1px solid #e4e2ec;"></div>
                <div id="edituser-coords-display" style="font-size:10.5px; color:#8a83a0; margin-top:6px;">
                    @(Model.ExpectedLatitude.HasValue && Model.ExpectedLongitude.HasValue
                        ? $"الإحداثيات المختارة: {Model.ExpectedLatitude.Value:F6}, {Model.ExpectedLongitude.Value:F6}"
                        : "لم يتم تحديد موقع بعد")
                </div>
                <input type="hidden" id="ExpectedLocationName" name="ExpectedLocationName" value="@Model.ExpectedLocationName" />
                <input type="hidden" id="ExpectedLatitude" name="ExpectedLatitude" value="@(Model.ExpectedLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                <input type="hidden" id="ExpectedLongitude" name="ExpectedLongitude" value="@(Model.ExpectedLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                <div style="margin-top:8px; max-width:220px;">
                    <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">نصف القطر المسموح (متر)</div>
                    <input type="number" min="1" name="AllowedRadiusMeters" id="AllowedRadiusMeters" value="@Model.AllowedRadiusMeters" style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#fff; padding:0 11px; font-size:12.5px; font-family:inherit;" />
                </div>
            </div>

            <div style="grid-column:span 2;">
                <button type="submit" style="height:36px; padding:0 20px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:12.5px; font-weight:600;">حفظ التعديلات</button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/location-picker.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deptParentSelect = document.getElementById('edit-dept-parent');
            var deptChildSelect = document.getElementById('edit-dept-child');
            deptParentSelect.addEventListener('change', function () {
                var groupId = this.value;
                Array.from(deptChildSelect.options).forEach(function (opt) {
                    opt.style.display = (opt.getAttribute('data-group') === groupId) ? '' : 'none';
                });
                deptChildSelect.value = groupId || '';
            });

            initAtharLocationPicker({
                mapId: 'edituser-map',
                searchInputId: 'edituser-address-search',
                latInputId: 'ExpectedLatitude',
                lngInputId: 'ExpectedLongitude',
                nameInputId: 'ExpectedLocationName',
                coordsDisplayId: 'edituser-coords-display',
                radiusInputId: 'AllowedRadiusMeters',
                initialLat: @initialLat,
                initialLng: @initialLng
            });
        });
    </script>
}