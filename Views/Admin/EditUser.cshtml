@using AtharERP_System.Models.Entities
@model ApplicationUser
@{
    ViewData["Title"] = "تعديل المستخدم";
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
    var currentRole = ViewBag.CurrentRole as string;
    var initialLat = Model.ExpectedLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null";
    var initialLng = Model.ExpectedLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null";
}

<h1 class="athar-page-title">تعديل بيانات المستخدم</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="EditUser" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">الاسم الكامل</label>
                <input type="text" name="FullName" class="form-control" value="@Model.FullName" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">البريد الإلكتروني</label>
                <input type="email" class="form-control" value="@Model.Email" disabled />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">المسمى الوظيفي</label>
                <input type="text" name="JobTitle" class="form-control" value="@Model.JobTitle" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">القسم</label>
                <input type="text" name="Department" class="form-control" value="@Model.Department" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">درجة المهندس</label>
                <select name="EngineerRank" class="form-select">
                    <option value="None" selected="@(Model.EngineerRank == EngineerRank.None)">غير محدد</option>
                    <option value="Junior" selected="@(Model.EngineerRank == EngineerRank.Junior)">مبتدئ</option>
                    <option value="MidLevel" selected="@(Model.EngineerRank == EngineerRank.MidLevel)">متوسط</option>
                    <option value="Senior" selected="@(Model.EngineerRank == EngineerRank.Senior)">خبير</option>
                    <option value="Lead" selected="@(Model.EngineerRank == EngineerRank.Lead)">رئيسي</option>
                    <option value="Principal" selected="@(Model.EngineerRank == EngineerRank.Principal)">استشاري</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">رقم الهاتف</label>
                <input type="tel" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">الدور</label>
                <select name="role" class="form-select" required>
                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(r == currentRole)">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">نصف القطر المسموح (متر)</label>
                <input type="number" step="any" name="AllowedRadiusMeters" class="form-control" value="@Model.AllowedRadiusMeters" />
            </div>
        </div>

        <div class="athar-map-section mb-3">
            <label class="form-label d-block">تحديد موقع الحضور المتوقع (اختياري)</label>
            <p class="athar-map-hint">انقر على الخريطة لتحديد الموقع، أو اسحب العلامة بعد وضعها لتعديل الموقع</p>

            <div class="mb-2">
                <label class="form-label">اسم الموقع</label>
                <input type="text" id="ExpectedLocationName" name="ExpectedLocationName" class="form-control"
                       value="@Model.ExpectedLocationName"
                       placeholder="يُعبَّأ تلقائياً بعد اختيار نقطة على الخريطة، ويمكنك تعديله يدوياً" />
            </div>

            <div id="edituser-map" class="athar-map"></div>

            <div class="athar-coords-display mt-2" id="edituser-coords-display">
                @if (Model.ExpectedLatitude.HasValue && Model.ExpectedLongitude.HasValue)
                {
                    @:الإحداثيات المختارة: @Model.ExpectedLatitude.Value.ToString("F6"), @Model.ExpectedLongitude.Value.ToString("F6")
                }
                else
                {
                    @:لم يتم تحديد موقع بعد
                }
            </div>

            <input type="hidden" id="ExpectedLatitude" name="ExpectedLatitude" value="@(Model.ExpectedLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
            <input type="hidden" id="ExpectedLongitude" name="ExpectedLongitude" value="@(Model.ExpectedLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
        </div>

        <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
        <a asp-action="Users" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/location-picker.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initAtharLocationPicker({
                mapId: 'edituser-map',
                latInputId: 'ExpectedLatitude',
                lngInputId: 'ExpectedLongitude',
                nameInputId: 'ExpectedLocationName',
                coordsDisplayId: 'edituser-coords-display',
                initialLat: @initialLat,
                initialLng: @initialLng
            });
        });
    </script>
}