@using AtharERP_System.Models.Entities
@model ApplicationUser
@{
    ViewData["Title"] = "تعديل المستخدم";
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
    var currentRole = ViewBag.CurrentRole as string;
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
    var jobRanks = ViewBag.JobRanks as List<(string Value, string Label)> ?? new List<(string Value, string Label)>();
    var careerTracks = ViewBag.CareerTracks as List<(string Value, string Label)> ?? new List<(string Value, string Label)>();
    var positions = ViewBag.Positions as List<EmployeePosition> ?? new List<EmployeePosition>();
    var allPermissions = ViewBag.AllPermissions as List<Permission> ?? new List<Permission>();
    var overridePermissions = ViewBag.UserOverridePermissions as List<UserPermission> ?? new List<UserPermission>();
    var overridePermissionIds = overridePermissions.Select(up => up.PermissionId).ToHashSet();
    var initialLat = Model.ExpectedLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null";
    var initialLng = Model.ExpectedLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null";
}

<h1 class="athar-page-title">تعديل بيانات المستخدم: @Model.FullName</h1>
<a asp-controller="EmployeeDocuments" asp-action="Index" asp-route-userId="@Model.Id" class="btn athar-btn-outline mb-3">مستندات الموظف</a>
<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

      <form method="post" asp-action="EditUser" asp-route-id="@Model.Id" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <h5>البيانات الأساسية</h5>
        <div class="row">
                       <div class="col-md-3 mb-3">
                <label class="form-label">الاسم</label>
                <input type="text" name="FirstName" class="form-control" value="@Model.FirstName" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">اللقب</label>
                <input type="text" name="LastName" class="form-control" value="@Model.LastName" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">البريد الإلكتروني</label>
                <input type="email" class="form-control" value="@Model.Email" disabled />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">رقم الهاتف</label>
                <input type="tel" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">الرقم الوظيفي</label>
                <input type="text" name="JobNumber" class="form-control" value="@Model.JobNumber" />
            </div>
                      <div class="col-md-4 mb-3">
                <label class="form-label">رقم أقرب الأقارب</label>
                <input type="text" name="NextOfKinPhone" class="form-control" value="@Model.NextOfKinPhone" />
            </div>
                  <div class="col-md-4 mb-3">
                <label class="form-label">الصورة الشخصية</label>
                @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
                {
                    <div class="mb-1">
                        <img src="@Model.ProfilePhotoPath" alt="الصورة الحالية" style="max-width:80px; max-height:80px; border-radius:6px;" />
                    </div>
                }
                <input type="file" name="profilePhoto" class="form-control" accept="image/*" />
                <small class="text-muted">اتركي هذا الحقل فارغاً للإبقاء على الصورة الحالية</small>
            </div>
        </div>

        <div class="row">
           
            <div class="col-md-6 mb-3">
                <label class="form-label">المسؤوليات</label>
                <input type="text" name="Responsibilities" class="form-control" value="@Model.Responsibilities" />
            </div>
        </div>

        <hr />
        <h5>الوظيفة</h5>
        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">القسم</label>
                <select name="DepartmentId" class="form-select" required>
                    <option value="">-- اختر القسم --</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الرتبة الوظيفية</label>
                <select name="Rank" class="form-select">
                    @foreach (var jr in jobRanks)
                    {
                        <option value="@jr.Value" selected="@(Model.Rank.ToString() == jr.Value)">@jr.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">المسار الوظيفي</label>
                <select name="CareerTrack" class="form-select">
                    @foreach (var ct in careerTracks)
                    {
                        <option value="@ct.Value" selected="@(Model.CareerTrack.ToString() == ct.Value)">@ct.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الدور</label>
                <select name="role" class="form-select" required>
                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(r == currentRole)">@r</option>
                    }
                </select>
            </div>
        </div>

        <hr />
        <h5>العقد والتقييم</h5>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">الراتب التعاقدي</label>
                <input type="number" step="0.01" min="0" name="ContractSalary" class="form-control" value="@Model.ContractSalary" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">تاريخ بداية العقد</label>
                <input type="date" name="ContractStartDate" class="form-control" value="@(Model.ContractStartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">تاريخ نهاية العقد</label>
                <input type="date" name="ContractEndDate" class="form-control" value="@(Model.ContractEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">تاريخ التقييم الشهري</label>
                <input type="date" name="MonthlyEvaluationDate" class="form-control" value="@(Model.MonthlyEvaluationDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">تاريخ التقييم السنوي</label>
                <input type="date" name="YearlyEvaluationDate" class="form-control" value="@(Model.YearlyEvaluationDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">تاريخ إنهاء العقد</label>
                <input type="date" name="ContractTerminationDate" class="form-control" value="@(Model.ContractTerminationDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">التعهد</label>
                <textarea name="Pledge" class="form-control" rows="2">@Model.Pledge</textarea>
            </div>
        </div>

        <hr />
        <h5>موقع الحضور المتوقع</h5>
        <div class="athar-map-section mb-3">
            <p class="athar-map-hint">انقر على الخريطة لتحديد الموقع، أو اسحب العلامة بعد وضعها لتعديل الموقع</p>

            <div class="mb-2">
                <label class="form-label">اسم الموقع</label>
              <input type="text" id="ExpectedLocationName" name="ExpectedLocationName" class="form-control" value="@Model.ExpectedLocationName" readonly />
            </div>
                        <div class="mb-2">
                <label class="form-label">بحث عن عنوان</label>
                <input type="text" id="edituser-address-search" class="form-control" placeholder="اكتب اسم منطقة أو شارع..." autocomplete="off" />
            </div>
            <div id="edituser-map" class="athar-map"></div>

            <div class="athar-coords-display mt-2" id="edituser-coords-display">
                @if (Model.ExpectedLatitude.HasValue && Model.ExpectedLongitude.HasValue)
                {
                    @:الإحداثيات المختارة: @Model.ExpectedLatitude.Value.ToString("F6"), @Model.ExpectedLongitude.Value.ToString("F6")
                }
                else
                {
                    @:لم يتم تحديد موقع بعد
                }
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <label class="form-label">نصف القطر المسموح (متر)</label>
                    <input type="number" min="1" name="AllowedRadiusMeters" class="form-control" value="@Model.AllowedRadiusMeters" />
                </div>
            </div>

            <input type="hidden" id="ExpectedLatitude" name="ExpectedLatitude" value="@(Model.ExpectedLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
            <input type="hidden" id="ExpectedLongitude" name="ExpectedLongitude" value="@(Model.ExpectedLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
        </div>

        <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
        <a asp-action="Users" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>

<div class="athar-card mt-3">
    <h5>المناصب الوظيفية</h5>

    @if (positions.Any())
    {
        <table class="table table-sm mt-2">
            <thead>
                <tr>
                    <th>القسم</th>
                    <th>الرتبة</th>
                    <th>المسار</th>
                    <th>تاريخ البداية</th>
                    <th>تاريخ النهاية</th>
                    <th>أساسي</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pos in positions)
                {
                    <tr>
                        <td>@pos.Department?.Name</td>
                        <td>@pos.Rank</td>
                        <td>@pos.Track</td>
                        <td>@pos.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@(pos.EndDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@(pos.IsPrimary ? "نعم" : "لا")</td>
                        <td>
                            @if (pos.EndDate == null)
                            {
                                <form method="post" asp-action="EndPosition" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@pos.Id" />
                                    <input type="hidden" name="userId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">إنهاء</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">لا توجد مناصب مسجلة بعد</p>
    }

    <hr />
    <h6>إضافة منصب جديد</h6>
    <form method="post" asp-action="AddPosition" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.Id" />
        <div class="col-md-3">
            <label class="form-label">القسم</label>
            <select name="DepartmentId" class="form-select form-select-sm" required>
                @foreach (var d in departments)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">الرتبة</label>
            <select name="Rank" class="form-select form-select-sm">
                @foreach (var jr in jobRanks)
                {
                    <option value="@jr.Value">@jr.Label</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">المسار</label>
            <select name="Track" class="form-select form-select-sm">
                @foreach (var ct in careerTracks)
                {
                    <option value="@ct.Value">@ct.Label</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">تاريخ البداية</label>
            <input type="date" name="StartDate" class="form-control form-control-sm" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="col-md-1">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" name="IsPrimary" value="true" id="isPrimaryPos" checked />
                <label class="form-check-label" for="isPrimaryPos">أساسي</label>
            </div>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة</button>
        </div>
    </form>
</div>

<div class="athar-card mt-3">
    <h5>صلاحيات إضافية ممنوحة يدوياً</h5>
    <p class="text-muted small">تُضاف فوق صلاحيات دور المستخدم (اتحاد Union) ولا تُلغي أي صلاحية من الدور.</p>

    @if (overridePermissions.Any())
    {
        <ul class="list-group mb-3">
            @foreach (var up in overridePermissions)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @up.Permission.Name <small class="text-muted">(@up.Permission.Code)</small>
                    <form method="post" asp-action="RemoveUserPermission" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@up.Id" />
                        <input type="hidden" name="userId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">إزالة</button>
                    </form>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">لا توجد صلاحيات إضافية ممنوحة حالياً</p>
    }

    <form method="post" asp-action="AddUserPermission" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.Id" />
        <div class="col-md-8">
            <label class="form-label">منح صلاحية إضافية</label>
            <select name="permissionId" class="form-select">
                @foreach (var perm in allPermissions.Where(p => !overridePermissionIds.Contains(p.Id)))
                {
                    <option value="@perm.Id">@perm.Name (@perm.Code)</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn athar-btn w-100">+ منح الصلاحية</button>
        </div>
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/location-picker.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initAtharLocationPicker({
                mapId: 'edituser-map',searchInputId: 'edituser-address-search',
                latInputId: 'ExpectedLatitude',
                lngInputId: 'ExpectedLongitude',
                nameInputId: 'ExpectedLocationName',
                coordsDisplayId: 'edituser-coords-display',                
                initialLat: @initialLat,
                initialLng: @initialLng
            });
        });
    </script>
}