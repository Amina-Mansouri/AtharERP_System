@using AtharERP_System.Models.Entities
@model ApplicationUser
@{
    ViewData["Title"] = "تعديل المستخدم";
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
    var currentRole = ViewBag.CurrentRole as string;
}

<h1 class="athar-page-title">تعديل بيانات المستخدم</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="EditUser" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">الاسم الكامل</label>
                <input type="text" name="FullName" class="form-control" value="@Model.FullName" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">البريد الإلكتروني</label>
                <input type="email" class="form-control" value="@Model.Email" disabled />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">المسمى الوظيفي</label>
                <input type="text" name="JobTitle" class="form-control" value="@Model.JobTitle" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">القسم</label>
                <input type="text" name="Department" class="form-control" value="@Model.Department" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">درجة المهندس</label>
                <select name="EngineerRank" class="form-select">
                    <option value="None" selected="@(Model.EngineerRank == EngineerRank.None)">غير محدد</option>
                    <option value="Junior" selected="@(Model.EngineerRank == EngineerRank.Junior)">مبتدئ</option>
                    <option value="MidLevel" selected="@(Model.EngineerRank == EngineerRank.MidLevel)">متوسط</option>
                    <option value="Senior" selected="@(Model.EngineerRank == EngineerRank.Senior)">خبير</option>
                    <option value="Lead" selected="@(Model.EngineerRank == EngineerRank.Lead)">رئيسي</option>
                    <option value="Principal" selected="@(Model.EngineerRank == EngineerRank.Principal)">استشاري</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">رقم الهاتف</label>
                <input type="tel" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">الدور</label>
                <select name="role" class="form-select" required>
                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(r == currentRole)">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">اسم الموقع المتوقع للحضور</label>
                <input type="text" name="ExpectedLocationName" class="form-control" value="@Model.ExpectedLocationName" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">خط العرض</label>
                <input type="number" step="any" name="ExpectedLatitude" class="form-control" value="@Model.ExpectedLatitude" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">خط الطول</label>
                <input type="number" step="any" name="ExpectedLongitude" class="form-control" value="@Model.ExpectedLongitude" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">نصف القطر المسموح (متر)</label>
                <input type="number" step="any" name="AllowedRadiusMeters" class="form-control" value="@Model.AllowedRadiusMeters" />
            </div>
        </div>

        <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
        <a asp-action="Users" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>