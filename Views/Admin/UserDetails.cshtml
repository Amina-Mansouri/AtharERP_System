@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model ApplicationUser
@{
    ViewData["Title"] = "ملف المستخدم";
    var positions = ViewBag.Positions as List<EmployeePosition> ?? new List<EmployeePosition>();
    var effectivePermissions = ViewBag.EffectivePermissions as List<PermissionService.EffectivePermission> ?? new List<PermissionService.EffectivePermission>();
    var documents = ViewBag.Documents as List<EmployeeDocument> ?? new List<EmployeeDocument>();
    var auditLogs = ViewBag.AuditLogs as List<AuditLog> ?? new List<AuditLog>();
    var auditActors = ViewBag.AuditActors as Dictionary<string, string> ?? new Dictionary<string, string>();
    var rankLabel = EnumDisplayHelper.GetDisplayList<JobRank>().FirstOrDefault(x => x.Value == Model.Rank.ToString()).Label;
    var trackLabel = EnumDisplayHelper.GetDisplayList<CareerTrack>().FirstOrDefault(x => x.Value == Model.CareerTrack.ToString()).Label;
    var contractRange = (Model.ContractStartDate?.ToString("yyyy-MM-dd") ?? "-") + " → " + (Model.ContractEndDate?.ToString("yyyy-MM-dd") ?? "مفتوح");
}

<div class="profile-head">
    @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
    {
        <img src="@Model.ProfilePhotoPath" class="profile-avatar" alt="" />
    }
    else
    {
        <img src="~/images/logo-badge.png" class="profile-avatar" alt="" />
    }
    <div style="flex:1">
        <span class="kicker">@(Model.JobNumber ?? "-") · الرقم الشخصي @(Model.PersonalId ?? "-")</span>
        <h1>@Model.FullName</h1>
    </div>
    <div class="page-head-actions">
        <form method="post" asp-action="ToggleUserStatus" asp-route-id="@Model.Id" class="d-inline"
              onsubmit="return confirm('هل أنت متأكد؟');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-line">@(Model.IsActive ? "تعطيل الحساب" : "تفعيل الحساب")</button>
        </form>
        <a asp-action="EditUser" asp-route-id="@Model.Id" class="btn-line" href="@Url.Action("EditUser", new { id = Model.Id })#permissions">صلاحيات يدوية</a>
        <a asp-action="EditUser" asp-route-id="@Model.Id" class="btn-line btn-line-accent">تعديل</a>
    </div>
</div>

<div class="stat-strip stat-strip-text">
    <div class="stat-item"><span class="kicker">القسم الأساسي</span><span class="stat-value">@(Model.Department?.Name ?? "-")</span></div>
    <div class="stat-item"><span class="kicker">الرتبة</span><span class="stat-value">@rankLabel</span></div>
    <div class="stat-item"><span class="kicker">المسار</span><span class="stat-value">@trackLabel</span></div>
    <div class="stat-item"><span class="kicker">العقد</span><span class="stat-value">@contractRange</span></div>
    <div class="stat-item"><span class="kicker">الحالة</span><span class="stat-value">@(Model.IsActive ? "نشط" : "معطل")</span></div>
</div>

<div class="tabs">
    <a class="tab-item active" data-bs-toggle="tab" href="#pane-data">البيانات</a>
    <a class="tab-item" data-bs-toggle="tab" href="#pane-positions">المناصب @positions.Count</a>
    <a class="tab-item" data-bs-toggle="tab" href="#pane-permissions">الصلاحيات الفعلية</a>
    <a class="tab-item" data-bs-toggle="tab" href="#pane-documents">المستندات @documents.Count</a>
    <a class="tab-item" data-bs-toggle="tab" href="#pane-location">موقع الحضور</a>
    <a class="tab-item" data-bs-toggle="tab" href="#pane-audit">سجل التغييرات</a>
</div>

<div class="tab-content">
    <div class="tab-pane fade show active" id="pane-data">
        <p><strong>البريد الإلكتروني:</strong> @Model.Email</p>
        <p><strong>رقم الهاتف:</strong> @(Model.PhoneNumber ?? "-")</p>
        <p><strong>الرقم الشخصي:</strong> @(Model.PersonalId ?? "-")</p>
        <p><strong>المسؤوليات:</strong> @(Model.Responsibilities ?? "-")</p>
        <p><strong>آخر دخول:</strong> @(Model.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "لم يسجل بعد")</p>
    </div>

    <div class="tab-pane fade" id="pane-positions">
        <div style="display:grid; grid-template-columns: 1.2fr 1fr; gap:12px;">
            <div class="data-table" style="--cols: 1fr 96px 84px 96px 62px">
                <div class="data-table-head">
                    <div class="cell">القسم</div>
                    <div class="cell">الرتبة</div>
                    <div class="cell">المسار</div>
                    <div class="cell">من</div>
                    <div class="cell">أساسي</div>
                </div>
                @if (!positions.Any())
                {
                    <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مناصب مسجّلة</div></div>
                }
                else
                {
                    @foreach (var p in positions)
                    {
                        <div class="data-table-row">
                            <div class="cell">@p.Department.Name</div>
                            <div class="cell">@p.Rank.ToString().Split('_')[0]</div>
                            <div class="cell">@EnumDisplayHelper.GetDisplayList<CareerTrack>().FirstOrDefault(x => x.Value == p.Track.ToString()).Label</div>
                            <div class="cell cell-num">@p.StartDate.ToString("yyyy-MM-dd")</div>
                            <div class="cell">@(p.IsPrimary ? "✓" : "")</div>
                        </div>
                    }
                }
            </div>
            <div class="side-panel">
                <div class="side-panel-title">موقع الحضور المعتمد</div>
                <div style="display:flex; gap:10px; align-items:flex-start;">
                    <div class="ds-map-slot">لا خريطة متاحة</div>
                    <div style="font-size:11px; line-height:1.7;">
                        <div>@(Model.ExpectedLocationName ?? "غير محدد")</div>
                        <div class="cell-num">@(Model.ExpectedLatitude?.ToString("F5") ?? "-")، @(Model.ExpectedLongitude?.ToString("F5") ?? "-")</div>
                        <div>نطاق مسموح @(Model.AllowedRadiusMeters) م</div>
                        <div class="stat-sub">يعدّله مدير النظام فقط</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="pane-permissions">
        <p class="stat-sub" style="margin-bottom:8px;">صلاحيات الدور ∪ الاستثناءات اليدوية</p>
        @if (!effectivePermissions.Any())
        {
            <p>لا توجد صلاحيات فعلية</p>
        }
        else
        {
            @foreach (var p in effectivePermissions)
            {
                <div style="display:flex; align-items:center; justify-content:space-between; font-size:11px; padding:4px 0; border-bottom: var(--ds-row-line);">
                    <span>@p.Code — @p.Name</span>
                    @if (p.Source == "يدوي")
                    {
                        <span class="tag tag-accent">يدوي</span>
                    }
                    else
                    {
                        <span class="tag">دور</span>
                    }
                </div>
            }
            <p class="stat-sub" style="margin-top:8px;">عرض الـ@(effectivePermissions.Count) · التغيير يُطبَّق فوراً بلا إعادة دخول</p>
        }
    </div>

    <div class="tab-pane fade" id="pane-documents">
        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:10px;">
            @if (!documents.Any())
            {
                <p>لا توجد مستندات مرفوعة</p>
            }
            else
            {
                @foreach (var d in documents)
                {
                    <div>
                        <div class="ds-photo-slot">
                            @if (d.FileType != null && d.FileType.StartsWith("image"))
                            {
                                <img src="@d.FilePath" alt="@d.FileName" />
                            }
                            else
                            {
                                <span>@d.FileName</span>
                            }
                        </div>
                        <div class="stat-sub" style="margin-top:2px; text-align:center;">@d.FileName</div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="tab-pane fade" id="pane-location">
        <p><strong>الموقع المتوقع:</strong> @(Model.ExpectedLocationName ?? "غير محدد")</p>
        <p><strong>الإحداثيات:</strong> @(Model.ExpectedLatitude?.ToString("F5") ?? "-")، @(Model.ExpectedLongitude?.ToString("F5") ?? "-")</p>
        <p><strong>نطاق مسموح:</strong> @(Model.AllowedRadiusMeters) متر</p>
        <p class="stat-sub">يعدّله مدير النظام فقط (من صفحة تعديل المستخدم)</p>
    </div>

    <div class="tab-pane fade" id="pane-audit">
        <div class="data-table" style="--cols: 100px 140px 120px 1fr">
            <div class="data-table-head">
                <div class="cell">الوقت</div>
                <div class="cell">المستخدم</div>
                <div class="cell">العملية</div>
                <div class="cell">التفاصيل</div>
            </div>
            @if (!auditLogs.Any())
            {
                <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا يوجد سجل تغييرات بعد</div></div>
            }
            else
            {
                @foreach (var a in auditLogs)
                {
                    <div class="data-table-row">
                        <div class="cell cell-num">@a.Timestamp.ToString("yyyy-MM-dd HH:mm")</div>
                        <div class="cell">@(auditActors.ContainsKey(a.UserId) ? auditActors[a.UserId] : "-")</div>
                        <div class="cell">@a.Action</div>
                        <div class="cell">@(a.Details ?? "-")</div>
                    </div>
                }
            }
        </div>
    </div>
</div>