@using AtharERP_System.Models.Entities
@model List<ExpenseCategory>
@{
    ViewData["Title"] = "تصنيفات المصروفات";
}

<div class="page-head">
    <div>
        <span class="kicker">إعدادات المالية</span>
        <h1>تصنيفات المصروفات</h1>
    </div>
    <div class="page-head-actions">
        <button type="button" class="btn-line btn-line-accent" onclick="openExpenseCategoryModal()">+ تصنيف جديد</button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="athar-card mt-3">
    @if (!Model.Any())
    {
        <p class="mb-0">لا توجد تصنيفات مصروفات بعد</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>اسم التصنيف</th>
                    <th>الحالة</th>
                    <th>النوع</th>
                    <th>عدد المصروفات المرتبطة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.NameAr</td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="tag tag-accent">نشط</span>
                            }
                            else
                            {
                                <span class="tag" style="color:#c94a42;">معطَّل</span>
                            }
                        </td>
                        <td>@(c.Scope == ExpenseCategoryScope.General ? "إداري عام" : "مشروع")</td>
                        <td>@c.Expenses.Count</td>
                        <td>
                            <button type="button" class="btn-line"
                                    onclick='openExpenseCategoryModal(@c.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(c.NameAr)), @c.IsActive.ToString().ToLower(), @((int)c.Scope))'>
                                تعديل
                            </button>
                            <form method="post" asp-action="DeleteExpenseCategory" asp-route-id="@c.Id" style="display:inline;" onsubmit="return confirm('هل أنتِ متأكدة من حذف هذا التصنيف؟');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-line" style="color:#c94a42;">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="modal fade" id="expenseCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="expenseCategoryForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="expense-category-modal-title">تصنيف مصروف جديد</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="display:grid; gap:10px;">
                    <div>
                        <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">اسم التصنيف (مثال: نثريات، مصروفات المواقع)</div>
                        <input type="text" name="NameAr" id="expense-category-name" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;" />
                    </div>
                    <div>
                        <div style="font-size:11px; color:#5a5370; margin-bottom:5px;">النوع</div>
                        <select name="Scope" id="expense-category-scope" required style="width:100%; height:34px; border:1px solid #e4e2ec; border-radius:8px; background:#faf9fd; padding:0 11px; font-size:12.5px; font-family:inherit;">
                            <option value="1">مصروف مشروع</option>
                            <option value="2">مصروف إداري عام</option>
                        </select>
                    </div>
                    <div id="expense-category-active-wrapper" style="display:none; align-items:center; gap:8px;">
                        <input type="checkbox" name="IsActive" id="expense-category-isActive" value="true" />
                        <input type="hidden" name="IsActive" value="false" />
                        <label for="expense-category-isActive" style="font-size:11.5px;">نشط</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn-line btn-line-accent">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openExpenseCategoryModal(id, nameAr, isActive, scope) {
            const form = document.getElementById('expenseCategoryForm');
            const isEdit = id !== undefined && id !== null;
            form.action = isEdit ? '@Url.Action("EditExpenseCategory")/' + id : '@Url.Action("CreateExpenseCategory")';
            document.getElementById('expense-category-name').value = nameAr ?? '';
            document.getElementById('expense-category-scope').value = scope ?? 1;
            document.getElementById('expense-category-modal-title').textContent = isEdit ? 'تعديل التصنيف' : 'تصنيف مصروف جديد';
            document.getElementById('expense-category-active-wrapper').style.display = isEdit ? 'flex' : 'none';
            if (isEdit) {
                document.getElementById('expense-category-isActive').checked = !!isActive;
            }
            new bootstrap.Modal(document.getElementById('expenseCategoryModal')).show();
        }
    </script>
}