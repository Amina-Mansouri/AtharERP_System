@inject PermissionService PermissionService﻿
@using AtharERP_System.Services
@using AtharERP_System.Models.Entities
@model List<ProjectAssignment>
@{
    ViewData["Title"] = "تتبّع تكليفات المشاريع";
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
    var stages = ViewBag.Stages as List<ProjectStage> ?? new List<ProjectStage>();
    var selectedProjectId = ViewBag.ProjectId as int?;
    var selectedStageId = ViewBag.StageId as int?;
    var taskFilter = ViewBag.TaskFilter as string ?? "all";
    var assignmentStatusLabels = EnumDisplayHelper.GetDisplayList<AssignmentStatus>();
}

<div style="margin-bottom:14px;">
    <div style="font-size:11px; color:#8a83a0; font-weight:500;">المشاريع</div>
    <div style="font-size:19px; font-weight:600; margin-top:2px;">تتبّع تكليفات المشاريع</div>
</div>

<form method="get" class="filter-bar">
    <select name="projectId" class="filter-chip" onchange="this.form.submit()">
        <option value="">-- اختر مشروعاً --</option>
        @foreach (var p in projects)
        {
            <option value="@p.Id" selected="@(selectedProjectId == p.Id)">@p.Code - @p.Name</option>
        }
    </select>
    @if (selectedProjectId.HasValue)
    {
        <select name="stageId" class="filter-chip" onchange="this.form.submit()">
            <option value="">كل المراحل</option>
            @foreach (var s in stages)
            {
                <option value="@s.Id" selected="@(selectedStageId == s.Id)">@s.Name</option>
            }
        </select>
    }
    <input type="hidden" name="taskFilter" value="@taskFilter" />
</form>

@if (!selectedProjectId.HasValue)
{
    <div class="stat-sub">اختاري مشروعاً لعرض إحصائيات تكليفاته</div>
}
else
{
    <div class="stat-strip stat-strip-text">
        <div class="stat-item"><span class="kicker">عدد التكليفات</span><span class="stat-value">@ViewBag.TotalAssignments</span></div>
        <div class="stat-item"><span class="kicker">معلقة</span><span class="stat-value">@ViewBag.PendingAssignments</span></div>
        <div class="stat-item"><span class="kicker">قيد التنفيذ</span><span class="stat-value">@ViewBag.InProgressAssignments</span></div>
        <div class="stat-item"><span class="kicker">مكتملة</span><span class="stat-value">@ViewBag.CompletedAssignments</span></div>
        <div class="stat-item"><span class="kicker">متأخرة</span><span class="stat-value" style="color:#c94a42;">@ViewBag.OverdueAssignments</span></div>
    </div>

    <div style="display:flex; gap:6px; margin-bottom:12px;">
        @{
            var tabs = new (string Key, string Label)[]
            {
                ("all", "كل البنود"),
                ("completed", "المكتملة"),
                ("pending", "قيد المراجعة"),
                ("delayed", "المتأخرة")
            };
        }
        @foreach (var tab in tabs)
        {
            var isActive = taskFilter == tab.Key;
            var tabStyle = isActive
                ? "background:#7b6bd6; color:#fff; border-color:#7b6bd6;"
                : "background:#fff; color:#5a5370; border-color:#e4e2ec;";
            <a href="@Url.Action("Overview", new { projectId = selectedProjectId, stageId = selectedStageId, taskFilter = tab.Key })" style="text-decoration:none; font-size:11.5px; padding:6px 14px; border-radius:8px; border:1px solid; @tabStyle">@tab.Label</a>
        }
    </div>

    <div class="data-table" style="--cols: minmax(0,1.3fr) 108px 170px 96px 96px">
        <div class="data-table-head">
            <div class="cell">التكليف</div>
            <div class="cell">المرحلة</div>
            <div class="cell">المهندسات</div>
            <div class="cell">الحالة</div>
            <div class="cell"></div>
        </div>
        @if (!Model.Any())
        {
            <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد تكليفات مطابقة</div></div>
        }
        else
        {
            @foreach (var a in Model)
            {
                IEnumerable<ProjectTask> filteredTasks = taskFilter switch
                {
                    "completed" => a.Tasks.Where(t => t.Status == ProjectTaskStatus.Completed),
                    "pending" => a.Tasks.Where(t => t.Status == ProjectTaskStatus.PendingReview),
                    "delayed" => a.Tasks.Where(t => t.DelayDays > 0),
                    _ => a.Tasks
                };
                var tasksToShow = filteredTasks.ToList();
                var totalTasks = a.Tasks.Count;
                var doneTasks = a.Tasks.Count(t => t.Status == ProjectTaskStatus.Completed);

                if (taskFilter != "all" && !tasksToShow.Any())
                {
                    continue;
                }

                <div class="data-table-row">
                    <div class="cell">
                        @a.CostType
                        @if (a.IsUrgent)
                        {
                            <span class="tag tag-danger">مستعجل</span>
                        }
                    </div>
                    <div class="cell">@(a.Stage?.Name ?? "-")</div>
                    <div class="cell">
                        @if (!a.Engineers.Any())
                        {
                            <span>-</span>
                        }
                        else
                        {
                            @foreach (var eng in a.Engineers)
                            {
                                <div style="font-size:11px;">• @eng.User.FullName</div>
                            }
                        }
                    </div>
                    <div class="cell"><span class="tag">@assignmentStatusLabels.FirstOrDefault(x => x.Value == a.Status.ToString()).Label</span></div>
                    <div class="cell"><a asp-controller="Projects" asp-action="Details" asp-route-id="@a.ProjectId" style="font-size:11px;">فتح المشروع</a></div>
                </div>
                <div style="grid-column:1/-1; background:#faf9fc; border-bottom:1px solid #f1f0f6; padding:8px 14px 12px;">
                    <div class="stat-sub" style="margin-bottom:6px;">مهام هذا التكليف: @doneTasks / @totalTasks مكتملة</div>
                    @if (!tasksToShow.Any())
                    {
                        <div class="stat-sub">لا توجد مهام مطابقة لهذا التصنيف</div>
                    }
                    else
                    {
                        var canReview = a.Stage?.AssignedEngineerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value
                            || await PermissionService.HasPermissionAsync(User, "Projects.Tasks.Manage");
                        <div style="display:grid; gap:6px;">
                            @foreach (var t in tasksToShow)
                            {
                                var taskTagClass = t.Status == ProjectTaskStatus.Completed ? "tag-success"
                                    : t.Status == ProjectTaskStatus.PendingReview ? "tag-warning"
                                    : "";
                                <div style="border:1px solid #ecebf2; border-radius:8px; padding:6px 10px; background:#fff;">
                                    <div style="display:flex; align-items:center; justify-content:space-between;">
                                        <a asp-controller="ProjectTasks" asp-action="Edit" asp-route-id="@t.Id" style="font-size:11.5px; font-weight:600; color:inherit; text-decoration:underline;">@t.Title</a>
                                        <span class="tag @taskTagClass">@(t.Status == ProjectTaskStatus.PendingReview ? "قيد المراجعة" : t.CompletionPercentage.ToString("N0") + "%")</span>
                                    </div>
                                    @if (t.Todos.Any())
                                    {
                                        <div style="display:grid; gap:3px; margin-top:6px;">
                                            @foreach (var todo in t.Todos)
                                            {
                                                var todoStyle = todo.IsCompleted ? "color:#8a83a0; text-decoration:line-through;" : "color:#3a3450;";
                                                <div style="font-size:10.5px; @todoStyle">@(todo.IsCompleted ? "✓" : "○") @todo.Item</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="stat-sub" style="margin-top:4px;">لا توجد بنود بعد</div>
                                    }
                                    @if (t.Status == ProjectTaskStatus.PendingReview && canReview)
                                    {
                                        <div style="display:flex; gap:6px; margin-top:8px; align-items:center;">
                                            <form method="post" asp-controller="ProjectTasks" asp-action="ApproveTask" style="display:flex; gap:4px; flex:1;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@t.Id" />
                                                <input type="hidden" name="projectId" value="@selectedProjectId" />
                                                <input type="hidden" name="stageId" value="@selectedStageId" />
                                                <input type="hidden" name="taskFilter" value="@taskFilter" />
                                                <input type="text" name="comment" placeholder="تعليق (اختياري)" style="flex:1; height:26px; border:1px solid #e4e2ec; border-radius:6px; padding:0 6px; font-size:10.5px;" />
                                                <button type="submit" style="height:26px; border:none; border-radius:6px; background:#2f8a57; color:#fff; font-size:10.5px; padding:0 10px;">اعتماد</button>
                                            </form>
                                            <form method="post" asp-controller="ProjectTasks" asp-action="RejectTask" style="display:flex; gap:4px; flex:1;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@t.Id" />
                                                <input type="hidden" name="projectId" value="@selectedProjectId" />
                                                <input type="hidden" name="stageId" value="@selectedStageId" />
                                                <input type="hidden" name="taskFilter" value="@taskFilter" />
                                                <input type="text" name="comment" placeholder="سبب الرفض (اختياري)" style="flex:1; height:26px; border:1px solid #e4e2ec; border-radius:6px; padding:0 6px; font-size:10.5px;" />
                                                <button type="submit" style="height:26px; border:none; border-radius:6px; background:#c94a42; color:#fff; font-size:10.5px; padding:0 10px;">رفض</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
}