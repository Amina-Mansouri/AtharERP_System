@inject PermissionService PermissionService﻿
@using AtharERP_System.Services
@using AtharERP_System.Models.Entities
@model List<ProjectAssignment>
@{
    ViewData["Title"] = "تتبّع تكليفات المشاريع";
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
    var stages = ViewBag.Stages as List<ProjectStage> ?? new List<ProjectStage>();
    var selectedProjectId = ViewBag.ProjectId as int?;
    var selectedStageId = ViewBag.StageId as int?;
    var taskFilter = ViewBag.TaskFilter as string ?? "all";
    var assignmentStatusLabels = EnumDisplayHelper.GetDisplayList<AssignmentStatus>();
}

<div style="margin-bottom:14px;">
    <div style="font-size:11px; color:#8a83a0; font-weight:500;">المشاريع</div>
    <div style="font-size:19px; font-weight:600; margin-top:2px;">تتبّع تكليفات المشاريع</div>
</div>

<form method="get" class="filter-bar">
    <select name="projectId" class="filter-chip" onchange="this.form.submit()">
        <option value="">-- اختر مشروعاً --</option>
        @foreach (var p in projects)
        {
            <option value="@p.Id" selected="@(selectedProjectId == p.Id)">@p.Code - @p.Name</option>
        }
    </select>
    @if (selectedProjectId.HasValue)
    {
        <select name="stageId" class="filter-chip" onchange="this.form.submit()">
            <option value="">كل المراحل</option>
            @foreach (var s in stages)
            {
                <option value="@s.Id" selected="@(selectedStageId == s.Id)">@s.Name</option>
            }
        </select>
    }
    <input type="hidden" name="taskFilter" value="@taskFilter" />
</form>

@if (!selectedProjectId.HasValue)
{
    <div class="stat-sub">اختاري مشروعاً لعرض إحصائيات تكليفاته</div>
}
else
{
    var totalAssignmentsCount = (int)ViewBag.TotalAssignments;
    var pendingAssignmentsCount = (int)ViewBag.PendingAssignments;
    var inProgressAssignmentsCount = (int)ViewBag.InProgressAssignments;
    var overdueAssignmentsCount = (int)ViewBag.OverdueAssignments;
    var completedAssignmentsCount = (int)ViewBag.CompletedAssignments;
    var otherAssignmentsCount = totalAssignmentsCount - pendingAssignmentsCount - inProgressAssignmentsCount - overdueAssignmentsCount - completedAssignmentsCount;
    var assignmentSlices = new List<(string Label, int Value, string Color)>
    {
        ("معلقة", pendingAssignmentsCount, "#8a83a0"),
        ("قيد التنفيذ", inProgressAssignmentsCount, "#7b6bd6"),
        ("متأخرة", overdueAssignmentsCount, "#c94a42"),
        ("مكتملة", completedAssignmentsCount, "#2f8a57"),
        ("ملغاة", otherAssignmentsCount, "#ecebf2")
    };
    var reworkCountInScope = (int)ViewBag.ReworkCount;
    var avgCompletionInScope = (decimal)ViewBag.AvgCompletionInScope;

    <div style="display:flex; justify-content:flex-end; margin-bottom:6px;">
        <div style="display:inline-block;">
            @await Html.PartialAsync("_StatDonutChart", assignmentSlices)
        </div>
    </div>

    <div class="stat-strip stat-strip-text">
        <div class="stat-item"><span class="kicker">عدد التكليفات</span><span class="stat-value">@totalAssignmentsCount</span></div>
        <div class="stat-item"><span class="kicker">متوسط نسبة الإنجاز @(selectedStageId.HasValue ? "(المرحلة)" : "(المشروع)")</span><span class="stat-value">@avgCompletionInScope.ToString("N1")%</span></div>
        <div class="stat-item"><span class="kicker">معدل إعادة العمل @(selectedStageId.HasValue ? "(المرحلة)" : "(المشروع)")</span><span class="stat-value" style="color:#c9700f;">@reworkCountInScope</span></div>
    </div>

    <div style="display:flex; gap:6px; margin-bottom:12px;">
        @{
            var tabs = new (string Key, string Label)[]
            {
                ("all", "كل البنود"),
                ("completed", "المكتملة"),
                ("pending", "قيد المراجعة"),
                ("delayed", "المتأخرة")
            };
        }
        @foreach (var tab in tabs)
        {
            var isActive = taskFilter == tab.Key;
            var tabStyle = isActive
                ? "background:#7b6bd6; color:#fff; border-color:#7b6bd6;"
                : "background:#fff; color:#5a5370; border-color:#e4e2ec;";
            <a href="@Url.Action("Overview", new { projectId = selectedProjectId, stageId = selectedStageId, taskFilter = tab.Key })" style="text-decoration:none; font-size:11.5px; padding:6px 14px; border-radius:8px; border:1px solid; @tabStyle">@tab.Label</a>
        }
    </div>

    <div style="display:grid; gap:12px;">
        @if (!Model.Any())
        {
            <div class="stat-sub">لا توجد تكليفات مطابقة</div>
        }
        else
        {
            var canReview = await PermissionService.HasPermissionAsync(User, "Projects.Tasks.Manage");
            @foreach (var a in Model)
            {
                IEnumerable<ProjectTask> filteredTasks = taskFilter switch
                {
                    "completed" => a.Tasks.Where(t => t.Status == ProjectTaskStatus.Completed),
                    "pending" => a.Tasks.Where(t => t.Status == ProjectTaskStatus.PendingReview),
                    "delayed" => a.Tasks.Where(t => t.DelayDays > 0),
                    _ => a.Tasks
                };
                var tasksToShow = filteredTasks.ToList();
                var totalTasks = a.Tasks.Count;
                var doneTasks = a.Tasks.Count(t => t.Status == ProjectTaskStatus.Completed);

                if (taskFilter != "all" && !tasksToShow.Any())
                {
                    continue;
                }

                var assignmentCanReview = a.Stage?.AssignedEngineerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value || canReview;
                var allProposals = a.Tasks.SelectMany(t => t.DesignProposals.Select(p => new { Task = t, Proposal = p })).OrderByDescending(x => x.Proposal.CreatedAt).ToList();

                <div style="display:grid; grid-template-columns:1.4fr 1fr; gap:12px; align-items:start;">
                    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;">
                            <div style="font-size:13px; font-weight:600;">
                                @a.CostType
                                @if (a.IsUrgent)
                                {
                                    <span class="tag tag-danger">مستعجل</span>
                                }
                            </div>
                            <span class="tag">@assignmentStatusLabels.FirstOrDefault(x => x.Value == a.Status.ToString()).Label</span>
                        </div>
                        <div class="stat-sub" style="margin-bottom:6px;">المرحلة: @(a.Stage?.Name ?? "-")</div>
                        <div style="margin-bottom:8px;">
                            @if (!a.Engineers.Any())
                            {
                                <span class="stat-sub">لا يوجد مهندسون</span>
                            }
                            else
                            {
                                @foreach (var eng in a.Engineers)
                                {
                                    <div style="font-size:11px;">• @eng.User.FullName</div>
                                }
                            }
                        </div>
                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
                            <div class="stat-sub">مهام هذا التكليف: @doneTasks / @totalTasks مكتملة</div>
                            <a asp-controller="Projects" asp-action="Details" asp-route-id="@a.ProjectId" style="font-size:11px;">فتح المشروع</a>
                        </div>

                        @if (!tasksToShow.Any())
                        {
                            <div class="stat-sub">لا توجد مهام مطابقة لهذا التصنيف</div>
                        }
                        else
                        {
                            <div style="display:grid; gap:6px;">
                                @foreach (var t in tasksToShow)
                                {
                                    var taskTagClass = t.Status == ProjectTaskStatus.Completed ? "tag-success" : (t.Status == ProjectTaskStatus.PendingReview ? "tag-warning" : "");
                                    <div style="border:1px solid #ecebf2; border-radius:8px; padding:6px 10px; background:#faf9fd;">
                                        <div style="display:flex; align-items:center; justify-content:space-between;">
                                            <a asp-controller="ProjectTasks" asp-action="Edit" asp-route-id="@t.Id" style="font-size:11.5px; font-weight:600; color:inherit; text-decoration:underline;">@t.Title</a>
                                            <span class="tag @taskTagClass">@(t.Status == ProjectTaskStatus.PendingReview ? "قيد المراجعة" : t.CompletionPercentage.ToString("N0") + "%")</span>
                                        </div>
                                        @if (t.Todos.Any())
                                        {
                                            <div style="display:grid; gap:3px; margin-top:6px;">
                                                @foreach (var todo in t.Todos)
                                                {
                                                    var todoStyle = todo.IsCompleted ? "color:#8a83a0; text-decoration:line-through;" : "color:#3a3450;";
                                                    <div style="font-size:10.5px; @todoStyle">@(todo.IsCompleted ? "✓" : "○") @todo.Item</div>
                                                }
                                            </div>
                                        }
                                        @if (t.Status == ProjectTaskStatus.PendingReview && assignmentCanReview)
                                        {
                                            <div style="display:flex; gap:6px; margin-top:8px; align-items:center;">
                                                <form method="post" asp-controller="ProjectTasks" asp-action="ApproveTask" style="display:flex; gap:4px; flex:1;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@t.Id" />
                                                    <input type="hidden" name="projectId" value="@selectedProjectId" />
                                                    <input type="hidden" name="stageId" value="@selectedStageId" />
                                                    <input type="hidden" name="taskFilter" value="@taskFilter" />
                                                    <input type="text" name="comment" placeholder="تعليق (اختياري)" style="flex:1; height:24px; border:1px solid #e4e2ec; border-radius:6px; padding:0 6px; font-size:10px;" />
                                                    <button type="submit" style="height:24px; border:none; border-radius:6px; background:#2f8a57; color:#fff; font-size:10px; padding:0 8px;">اعتماد</button>
                                                </form>
                                                <form method="post" asp-controller="ProjectTasks" asp-action="RejectTask" style="display:flex; gap:4px; flex:1;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@t.Id" />
                                                    <input type="hidden" name="projectId" value="@selectedProjectId" />
                                                    <input type="hidden" name="stageId" value="@selectedStageId" />
                                                    <input type="hidden" name="taskFilter" value="@taskFilter" />
                                                    <input type="text" name="comment" placeholder="سبب الرفض (اختياري)" style="flex:1; height:24px; border:1px solid #e4e2ec; border-radius:6px; padding:0 6px; font-size:10px;" />
                                                    <button type="submit" style="height:24px; border:none; border-radius:6px; background:#c94a42; color:#fff; font-size:10px; padding:0 8px;">رفض</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
                        <div style="font-size:13px; font-weight:600; margin-bottom:8px;">مستندات التكليف (مقترحات التصميم)</div>
                        @if (!allProposals.Any())
                        {
                            <div class="stat-sub">لا توجد مستندات مرفوعة بعد</div>
                        }
                        else
                        {
                            <div style="display:grid; gap:8px;">
                                @foreach (var item in allProposals)
                                {
                                    var proposal = item.Proposal;
                                    var propTagClass = proposal.Status == ProposalStatus.Approved ? "tag-success" : (proposal.Status == ProposalStatus.Rejected ? "tag-danger" : "tag-warning");
                                    var propLabel = proposal.Status == ProposalStatus.Approved ? "معتمد" : (proposal.Status == ProposalStatus.Rejected ? "مرفوض" : "بانتظار الاعتماد");
                                    <div style="border:1px solid #ecebf2; border-radius:8px; padding:8px 10px; background:#faf9fd;">
                                        <div class="stat-sub" style="margin-bottom:3px;">للمهمة: @item.Task.Title</div>
                                        <div style="display:flex; align-items:center; justify-content:space-between;">
                                            <a href="@proposal.FilePath" target="_blank" style="font-size:11px; font-weight:600; color:inherit; text-decoration:underline;">@proposal.Code — @proposal.Name (نسخة @proposal.Revision)</a>
                                            <span class="tag @propTagClass">@propLabel</span>
                                        </div>
                                        <div class="stat-sub" style="margin-top:2px;">@proposal.PreparedBy.FullName — @proposal.SubmittedDate?.ToString("yyyy/MM/dd")</div>
                                        @if (!string.IsNullOrWhiteSpace(proposal.ManagerComment))
                                        {
                                            <div style="font-size:10.5px; color:#5a5370; margin-top:3px;">تعليق: @proposal.ManagerComment</div>
                                        }
                                        @if (proposal.Status == ProposalStatus.Submitted && assignmentCanReview)
                                        {
                                            <div style="display:flex; gap:6px; margin-top:6px; align-items:center;">
                                                <form method="post" asp-controller="DesignProposals" asp-action="Approve" style="display:flex; gap:4px; flex:1;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@proposal.Id" />
                                                    <input type="hidden" name="projectId" value="@selectedProjectId" />
                                                    <input type="hidden" name="stageId" value="@selectedStageId" />
                                                    <input type="hidden" name="taskFilter" value="@taskFilter" />
                                                    <input type="text" name="comment" placeholder="تعليق (اختياري)" style="flex:1; height:24px; border:1px solid #e4e2ec; border-radius:6px; padding:0 6px; font-size:10px;" />
                                                    <button type="submit" style="height:24px; border:none; border-radius:6px; background:#2f8a57; color:#fff; font-size:10px; padding:0 8px;">اعتماد</button>
                                                </form>
                                                <form method="post" asp-controller="DesignProposals" asp-action="Reject" style="display:flex; gap:4px; flex:1;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@proposal.Id" />
                                                    <input type="hidden" name="projectId" value="@selectedProjectId" />
                                                    <input type="hidden" name="stageId" value="@selectedStageId" />
                                                    <input type="hidden" name="taskFilter" value="@taskFilter" />
                                                    <input type="text" name="comment" placeholder="سبب الرفض" style="flex:1; height:24px; border:1px solid #e4e2ec; border-radius:6px; padding:0 6px; font-size:10px;" />
                                                    <button type="submit" style="height:24px; border:none; border-radius:6px; background:#c94a42; color:#fff; font-size:10px; padding:0 8px;">رفض</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
}