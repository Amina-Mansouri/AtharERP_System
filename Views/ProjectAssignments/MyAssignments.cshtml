@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<ProjectAssignment>
@{
    ViewData["Title"] = "تكليفاتي";
    var statusLabels = EnumDisplayHelper.GetDisplayList<AssignmentStatus>();

    string StatusTagClass(AssignmentStatus s) => s switch
    {
        AssignmentStatus.Completed => "tag-success",
        AssignmentStatus.Cancelled => "tag-danger",
        AssignmentStatus.InProgress => "tag-accent",
        _ => ""
    };
}

<div style="font-size:11px; color:#8a83a0; font-weight:500;">الرئيسية</div>
<div style="font-size:19px; font-weight:600; margin-top:2px; margin-bottom:14px;">تكليفاتي</div>

@if (!Model.Any())
{
    <div class="stat-sub">لا توجد تكليفات مسندة إليك حالياً</div>
}
else
{
    @foreach (var a in Model)
    {
        var totalTasks = a.Tasks.Count;
        var doneTasks = a.Tasks.Count(t => t.Status == ProjectTaskStatus.Completed);
        <a asp-controller="ProjectAssignments" asp-action="ManageTasks" asp-route-id="@a.Id" asp-route-personal="true" style="display:block; background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px; margin-bottom:12px; text-decoration:none; color:inherit;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
                <div>
                    <div style="font-size:13.5px; font-weight:600;">@a.CostType</div>
                    <div class="stat-sub">@a.Stage?.Project?.Name — @a.Stage?.Name</div>
                </div>
                <span class="tag @StatusTagClass(a.Status)">@statusLabels.FirstOrDefault(x => x.Value == a.Status.ToString()).Label</span>
            </div>
            <div class="stat-sub">البنود: @doneTasks / @totalTasks مكتمل</div>
        </a>
    }
}