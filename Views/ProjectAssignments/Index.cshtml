@using AtharERP_System.Models.Entities
@model List<ProjectAssignment>
@{
    ViewData["Title"] = "تكليفات المشروع";
    var project = ViewBag.Project as Project;
    var canEdit = ViewBag.CanEdit as bool? ?? false;

    string StatusLabel(AssignmentStatus s) => s switch
    {
        AssignmentStatus.Pending => "معلق",
        AssignmentStatus.InProgress => "قيد التنفيذ",
        AssignmentStatus.Completed => "مكتمل",
        AssignmentStatus.Cancelled => "ملغى",
        _ => s.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="athar-page-title">تكليفات مشروع: @project?.Name <small class="text-muted">(@project?.Code)</small></h1>
    <a asp-controller="Projects" asp-action="Details" asp-route-id="@project?.Id" class="btn athar-btn-outline">العودة إلى المشروع</a>
</div>

<div class="athar-card mt-3">
    <div class="table-responsive">
        <table class="table athar-table align-middle">
            <thead>
                <tr>
                    <th>نوع التكلفة</th>
                    <th>المرحلة</th>
                    <th>المهندسة الرئيسية</th>
                    <th>المهندسة المساعدة</th>
                    <th>المساحة (م²)</th>
                    <th>السعر/م²</th>
                    <th>المبلغ النهائي</th>
                    <th>عاجل</th>
                    <th>الحالة</th>
                    <th>مرحّل للمالية</th>
                    @if (canEdit)
                    {
                        <th>إجراءات</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted">لا توجد تكليفات بعد</td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            @a.CostType
                            @if (!string.IsNullOrEmpty(a.Description))
                            {
                                <br /><small class="text-muted">@a.Description</small>
                            }
                        </td>
                        <td>@(a.Stage?.Name ?? "-")</td>
                        <td>@(a.LeadEngineer?.FullName ?? "-")</td>
                        <td>@(a.AssistantEngineer?.FullName ?? "-")</td>
                        <td>@(a.Area?.ToString("N2") ?? "-")</td>
                        <td>@(a.PricePerMeter?.ToString("N2") ?? "-")</td>
                        <td><strong>@a.FinalAmount.ToString("N2")</strong></td>
                        <td>@(a.IsUrgent ? "نعم" : "لا")</td>
                        <td>
                            @if (canEdit)
                            {
                                <form method="post" asp-action="Edit" asp-route-id="@a.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="CostType" value="@a.CostType" />
                                    <input type="hidden" name="Description" value="@a.Description" />
                                    <input type="hidden" name="Area" value="@a.Area" />
                                    <input type="hidden" name="PricePerMeter" value="@a.PricePerMeter" />
                                    <input type="hidden" name="Amount" value="@a.Amount" />
                                    <input type="hidden" name="DiscountOrAdditionPercent" value="@a.DiscountOrAdditionPercent" />
                                    <input type="hidden" name="IsUrgent" value="@a.IsUrgent" />
                                    <input type="hidden" name="LeadEngineerId" value="@a.LeadEngineerId" />
                                    <input type="hidden" name="AssistantEngineerId" value="@a.AssistantEngineerId" />
                                    <input type="hidden" name="ReceivedDate" value="@a.ReceivedDate?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="AgreedDate" value="@a.AgreedDate?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="ActualDate" value="@a.ActualDate?.ToString("yyyy-MM-dd")" />
                                    <select name="Status" class="form-select form-select-sm" onchange="this.form.submit()" @(a.IsTransferredToFinance ? "disabled" : "")>
                                        <option value="Pending" selected="@(a.Status == AssignmentStatus.Pending)">معلق</option>
                                        <option value="InProgress" selected="@(a.Status == AssignmentStatus.InProgress)">قيد التنفيذ</option>
                                        <option value="Completed" selected="@(a.Status == AssignmentStatus.Completed)">مكتمل</option>
                                        <option value="Cancelled" selected="@(a.Status == AssignmentStatus.Cancelled)">ملغى</option>
                                    </select>
                                </form>
                            }
                            else
                            {
                                @StatusLabel(a.Status)
                            }
                        </td>
                        <td>@(a.IsTransferredToFinance ? "نعم" : "لا")</td>
                        @if (canEdit)
                        {
                            <td>
                                @if (!a.IsTransferredToFinance)
                                {
                                    <form method="post" asp-action="Delete" asp-route-id="@a.Id" class="d-inline"
                                          onsubmit="return confirm('حذف هذا التكليف؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                    @if (a.Subtasks.Any() || canEdit)
                    {
                        <tr>
                            <td colspan="11">
                                <div class="ps-3">
                                    <small class="text-muted">مهام فرعية:</small>
                                    <ul class="list-unstyled mb-1">
                                        @foreach (var st in a.Subtasks)
                                        {
                                            <li class="d-flex align-items-center gap-2">
                                                @if (canEdit)
                                                {
                                                    <form method="post" asp-action="ToggleSubtask" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@st.Id" />
                                                        <input type="hidden" name="projectId" value="@project?.Id" />
                                                        <button type="submit" class="btn btn-sm @(st.IsCompleted ? "btn-success" : "btn-outline-secondary")">@(st.IsCompleted ? "✓" : "○")</button>
                                                    </form>
                                                }
                                                <span class="@(st.IsCompleted ? "text-decoration-line-through text-muted" : "")">@st.Name</span>
                                                @if (canEdit)
                                                {
                                                    <form method="post" asp-action="DeleteSubtask" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@st.Id" />
                                                        <input type="hidden" name="projectId" value="@project?.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                                    </form>
                                                }
                                            </li>
                                        }
                                    </ul>
                                    @if (canEdit)
                                    {
                                        <form method="post" asp-action="AddSubtask" class="row g-2 align-items-end">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="projectAssignmentId" value="@a.Id" />
                                            <div class="col-md-6">
                                                <input type="text" name="name" class="form-control form-control-sm" placeholder="اسم المهمة الفرعية" required />
                                            </div>
                                            <div class="col-md-3">
                                                <button type="submit" class="btn btn-sm athar-btn-outline">+ إضافة</button>
                                            </div>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (canEdit)
    {
        <hr />
        <h6>إضافة تكليف جديد</h6>
        <form method="post" asp-action="Create" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProjectId" value="@project?.Id" />
            <div class="col-md-2">
                <label class="form-label">نوع التكلفة</label>
                <input type="text" name="CostType" class="form-control form-control-sm" placeholder="معماري، إنشائي..." required />
            </div>
            <div class="col-md-2">
                <label class="form-label">الوصف</label>
                <input type="text" name="Description" class="form-control form-control-sm" />
            </div>
            <div class="col-md-1">
                <label class="form-label">المساحة م²</label>
                <input type="number" step="0.01" min="0" name="Area" class="form-control form-control-sm" />
            </div>
            <div class="col-md-1">
                <label class="form-label">السعر/م²</label>
                <input type="number" step="0.01" min="0" name="PricePerMeter" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label">المبلغ (إن لم يُحسب من المساحة)</label>
                <input type="number" step="0.01" min="0" name="Amount" class="form-control form-control-sm" value="0" />
            </div>
            <div class="col-md-1">
                <label class="form-label">الخصم/الإضافة %</label>
                <input type="number" step="0.01" name="DiscountOrAdditionPercent" class="form-control form-control-sm" value="0" />
            </div>
            <div class="col-md-1 form-check ms-2">
                <input type="checkbox" name="IsUrgent" value="true" class="form-check-input" id="isUrgentNew" />
                <label class="form-check-label" for="isUrgentNew">عاجل</label>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة</button>
            </div>
        </form>
    }
</div>