@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model ProjectAssignment
@{
    ViewData["Title"] = "بيانات التكليف";
    var isSysAdmin = ViewBag.IsSysAdmin as bool? ?? false;
    var statusLabels = EnumDisplayHelper.GetDisplayList<AssignmentStatus>();
    var priorityLabels = EnumDisplayHelper.GetDisplayList<TaskPriority>();
    var totalTasks = Model.Tasks.Count;
    var completedTasks = Model.Tasks.Count(t => t.Status == ProjectTaskStatus.Completed);
    var progressPct = totalTasks > 0 ? Math.Round((decimal)completedTasks / totalTasks * 100, 0) : 0;
    var selectedTaskId = ViewBag.SelectedTaskId as int?;
    var canEdit = ViewBag.CanEdit as bool? ?? false;
}
@if (!canEdit)
{
    <div style="margin-bottom:12px; padding:9px 14px; border:1px solid #e1defa; background:#f3f1fb; border-radius:8px; font-size:12px; color:#5a4bb0;">
        أنتِ تعرضين هذا التكليف فقط — التعديل متاح فقط للمهندسة/المهندس المكلَّف به مباشرة.
    </div>
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px;">
    <div>
        <div style="font-size:11px; color:#8a83a0; font-weight:500;">@(Model.Stage?.Project != null ? $"{Model.Stage.Project.Code} - {Model.Stage.Project.Name}" : "") — @Model.Stage?.Name</div>
        <div style="font-size:19px; font-weight:600; margin-top:2px;">بيانات التكليف</div>

    </div>
    <a asp-controller="ProjectAssignments" asp-action="MyAssignments" class="btn-line">رجوع لتكليفاتي</a>
</div>

<div class="stat-strip stat-strip-text">
    <div class="stat-item"><span class="kicker">حالة التكليف</span><span class="stat-value">@statusLabels.FirstOrDefault(x => x.Value == Model.Status.ToString()).Label</span></div>
    <div class="stat-item"><span class="kicker">نسبة الإنجاز</span><span class="stat-value">@progressPct%</span></div>
    <div class="stat-item"><span class="kicker">المهام المكتملة</span><span class="stat-value">@completedTasks / @totalTasks</span></div>
    @if (Model.Status == AssignmentStatus.Completed)
    {
        var lastDelivery = Model.Tasks.Where(t => t.ActualDeliveryDate.HasValue).Select(t => t.ActualDeliveryDate!.Value).DefaultIfEmpty().Max();
        if (lastDelivery != default)
        {
            <div class="stat-item"><span class="kicker">تاريخ التسليم الفعلي</span><span class="stat-value" style="color:#2f8a57;">@lastDelivery.ToString("yyyy-MM-dd")</span></div>
        }
    }
</div>

<div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px; margin-bottom:12px;">
    <div style="font-size:13.5px; font-weight:700; margin-bottom:10px;">بيانات التكليف</div>
    <form method="post" asp-controller="ProjectAssignments" asp-action="EditDates" style="display:grid; grid-template-columns:1fr 1fr 1fr auto; gap:8px; align-items:end; margin-bottom:10px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div>
            <label style="font-size:10.5px; color:#8a83a0;">بيان التكليف</label>
            <input type="text" name="AssignmentType" value="@Model.AssignmentType" disabled="@(!isSysAdmin)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
        </div>
        <div>
            <label style="font-size:10.5px; color:#8a83a0;">تاريخ بداية التكليف</label>
            <input type="date" name="PlannedStartDate" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" disabled="@(!isSysAdmin)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
        </div>
        <div>
            <label style="font-size:10.5px; color:#8a83a0;">تاريخ نهاية التكليف</label>
            <input type="date" name="PlannedEndDate" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" disabled="@(!isSysAdmin)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
        </div>
        @if (isSysAdmin)
        {
            <button type="submit" class="btn-line btn-line-accent" style="height:32px;">حفظ</button>
        }
    </form>
    <div>
        <label style="font-size:10.5px; color:#8a83a0; display:block; margin-bottom:6px;">المهندسات معك</label>
        <div style="display:flex; gap:6px; flex-wrap:wrap;">
            @foreach (var eng in Model.Engineers)
            {
                <span style="background:#f3f1fb; border:1px solid #e1defa; color:#5a5370; border-radius:20px; padding:4px 10px; font-size:11.5px;">@eng.User.FullName</span>
            }
        </div>
    </div>
    @if (isSysAdmin && Model.Status != AssignmentStatus.Completed)
    {
        <div style="margin-top:14px; padding-top:12px; border-top:1px dashed #e4e2ec;">
            <form method="post" asp-controller="ProjectAssignments" asp-action="AdminForceComplete"
                  onsubmit="return confirm('سيُنهى هذا التكليف مباشرة بدون المرور بالمراجعات، ويُرحَّل فوراً للمالية. هل تريدين المتابعة؟');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-line" style="color:#c9a15a; border-color:#c9a15a;">إنهاء تكليف</button>
            </form>
        </div>
    }
</div>

<div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04);">
    <div style="display:flex; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid #f1f0f6; flex-wrap:wrap; gap:8px;">
        <div style="font-size:13.5px; font-weight:700;">بنود المهمة</div>
        @if (Model.Tasks.Any())
        {
            <select id="taskFilterSelect" onchange="filterTodosByTask()" style="height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 10px; font-size:12px;">
                @foreach (var t in Model.Tasks)
                {
                    <option value="@t.Id" selected="@(selectedTaskId == t.Id)">@t.Title</option>
                }
            </select>
        }
    </div>

    <div style="padding:4px 18px 14px;">
        @if (!Model.Tasks.Any())
        {
            <div style="padding:16px 0; text-align:center; color:#8a83a0; font-size:12px;">لا توجد مهام مرتبطة بهذا التكليف بعد</div>
        }
        else
        {
            @foreach (var t in Model.Tasks)
            {
                <div data-task-group="@t.Id" hidden>
                    <div style="display:flex; gap:14px; align-items:center; padding:8px 0 12px; font-size:11px; color:#5a5370;">
                        <span><span style="color:#8a83a0;">بيانات المهمة — الأولوية:</span> <strong>@priorityLabels.FirstOrDefault(x => x.Value == t.Priority.ToString()).Label</strong></span>
                        @if (t.IsUrgent)
                        {
                            <span class="tag tag-danger">عاجلة</span>
                        }
                    </div>

                    @if (!t.IsSupply)
                    {
                        <div style="display:grid; grid-template-columns:minmax(140px,2fr) 80px 80px minmax(150px,1fr) 95px 95px 95px 32px; gap:8px; padding:8px 0; font-size:10.5px; color:#8a83a0; font-weight:600; border-bottom:1px solid #f1f0f6;">
                        <div>نص البند</div><div>التصنيف</div><div>نوع الملف</div><div>رفع مستند</div><div>تاريخ الرفع</div><div>تاريخ المراجعة</div><div>الحالة</div><div></div>
                    </div>

                    @if (!t.Todos.Any())
                    {
                        <div style="padding:16px 0; text-align:center; color:#8a83a0; font-size:12px;">لا توجد بنود لهذه المهمة بعد</div>
                    }
                    else
                    {
                        @foreach (var todo in t.Todos)
                        {
                            var docs = todo.DesignProposals;
                            var latestDoc = docs.OrderByDescending(d => d.Revision).FirstOrDefault();
                            bool isTodoApproved = latestDoc != null && latestDoc.Status == ProposalStatus.Approved;
                            string statusLabel = !docs.Any() ? "بانتظار الرفع" : (isTodoApproved ? "مكتمل" : "قيد المراجعة");
                            string statusClass = !docs.Any() ? "tag-warning" : (isTodoApproved ? "tag-success" : "tag-accent");
                            <div style="display:grid; grid-template-columns:minmax(140px,2fr) 80px 80px minmax(150px,1fr) 95px 95px 95px 32px; gap:8px; align-items:center; padding:8px 0; border-bottom:1px solid #f6f5fa;">
                                <div style="font-size:12px; font-weight:500;">@todo.Item</div>

                                <form method="post" asp-controller="DesignProposals" asp-action="Upload" enctype="multipart/form-data" style="display:contents;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="todoId" value="@todo.Id" />
                                    <input type="hidden" name="assignmentId" value="@Model.Id" />
                                    <div style="height:30px; display:flex; align-items:center; font-size:10.5px; font-weight:600;" title="التصنيف تلقائي حسب تخصص المرحلة">
                                        @if (ViewBag.StageDiscipline is Department stageDiscipline)
                                        {
                                            <span>@stageDiscipline.Code</span>
                                        }
                                        else
                                        {
                                            <span style="color:#c94a42;">⚠ لا تخصص</span>
                                        }
                                    </div>
                                        <select name="fileCategory" required disabled="@(!canEdit)" style="height:30px; border:1px solid #e4e2ec; border-radius:7px; font-size:10.5px;">
                                            <option value="">--</option>
                                            <option value="DG">DG</option>
                                            <option value="PH">PH</option>
                                            <option value="RE">RE</option>
                                            <option value="REQ">REQ</option>
                                        </select>
                                        <div style="display:flex; gap:4px; align-items:center;">
                                            <input type="file" name="file" required disabled="@(!canEdit)" style="font-size:10px; max-width:110px;" />
                                            <button type="submit" disabled="@(!canEdit)" style="height:28px; padding:0 8px; border:none; border-radius:6px; background:#7b6bd6; color:#fff; font-size:10.5px; white-space:nowrap;">رفع</button>
                                        </div>
                                                              </form>

                                <div style="font-size:10.5px; color:#5a5370;">@(latestDoc?.SubmittedDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                                <div style="font-size:10.5px; color:#5a5370;">@(latestDoc?.Reviews.OrderByDescending(r => r.ReviewDate).FirstOrDefault()?.ReviewDate.ToString("yyyy-MM-dd") ?? "-")</div>

                                <div><span class="tag @statusClass">@statusLabel</span></div>

                                @if (ViewBag.CanManageTasks as bool? ?? false)
                                {
                                    <form method="post" asp-controller="ProjectTasks" asp-action="RemoveTodo" style="display:contents;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@todo.Id" />
                                        <input type="hidden" name="taskId" value="@t.Id" />
                                        <input type="hidden" name="assignmentId" value="@Model.Id" />
                                        <button type="submit" style="border:none; background:none; color:#c94a42; font-size:14px; cursor:pointer;">×</button>
                                    </form>
                                }
                            </div>
                        }
                            }
                        @if (canEdit)
                        {
                            <form method="post" asp-controller="ProjectTasks" asp-action="AddTodo" style="display:flex; gap:8px; margin-top:12px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taskId" value="@t.Id" />
                                <input type="hidden" name="assignmentId" value="@Model.Id" />
                                <input type="text" name="item" placeholder="نص البند" required style="flex:1; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                                <button type="submit" style="height:32px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:11.5px; font-weight:600; padding:0 14px;">+ إضافة بند</button>
                            </form>
                        }
                    }
                    else
                    {
                        var latestSupplyRequest = t.SupplyRequests.OrderByDescending(r => r.RequestDate).FirstOrDefault();
                        string supplyStatusLabel = latestSupplyRequest?.Status switch
                        {
                            SiteSupplyStatus.Pending => "معلّق",
                            SiteSupplyStatus.Approved => "تمت الموافقة",
                            SiteSupplyStatus.Delivered => "تم التسليم",
                            SiteSupplyStatus.Rejected => "مرفوض",
                            _ => "-"
                        };
                        string supplyStatusClass = latestSupplyRequest?.Status switch
                        {
                            SiteSupplyStatus.Approved => "tag-accent",
                            SiteSupplyStatus.Delivered => "tag-success",
                            SiteSupplyStatus.Rejected => "tag-danger",
                            _ => "tag-warning"
                        };
                        if (latestSupplyRequest != null && latestSupplyRequest.Status != SiteSupplyStatus.Rejected)
                        {
                            <div style="padding:14px 0; font-size:12px;">
                                حالة طلب التوريد: <span class="tag @supplyStatusClass">@supplyStatusLabel</span>
                                <div style="color:#8a83a0; font-size:11px; margin-top:4px;">بانتظار اعتماد/تسليم الطلب من مدير الموقع — تُقفل هذه المهمة تلقائياً عند التسليم</div>
                            </div>
                        }
                        else
                        {
                            if (latestSupplyRequest != null && latestSupplyRequest.Status == SiteSupplyStatus.Rejected && canEdit)
                            {
                                <div style="color:#c94a42; font-size:11.5px; margin:10px 0 4px;">رُفض طلب التوريد السابق — يمكنك إرسال طلب جديد أدناه</div>
                            }
                            @if (canEdit)
                            {
                                <form method="post" asp-controller="SiteSupplyRequests" asp-action="CreateFromTask" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:8px; margin-top:8px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="projectTaskId" value="@t.Id" />
                                <input type="hidden" name="assignmentId" value="@Model.Id" />
                                <div id="supplyItemsContainer-@t.Id" style="display:flex; flex-direction:column; gap:8px;">
                                    <div class="supply-item-row" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end; border-bottom:1px dashed #e4e2ec; padding-bottom:8px;">
                                        <div style="min-width:160px;">
                                            <label style="font-size:11px; color:#8a83a0;">التصنيف</label>
                                            <select class="form-select form-select-sm materialCategorySelect" onchange="onSupplyCategoryChange(this)">
                                                <option value="">-- اختاري تصنيفاً --</option>
                                                @foreach (var cat in (ViewBag.MaterialCategories as List<MaterialCategory> ?? new List<MaterialCategory>()))
                                                {
                                                    <option value="@cat.Id">@cat.NameAr</option>
                                                }
                                            </select>
                                        </div>
                                        <div style="min-width:180px;">
                                            <label style="font-size:11px; color:#8a83a0;">المادة</label>
                                            <select name="materialItemIds" class="form-select form-select-sm materialItemSelect" required>
                                                <option value="">-- اختاري تصنيفاً أولاً --</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label style="font-size:11px; color:#8a83a0;">الكمية</label>
                                            <input type="number" step="0.01" name="quantities" class="form-control form-control-sm" style="max-width:90px;" required />
                                        </div>
                                        <div>
                                            <label style="font-size:11px; color:#8a83a0;">الوحدة</label>
                                            <input type="text" name="units" class="form-control form-control-sm" style="max-width:90px;" required />
                                        </div>
                                        <div>
                                            <label style="font-size:11px; color:#8a83a0;">المورّد (اختياري)</label>
                                            <select name="vendorIds" class="form-select form-select-sm">
                                                <option value="">-- بلا --</option>
                                                @foreach (var v in (ViewBag.Vendors as List<Vendor> ?? new List<Vendor>()))
                                                {
                                                    <option value="@v.Id">@v.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <label style="font-size:11px; color:#8a83a0;">صورة</label>
                                            <input type="file" name="photos" accept="image/*" class="form-control form-control-sm" />
                                        </div>
                                        <div style="flex:1; min-width:140px;">
                                            <label style="font-size:11px; color:#8a83a0;">ملاحظات المادة</label>
                                            <input type="text" name="itemNotes" class="form-control form-control-sm" />
                                        </div>
                                        <button type="button" class="btn-line" onclick="removeSupplyItemRow(this)" style="color:#c94a42;">حذف</button>
                                    </div>
                                </div>
                                <div style="display:flex; gap:8px; align-items:end; justify-content:space-between; flex-wrap:wrap;">
                                    <button type="button" class="btn-line" onclick="addSupplyItemRow('@t.Id')">+ إضافة مادة أخرى</button>
                                    <div style="flex:1; min-width:160px;">
                                        <label style="font-size:11px; color:#8a83a0;">ملاحظات عامة على الطلب</label>
                                        <input type="text" name="notes" class="form-control form-control-sm" />
                                    </div>
                                        <button type="submit" class="btn-line btn-line-accent">+ إرسال طلب التوريد</button>
                                    </div>
                                </form>
                            }
                        }
                    }
                </div>
            }
        }
    </div>
</div>
@if (canEdit)
{
<div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px; margin-top:12px;">
    <div style="font-size:13.5px; font-weight:700; margin-bottom:10px;">قائمتي الشخصية</div>

    <form method="post" asp-controller="ProjectAssignments" asp-action="AddChecklistItem" style="display:flex; gap:8px; margin-bottom:10px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="assignmentId" value="@Model.Id" />
        <input type="text" name="text" placeholder="أضيفي عنصرًا..." required style="flex:1; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 10px; font-size:12px;" />
        <button type="submit" style="height:32px; padding:0 16px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:12px; font-weight:600;">إضافة</button>
    </form>

    @{
        var myChecklist = ViewBag.MyChecklist as List<PersonalChecklistItem> ?? new List<PersonalChecklistItem>();
    }
    @if (!myChecklist.Any())
    {
        <div style="padding:10px 0; text-align:center; color:#8a83a0; font-size:12px;">لا توجد عناصر بعد</div>
    }
    else
    {
        <div style="display:grid; gap:6px;">
            @foreach (var item in myChecklist)
            {
                <div style="display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid #f6f5fa;">
                    <form method="post" asp-controller="ProjectAssignments" asp-action="ToggleChecklistItem" style="display:contents;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="assignmentId" value="@Model.Id" />
                        <input type="checkbox" class="chk-gold" checked="@item.IsChecked" onchange="this.form.submit()" />
                    </form>
                    <span style="flex:1; font-size:12px; text-decoration:@(item.IsChecked ? "line-through" : "none"); color:@(item.IsChecked ? "#8a83a0" : "inherit");">@item.Text</span>
                    <form method="post" asp-controller="ProjectAssignments" asp-action="DeleteChecklistItem" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="assignmentId" value="@Model.Id" />
                        <button type="submit" style="border:none; background:none; color:#c94a42; font-size:13px; cursor:pointer;">×</button>
                    </form>
                </div>
            }
        </div>
        }
    </div>
}
@section Scripts {
    <script src="~/js/tab-persist.js" asp-append-version="true"></script>
    <script>
        const allMaterialItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.MaterialItems as List<MaterialItem> ?? new List<MaterialItem>()).Select(m => new { id = m.Id, name = m.Name, categoryId = m.MaterialCategoryId })));

        function onSupplyCategoryChange(select) {
            var row = select.closest('.supply-item-row');
            var categoryId = parseInt(select.value);
            var materialSelect = row.querySelector('.materialItemSelect');
            materialSelect.innerHTML = '<option value="">-- اختاري مادة --</option>';
            allMaterialItems.filter(function (m) { return m.categoryId === categoryId; }).forEach(function (m) {
                var opt = document.createElement('option');
                opt.value = m.id;
                opt.textContent = m.name;
                materialSelect.appendChild(opt);
            });
        }

        function addSupplyItemRow(taskId) {
            var container = document.getElementById('supplyItemsContainer-' + taskId);
            var first = container.querySelector('.supply-item-row');
            var clone = first.cloneNode(true);
            clone.querySelectorAll('input, select').forEach(function (el) {
                if (el.type === 'file') { el.value = ''; }
                else if (el.tagName === 'SELECT') { el.selectedIndex = 0; }
                else { el.value = ''; }
            });
            clone.querySelector('.materialItemSelect').innerHTML = '<option value="">-- اختاري تصنيفاً أولاً --</option>';
            container.appendChild(clone);
        }
        function removeSupplyItemRow(btn) {
            var container = btn.closest('[id^="supplyItemsContainer-"]');
            if (container.querySelectorAll('.supply-item-row').length > 1) {
                btn.closest('.supply-item-row').remove();
            }
        }

        function filterTodosByTask() {
            var sel = document.getElementById('taskFilterSelect');
            if (!sel) return;
            var val = sel.value;
            document.querySelectorAll('[data-task-group]').forEach(function (el) {
                el.hidden = el.getAttribute('data-task-group') !== val;
            });
        }
        filterTodosByTask();
    </script>
}