@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model ProjectAssignment
@{
    ViewData["Title"] = "بيانات التكليف";
    var isSysAdmin = ViewBag.IsSysAdmin as bool? ?? false;
    var statusLabels = EnumDisplayHelper.GetDisplayList<AssignmentStatus>();
    var totalTasks = Model.Tasks.Count;
    var completedTasks = Model.Tasks.Count(t => t.Status == ProjectTaskStatus.Completed);
    var progressPct = totalTasks > 0 ? Math.Round((decimal)completedTasks / totalTasks * 100, 0) : 0;
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px;">
    <div>
        <div style="font-size:11px; color:#8a83a0; font-weight:500;">@Model.Stage?.Project?.Name — @Model.Stage?.Name</div>
        <div style="font-size:19px; font-weight:600; margin-top:2px;">بيانات التكليف</div>
    </div>
    <a asp-controller="ProjectAssignments" asp-action="MyAssignments" class="btn-line">رجوع لتكليفاتي</a>
</div>

<div class="stat-strip stat-strip-text">
    <div class="stat-item"><span class="kicker">حالة التكليف</span><span class="stat-value">@statusLabels.FirstOrDefault(x => x.Value == Model.Status.ToString()).Label</span></div>
    <div class="stat-item"><span class="kicker">نسبة الإنجاز</span><span class="stat-value">@progressPct%</span></div>
    <div class="stat-item"><span class="kicker">المهام المكتملة</span><span class="stat-value">@completedTasks / @totalTasks</span></div>
    @if (Model.Status == AssignmentStatus.Completed)
    {
        var lastDelivery = Model.Tasks.Where(t => t.ActualDeliveryDate.HasValue).Select(t => t.ActualDeliveryDate!.Value).DefaultIfEmpty().Max();
        if (lastDelivery != default)
        {
            <div class="stat-item"><span class="kicker">تاريخ التسليم الفعلي</span><span class="stat-value" style="color:#2f8a57;">@lastDelivery.ToString("yyyy-MM-dd")</span></div>
        }
    }
</div>

<div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px; margin-bottom:12px;">
    <div style="font-size:13.5px; font-weight:700; margin-bottom:10px;">بيانات التكليف</div>
    <form method="post" asp-controller="ProjectAssignments" asp-action="EditDates" style="display:grid; grid-template-columns:1fr 1fr 1fr auto; gap:8px; align-items:end; margin-bottom:10px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div>
            <label style="font-size:10.5px; color:#8a83a0;">بيان التكليف</label>
            <input type="text" name="CostType" value="@Model.CostType" disabled="@(!isSysAdmin)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
        </div>
        <div>
            <label style="font-size:10.5px; color:#8a83a0;">تاريخ بداية التكليف</label>
            <input type="date" name="PlannedStartDate" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" disabled="@(!isSysAdmin)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
        </div>
        <div>
            <label style="font-size:10.5px; color:#8a83a0;">تاريخ نهاية التكليف</label>
            <input type="date" name="PlannedEndDate" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" disabled="@(!isSysAdmin)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
        </div>
        @if (isSysAdmin)
        {
            <button type="submit" class="btn-line btn-line-accent" style="height:32px;">حفظ</button>
        }
    </form>
    <div>
        <label style="font-size:10.5px; color:#8a83a0; display:block; margin-bottom:6px;">المهندسات معك</label>
        <div style="display:flex; gap:6px; flex-wrap:wrap;">
            @foreach (var eng in Model.Engineers)
            {
                <span style="background:#f3f1fb; border:1px solid #e1defa; color:#5a5370; border-radius:20px; padding:4px 10px; font-size:11.5px;">@eng.User.FullName</span>
            }
        </div>
    </div>
</div>

<div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04);">
    <div style="display:flex; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid #f1f0f6; flex-wrap:wrap; gap:8px;">
        <div style="font-size:13.5px; font-weight:700;">بنود المهمة</div>
        @if (Model.Tasks.Any())
        {
            <select id="taskFilterSelect" onchange="filterTodosByTask()" style="height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 10px; font-size:12px;">
                @foreach (var t in Model.Tasks)
                {
                    <option value="@t.Id">@t.Title</option>
                }
            </select>
        }
    </div>

    <div style="padding:4px 18px 14px;">
        @if (!Model.Tasks.Any())
        {
            <div style="padding:16px 0; text-align:center; color:#8a83a0; font-size:12px;">لا توجد مهام مرتبطة بهذا التكليف بعد</div>
        }
        else
        {
            @foreach (var t in Model.Tasks)
            {
                <div data-task-group="@t.Id" hidden>
                    <div style="display:grid; grid-template-columns:minmax(160px,2fr) 100px 100px minmax(160px,1fr) 110px 40px; gap:8px; padding:8px 0; font-size:10.5px; color:#8a83a0; font-weight:600; border-bottom:1px solid #f1f0f6;">
                        <div>نص البند</div><div>التصنيف</div><div>نوع الملف</div><div>رفع مستند</div><div>الحالة</div><div></div>
                    </div>

                    @if (!t.Todos.Any())
                    {
                        <div style="padding:16px 0; text-align:center; color:#8a83a0; font-size:12px;">لا توجد بنود لهذه المهمة بعد</div>
                    }
                    else
                    {
                        @foreach (var todo in t.Todos)
                        {
                            var docs = todo.DesignProposals;
                            string statusLabel = !docs.Any() ? "بانتظار الرفع" : (docs.All(d => d.Status == ProposalStatus.Approved) ? "مكتمل" : "قيد المراجعة");
                            string statusClass = !docs.Any() ? "tag-warning" : (docs.All(d => d.Status == ProposalStatus.Approved) ? "tag-success" : "tag-accent");
                            <div style="display:grid; grid-template-columns:minmax(160px,2fr) 100px 100px minmax(160px,1fr) 110px 40px; gap:8px; align-items:center; padding:8px 0; border-bottom:1px solid #f6f5fa;">
                                <div style="font-size:12px; font-weight:500;">@todo.Item</div>

                                <form method="post" asp-controller="DesignProposals" asp-action="Upload" enctype="multipart/form-data" style="display:contents;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="todoId" value="@todo.Id" />
                                    <input type="hidden" name="assignmentId" value="@Model.Id" />
                                    <select name="classification" required style="height:30px; border:1px solid #e4e2ec; border-radius:7px; font-size:10.5px;">
                                        <option value="">--</option>
                                        <option value="AA">AA</option>
                                        <option value="IN">IN</option>
                                        <option value="SE">SE</option>
                                        <option value="ME">ME</option>
                                        <option value="EE">EE</option>
                                    </select>
                                    <select name="fileCategory" required style="height:30px; border:1px solid #e4e2ec; border-radius:7px; font-size:10.5px;">
                                        <option value="">--</option>
                                        <option value="DG">DG</option>
                                        <option value="PH">PH</option>
                                        <option value="RE">RE</option>
                                        <option value="REQ">REQ</option>
                                    </select>
                                    <div style="display:flex; gap:4px; align-items:center;">
                                        <input type="file" name="file" required style="font-size:10px; max-width:110px;" />
                                        <button type="submit" style="height:28px; padding:0 8px; border:none; border-radius:6px; background:#7b6bd6; color:#fff; font-size:10.5px; white-space:nowrap;">رفع</button>
                                    </div>
                                </form>

                                <div><span class="tag @statusClass">@statusLabel</span></div>

                                <form method="post" asp-controller="ProjectTasks" asp-action="RemoveTodo" style="display:contents;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@todo.Id" />
                                    <input type="hidden" name="taskId" value="@t.Id" />
                                    <input type="hidden" name="assignmentId" value="@Model.Id" />
                                    <button type="submit" style="border:none; background:none; color:#c94a42; font-size:14px; cursor:pointer;">×</button>
                                </form>
                            </div>
                        }
                    }

                    <form method="post" asp-controller="ProjectTasks" asp-action="AddTodo" style="display:flex; gap:8px; margin-top:12px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="taskId" value="@t.Id" />
                        <input type="hidden" name="assignmentId" value="@Model.Id" />
                        <input type="text" name="item" placeholder="نص البند" required style="flex:1; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                        <button type="submit" style="height:32px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:11.5px; font-weight:600; padding:0 14px;">+ إضافة بند</button>
                    </form>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/tab-persist.js" asp-append-version="true"></script>
    <script>
        function filterTodosByTask() {
            var sel = document.getElementById('taskFilterSelect');
            if (!sel) return;
            var val = sel.value;
            document.querySelectorAll('[data-task-group]').forEach(function (el) {
                el.hidden = el.getAttribute('data-task-group') !== val;
            });
        }
        filterTodosByTask();
    </script>
}