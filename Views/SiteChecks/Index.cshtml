@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteQualityCheck>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    var safetyChecks = ViewBag.SafetyChecks as List<SiteSafetyCheck> ?? new List<SiteSafetyCheck>();
    ViewData["Title"] = $"فحوصات الجودة والسلامة - {site?.Name}";
    var canApprove = await PermissionService.HasPermissionAsync(User, "Quality.Approve");

    string QualityTypeLabel(SiteQualityType t) => t switch
    {
        SiteQualityType.Technical => "جودة فنية",
        SiteQualityType.Site => "جودة موقع",
        SiteQualityType.Financial => "جودة مالية",
        SiteQualityType.Administrative => "جودة إدارية",
        _ => t.ToString()
    };

    string ResultLabel(QualityCheckResult r) => r switch
    {
        QualityCheckResult.Pending => "معلق",
        QualityCheckResult.Pass => "مطابق",
        QualityCheckResult.Fail => "غير مطابق",
        QualityCheckResult.NeedsReview => "يحتاج مراجعة",
        _ => r.ToString()
    };

    string ResultTagClass(QualityCheckResult r) => r switch
    {
        QualityCheckResult.Pass => "tag-success",
        QualityCheckResult.Fail => "tag-danger",
        QualityCheckResult.NeedsReview => "tag-warning",
        _ => "tag-muted"
    };

    string SafetyLabel(SafetyResult r) => r switch
    {
        SafetyResult.Safe => "آمن",
        SafetyResult.Warning => "تحذير",
        SafetyResult.Danger => "خطير",
        _ => r.ToString()
    };

    string SafetyTagClass(SafetyResult r) => r switch
    {
        SafetyResult.Safe => "tag-success",
        SafetyResult.Warning => "tag-warning",
        SafetyResult.Danger => "tag-danger",
        _ => "tag-muted"
    };
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@site?.Code</div>
        <h1 class="athar-page-title" style="margin-top:2px;">فحوصات الجودة والسلامة - @site?.Name</h1>
    </div>
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn-line">العودة للموقع</a>
</div>

<div style="font-size:13.5px; font-weight:600; margin-bottom:8px;">فحوصات الجودة</div>
<div class="data-table" style="--cols: 100px 1fr 110px 130px 130px @(canApprove ? "220px" : "");">
    <div class="data-table-head">
        <div class="cell">النوع</div>
        <div class="cell">نوع الفحص</div>
        <div class="cell">النتيجة</div>
        <div class="cell">فحصه</div>
        <div class="cell">اعتُمد</div>
        @if (canApprove)
        {
            <div class="cell">إجراء</div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد فحوصات جودة بعد</div></div>
    }
    else
    {
        @foreach (var q in Model)
        {
            <div class="data-table-row">
                <div class="cell">@QualityTypeLabel(q.QualityType)</div>
                <div class="cell">@q.CheckType</div>
                <div class="cell"><span class="tag @ResultTagClass(q.Result)">@ResultLabel(q.Result)</span></div>
                <div class="cell">@(q.CheckedBy?.FullName ?? q.CheckedByContractor?.Name ?? "-")</div>
                <div class="cell">@(q.IsApproved ? $"نعم - {q.ApprovedBy?.FullName}" : "لا")</div>
                @if (canApprove)
                {
                    <div class="cell">
                        @if (!q.IsApproved)
                        {
                            <form method="post" asp-action="ApproveQualityCheck" style="display:flex; gap:4px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@q.Id" />
                                <select name="result" class="form-select form-select-sm">
                                    <option value="Pass">مطابق</option>
                                    <option value="Fail">غير مطابق</option>
                                    <option value="NeedsReview">يحتاج مراجعة</option>
                                </select>
                                <button type="submit" class="btn-line btn-line-accent">اعتماد</button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px; margin-top:12px; margin-bottom:20px;">
    <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">إضافة فحص جودة جديد</div>
    <form method="post" asp-action="CreateQualityCheck" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SiteId" value="@site?.Id" />
        <div>
            <label class="form-label" style="font-size:11px;">نوع الجودة</label>
            <select name="QualityType" class="form-select form-select-sm">
                <option value="Technical">جودة فنية</option>
                <option value="Site" selected>جودة موقع</option>
                <option value="Financial">جودة مالية</option>
                <option value="Administrative">جودة إدارية</option>
            </select>
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">نوع الفحص</label>
            <input type="text" name="CheckType" class="form-control form-control-sm" required />
        </div>
        <div style="flex:1; min-width:200px;">
            <label class="form-label" style="font-size:11px;">الوصف</label>
            <input type="text" name="Description" class="form-control form-control-sm" />
        </div>
        <button type="submit" class="btn-line btn-line-accent">+ إضافة فحص جودة</button>
    </form>
</div>

<div style="font-size:13.5px; font-weight:600; margin-bottom:8px;">فحوصات السلامة</div>
<div class="data-table" style="--cols: 1fr 110px 130px 90px @(canApprove ? "220px" : "");">
    <div class="data-table-head">
        <div class="cell">نوع الفحص</div>
        <div class="cell">النتيجة</div>
        <div class="cell">فحصه</div>
        <div class="cell">اعتُمد</div>
        @if (canApprove)
        {
            <div class="cell">إجراء</div>
        }
    </div>

    @if (!safetyChecks.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد فحوصات سلامة بعد</div></div>
    }
    else
    {
        @foreach (var s in safetyChecks)
        {
            <div class="data-table-row @(s.Result == SafetyResult.Danger && !s.IsApproved ? "row-action-required" : "")">
                <div class="cell">@s.CheckType</div>
                <div class="cell"><span class="tag @SafetyTagClass(s.Result)">@SafetyLabel(s.Result)</span></div>
                <div class="cell">@(s.CheckedBy?.FullName ?? s.CheckedByContractor?.Name ?? "-")</div>
                <div class="cell">@(s.IsApproved ? "نعم" : "لا")</div>
                @if (canApprove)
                {
                    <div class="cell">
                        @if (!s.IsApproved)
                        {
                            <form method="post" asp-action="ApproveSafetyCheck" style="display:flex; gap:4px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <select name="result" class="form-select form-select-sm">
                                    <option value="Safe">آمن</option>
                                    <option value="Warning">تحذير</option>
                                    <option value="Danger">خطير</option>
                                </select>
                                <button type="submit" class="btn-line btn-line-accent">اعتماد</button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px; margin-top:12px;">
    <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">إضافة فحص سلامة جديد</div>
    <form method="post" asp-action="CreateSafetyCheck" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SiteId" value="@site?.Id" />
        <div style="flex:1; min-width:160px;">
            <label class="form-label" style="font-size:11px;">نوع الفحص</label>
            <input type="text" name="CheckType" class="form-control form-control-sm" required />
        </div>
        <div style="flex:2; min-width:200px;">
            <label class="form-label" style="font-size:11px;">الوصف</label>
            <input type="text" name="Description" class="form-control form-control-sm" />
        </div>
        <button type="submit" class="btn-line btn-line-accent">+ إضافة فحص سلامة</button>
    </form>
</div>