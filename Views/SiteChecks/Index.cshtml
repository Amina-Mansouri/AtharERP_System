@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteQualityCheck>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    var safetyChecks = ViewBag.SafetyChecks as List<SiteSafetyCheck> ?? new List<SiteSafetyCheck>();
    ViewData["Title"] = $"فحوصات الجودة والسلامة - {site?.Name}";
    var canApprove = await PermissionService.HasPermissionAsync(User, "Quality.Approve");

    string QualityTypeLabel(SiteQualityType t) => t switch
    {
        SiteQualityType.Technical => "جودة فنية",
        SiteQualityType.Site => "جودة موقع",
        SiteQualityType.Financial => "جودة مالية",
        SiteQualityType.Administrative => "جودة إدارية",
        _ => t.ToString()
    };

    string ResultLabel(QualityCheckResult r) => r switch
    {
        QualityCheckResult.Pending => "معلق",
        QualityCheckResult.Pass => "مطابق",
        QualityCheckResult.Fail => "غير مطابق",
        QualityCheckResult.NeedsReview => "يحتاج مراجعة",
        _ => r.ToString()
    };

    string SafetyLabel(SafetyResult r) => r switch
    {
        SafetyResult.Safe => "آمن",
        SafetyResult.Warning => "تحذير",
        SafetyResult.Danger => "خطير",
        _ => r.ToString()
    };
}

<h1 class="athar-page-title">فحوصات الجودة والسلامة - @site?.Name</h1>

<div class="athar-card mt-3">
    <h5>فحوصات الجودة</h5>
    <div class="table-responsive">
        <table class="table athar-table align-middle">
            <thead>
                <tr>
                    <th>النوع</th>
                    <th>نوع الفحص</th>
                    <th>النتيجة</th>
                    <th>فحصه</th>
                    <th>اعتُمد</th>
                    @if (canApprove)
                    {
                        <th>إجراء</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">لا توجد فحوصات جودة بعد</td></tr>
                }
                @foreach (var q in Model)
                {
                    <tr>
                        <td>@QualityTypeLabel(q.QualityType)</td>
                        <td>@q.CheckType</td>
                        <td><span class="badge athar-status-badge athar-status-@q.Result">@ResultLabel(q.Result)</span></td>
                        <td>@q.CheckedBy.FullName</td>
                        <td>@(q.IsApproved ? $"نعم - {q.ApprovedBy?.FullName}" : "لا")</td>
                        @if (canApprove)
                        {
                            <td>
                                @if (!q.IsApproved)
                                {
                                    <form method="post" asp-action="ApproveQualityCheck" class="d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@q.Id" />
                                        <select name="result" class="form-select form-select-sm">
                                            <option value="Pass">مطابق</option>
                                            <option value="Fail">غير مطابق</option>
                                            <option value="NeedsReview">يحتاج مراجعة</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm athar-btn">اعتماد</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <hr />
    <h6>إضافة فحص جودة جديد</h6>
    <form method="post" asp-action="CreateQualityCheck" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SiteId" value="@site?.Id" />
        <div class="col-md-2">
            <label class="form-label">نوع الجودة</label>
            <select name="QualityType" class="form-select form-select-sm">
                <option value="Technical">جودة فنية</option>
                <option value="Site" selected>جودة موقع</option>
                <option value="Financial">جودة مالية</option>
                <option value="Administrative">جودة إدارية</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">نوع الفحص</label>
            <input type="text" name="CheckType" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">الوصف</label>
            <input type="text" name="Description" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة فحص جودة</button>
        </div>
    </form>
</div>

<div class="athar-card mt-3">
    <h5>فحوصات السلامة</h5>
    <div class="table-responsive">
        <table class="table athar-table align-middle">
            <thead>
                <tr>
                    <th>نوع الفحص</th>
                    <th>النتيجة</th>
                    <th>فحصه</th>
                    <th>اعتُمد</th>
                    @if (canApprove)
                    {
                        <th>إجراء</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!safetyChecks.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">لا توجد فحوصات سلامة بعد</td></tr>
                }
                @foreach (var s in safetyChecks)
                {
                    <tr>
                        <td>@s.CheckType</td>
                        <td><span class="badge athar-status-badge athar-status-@s.Result">@SafetyLabel(s.Result)</span></td>
                        <td>@s.CheckedBy.FullName</td>
                        <td>@(s.IsApproved ? "نعم" : "لا")</td>
                        @if (canApprove)
                        {
                            <td>
                                @if (!s.IsApproved)
                                {
                                    <form method="post" asp-action="ApproveSafetyCheck" class="d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <select name="result" class="form-select form-select-sm">
                                            <option value="Safe">آمن</option>
                                            <option value="Warning">تحذير</option>
                                            <option value="Danger">خطير</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm athar-btn">اعتماد</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <hr />
    <h6>إضافة فحص سلامة جديد</h6>
    <form method="post" asp-action="CreateSafetyCheck" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SiteId" value="@site?.Id" />
        <div class="col-md-4">
            <label class="form-label">نوع الفحص</label>
            <input type="text" name="CheckType" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-5">
            <label class="form-label">الوصف</label>
            <input type="text" name="Description" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة فحص سلامة</button>
        </div>
    </form>
</div>

<div class="mt-3">
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn athar-btn-outline">العودة للموقع</a>
</div>