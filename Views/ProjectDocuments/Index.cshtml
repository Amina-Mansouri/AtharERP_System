@using AtharERP_System.Models.Entities
@model List<ProjectDocument>
@{
    ViewData["Title"] = "مستندات المشروع";
    var project = ViewBag.Project as Project;
    var canEdit = ViewBag.CanEdit as bool? ?? false;

    string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / (1024.0 * 1024):N1} م.ب";
        if (bytes >= 1024) return $"{bytes / 1024.0:N1} ك.ب";
        return $"{bytes} بايت";
    }
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="athar-page-title">مستندات مشروع: @project?.Name <small class="text-muted">(@project?.Code)</small></h1>
    <a asp-controller="Projects" asp-action="Details" asp-route-id="@project?.Id" class="btn athar-btn-outline">العودة إلى المشروع</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="athar-card mt-3">
    @if (canEdit)
    {
        <form method="post" asp-action="Upload" enctype="multipart/form-data" class="row g-2 align-items-end mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="projectId" value="@project?.Id" />
            <div class="col-md-5">
                <label class="form-label">اختر ملفاً (صور، PDF، DWG، DOCX)</label>
                <input type="file" name="file" class="form-control" required />
            </div>
            <div class="col-md-5">
                <label class="form-label">وصف</label>
                <input type="text" name="description" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn athar-btn w-100">رفع الملف</button>
            </div>
        </form>
        <hr />
    }

    <div class="table-responsive">
        <table class="table athar-table align-middle">
            <thead>
                <tr>
                    <th>اسم الملف</th>
                    <th>النوع</th>
                    <th>الحجم</th>
                    <th>الوصف</th>
                    <th>رفعه</th>
                    <th>تاريخ الرفع</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">لا توجد مستندات بعد</td></tr>
                }
                @foreach (var doc in Model)
                {
                    <tr>
                        <td>@doc.FileName</td>
                        <td>@(doc.FileType ?? "-")</td>
                        <td>@FormatSize(doc.FileSize)</td>
                        <td>@(doc.Description ?? "-")</td>
                        <td>@doc.UploadedBy.FullName</td>
                        <td>@doc.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a href="@doc.FilePath" target="_blank" class="btn btn-sm athar-btn-outline">فتح</a>
                            @if (canEdit)
                            {
                                <form method="post" asp-action="Delete" asp-route-id="@doc.Id" class="d-inline"
                                      onsubmit="return confirm('حذف هذا المستند؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>