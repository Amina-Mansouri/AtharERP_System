@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<Notification>
@{
    ViewData["Title"] = "الإشعارات";
    string filter = ViewBag.Filter as string ?? "all";
    string? eventTypeFilter = ViewBag.EventTypeFilter as string;
    string? period = ViewBag.Period as string;
    int unreadCount = ViewBag.UnreadCount as int? ?? 0;
    int actionCount = ViewBag.ActionCount as int? ?? 0;
    var eventSettings = ViewBag.EventSettings as List<(NotificationEventType EventType, bool IsEnabled)> ?? new();
    var eventLabels = EnumDisplayHelper.GetDisplayList<NotificationEventType>();

    string EventLabel(NotificationEventType e) => eventLabels.FirstOrDefault(x => x.Value == e.ToString()).Label;
    string SourceLabel(string code) => code switch
    {
        "01" => "الموارد البشرية",
        "02" => "المشاريع",
        _ => code
    };
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">عام</div>
        <h1 class="athar-page-title" style="margin-top:2px;">الإشعارات</h1>
    </div>
    @if (Model.Any(n => !n.IsRead))
    {
        <form method="post" asp-action="MarkAllAsRead">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnFilter" value="@filter" />
            <input type="hidden" name="returnEventType" value="@eventTypeFilter" />
            <input type="hidden" name="returnPeriod" value="@period" />
            <button type="submit" class="btn-line">تعليم الكل كمقروء</button>
        </form>
    }
</div>

<div style="display:grid; grid-template-columns:1.5fr 1fr; gap:12px; align-items:start;">
    <div class="data-table" style="--cols: 22px 118px minmax(0,1fr) 130px 110px 84px;">
        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding:11px 16px; border-bottom:1px solid var(--sys-border);">
            <a href="@Url.Action("Index", new { filter = "all", eventType = eventTypeFilter, period })" class="btn-line @(filter == "all" ? "btn-line-accent" : "")">الكل</a>
            <a href="@Url.Action("Index", new { filter = "unread", eventType = eventTypeFilter, period })" class="btn-line @(filter == "unread" ? "btn-line-accent" : "")">غير مقروء <span class="n" style="margin-inline-start:4px;">@unreadCount</span></a>
            <a href="@Url.Action("Index", new { filter = "action", eventType = eventTypeFilter, period })" class="btn-line @(filter == "action" ? "btn-line-accent" : "")">تحتاج إجراءً <span class="n" style="margin-inline-start:4px;">@actionCount</span></a>

            <form method="get" asp-action="Index" style="display:contents;">
                <input type="hidden" name="filter" value="@filter" />
                <select name="eventType" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                    <option value="">كل الأحداث</option>
                    @foreach (var ev in eventLabels)
                    {
                        <option value="@ev.Value" selected="@(eventTypeFilter == ev.Value)">@ev.Label</option>
                    }
                </select>
                <select name="period" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(period))">كل الفترات</option>
                    <option value="today" selected="@(period == "today")">اليوم</option>
                    <option value="week" selected="@(period == "week")">هذا الأسبوع</option>
                    <option value="month" selected="@(period == "month")">هذا الشهر</option>
                </select>
            </form>
        </div>

        <div class="data-table-head">
            <div class="cell"></div>
            <div class="cell">الحدث</div>
            <div class="cell">الإشعار</div>
            <div class="cell">المصدر</div>
            <div class="cell">الوقت</div>
            <div class="cell">إجراء</div>
        </div>

        @if (!Model.Any())
        {
            <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد إشعارات</div></div>
        }
        else
        {
            @foreach (var n in Model)
            {
                <form method="post" asp-action="MarkAsRead" asp-route-id="@n.Id" class="data-table-row @(n.RequiresAction && !n.IsRead ? "row-action-required" : "")" style="cursor:pointer;" onclick="this.requestSubmit()">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnFilter" value="@filter" />
                    <input type="hidden" name="returnEventType" value="@eventTypeFilter" />
                    <input type="hidden" name="returnPeriod" value="@period" />
                    <div class="cell">
                        <span style="display:inline-block; width:7px; height:7px; border-radius:50%; @(n.IsRead ? "border:1px solid var(--sys-border);" : "background:var(--sys-primary);")"></span>
                    </div>
                    <div class="cell" style="@(n.IsRead ? "" : "font-weight:600;")">@EventLabel(n.EventType)</div>
                    <div class="cell" style="white-space:normal; @(n.IsRead ? "" : "font-weight:600;")">@n.Message</div>
                    <div class="cell">@SourceLabel(n.SourceModule)</div>
                    <div class="cell cell-num">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                    <div class="cell">
                        @if (n.RequiresAction)
                        {
                            <span class="tag tag-danger">مطلوب</span>
                        }
                    </div>
                </form>
            }
        }
    </div>

    <div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow);">
        <div style="padding:12px 16px 10px; border-bottom:1px solid var(--sys-border);">
            <div style="font-size:13.5px; font-weight:600;">أحداث الإشعارات</div>
            <div style="font-size:11px; color:var(--sys-text-light); margin-top:2px;">الأحداث التي تُطلق إشعاراً في المنظومة — عطّلي ما لا يهمك.</div>
        </div>
        <div style="padding:8px 16px 13px;">
            @foreach (var (ev, isOn) in eventSettings)
            {
                <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; padding:9px 0; border-bottom:1px solid var(--sys-row-line-light);">
                    <span style="font-size:12px;">@EventLabel(ev)</span>
                    <form method="post" asp-action="UpdateSetting">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventType" value="@ev" />
                        <input type="hidden" name="returnFilter" value="@filter" />
                        <input type="hidden" name="returnEventType" value="@eventTypeFilter" />
                        <input type="hidden" name="returnPeriod" value="@period" />
                        <label class="toggle-switch">
                            <input type="checkbox" name="isEnabled" value="true" onchange="this.form.submit()" checked="@isOn" />
                            <span class="slider"></span>
                        </label>
                        <input type="hidden" name="isEnabled" value="false" />
                    </form>
                </div>
            }
        </div>
    </div>
</div>