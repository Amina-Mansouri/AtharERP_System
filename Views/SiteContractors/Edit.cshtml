@using AtharERP_System.Models.Entities
@model SiteContractor
@{
    ViewData["Title"] = "تعديل ارتباط المقاول";
}

<h1 class="athar-page-title">تعديل ارتباط المقاول: @Model.Contractor.Name</h1>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:16px; margin-top:12px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div style="font-size:11px; color:var(--sys-text-light); margin-bottom:12px;">
        بيانات المقاول نفسه (الاسم/الشركة/الهاتف/البريد) تُدار من شاشة حسابات المقاولين — هذه الشاشة لتفاصيل ارتباطه بهذا الموقع فقط.
    </div>

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">التخصص</label>
                <input type="text" name="Specialty" class="form-control" value="@Model.Specialty" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="Active" selected="@(Model.Status == ContractorStatus.Active)">نشط</option>
                    <option value="Completed" selected="@(Model.Status == ContractorStatus.Completed)">منتهي</option>
                    <option value="Cancelled" selected="@(Model.Status == ContractorStatus.Cancelled)">ملغى</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">تاريخ البدء</label>
                <input type="date" name="StartDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">تاريخ الانتهاء</label>
                <input type="date" name="EndDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">ملاحظات</label>
            <textarea name="Notes" class="form-control" rows="2">@Model.Notes</textarea>
        </div>

        <button type="submit" class="btn-line btn-line-accent">حفظ التعديلات</button>
        <a asp-action="Index" asp-route-siteId="@Model.SiteId" class="btn-line">إلغاء</a>
    </form>
</div>