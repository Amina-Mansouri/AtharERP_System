@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteContractor>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    ViewData["Title"] = $"المقاولون - {site?.Name}";
    var canManage = await PermissionService.HasPermissionAsync(User, "Sites.Manage");

    string StatusLabel(ContractorStatus s) => s switch
    {
        ContractorStatus.Active => "نشط",
        ContractorStatus.Completed => "منتهي",
        ContractorStatus.Cancelled => "ملغى",
        _ => s.ToString()
    };
}

<h1 class="athar-page-title">المقاولون - @site?.Name</h1>

<div class="athar-card mt-3">
    <div class="table-responsive">
        <table class="table athar-table align-middle">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>الشركة</th>
                    <th>الهاتف</th>
                    <th>التخصص</th>
                    <th>الحالة</th>
                    @if (canManage)
                    {
                        <th>إجراءات</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">لا يوجد مقاولون مسجَّلون بعد</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@(c.CompanyName ?? "-")</td>
                        <td>@(c.Phone ?? "-")</td>
                        <td>@(c.Specialty ?? "-")</td>
                        <td><span class="badge athar-status-badge athar-status-@c.Status">@StatusLabel(c.Status)</span></td>
                        @if (canManage)
                        {
                            <td>
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm athar-btn-outline">تعديل</a>
                                <form method="post" asp-action="Delete" asp-route-id="@c.Id" class="d-inline"
                                      onsubmit="return confirm('حذف هذا المقاول؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (canManage)
    {
        <hr />
        <h6>إضافة مقاول جديد</h6>
        <form method="post" asp-action="Create" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SiteId" value="@site?.Id" />
            <div class="col-md-3">
                <label class="form-label">الاسم</label>
                <input type="text" name="Name" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">الشركة</label>
                <input type="text" name="CompanyName" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label">الهاتف</label>
                <input type="text" name="Phone" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label">التخصص</label>
                <input type="text" name="Specialty" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة</button>
            </div>
        </form>
    }
</div>

<div class="mt-3">
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn athar-btn-outline">العودة للموقع</a>
</div>