@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteContractor>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    var allContractors = ViewBag.AllContractors as List<Contractor> ?? new List<Contractor>();
    var canManage = await PermissionService.HasPermissionAsync(User, "Sites.Manage");
    var isGlobalView = site == null;

    string pageTitle;
    if (site != null)
    {
        pageTitle = "المقاولون - " + site.Name;
    }
    else
    {
        pageTitle = "المقاولون";
    }
    ViewData["Title"] = pageTitle;

    string cols;
    if (isGlobalView && canManage)
    {
        cols = "1.2fr 1.1fr 1.2fr 110px 1fr 90px 160px";
    }
    else if (isGlobalView)
    {
        cols = "1.2fr 1.1fr 1.2fr 110px 1fr 90px";
    }
    else if (canManage)
    {
        cols = "1.2fr 1.2fr 110px 1fr 90px 160px";
    }
    else
    {
        cols = "1.2fr 1.2fr 110px 1fr 90px";
    }

    string StatusLabel(ContractorStatus s) => s switch
    {
        ContractorStatus.Active => "نشط",
        ContractorStatus.Completed => "منتهي",
        ContractorStatus.Cancelled => "ملغى",
        _ => s.ToString()
    };

    string StatusTagClass(ContractorStatus s) => s switch
    {
        ContractorStatus.Active => "tag-success",
        ContractorStatus.Cancelled => "tag-danger",
        _ => "tag-muted"
    };
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        @if (site != null)
        {
            <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@site.Code</div>
        }
        <h1 class="athar-page-title" style="margin-top:2px;">@pageTitle</h1>
    </div>
    @if (site != null)
    {
        <a asp-controller="Sites" asp-action="Details" asp-route-id="@site.Id" class="btn-line">العودة للموقع</a>
    }
</div>

<div class="data-table" style="--cols: @cols;">
    <div class="data-table-head">
        <div class="cell">الاسم</div>
        @if (isGlobalView)
        {
            <div class="cell">الموقع</div>
        }
        <div class="cell">الشركة</div>
        <div class="cell">الهاتف</div>
        <div class="cell">التخصص</div>
        <div class="cell">الحالة</div>
        @if (canManage)
        {
            <div class="cell">إجراءات</div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا يوجد مقاولون مسجَّلون بعد</div></div>
    }
    else
    {
        @foreach (var c in Model)
        {
            <div class="data-table-row">
                <div class="cell">@c.Contractor.Name</div>
                @if (isGlobalView)
                {
                    <div class="cell">
                        <a asp-controller="Sites" asp-action="Details" asp-route-id="@c.SiteId">@c.Site.Code - @c.Site.Name</a>
                    </div>
                }
                <div class="cell">@(c.Contractor.CompanyName ?? "-")</div>
                <div class="cell cell-num">@(c.Contractor.Phone ?? "-")</div>
                <div class="cell">@(c.Specialty ?? "-")</div>
                <div class="cell"><span class="tag @StatusTagClass(c.Status)">@StatusLabel(c.Status)</span></div>
                @if (canManage)
                {
                    <div class="cell" style="display:flex; gap:6px;">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn-line">تعديل</a>
                        <form method="post" asp-action="Delete" asp-route-id="@c.Id" onsubmit="return confirm('إلغاء ربط هذا المقاول بالموقع؟');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-line" style="color:#c94a42;">إلغاء الربط</button>
                        </form>
                    </div>
                }
            </div>
        }
    }
</div>

@if (canManage && site != null)
{
    <div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px; margin-top:12px;">
        <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">ربط مقاول موجود بهذا الموقع</div>
        <form method="post" asp-action="Create" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end; margin-bottom:14px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site.Id" />
            <div style="flex:1; min-width:200px;">
                <label class="form-label" style="font-size:11px;">المقاول</label>
                <select name="contractorId" class="form-select form-select-sm" required>
                    <option value="">-- اختاري --</option>
                    @foreach (var ct in allContractors)
                    {
                        <option value="@ct.Id">@ct.Name (@ct.Email)</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">التخصص</label>
                <input type="text" name="specialty" class="form-control form-control-sm" />
            </div>
            <button type="submit" class="btn-line btn-line-accent">+ ربط</button>
        </form>

        <div style="font-size:12.5px; font-weight:600; margin-bottom:8px; padding-top:10px; border-top:1px solid var(--sys-border);">أو إنشاء حساب مقاول جديد وربطه</div>
        <form method="post" asp-action="Create" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site.Id" />
            <div>
                <label class="form-label" style="font-size:11px;">الاسم</label>
                <input type="text" name="newName" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">الشركة</label>
                <input type="text" name="newCompanyName" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">الهاتف</label>
                <input type="text" name="newPhone" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">البريد الإلكتروني</label>
                <input type="email" name="newEmail" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">كلمة المرور</label>
                <input type="password" name="newPassword" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">التخصص</label>
                <input type="text" name="specialty" class="form-control form-control-sm" />
            </div>
            <button type="submit" class="btn-line btn-line-accent">+ إنشاء وربط</button>
        </form>
    </div>
}
@if (canManage && site == null)
{
    <div style="margin-top:10px; font-size:11px; color:var(--sys-text-light);">لربط مقاول بموقع، ادخلي على الموقع المطلوب من «إدارة المواقع» ثم «المقاولون» الخاصة به.</div>
}