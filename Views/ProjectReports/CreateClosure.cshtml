@using AtharERP_System.Models.Entities
@{
    ViewData["Title"] = "تقرير إغلاق وتسليم المشاريع";
    var project = ViewBag.Project as Project;
    var stages = ViewBag.Stages as List<ProjectStage> ?? new List<ProjectStage>();
}

<div class="page-head">
    <div>
        <span class="kicker">التقارير</span>
        <h1>تقرير إغلاق وتسليم المشاريع — @project?.Name</h1>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="athar-card" style="padding:14px;">
    <form method="post" asp-action="CreateClosure">
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectId" value="@project?.Id" />

        <div style="margin-bottom:10px;">
            <label class="form-label" style="font-size:11px;">تاريخ الإغلاق</label>
            <input type="date" name="closureDate" class="form-control form-control-sm" style="max-width:240px;" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>

        <div style="margin-bottom:10px;">
            <div style="font-size:11px; font-weight:600; margin-bottom:4px;">التخصص (اختاري المراحل المعنيّة)</div>
            @if (!stages.Any())
            {
                <div style="font-size:11px; color:#999;">لا توجد مراحل مسجّلة لهذا المشروع</div>
            }
            @foreach (var s in stages)
            {
                <label style="display:inline-flex; align-items:center; gap:4px; margin-left:14px; font-size:11.5px;">
                    <input type="checkbox" name="stageIds" value="@s.Id" /> @s.Name
                </label>
            }
        </div>

        <div style="margin-bottom:10px;">
            <div style="font-size:11px; font-weight:600; margin-bottom:4px;">حالة نطاق العمل</div>
            <label style="display:block; font-size:11.5px;"><input type="checkbox" name="scopeFullyCompleted" value="true" /> تم استكمال كامل نطاق العمل</label>
            <label style="display:block; font-size:11.5px;"><input type="checkbox" name="scopePartiallyWithNotes" value="true" /> تم استكمال جزئي مع ملاحظات</label>
            <label style="display:block; font-size:11.5px;"><input type="checkbox" name="scopeExcludedWorkExists" value="true" /> توجد أعمال مستثناة من نطاق العقد</label>
        </div>
        <div style="margin-bottom:10px;">
            <label class="form-label" style="font-size:11px;">ملاحظات نطاق العمل</label>
            <textarea name="scopeNotes" class="form-control form-control-sm" rows="3"></textarea>
        </div>

        <button type="submit" class="btn-line btn-line-accent">إرسال التقرير</button>
        <a class="btn-line" asp-action="Index">رجوع</a>
    </form>
</div>