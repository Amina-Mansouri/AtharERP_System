@using AtharERP_System.Models.Entities
@{
    ViewData["Title"] = "مصروفات الأداء";
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
    var engineerId = ViewBag.EngineerId as string;
    var selectedProjectIds = ViewBag.SelectedProjectIds as List<int> ?? new List<int>();
    var engineer = ViewBag.Engineer as ApplicationUser;
    var availableProjects = ViewBag.AvailableProjects as List<Project> ?? new List<Project>();
    bool noAssignments = ViewBag.NoAssignments as bool? ?? false;
    bool hasResults = ViewBag.TotalSales != null;
}

<h1 class="athar-page-title">مصروفات الأداء</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["Error"]</div>
}

<div class="athar-card mt-3">
    <form method="get">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">المهندسة</label>
                <select name="engineerId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- اختاري مهندسة --</option>
                    @foreach (var e in engineers)
                    {
                        <option value="@e.Id" selected="@(engineerId == e.Id)">@e.FullName</option>
                    }
                </select>
            </div>
            @if (!string.IsNullOrEmpty(engineerId))
            {
                <div class="col-md-8 mb-3">
                    <label class="form-label">المشاريع (رئيسي وفرعي — يمكن اختيار أكثر من واحد)</label>
                    <select name="projectIds" class="form-select" multiple size="4" onchange="this.form.submit()">
                        @foreach (var p in availableProjects)
                        {
                            <option value="@p.Id" selected="@(selectedProjectIds.Contains(p.Id))">@p.Code - @p.Name</option>
                        }
                    </select>
                </div>
                <input type="hidden" name="engineerId" value="@engineerId" />
            }
        </div>
    </form>
</div>

@if (!string.IsNullOrEmpty(engineerId) && noAssignments)
{
    <div class="alert alert-warning mt-3">لا توجد تكليفات لهذه المهندسة ضمن المشاريع المختارة</div>
}

@if (hasResults)
{
    decimal totalSales = ViewBag.TotalSales;
    decimal totalSalaryInPeriod = ViewBag.TotalSalaryInPeriod;
    decimal otherProjectExpenses = ViewBag.OtherProjectExpenses;
    decimal netProfit = ViewBag.NetProfit;
    DateTime periodStart = ViewBag.PeriodStart;
    DateTime periodEnd = ViewBag.PeriodEnd;
    int presentDays = ViewBag.PresentDays;
    int absentDays = ViewBag.AbsentDays;
    decimal lateMinutesTotal = ViewBag.LateMinutesTotal;

    <div class="stat-sub mt-3">الفترة المحتسبة: @periodStart.ToString("yyyy-MM-dd") → @periodEnd.ToString("yyyy-MM-dd")</div>

    <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:12px; margin-top:10px;">
        <div class="athar-card">
            <div style="font-size:11px; color:#8a83a0;">إجمالي مبيعات تكليفاتها</div>
            <div style="font-size:18px; font-weight:700; margin-top:4px;">@totalSales.ToString("N0") د.ل</div>
        </div>
        <div class="athar-card">
            <div style="font-size:11px; color:#8a83a0;">راتبها خلال الفترة</div>
            <div style="font-size:18px; font-weight:700; margin-top:4px;">@totalSalaryInPeriod.ToString("N0") د.ل</div>
        </div>
        <div class="athar-card">
            <div style="font-size:11px; color:#8a83a0;">مصروفات المشروع الأخرى</div>
            <div style="font-size:18px; font-weight:700; margin-top:4px;">@otherProjectExpenses.ToString("N0") د.ل</div>
        </div>
        <div class="athar-card">
            <div style="font-size:11px; color:#8a83a0;">صافي الربح</div>
            <div style="font-size:18px; font-weight:700; margin-top:4px; color:@(netProfit >= 0 ? "#2f8a57" : "#c94a42");">@netProfit.ToString("N0") د.ل</div>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:12px; margin-top:12px;">
        <div class="athar-card">
            <div style="font-size:11px; color:#8a83a0;">أيام الحضور</div>
            <div style="font-size:16px; font-weight:700; margin-top:4px;">@presentDays</div>
        </div>
        <div class="athar-card">
            <div style="font-size:11px; color:#8a83a0;">أيام الغياب</div>
            <div style="font-size:16px; font-weight:700; margin-top:4px;">@absentDays</div>
        </div>
        <div class="athar-card">
            <div style="font-size:11px; color:#8a83a0;">دقائق التأخير</div>
            <div style="font-size:16px; font-weight:700; margin-top:4px;">@lateMinutesTotal.ToString("N0")</div>
        </div>
        <div class="athar-card">
            <div style="font-size:11px; color:#8a83a0;">مؤشر الأداء (KPI)</div>
            <div style="font-size:14px; font-weight:600; margin-top:4px;" class="stat-sub">قادم</div>
        </div>
    </div>

    <div class="athar-card mt-3">
        <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">صرف مكافأة أداء</div>
        <form method="post" asp-action="Disburse">
            @Html.AntiForgeryToken()
            <input type="hidden" name="engineerId" value="@engineerId" />
            @foreach (var pid in selectedProjectIds)
            {
                <input type="hidden" name="projectIds" value="@pid" />
            }
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">مبلغ المكافأة</label>
                    <input type="number" step="0.01" min="0" name="amount" class="form-control" required />
                </div>
                <div class="col-md-5 mb-3">
                    <label class="form-label">ملاحظات (اختياري)</label>
                    <input type="text" name="notes" class="form-control" />
                </div>
                <div class="col-md-3 mb-3 d-flex align-items-end">
                    <button type="submit" class="btn athar-btn" onclick="return confirm('تأكيد صرف هذه المكافأة؟');">صرف المكافأة</button>
                </div>
            </div>
        </form>
        <div class="stat-sub">سيُسجَّل هذا المبلغ ضمن مصروفات الشركة العامة (تصنيف "مكافآت"). طباعة نموذج رسمي لهذا الصرف ستُضاف لاحقاً.</div>
    </div>
}