@using AtharERP_System.Models.Entities
@model List<SiteCorrespondence>
@{
    var site = ViewBag.Site as Site;
    ViewData["Title"] = $"مراسلات المقاول - {site?.Name}";

    string StatusLabel(SiteCorrespondence c) => c.IsFromContractor
        ? (c.Status == CorrespondenceStatus.Pending ? "في انتظار الاعتماد" : "معتمد")
        : (c.Status == CorrespondenceStatus.Pending ? "في انتظار قبول الطلب" : "مقبول");

    string StatusTagClass(SiteCorrespondence c) => c.Status == CorrespondenceStatus.Resolved ? "tag-success" : "tag-accent";

    string PriorityLabel(CorrespondencePriority p) => p switch
    {
        CorrespondencePriority.High => "عالية",
        CorrespondencePriority.Urgent => "عاجلة",
        _ => "عادية"
    };
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@site?.Code</div>
        <h1 class="athar-page-title" style="margin-top:2px;">مراسلات المقاول - @site?.Name</h1>
    </div>
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn-line">العودة للموقع</a>
</div>

<div style="display:flex; flex-direction:column; gap:10px; margin-bottom:16px;">
    @if (!Model.Any())
    {
        <div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); padding:16px; text-align:center; color:var(--sys-text-light);">لا توجد مراسلات بعد</div>
    }
    else
    {
        @foreach (var c in Model)
        {
            var isMine = !c.IsFromContractor;
            <div style="background:@(isMine ? "#f1eefc" : "#fff"); border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); padding:12px 16px; max-width:85%; align-self:@(isMine ? "flex-end" : "flex-start");">
                <div style="font-size:11px; color:var(--sys-text-light); margin-bottom:6px; display:flex; gap:8px; align-items:center;">
                    <span>@(c.IsFromContractor ? (c.SentByContractor?.Name ?? "المقاول") : (c.SentBy?.FullName ?? "الشركة"))</span>
                    <span>— @c.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                    <span class="tag tag-muted" style="font-size:9px;">أولوية: @PriorityLabel(c.Priority)</span>
                    <span class="tag @StatusTagClass(c)" style="font-size:9px;">@StatusLabel(c)</span>
                </div>
                <div style="font-size:13px; white-space:pre-wrap;">@c.DetailedQuery</div>
                @if (c.RequiredResponseDate.HasValue)
                {
                    <div style="font-size:11px; color:var(--sys-text-light); margin-top:4px;">تاريخ الرد المطلوب: @c.RequiredResponseDate.Value.ToString("yyyy-MM-dd")</div>
                }
                <div style="margin-top:8px; display:flex; gap:10px; align-items:center;">
                    <a asp-action="Download" asp-route-id="@c.Id" target="_blank" style="font-size:11.5px;">📄 عرض PDF</a>
                    @if (!string.IsNullOrEmpty(c.AttachmentPath))
                    {
                        <a href="@c.AttachmentPath" target="_blank" style="font-size:11.5px;">📎 @(c.AttachmentFileName ?? "مرفق")</a>
                    }
                </div>
            </div>
        }
    }
</div>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px;">
    <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">إرسال مراسلة للمقاول</div>
    <form method="post" asp-action="Create" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:10px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="siteId" value="@site?.Id" />
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            <div>
                <label class="form-label" style="font-size:11px;">الأولوية</label>
                <select name="priority" class="form-select form-select-sm">
                    <option value="Normal">عادية</option>
                    <option value="High">عالية</option>
                    <option value="Urgent">عاجلة</option>
                </select>
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">تاريخ الرد المطلوب</label>
                <input type="date" name="requiredResponseDate" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">مرفق (اختياري)</label>
                <input type="file" name="attachment" class="form-control form-control-sm" />
            </div>
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">تفاصيل الاستفسار</label>
            <textarea name="detailedQuery" class="form-control" rows="3" required></textarea>
        </div>
        <div>
            <button type="submit" class="btn-line btn-line-accent">+ إرسال</button>
        </div>
    </form>
</div>