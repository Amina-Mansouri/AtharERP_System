@using AtharERP_System.Models.Entities
@model List<FinancialRecord>
@{
    var categories = ViewBag.Categories as List<ProjectCategory> ?? new List<ProjectCategory>();
    var categoryId = ViewBag.CategoryId as int?;
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
    var projectId = ViewBag.ProjectId as int?;
    var mainProjectId = ViewBag.MainProjectId as int?;
    var selectedProjectIds = ViewBag.ProjectIds as List<int> ?? new List<int>();
    var selectedSubProjectIds = ViewBag.SubProjectIds as List<int> ?? new List<int>();
    var subProjects = ViewBag.SubProjects as List<Project> ?? new List<Project>();
    var project = ViewBag.Project as Project;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var contributions = ViewBag.EngineerContributions as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var engineerId = ViewBag.EngineerId as string;
    var engineerOptions = ViewBag.Engineers as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    ViewData["Title"] = "جدول التكاليف";
}

<div class="page-head">
    <div>
        <span class="kicker">المالية</span>
        <h1>جدول التكاليف</h1>
    </div>
</div>

<div class="athar-card" style="margin-bottom:12px;">
    <form method="get" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
        <div style="min-width:180px;">
            <label class="form-label" style="font-size:11px;">نوع المشروع</label>
            <select name="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- الكل --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(categoryId == cat.Id)">@cat.DisplayName</option>
                }
            </select>
        </div>
        <div style="min-width:220px; position:relative;">
            <label class="form-label" style="font-size:11px;">المشروع الرئيسي (يمكن اختيار أكثر من واحد)</label>
            <div class="form-select form-select-sm" style="cursor:pointer; user-select:none;" onclick="toggleProjectsDropdown(event)">
                <span>@(selectedProjectIds.Any() ? $"{selectedProjectIds.Count} مشروع مختار" : "-- اختاري مشاريع --")</span>
            </div>
            <div id="projectsDropdownPanel" hidden class="athar-checkbox-dropdown-panel" style="position:absolute; z-index:20; top:100%; right:0; left:0; background:#fff; border:1px solid #e4e2ec; border-radius:8px; box-shadow:0 4px 12px rgba(0,0,0,.12); max-height:220px; overflow-y:auto; padding:6px; margin-top:2px;">
                @foreach (var p in projects)
                {
                    <label style="display:flex; align-items:center; gap:6px; padding:4px 6px; font-size:12px; cursor:pointer;">
                        <input type="checkbox" name="projectIds" value="@p.Id" checked="@(selectedProjectIds.Contains(p.Id))" onchange="this.form.submit()" />
                        @($"{p.Name}({p.Code})")
                    </label>
                }
            </div>
        </div>
        @if (mainProjectId.HasValue && subProjects.Any())
        {
            <div style="min-width:220px; position:relative;">
                <label class="form-label" style="font-size:11px;">المشروع الفرعي</label>
                <div class="form-select form-select-sm" style="cursor:pointer; user-select:none;" onclick="toggleDropdownPanel(event, 'subProjectsDropdownPanel')">
                    <span>@(selectedSubProjectIds.Any() ? $"{selectedSubProjectIds.Count} مبنى مختار" : "-- الكل مع الرئيسي --")</span>
                </div>
                <div id="subProjectsDropdownPanel" hidden class="athar-checkbox-dropdown-panel" style="position:absolute; z-index:20; top:100%; right:0; left:0; background:#fff; border:1px solid #e4e2ec; border-radius:8px; box-shadow:0 4px 12px rgba(0,0,0,.12); max-height:220px; overflow-y:auto; padding:6px; margin-top:2px;">
                    @foreach (var sp in subProjects)
                    {
                        <label style="display:flex; align-items:center; gap:6px; padding:4px 6px; font-size:12px; cursor:pointer;">
                            <input type="checkbox" name="subProjectIds" value="@sp.Id" checked="@(selectedSubProjectIds.Contains(sp.Id))" onchange="this.form.submit()" />
                            @($"{sp.Name}({sp.Code})")
                        </label>
                    }
                </div>
            </div>
        }
        <div style="min-width:180px;">
            <label class="form-label" style="font-size:11px;">المهندسة (اختيارها يلغي فلتر المشروع والتاريخ)</label>
            <select name="engineerId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- الكل --</option>
                @foreach (var e in engineerOptions)
                {
                    <option value="@e.EngineerId" selected="@(engineerId == e.EngineerId)">@e.FullName</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">الربع</label>
            <select id="quarterSelect" class="form-select form-select-sm" onchange="applyQuarter()">
                <option value="">-- تحديد يدوي --</option>
                <option value="1">الربع الأول</option>
                <option value="2">الربع الثاني</option>
                <option value="3">الربع الثالث</option>
                <option value="4">الربع الرابع</option>
            </select>
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">السنة</label>
            <input type="number" id="quarterYear" class="form-control form-control-sm" value="@DateTime.UtcNow.Year" style="width:90px;" />
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">من</label>
            <input type="date" name="dateFrom" id="dateFromInput" class="form-control form-control-sm" value="@(dateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">إلى</label>
            <input type="date" name="dateTo" id="dateToInput" class="form-control form-control-sm" value="@(dateTo?.ToString("yyyy-MM-dd"))" />
        </div>
        <button type="submit" class="btn-line btn-line-accent">تصفية</button>
    </form>
</div>

<script>
    function toggleDropdownPanel(e, panelId) {
        e.stopPropagation();
        var panel = document.getElementById(panelId);
        panel.hidden = !panel.hidden;
    }
    function toggleProjectsDropdown(e) {
        toggleDropdownPanel(e, 'projectsDropdownPanel');
    }
    document.addEventListener('click', function (e) {
        document.querySelectorAll('.athar-checkbox-dropdown-panel').forEach(function (panel) {
            if (!panel.hidden && !panel.contains(e.target)) {
                panel.hidden = true;
            }
        });
    });
    function applyQuarter() {
        const q = document.getElementById('quarterSelect').value;
        if (!q) return;
        const year = document.getElementById('quarterYear').value || new Date().getFullYear();
        const starts = { "1": "01-01", "2": "04-01", "3": "07-01", "4": "10-01" };
        const ends = { "1": "03-31", "2": "06-30", "3": "09-30", "4": "12-31" };
        document.getElementById('dateFromInput').value = year + "-" + starts[q];
        document.getElementById('dateToInput').value = year + "-" + ends[q];
    }
</script>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@{
    var engineerNames = Model.Select(r => r.Engineer?.FullName ?? "-").Distinct().OrderBy(n => n).ToList();
    var engineerReceived = new List<decimal>();
    var engineerNotReceived = new List<decimal>();
    foreach (var name in engineerNames)
    {
        engineerReceived.Add(Model.Where(r => (r.Engineer?.FullName ?? "-") == name && r.IsCleared).Sum(r => r.ValueAfterPercentage));
        engineerNotReceived.Add(Model.Where(r => (r.Engineer?.FullName ?? "-") == name && !r.IsCleared).Sum(r => r.ValueAfterPercentage));
    }

    if (engineerNames.Any())
    {
        <div class="athar-card" style="margin-bottom:12px;">
            <div style="font-size:12.5px; font-weight:600; margin-bottom:10px;">ما استلمته وما لم تستلمه كل مهندسة</div>
            <div style="overflow-x:auto;">
                <canvas id="engineerBarChart" height="90" style="min-width:@(Math.Max(engineerNames.Count * 70, 300))px;"></canvas>
            </div>
        </div>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
        <script>
            new Chart(document.getElementById('engineerBarChart'), {
                type: 'bar',
                data: {
                    labels: @Json.Serialize(engineerNames),
                    datasets: [
                        {
                            label: 'ما استلمته',
                            data: @Json.Serialize(engineerReceived),
                            backgroundColor: '#2e8b57',
                            maxBarThickness: 18
                        },
                        {
                            label: 'ما لم تستلمه',
                            data: @Json.Serialize(engineerNotReceived),
                            backgroundColor: '#c94a42',
                            maxBarThickness: 18
                        }
                    ]
                },
                options: {
                    plugins: { legend: { position: 'bottom', labels: { font: { size: 10 } } } },
                    scales: { y: { beginAtZero: true } }
                }
            });
        </script>
    }

        <div style="margin-bottom:8px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
            <a asp-action="EngineerReceipts" class="btn-line">🧾 سجل إيصالات الصرف</a>
            @if (!string.IsNullOrWhiteSpace(engineerId))
            {
                <button type="submit" form="engineerStatementForm" class="btn-line btn-line-accent">📑 طباعة كشف المحدَّد</button>
            }
        </div>
        <form id="engineerStatementForm" method="post" asp-action="ExportEngineerStatementPdf" target="_blank">
            @Html.AntiForgeryToken()
            <input type="hidden" name="engineerId" value="@engineerId" />
        </form>

        <div class="data-table data-table-compact" style="--cols: @(!string.IsNullOrWhiteSpace(engineerId) ? "28px" : "0px") 50px 1fr 1fr 1fr 55px 65px 65px 70px 65px 75px 110px">
            <div class="data-table-head">
                <div class="cell"></div>
                <div class="cell"><span>رقم المشروع</span></div>
                <div class="cell"><span>المشروع</span></div>
                <div class="cell"><span>بيان التكليف</span></div>
                <div class="cell"><span>المهندسة</span></div>
                <div class="cell"><span>مساحة التكليف</span></div>
                <div class="cell"><span>سعر متر التكليف</span></div>
                <div class="cell"><span>قيمة التكليف</span></div>
                <div class="cell"><span>نسبة التكليف من المشروع</span></div>
                <div class="cell"><span>تقييم الأداء</span></div>
                <div class="cell"><span>استحقاق المهندسة</span></div>
                <div class="cell"><span>الحالة</span></div>
            </div>

            @if (!Model.Any())
            {
                <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد تكليفات مُرحَّلة إلى المالية بعد لهذا المشروع</div></div>
            }
            else
            {
                @foreach (var r in Model)
                {
                    var valueAfter = r.ValueAfterPercentage;
                    var engineerContribution = contributions.TryGetValue(r.EngineerId, out var c) ? c : 0;
                    <div class="data-table-row">
                        <div class="cell">
                            @if (!string.IsNullOrWhiteSpace(engineerId))
                            {
                                <input type="checkbox" name="recordIds" value="@r.Id" form="engineerStatementForm" />
                            }
                        </div>
                        <div class="cell cell-num">@(r.Project?.Code ?? "-")</div>
                        <div class="cell">@(r.Project?.Name ?? "-")</div>
                        <div class="cell">@(r.ProjectAssignment?.Stage?.Name ?? "-")</div>
                        <div class="cell">@(r.Engineer?.FullName ?? "-")</div>
                        <div class="cell cell-num">@(r.Area?.ToString("N1") ?? "-")</div>
                        <div class="cell cell-num">@(r.PricePerMeter?.ToString("N0") ?? "-")</div>
                        <div class="cell cell-num">@r.Value.ToString("N0")</div>
                        <div class="cell cell-num">@engineerContribution.ToString("N1")%</div>
                        <div class="cell cell-num">@(r.ContributionPercentage?.ToString("N1") + "%" ?? "-")</div>
                        <div class="cell cell-num">@valueAfter.ToString("N0")</div>
                        <div class="cell">
                        @if (r.IsCleared)
                        {
                            <div style="display:flex; flex-direction:column; gap:3px;">
                                <span class="tag tag-success">تم الصرف (@r.ClearedAt?.ToString("yyyy-MM-dd"))</span>
                                <a asp-action="ExportRecordReceiptPdf" asp-route-recordId="@r.Id" target="_blank" class="btn-line" style="font-size:10px;">📄 طباعة</a>
                            </div>
                        }
                            else
                            {
                                <form method="post" asp-action="MarkRecordCleared" onsubmit="return confirm('تأكيد صرف مستحقات هذه المهندسة عن هذا التكليف؟');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="projectId" value="@r.ProjectId" />
                                    <button type="submit" class="btn-line btn-line-accent" style="font-size:10.5px;">صرف المكافأة</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }