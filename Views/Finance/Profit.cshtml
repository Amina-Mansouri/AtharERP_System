@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model ProjectCalculationService.ProjectNetProfitResult
@{
    var categories = ViewBag.Categories as List<ProjectCategory> ?? new List<ProjectCategory>();
    var categoryId = ViewBag.CategoryId as int?;
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
    var projectId = ViewBag.ProjectId as int?;
    var mainProjectId = ViewBag.MainProjectId as int?;
    var subProjectId = ViewBag.SubProjectId as int?;
    var subProjects = ViewBag.SubProjects as List<Project> ?? new List<Project>();
    var project = ViewBag.Project as Project;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;

    var generalAdminExpenses = ViewBag.GeneralAdminExpenses as List<ProjectExpense> ?? new List<ProjectExpense>();
    var generalAdminTotal = ViewBag.GeneralAdminTotal as decimal? ?? 0;
    var generalAdminTotalForMargin = ViewBag.GeneralAdminTotalForMargin as decimal? ?? 0;
    var generalAdminCategories = ViewBag.GeneralAdminCategories as List<ExpenseCategory> ?? new List<ExpenseCategory>();
    var genCategoryId = ViewBag.GenCategoryId as int?;
    var genDateFrom = ViewBag.GenDateFrom as DateTime?;
    var genDateTo = ViewBag.GenDateTo as DateTime?;


    ViewData["Title"] = "الأرباح والخسائر";
}

<div class="page-head">
    <div>
        <span class="kicker">المالية</span>
        <h1>الأرباح والخسائر</h1>
    </div>
    @if (project != null)
    {
        <a asp-action="PrintProfitReport" asp-route-projectId="@projectId" asp-route-dateFrom="@dateFrom" asp-route-dateTo="@dateTo" target="_blank" class="btn-line btn-line-accent">🖨 طباعة تقرير الربح والخسارة</a>
    }
</div>

<div class="athar-card no-print" style="margin-bottom:12px;">
    <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">ربح/خسارة مشروع</div>
    <form method="get" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
        <div style="min-width:180px;">
            <label class="form-label" style="font-size:11px;">نوع المشروع</label>
            <select name="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- الكل --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(categoryId == cat.Id)">@cat.DisplayName</option>
                }
            </select>
        </div>
        <div style="min-width:220px;">
            <label class="form-label" style="font-size:11px;">المشروع الرئيسي</label>
            <select name="projectId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- كل المشاريع (الرئيسية) --</option>
                @foreach (var p in projects)
                {
                    <option value="@p.Id" selected="@(mainProjectId == p.Id)">@($"{p.Name}({p.Code})")</option>
                }
            </select>
        </div>
        @if (mainProjectId.HasValue && subProjects.Any())
        {
            <div style="min-width:200px;">
                <label class="form-label" style="font-size:11px;">المشروع الفرعي</label>
                <select name="subProjectId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- المشروع الرئيسي نفسه --</option>
                    @foreach (var sp in subProjects)
                    {
                        <option value="@sp.Id" selected="@(subProjectId == sp.Id)">@($"{sp.Name}({sp.Code})")</option>
                    }
                </select>
            </div>
        }
        <div>
            <label class="form-label" style="font-size:11px;">الربع</label>
            <select id="quarterSelect" class="form-select form-select-sm" onchange="applyQuarter()">
                <option value="">-- تحديد يدوي --</option>
                <option value="1">الربع الأول</option>
                <option value="2">الربع الثاني</option>
                <option value="3">الربع الثالث</option>
                <option value="4">الربع الرابع</option>
            </select>
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">السنة</label>
            <input type="number" id="quarterYear" class="form-control form-control-sm" value="@DateTime.UtcNow.Year" style="width:90px;" />
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">من</label>
            <input type="date" name="dateFrom" id="dateFromInput" class="form-control form-control-sm" value="@(dateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">إلى</label>
            <input type="date" name="dateTo" id="dateToInput" class="form-control form-control-sm" value="@(dateTo?.ToString("yyyy-MM-dd"))" />
        </div>
        <button type="submit" class="btn-line btn-line-accent">تصفية</button>
    </form>
</div>

<script>
    function applyQuarter() {
        const q = document.getElementById('quarterSelect').value;
        if (!q) return;
        const year = document.getElementById('quarterYear').value || new Date().getFullYear();
        const starts = { "1": "01-01", "2": "04-01", "3": "07-01", "4": "10-01" };
        const ends = { "1": "03-31", "2": "06-30", "3": "09-30", "4": "12-31" };
        document.getElementById('dateFromInput').value = year + "-" + starts[q];
        document.getElementById('dateToInput').value = year + "-" + ends[q];
    }
</script>

@if (Model != null)
{
    var aggregate = ViewBag.Aggregate as ProjectCalculationService.ProjectNetProfitResult ?? new ProjectCalculationService.ProjectNetProfitResult();
    var salesOutstanding = Model.TotalSalesAccrued - Model.TotalSalesRealized;
    var taskCostsOutstanding = Model.TotalTaskCostsAccrued - Model.TotalTaskCostsRealized;
    var treasury = aggregate.TotalSalesRealized - aggregate.TotalTaskCostsRealized - aggregate.SiteCosts - aggregate.TotalGeneralExpenses;
    var profitMargin = treasury - generalAdminTotalForMargin;

    // --- بيانات رسم Waterfall (دائماً على كل المشاريع ضمن التصنيف المختار، على أساس "المنفَّذ") ---
    var wStep1 = aggregate.TotalSalesRealized; var wCum1 = wStep1;
    var wStep2 = aggregate.TotalTaskCostsRealized; var wCum2 = wCum1 - wStep2;
    var wStep3 = aggregate.SiteCosts; var wCum3 = wCum2 - wStep3;
    var wStep4 = aggregate.TotalGeneralExpenses; var wCum4 = wCum3 - wStep4; // = treasury
    var wStep6 = generalAdminTotalForMargin; var wCum6 = wCum4 - wStep6;
    var wStep7 = 0m; var wCum7 = wCum6 - wStep7; // رواتب
    var wStep8 = 0m; var wCum8 = wCum7 + wStep8; // خصومات (+)
    var wStep9 = 0m; var wCum9 = wCum8 - wStep9; // مكافآت = profitMargin

    var wLabels = new[] { "المبيعات", "تكاليف المهام", "تكاليف المواقع", "مصروفات المشروع", "الخزينة", "مصروفات عامة", "الرواتب", "الخصومات", "المكافآت", "هامش الربح" };
    var wBase = new[] { 0m, 0m, 0m, 0m, 0m, 0m, 0m, 0m, 0m, 0m };
    var wDeltaRaw = new[] { wStep1, wCum2 - wCum1, wCum3 - wCum2, wCum4 - wCum3, wCum4, wCum6 - wCum4, wCum7 - wCum6, wCum8 - wCum7, wCum9 - wCum8, wCum9 };
    var wBaseColors = new[] { "#2e8b57", "#c94a42", "#c94a42", "#c94a42", "#7b6bd6", "#c94a42", "#c94a42", "#2e8b57", "#c94a42", "#c9a15a" };
    // المؤشران 4 (الخزينة) و9 (هامش الربح) نتيجتان صافيتان قد تكونان سالبتين فعلاً (خسارة) — تُعرضان بقيمتهما الحقيقية مع لون أحمر عند السلب؛
    // بقية الأعمدة مبالغ خطوات لا تكون سالبة طبيعياً فتُعرض بقيمتها المطلقة كما استقر التصميم سابقاً
    var wNetResultIndices = new HashSet<int> { 4, 9 };
    var wDelta = new decimal[wDeltaRaw.Length];
    var wColors = new string[wDeltaRaw.Length];
    for (int i = 0; i < wDeltaRaw.Length; i++)
    {
        if (wNetResultIndices.Contains(i))
        {
            wDelta[i] = wDeltaRaw[i];
            wColors[i] = wDeltaRaw[i] < 0 ? "#c94a42" : wBaseColors[i];
        }
        else
        {
            wDelta[i] = Math.Abs(wDeltaRaw[i]);
            wColors[i] = wBaseColors[i];
        }
    }

    // تسمية كل عمود بسطرين ثابتين: اسم البند + رقمه الدقيق — لا يتأثر بارتفاع العمود إطلاقاً
    var wTickLabels = new object[wLabels.Length];
    for (int i = 0; i < wLabels.Length; i++)
    {
        wTickLabels[i] = new[] { wLabels[i], wDelta[i].ToString("N0") };
    }

    <div class="stat-strip" style="margin-bottom:16px;">
        <div class="stat-item" style="border-right:4px solid @(treasury >= 0 ? "#2e8b57" : "#c94a42");">
            <span class="kicker">الخزينة</span>
            <span class="stat-value" style="color:@(treasury >= 0 ? "#2e8b57" : "#c94a42");">@treasury.ToString("N0")</span>
        </div>
        <div class="stat-item" style="border-right:4px solid @(profitMargin >= 0 ? "#2e8b57" : "#c94a42");">
            <span class="kicker">هامش الربح</span>
            <span class="stat-value" style="color:@(profitMargin >= 0 ? "#2e8b57" : "#c94a42");">@profitMargin.ToString("N0")</span>
        </div>
    </div>

    <div class="athar-card no-print" style="margin-bottom:16px;">
        <div style="font-size:12.5px; font-weight:600; margin-bottom:10px;">مسار تحوّل المبيعات إلى هامش الربح</div>
        <canvas id="profitWaterfall" height="140"></canvas>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script>
        const wNamesJs = @Json.Serialize(wLabels);

        new Chart(document.getElementById('profitWaterfall'), {
            type: 'bar',
            data: {
                labels: @Json.Serialize(wTickLabels),
                datasets: [
                    {
                        label: 'base',
                        data: @Json.Serialize(wBase),
                        backgroundColor: 'transparent',
                        borderWidth: 0,
                        stack: 's'
                    },
                                   {
            label: 'value',
            data: @Json.Serialize(wDelta),
            backgroundColor: @Json.Serialize(wColors),
            stack: 's'
        }
                ]
            },
            options: {
                interaction: { mode: 'index', intersect: true },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        filter: (item) => item.datasetIndex === 1,
                        callbacks: {
                            label: (ctx) => wNamesJs[ctx.dataIndex] + ': ' + (ctx.raw ?? 0).toLocaleString('en-US')
                        }
                    }
                },
                scales: {
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        grid: { color: '#e4e2ec', borderDash: [4, 4] }
                    },
                    x: {
                        stacked: true,
                        grid: { display: false },
                        categoryPercentage: 0.7,
                        barPercentage: 0.9
                    }
                }
            }
        });
    </script>

    <style>
        .profit-card {
            cursor: pointer;
            text-align: center;
            padding: 14px 10px;
            transition: border-color .15s;
        }

            .profit-card.profit-card-active {
                border: 2px solid #7b6bd6;
            }
    </style>
    <div class="no-print" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:10px; margin-bottom:16px;">
        <div id="profitCard-sales" class="athar-card profit-card profit-card-active" onclick="showProfitSection('sales')">
            <div style="font-size:11.5px; color:#8a83a0; margin-bottom:6px;">المبيعات</div>
            <div style="font-size:16px; font-weight:700;">@Model.TotalSalesAccrued.ToString("N0")</div>
            <div style="font-size:9.5px; color:#2e8b57; margin-top:2px;">محقق: @Model.TotalSalesRealized.ToString("N0")</div>
        </div>
        <div id="profitCard-costs" class="athar-card profit-card" onclick="showProfitSection('costs')">
            <div style="font-size:11.5px; color:#8a83a0; margin-bottom:6px;">تكاليف المهام</div>
            <div style="font-size:16px; font-weight:700;">@Model.TotalTaskCostsAccrued.ToString("N0")</div>
            <div style="font-size:9.5px; color:#c94a42; margin-top:2px;">مسدَّد: @Model.TotalTaskCostsRealized.ToString("N0")</div>
        </div>
        <div id="profitCard-expenses" class="athar-card profit-card" onclick="showProfitSection('expenses')">
            <div style="font-size:11.5px; color:#8a83a0; margin-bottom:6px;">مصروفات المشروع</div>
            <div style="font-size:16px; font-weight:700;">@Model.TotalGeneralExpenses.ToString("N0")</div>
        </div>
        <div id="profitCard-site" class="athar-card profit-card" onclick="showProfitSection('site')">
            <div style="font-size:11.5px; color:#8a83a0; margin-bottom:6px;">تكاليف المواقع</div>
            <div style="font-size:16px; font-weight:700;">@Model.SiteCosts.ToString("N0")</div>
        </div>
        <div id="profitCard-treasury" class="athar-card profit-card" onclick="showProfitSection('treasury')">
            <div style="font-size:11.5px; color:#8a83a0; margin-bottom:6px;">الخزينة</div>
            <div style="font-size:16px; font-weight:700; color:@(treasury >= 0 ? "#2e8b57" : "#c94a42");">@treasury.ToString("N0")</div>
        </div>
        <div id="profitCard-genexp" class="athar-card profit-card" onclick="showProfitSection('genexp')">
            <div style="font-size:11.5px; color:#8a83a0; margin-bottom:6px;">مصروفات عامة</div>
            <div style="font-size:16px; font-weight:700;">@generalAdminTotal.ToString("N0")</div>
        </div>
        <div id="profitCard-margin" class="athar-card profit-card" onclick="showProfitSection('margin')">
            <div style="font-size:11.5px; color:#8a83a0; margin-bottom:6px;">هامش الربح</div>
            <div style="font-size:16px; font-weight:700; color:@(profitMargin >= 0 ? "#2e8b57" : "#c94a42");">@profitMargin.ToString("N0")</div>
        </div>
    </div>

    <div class="no-print" style="margin-bottom:12px;">
        <button type="button" class="btn-line btn-line-accent" onclick="window.print()">🖨 طباعة القسم المعروض</button>
    </div>

    <style>
        @media print {
            .no-print {
                display: none !important;
            }

            .profit-section-detail {
                box-shadow: none !important;
                border: none !important;
            }
        }
    </style>

    <div id="profitDetail-sales" class="profit-section-detail athar-card" style="margin-bottom:16px;">
        <div style="font-size:13px; font-weight:600; margin-bottom:10px;">المبيعات — الإجمالي: <strong>@Model.TotalSalesAccrued.ToString("N0")</strong> | <span style="color:#2e8b57;">المحقق: <strong>@Model.TotalSalesRealized.ToString("N0")</strong></span> | المستحق: <strong>@salesOutstanding.ToString("N0")</strong></div>
        <div>
            <div class="data-table data-table-compact profit-table" style="--cols: @(project == null ? "1fr 1.2fr 85px 80px 85px 95px 80px 90px 115px" : "1.2fr 85px 80px 85px 95px 80px 90px 115px");">
                <div class="data-table-head">
                    @if (project == null)
                    {
                        <div class="cell"><span>المشروع</span></div>
                    }
                    <div class="cell"><span>بيان التكليف</span></div>
                    <div class="cell"><span>التاريخ</span></div>
                    <div class="cell"><span>قيمة البيع</span></div>
                    <div class="cell"><span>نسبة إعادة التصميم</span></div>
                    <div class="cell"><span>الإجمالي</span></div>
                    <div class="cell"><span>المحقق</span></div>
                    <div class="cell"><span>المستحق</span></div>
                    <div class="cell"><span>الحالة</span></div>
                </div>
                @if (!Model.Claims.Any())
                {
                    <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مبيعات ضمن هذه الفلترة</div></div>
                }
                else
                {
                    @foreach (var c in Model.Claims)
                    {
                        <div class="data-table-row row-income">
                            @if (project == null)
                            {
                                <div class="cell">@c.Project?.Name</div>
                            }
                            <div class="cell">@(c.ProjectAssignment != null && c.ProjectAssignment.Tasks.Any() ? string.Join("، ", c.ProjectAssignment.Tasks.Select(t => t.Title)) : "-")</div>
                            <div class="cell cell-num">@c.CreatedAt.ToString("yyyy-MM-dd")</div>
                            <div class="cell cell-num">@c.Value.ToString("N0")</div>
                            <div class="cell cell-num">@(c.RedesignIncreasePercentage?.ToString("N1") + "%" ?? "-")</div>
                            <div class="cell cell-num">@c.RealValue.ToString("N0")</div>
                            <div class="cell cell-num">@c.PaidAmount.ToString("N0")</div>
                            <div class="cell cell-num">@c.RemainingAmount.ToString("N0")</div>
                            <div class="cell">
                                @if (c.IsClientSettled)
                                {
                                    <span class="tag tag-success">محصَّل @c.ClientSettledAt?.ToString("yyyy-MM-dd")</span>
                                }
                                else
                                {
                                    <span class="tag tag-warning">غير محصَّل</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div id="profitDetail-costs" class="profit-section-detail athar-card" style="margin-bottom:16px; display:none;">
        <div style="font-size:13px; font-weight:600; margin-bottom:10px;">تكاليف المهام — الالتزام: <strong>@Model.TotalTaskCostsAccrued.ToString("N0")</strong> | <span style="color:#c94a42;">المسدَّد: <strong>@Model.TotalTaskCostsRealized.ToString("N0")</strong></span></div>
        <div style="overflow-x:auto;">
            <div class="data-table profit-table" style="--cols: @(project == null ? "1fr 1.2fr 1fr 90px 90px 100px 130px" : "1.2fr 1fr 90px 90px 100px 130px");">
                <div class="data-table-head">
                    @if (project == null)
                    {
                        <div class="cell">المشروع</div>
                    }
                    <div class="cell">بيان التكليف</div>
                    <div class="cell">المهندسة</div>
                    <div class="cell">القيمة</div>
                    <div class="cell">تقييم الأداء</div>
                    <div class="cell">استحقاق المهندسة</div>
                    <div class="cell">الحالة</div>
                </div>
                @if (!Model.Records.Any())
                {
                    <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد تكاليف ضمن هذه الفلترة</div></div>
                }
                else
                {
                    @foreach (var r in Model.Records)
                    {
                        <div class="data-table-row row-expense">
                            @if (project == null)
                            {
                                <div class="cell">@r.Project?.Name</div>
                            }
                            <div class="cell">@(r.ProjectAssignment != null && r.ProjectAssignment.Tasks.Any() ? string.Join("، ", r.ProjectAssignment.Tasks.Select(t => t.Title)) : "-")</div>
                            <div class="cell">@(r.Engineer?.FullName ?? "-")</div>
                            <div class="cell cell-num">@r.Value.ToString("N0")</div>
                            <div class="cell cell-num">@(r.ContributionPercentage?.ToString("N1") + "%" ?? "-")</div>
                            <div class="cell cell-num">@r.ValueAfterPercentage.ToString("N0")</div>
                            <div class="cell">
                                @if (r.IsCleared)
                                {
                                    <span class="tag tag-success">مصروف @r.ClearedAt?.ToString("yyyy-MM-dd")</span>
                                }
                                else
                                {
                                    <span class="tag tag-warning">غير مصروف</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div id="profitDetail-expenses" class="profit-section-detail athar-card" style="margin-bottom:16px; display:none;">
        <div style="font-size:13px; font-weight:600; margin-bottom:10px;">مصروفات المشروع: <strong>@Model.TotalGeneralExpenses.ToString("N0")</strong></div>
        <div style="overflow-x:auto;">
            <div class="data-table profit-table" style="--cols: 1fr 130px;">
                <div class="data-table-head">
                    <div class="cell">التصنيف</div>
                    <div class="cell">المبلغ</div>
                </div>
                @if (!Model.ProjectExpensesByCategory.Any())
                {
                    <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مصروفات مشروع ضمن هذه الفلترة</div></div>
                }
                else
                {
                    @foreach (var cat in Model.ProjectExpensesByCategory)
                    {
                        <div class="data-table-row row-expense">
                            <div class="cell">@cat.CategoryName</div>
                            <div class="cell cell-num">@cat.Amount.ToString("N0")</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div id="profitDetail-site" class="profit-section-detail athar-card" style="margin-bottom:16px; display:none;">
        <div style="font-size:13px; font-weight:600; margin-bottom:10px;">تكاليف المواقع: <strong>@Model.SiteCosts.ToString("N0")</strong></div>
        <div style="overflow-x:auto;">
            <div class="data-table profit-table" style="--cols: 1fr 130px; min-width:420px;">
                <div class="data-table-head">
                    <div class="cell">المصدر</div>
                    <div class="cell">المبلغ</div>
                </div>
                @if (Model.SiteCostBreakdown.MaintenanceCost != 0)
                {
                    <div class="data-table-row row-expense">
                        <div class="cell">الصيانة</div>
                        <div class="cell cell-num">@Model.SiteCostBreakdown.MaintenanceCost.ToString("N0")</div>
                    </div>
                }
                @if (Model.SiteCostBreakdown.ContractorCost != 0)
                {
                    <div class="data-table-row row-expense">
                        <div class="cell">أجور المقاولين</div>
                        <div class="cell cell-num">@Model.SiteCostBreakdown.ContractorCost.ToString("N0")</div>
                    </div>
                }
                @foreach (var cat in Model.SiteCostBreakdown.ExpensesByCategory)
                {
                    <div class="data-table-row row-expense">
                        <div class="cell">@cat.CategoryName</div>
                        <div class="cell cell-num">@cat.Amount.ToString("N0")</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div id="profitDetail-treasury" class="profit-section-detail athar-card" style="margin-bottom:16px; display:none;">
        <div style="font-size:13px; font-weight:600; margin-bottom:10px;">الخزينة: <strong style="color:@(treasury >= 0 ? "#2e8b57" : "#c94a42");">@treasury.ToString("N0")</strong></div>
        <div style="overflow-x:auto;">
            <div class="data-table profit-table" style="--cols: 1fr 130px 130px 130px;">
                <div class="data-table-head">
                    <div class="cell">البند</div>
                    <div class="cell">الإجمالي</div>
                    <div class="cell">المنفَّذ</div>
                    <div class="cell">المتبقي</div>
                </div>
                <div class="data-table-row row-income">
                    <div class="cell">+ إجمالي المبيعات</div>
                    <div class="cell cell-num">@aggregate.TotalSalesAccrued.ToString("N0")</div>
                    <div class="cell cell-num">@aggregate.TotalSalesRealized.ToString("N0")</div>
                    <div class="cell cell-num">@((aggregate.TotalSalesAccrued - aggregate.TotalSalesRealized).ToString("N0"))</div>
                </div>
                <div class="data-table-row row-expense">
                    <div class="cell">− تكاليف المهام</div>
                    <div class="cell cell-num">@aggregate.TotalTaskCostsAccrued.ToString("N0")</div>
                    <div class="cell cell-num">@aggregate.TotalTaskCostsRealized.ToString("N0")</div>
                    <div class="cell cell-num">@((aggregate.TotalTaskCostsAccrued - aggregate.TotalTaskCostsRealized).ToString("N0"))</div>
                </div>
                <div class="data-table-row row-expense">
                    <div class="cell">− تكاليف المواقع</div>
                    <div class="cell cell-num">@aggregate.SiteCosts.ToString("N0")</div>
                    <div class="cell cell-num">@aggregate.SiteCosts.ToString("N0")</div>
                    <div class="cell cell-num">-</div>
                </div>
                <div class="data-table-row row-expense">
                    <div class="cell">− مصروفات المشروع</div>
                    <div class="cell cell-num">@aggregate.TotalGeneralExpenses.ToString("N0")</div>
                    <div class="cell cell-num">@aggregate.TotalGeneralExpenses.ToString("N0")</div>
                    <div class="cell cell-num">-</div>
                </div>
                <div class="data-table-row row-total">
                    <div class="cell">الخزينة =</div>
                    <div class="cell cell-num"></div>
                    <div class="cell cell-num" style="color:@(treasury >= 0 ? "#2e8b57" : "#c94a42");">@treasury.ToString("N0")</div>
                    <div class="cell cell-num"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="profitDetail-genexp" class="profit-section-detail athar-card" style="border:2px solid #7b6bd6; margin-bottom:16px; display:none;">
        <div style="font-size:13.5px; font-weight:700; margin-bottom:10px; color:#221837;">مصروفات عامة: <strong>@generalAdminTotal.ToString("N0")</strong></div>
        <form method="get" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap; margin-bottom:12px;">
            <input type="hidden" name="categoryId" value="@categoryId" />
            <input type="hidden" name="projectId" value="@projectId" />
            <input type="hidden" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" />
            <div style="min-width:200px;">
                <label class="form-label" style="font-size:11px;">تصنيف المصروف الإداري</label>
                <select name="genCategoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- الكل --</option>
                    @foreach (var c in generalAdminCategories)
                    {
                        <option value="@c.Id" selected="@(genCategoryId == c.Id)">@c.NameAr</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">من</label>
                <input type="date" name="genDateFrom" class="form-control form-control-sm" value="@(genDateFrom?.ToString("yyyy-MM-dd"))" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">إلى</label>
                <input type="date" name="genDateTo" class="form-control form-control-sm" value="@(genDateTo?.ToString("yyyy-MM-dd"))" />
            </div>
            <button type="submit" class="btn-line btn-line-accent">تصفية</button>
        </form>

        <div class="stat-strip stat-strip-text" style="margin-bottom:12px;">
            <div class="stat-item"><span class="kicker">إجمالي المصروفات الإدارية</span><span class="stat-value">@generalAdminTotal.ToString("N0")</span></div>
            <div class="stat-item" style="opacity:.5;"><span class="kicker">الرواتب</span><span class="stat-value">قادمة</span></div>
        </div>

        <div style="overflow-x:auto;">
            <div class="data-table profit-table" style="--cols: 100px 1fr 100px 1fr;">
                <div class="data-table-head">
                    <div class="cell">التاريخ</div>
                    <div class="cell">التصنيف</div>
                    <div class="cell">المبلغ</div>
                    <div class="cell">الوصف</div>
                </div>
                @if (!generalAdminExpenses.Any())
                {
                    <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مصروفات إدارية ضمن هذه الفلترة</div></div>
                }
                else
                {
                    @foreach (var e in generalAdminExpenses)
                    {
                        <div class="data-table-row row-expense">
                            <div class="cell cell-num">@e.Date.ToString("yyyy-MM-dd")</div>
                            <div class="cell">@e.ExpenseCategory?.NameAr</div>
                            <div class="cell cell-num">@e.Amount.ToString("N0")</div>
                            <div class="cell">@(e.Description ?? "-")</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div id="profitDetail-margin" class="profit-section-detail athar-card" style="margin-bottom:16px; display:none;">
        <div style="font-size:13px; font-weight:600; margin-bottom:10px;">هامش الربح: <strong style="color:@(profitMargin >= 0 ? "#2e8b57" : "#c94a42");">@profitMargin.ToString("N0")</strong></div>
        <div style="overflow-x:auto;">
            <div class="data-table profit-table" style="--cols: 1fr 130px 130px 130px; min-width:650px;">
                <div class="data-table-row row-total">
                    <div class="cell">الخزينة</div>
                    <div class="cell cell-num"></div>
                    <div class="cell cell-num" style="color:@(treasury >= 0 ? "#2e8b57" : "#c94a42");">@treasury.ToString("N0")</div>
                    <div class="cell cell-num"></div>
                </div>
                <div class="data-table-row row-expense">
                    <div class="cell">− مصروفات عامة</div>
                    <div class="cell cell-num">@generalAdminTotalForMargin.ToString("N0")</div>
                    <div class="cell cell-num">@generalAdminTotalForMargin.ToString("N0")</div>
                    <div class="cell cell-num">-</div>
                </div>
                <div class="data-table-row row-expense">
                    <div class="cell">− الرواتب <span class="tag tag-muted" style="font-size:9px;">قادمة</span></div>
                    <div class="cell cell-num">0</div>
                    <div class="cell cell-num">0</div>
                    <div class="cell cell-num">-</div>
                </div>
                <div class="data-table-row row-income">
                    <div class="cell">+ الخصومات <span class="tag tag-muted" style="font-size:9px;">قادمة</span></div>
                    <div class="cell cell-num">0</div>
                    <div class="cell cell-num">0</div>
                    <div class="cell cell-num">-</div>
                </div>
                <div class="data-table-row row-expense">
                    <div class="cell">− المكافآت <span class="tag tag-muted" style="font-size:9px;">قادمة</span></div>
                    <div class="cell cell-num">0</div>
                    <div class="cell cell-num">0</div>
                    <div class="cell cell-num">-</div>
                </div>
                <div class="data-table-row row-total">
                    <div class="cell">= هامش الربح</div>
                    <div class="cell cell-num"></div>
                    <div class="cell cell-num" style="color:@(profitMargin >= 0 ? "#2e8b57" : "#c94a42");">@profitMargin.ToString("N0")</div>
                    <div class="cell cell-num"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function showProfitSection(key) {
            document.querySelectorAll('.profit-section-detail').forEach(function (el) {
                el.style.display = 'none';
            });
            document.querySelectorAll('.profit-card').forEach(function (el) {
                el.classList.remove('profit-card-active');
            });
            var detail = document.getElementById('profitDetail-' + key);
            if (detail) detail.style.display = '';
            var card = document.getElementById('profitCard-' + key);
            if (card) card.classList.add('profit-card-active');
        }
    </script>
}
else
{
    <div class="stat-sub" style="margin-bottom:16px;">لا توجد مشاريع متاحة لعرض بياناتها</div>
}