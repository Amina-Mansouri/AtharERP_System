@using AtharERP_System.Models.Entities
@model List<FinancialClaim>
@{
    var categories = ViewBag.Categories as List<ProjectCategory> ?? new List<ProjectCategory>();
    var categoryId = ViewBag.CategoryId as int?;
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
    var projectId = ViewBag.ProjectId as int?;
    var mainProjectId = ViewBag.MainProjectId as int?;
    var selectedProjectIds = ViewBag.ProjectIds as List<int> ?? new List<int>();
    var selectedSubProjectIds = ViewBag.SubProjectIds as List<int> ?? new List<int>();
    var subProjects = ViewBag.SubProjects as List<Project> ?? new List<Project>();
    var project = ViewBag.Project as Project;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    ViewData["Title"] = "جدول البيع النهائي";
}

<div class="page-head">
    <div>
        <span class="kicker">المالية</span>
        <h1>جدول البيع النهائي / المطالبة</h1>
    </div>
</div>

<div class="athar-card" style="margin-bottom:12px;">
    <form method="get" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
        <div style="min-width:180px;">
            <label class="form-label" style="font-size:11px;">نوع المشروع</label>
            <select name="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- الكل --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(categoryId == cat.Id)">@cat.DisplayName</option>
                }
            </select>
        </div>
        <div style="min-width:220px; position:relative;">
            <label class="form-label" style="font-size:11px;">المشروع الرئيسي (يمكن اختيار أكثر من واحد)</label>
            <div class="form-select form-select-sm" style="cursor:pointer; user-select:none;" onclick="toggleProjectsDropdown(event)">
                <span>@(selectedProjectIds.Any() ? $"{selectedProjectIds.Count} مشروع مختار" : "-- اختاري مشاريع --")</span>
            </div>
            <div id="projectsDropdownPanel" hidden class="athar-checkbox-dropdown-panel" style="position:absolute; z-index:20; top:100%; right:0; left:0; background:#fff; border:1px solid #e4e2ec; border-radius:8px; box-shadow:0 4px 12px rgba(0,0,0,.12); max-height:220px; overflow-y:auto; padding:6px; margin-top:2px;">
                @foreach (var p in projects)
                {
                    <label style="display:flex; align-items:center; gap:6px; padding:4px 6px; font-size:12px; cursor:pointer;">
                        <input type="checkbox" name="projectIds" value="@p.Id" checked="@(selectedProjectIds.Contains(p.Id))" onchange="this.form.submit()" />
                        @($"{p.Name}({p.Code})")
                    </label>
                }
            </div>
        </div>
        @if (mainProjectId.HasValue && subProjects.Any())
        {
            <div style="min-width:220px; position:relative;">
                <label class="form-label" style="font-size:11px;">المشروع الفرعي</label>
                <div class="form-select form-select-sm" style="cursor:pointer; user-select:none;" onclick="toggleDropdownPanel(event, 'subProjectsDropdownPanel')">
                    <span>@(selectedSubProjectIds.Any() ? $"{selectedSubProjectIds.Count} مبنى مختار" : "-- الكل مع الرئيسي --")</span>
                </div>
                <div id="subProjectsDropdownPanel" hidden class="athar-checkbox-dropdown-panel" style="position:absolute; z-index:20; top:100%; right:0; left:0; background:#fff; border:1px solid #e4e2ec; border-radius:8px; box-shadow:0 4px 12px rgba(0,0,0,.12); max-height:220px; overflow-y:auto; padding:6px; margin-top:2px;">
                    @foreach (var sp in subProjects)
                    {
                        <label style="display:flex; align-items:center; gap:6px; padding:4px 6px; font-size:12px; cursor:pointer;">
                            <input type="checkbox" name="subProjectIds" value="@sp.Id" checked="@(selectedSubProjectIds.Contains(sp.Id))" onchange="this.form.submit()" />
                            @($"{sp.Name}({sp.Code})")
                        </label>
                    }
                </div>
            </div>
        }
        <div>
            <label class="form-label" style="font-size:11px;">الربع</label>
            <select id="quarterSelect" class="form-select form-select-sm" onchange="applyQuarter()">
                <option value="">-- تحديد يدوي --</option>
                <option value="1">الربع الأول</option>
                <option value="2">الربع الثاني</option>
                <option value="3">الربع الثالث</option>
                <option value="4">الربع الرابع</option>
            </select>
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">السنة</label>
            <input type="number" id="quarterYear" class="form-control form-control-sm" value="@DateTime.UtcNow.Year" style="width:90px;" />
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">من</label>
            <input type="date" name="dateFrom" id="dateFromInput" class="form-control form-control-sm" value="@(dateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">إلى</label>
            <input type="date" name="dateTo" id="dateToInput" class="form-control form-control-sm" value="@(dateTo?.ToString("yyyy-MM-dd"))" />
        </div>
        <button type="submit" class="btn-line btn-line-accent">تصفية</button>
    </form>
</div>

<script>
    function toggleDropdownPanel(e, panelId) {
        e.stopPropagation();
        var panel = document.getElementById(panelId);
        panel.hidden = !panel.hidden;
    }
    function toggleProjectsDropdown(e) {
        toggleDropdownPanel(e, 'projectsDropdownPanel');
    }
    function toggleTaskDesc(el) {
        var expanded = el.getAttribute('data-expanded') === 'true';
        if (expanded) {
            el.innerHTML = el.getAttribute('data-short') + '... <span class="task-desc-arrow">▸</span>';
            el.setAttribute('data-expanded', 'false');
        } else {
            el.innerHTML = el.getAttribute('data-full') + ' <span class="task-desc-arrow">▾</span>';
            el.setAttribute('data-expanded', 'true');
        }
    }
    document.addEventListener('click', function (e) {
        document.querySelectorAll('.athar-checkbox-dropdown-panel').forEach(function (panel) {
            if (!panel.hidden && !panel.contains(e.target)) {
                panel.hidden = true;
            }
        });
    });
    function applyQuarter() {
        const q = document.getElementById('quarterSelect').value;
        if (!q) return;
        const year = document.getElementById('quarterYear').value || new Date().getFullYear();
        const starts = { "1": "01-01", "2": "04-01", "3": "07-01", "4": "10-01" };
        const ends = { "1": "03-31", "2": "06-30", "3": "09-30", "4": "12-31" };
        document.getElementById('dateFromInput').value = year + "-" + starts[q];
        document.getElementById('dateToInput').value = year + "-" + ends[q];
    }
</script>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@{
    var showProjectSpecificActions = projectId.HasValue && project != null;
}

@if (showProjectSpecificActions)
{
    <form id="saleExportForm" method="post" asp-action="ExportSaleTableSelectedPdf" target="_blank">
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectId" value="@projectId" />
        <input type="hidden" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" />
    </form>
    <div style="margin-bottom:8px;">
        <button type="submit" form="saleExportForm" class="btn-line btn-line-accent">📑 تصدير المحدَّد (PDF)</button>
    </div>
}

    @if (Model.Any())
    {
        <div class="athar-card" style="margin-bottom:12px;">
            <div style="font-size:12.5px; font-weight:600; margin-bottom:10px;">ملخص جدول البيع النهائي</div>
            <div style="max-width:560px; margin:0 auto;">
                <canvas id="saleBarChart" height="180"></canvas>
            </div>
        </div>
        @{
            var sLabels = new[] { "قيمة البيع", "قيم النسب", "قيمة البيع بعد النسب", "نسبة إعادة التصميم", "المساحة", "المحقق", "المستحق" };
            var sValues = new[] { Model.Sum(c => c.Value), Model.Sum(c => c.MarkupNetEffect), Model.Sum(c => c.ValueAfterPercentage), Model.Sum(c => c.RedesignResult), Model.Sum(c => c.Area ?? 0), Model.Sum(c => c.PaidAmount), Model.Sum(c => c.RemainingAmount) };
            var sTickLabels = new object[sLabels.Length];
            for (int i = 0; i < sLabels.Length; i++)
            {
                sTickLabels[i] = new[] { sLabels[i], sValues[i].ToString("N0") };
            }
        }
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
        <script>
                new Chart(document.getElementById('saleBarChart'), {
                    type: 'bar',
                    data: {
                        labels: @Json.Serialize(sTickLabels),
                        datasets: [{
                            data: @Json.Serialize(sValues),
                            backgroundColor: ['#7b6bd6', '#9a6fb0', '#c9a15a', '#e0a040', '#4a90d9', '#2e8b57', '#c94a42']
                        }]
                    },
                    options: {
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true }, x: { ticks: { font: { size: 10 } } } }
                    }
                });
        </script>
    }

    <div class="data-table data-table-compact" style="--cols: @(showProjectSpecificActions ? "32px" : "0px") 50px 1fr 1fr 55px 60px 65px 150px 65px 60px 55px 65px 55px 60px 140px">
            <div class="data-table-head">
        <div class="cell"></div>
        <div class="cell"><span>رقم المشروع</span></div>
        <div class="cell"><span>المشروع</span></div>
        <div class="cell"><span>بيان التكليف</span></div>
        <div class="cell"><span>مساحة التكليف</span></div>
        <div class="cell"><span>سعر متر البيع</span></div>
        <div class="cell"><span>قيمة البيع</span></div>
            <div class="cell"><span>نسبة 1 / نسبة 2</span></div>
            <div class="cell"><span>قيم النسب</span></div>
            <div class="cell"><span>قيمة البيع بعد النسب</span></div>
        <div class="cell"><span>نسبة إعادة التصميم</span></div>
                <div class="cell"><span>الإجمالي</span></div>
                <div class="cell"><span>المحقق</span></div>
                <div class="cell"><span>المستحق</span></div>
        <div class="cell"><span>الحالة</span></div>
    </div>

            @if (!Model.Any())
            {
                <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد تكليفات مُرحَّلة إلى المالية بعد لهذا المشروع</div></div>
            }
            else
            {
        @foreach (var c in Model)
        {
            <div class="data-table-row">
                <div class="cell">
                    @if (showProjectSpecificActions)
                    {
                        <input type="checkbox" name="claimIds" value="@c.Id" form="saleExportForm" />
                    }
                </div>
            <div class="cell cell-num">@(c.Project?.Code ?? "-")</div>
                    <div class="cell">@(c.Project?.Name ?? "-")</div>
                <div class="cell">
                    @{
                        var cTaskTitles = c.ProjectAssignment != null ? c.ProjectAssignment.Tasks.Select(t => t.Title).ToList() : new List<string>();
                    }
                    @if (cTaskTitles.Any())
                    {
                        <span class="task-desc-toggle" onclick="toggleTaskDesc(this)" data-full="@string.Join("، ", cTaskTitles)" data-short="@cTaskTitles[0]" data-expanded="false" style="cursor:pointer;">@cTaskTitles[0]... <span class="task-desc-arrow">▸</span></span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
                        <div class="cell cell-num">@(c.Area?.ToString("N1") ?? "-")</div>
                        <div class="cell cell-num">@(c.SalePricePerMeter?.ToString("N0") ?? "-")</div>
                        <div class="cell cell-num">@c.Value.ToString("N0")</div>
                        <div class="cell" style="white-space:normal; overflow:visible; padding:4px 6px;">
                        <form method="post" asp-action="UpdateClaimPercentages" style="display:flex; flex-direction:column; gap:2px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <input type="hidden" name="projectId" value="@c.ProjectId" />
                                <div style="display:flex; align-items:center; gap:3px;">
                                    <span style="font-size:8.5px; color:#8a83a0; width:26px;">نسبة 1</span>
                                    <input type="number" step="0.01" name="percent1" value="@c.SaleMarkupPercent1" class="claim-percent-input" data-claim-id="@c.Id" data-which="1" data-value="@c.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" oninput="recalcClaimPercent(@c.Id)" style="width:46px; height:18px; font-size:9px; padding:0 3px; border:1px solid #e4e2ec; border-radius:4px;" />
                                    <span id="result1-@c.Id" style="font-size:8.5px; color:#2f8a57; font-weight:600;"></span>
                                </div>
                                <div style="display:flex; align-items:center; gap:3px;">
                                    <span style="font-size:8.5px; color:#8a83a0; width:26px;">نسبة 2</span>
                                    <input type="number" step="0.01" name="percent2" value="@c.SaleMarkupPercent2" class="claim-percent-input" data-claim-id="@c.Id" data-which="2" data-value="@c.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" oninput="recalcClaimPercent(@c.Id)" style="width:46px; height:18px; font-size:9px; padding:0 3px; border:1px solid #e4e2ec; border-radius:4px;" />
                                    <span id="result2-@c.Id" style="font-size:8.5px; color:#c94a42; font-weight:600;"></span>
                                </div>
                                <button type="submit" class="btn-line btn-line-accent" style="font-size:8px; height:16px; padding:0 5px; align-self:flex-start;">حفظ</button>
                            </form>
                        </div>
                    <div class="cell cell-num" style="color:@(c.MarkupNetEffect < 0 ? "#c94a42" : (c.MarkupNetEffect > 0 ? "#2e8b57" : "inherit"));">@(c.MarkupNetEffect.ToString("+#,0.00;-#,0.00;0"))</div>
                    <div class="cell cell-num">@c.ValueAfterPercentage.ToString("N0")</div>
                    <div class="cell cell-num">@(c.RedesignIncreasePercentage?.ToString("N1") + "%" ?? "-")</div>
                        <div class="cell cell-num">@c.RealValue.ToString("N0")</div>
                        <div class="cell cell-num">@c.PaidAmount.ToString("N0")</div>
                        <div class="cell cell-num">@c.RemainingAmount.ToString("N0")</div>
                        <div class="cell">
                            @if (c.IsClientSettled)
                            {
                                <span class="tag tag-success">تم التحصيل (@c.ClientSettledAt?.ToString("yyyy-MM-dd"))</span>
                            }
                            else
                            {
                                <span class="tag">بانتظار التحصيل</span>
                            }
                        </div>
                    </div>
                }
            <div class="data-table-row" style="font-weight:700; background:var(--sys-bg);">
            <div class="cell" style="grid-column:1/7;">الإجمالي</div>
            <div class="cell cell-num">@Model.Sum(c => c.Value).ToString("N0")</div>
            <div class="cell"></div>
            <div class="cell cell-num">@Model.Sum(c => c.MarkupNetEffect).ToString("+#,0.00;-#,0.00;0")</div>
                <div class="cell cell-num">@Model.Sum(c => c.ValueAfterPercentage).ToString("N0")</div>
                <div class="cell"></div>
                <div class="cell cell-num">@Model.Sum(c => c.RealValue).ToString("N0")</div>
                <div class="cell cell-num">@Model.Sum(c => c.PaidAmount).ToString("N0")</div>
                <div class="cell cell-num">@Model.Sum(c => c.RemainingAmount).ToString("N0")</div>
        <div class="cell"></div>
    </div>
}
</div>

<script>
    function recalcClaimPercent(claimId) {
            const input1 = document.querySelector(`input[data-claim-id="${claimId}"][data-which="1"]`);
            const input2 = document.querySelector(`input[data-claim-id="${claimId}"][data-which="2"]`);
            const value = parseFloat(input1.getAttribute('data-value')) || 0;
            const p1 = parseFloat(input1.value) || 0;
            const p2 = parseFloat(input2.value) || 0;
            const result1 = value * p1 / 100;
            const result2 = value * p2 / 100;
            document.getElementById('result1-' + claimId).textContent = p1 ? ('−' + result1.toFixed(0)) : '';
            document.getElementById('result2-' + claimId).textContent = p2 ? ('−' + result2.toFixed(0)) : '';
        }
        document.querySelectorAll('.claim-percent-input[data-which="1"]').forEach(el => recalcClaimPercent(el.getAttribute('data-claim-id')));
    </script>
