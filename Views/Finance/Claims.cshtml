@using AtharERP_System.Models.Entities
@model List<FinancialClaim>
@{
    var categories = ViewBag.Categories as List<ProjectCategory> ?? new List<ProjectCategory>();
    var categoryId = ViewBag.CategoryId as int?;
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
    var projectId = ViewBag.ProjectId as int?;
    var mainProjectId = ViewBag.MainProjectId as int?;
    var selectedProjectIds = ViewBag.ProjectIds as List<int> ?? new List<int>();
    var selectedSubProjectIds = ViewBag.SubProjectIds as List<int> ?? new List<int>();
    var subProjects = ViewBag.SubProjects as List<Project> ?? new List<Project>();
    var project = ViewBag.Project as Project;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    ViewData["Title"] = "المطالبة";
}

<div class="page-head">
    <div>
        <span class="kicker">المالية</span>
        <h1>المطالبة</h1>
    </div>
</div>

<div class="athar-card" style="margin-bottom:12px;">
    <form method="get" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
        <div style="min-width:180px;">
            <label class="form-label" style="font-size:11px;">نوع المشروع</label>
            <select name="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- الكل --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(categoryId == cat.Id)">@cat.DisplayName</option>
                }
            </select>
        </div>
        <div style="min-width:220px; position:relative;">
            <label class="form-label" style="font-size:11px;">المشروع الرئيسي (يمكن اختيار أكثر من واحد)</label>
            <div class="form-select form-select-sm" style="cursor:pointer; user-select:none;" onclick="toggleProjectsDropdown(event)">
                <span>@(selectedProjectIds.Any() ? $"{selectedProjectIds.Count} مشروع مختار" : "-- اختاري مشاريع --")</span>
            </div>
            <div id="projectsDropdownPanel" hidden class="athar-checkbox-dropdown-panel" style="position:absolute; z-index:20; top:100%; right:0; left:0; background:#fff; border:1px solid #e4e2ec; border-radius:8px; box-shadow:0 4px 12px rgba(0,0,0,.12); max-height:220px; overflow-y:auto; padding:6px; margin-top:2px;">
                @foreach (var p in projects)
                {
                    <label style="display:flex; align-items:center; gap:6px; padding:4px 6px; font-size:12px; cursor:pointer;">
                        <input type="checkbox" name="projectIds" value="@p.Id" checked="@(selectedProjectIds.Contains(p.Id))" onchange="this.form.submit()" />
                        @p.Name
                    </label>
                }
            </div>
        </div>
        @if (mainProjectId.HasValue && subProjects.Any())
        {
            <div style="min-width:220px; position:relative;">
                <label class="form-label" style="font-size:11px;">المشروع الفرعي</label>
                <div class="form-select form-select-sm" style="cursor:pointer; user-select:none;" onclick="toggleDropdownPanel(event, 'subProjectsDropdownPanel')">
                    <span>@(selectedSubProjectIds.Any() ? $"{selectedSubProjectIds.Count} مبنى مختار" : "-- الكل مع الرئيسي --")</span>
                </div>
                <div id="subProjectsDropdownPanel" hidden class="athar-checkbox-dropdown-panel" style="position:absolute; z-index:20; top:100%; right:0; left:0; background:#fff; border:1px solid #e4e2ec; border-radius:8px; box-shadow:0 4px 12px rgba(0,0,0,.12); max-height:220px; overflow-y:auto; padding:6px; margin-top:2px;">
                    @foreach (var sp in subProjects)
                    {
                        <label style="display:flex; align-items:center; gap:6px; padding:4px 6px; font-size:12px; cursor:pointer;">
                            <input type="checkbox" name="subProjectIds" value="@sp.Id" checked="@(selectedSubProjectIds.Contains(sp.Id))" onchange="this.form.submit()" />
                            @sp.Name
                        </label>
                    }
                </div>
            </div>
        }
        <div>
            <label class="form-label" style="font-size:11px;">الربع</label>
            <select id="quarterSelect" class="form-select form-select-sm" onchange="applyQuarter()">
                <option value="">-- تحديد يدوي --</option>
                <option value="1">الربع الأول</option>
                <option value="2">الربع الثاني</option>
                <option value="3">الربع الثالث</option>
                <option value="4">الربع الرابع</option>
            </select>
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">السنة</label>
            <input type="number" id="quarterYear" class="form-control form-control-sm" value="@DateTime.UtcNow.Year" style="width:90px;" />
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">من</label>
            <input type="date" name="dateFrom" id="dateFromInput" class="form-control form-control-sm" value="@(dateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">إلى</label>
            <input type="date" name="dateTo" id="dateToInput" class="form-control form-control-sm" value="@(dateTo?.ToString("yyyy-MM-dd"))" />
        </div>
        <button type="submit" class="btn-line btn-line-accent">تصفية</button>
    </form>
</div>

<script>
    function toggleDropdownPanel(e, panelId) {
        e.stopPropagation();
        var panel = document.getElementById(panelId);
        panel.hidden = !panel.hidden;
    }
    function toggleProjectsDropdown(e) {
        toggleDropdownPanel(e, 'projectsDropdownPanel');
    }
    document.addEventListener('click', function (e) {
        document.querySelectorAll('.athar-checkbox-dropdown-panel').forEach(function (panel) {
            if (!panel.hidden && !panel.contains(e.target)) {
                panel.hidden = true;
            }
        });
    });
    function applyQuarter() {
        const q = document.getElementById('quarterSelect').value;
        if (!q) return;
        const year = document.getElementById('quarterYear').value || new Date().getFullYear();
        const starts = { "1": "01-01", "2": "04-01", "3": "07-01", "4": "10-01" };
        const ends = { "1": "03-31", "2": "06-30", "3": "09-30", "4": "12-31" };
        document.getElementById('dateFromInput').value = year + "-" + starts[q];
        document.getElementById('dateToInput').value = year + "-" + ends[q];
    }
</script>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@{
    var showProjectSpecificActions = projectId.HasValue && project != null;
}

@if (showProjectSpecificActions)
{
    <a asp-action="PrintProjectInvoice" asp-route-projectId="@projectId" target="_blank" class="btn-line btn-line-accent" style="margin-bottom:10px; display:inline-block;">🖨 طباعة فاتورة المشروع</a>
}

@if (Model.Any())
{
    var settledArea = Model.Where(c => c.IsClientSettled).Sum(c => c.Area ?? 0);
    var unsettledArea = Model.Where(c => !c.IsClientSettled).Sum(c => c.Area ?? 0);
    var baseValueSum = Model.Sum(c => c.Value);
    var redesignValueSum = Model.Sum(c => c.RedesignResult);

    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:12px;">
        <div class="athar-card" style="flex:1; min-width:280px;">
            <div style="font-size:12.5px; font-weight:600; margin-bottom:10px;">نسبة التحصيل</div>
            <div style="display:flex; align-items:center; justify-content:center; gap:28px; flex-wrap:wrap;">
                <div style="max-width:220px;">
                    <canvas id="claimsDonut" height="150"></canvas>
                </div>
                <div style="display:flex; flex-direction:column; gap:10px;">
                    <div>
                        <span style="display:inline-block; width:10px; height:10px; background:#2e8b57; border-radius:2px; margin-left:6px;"></span>
                        <span style="font-size:11px; color:#8a83a0;">المحقق</span>
                        <div style="font-size:18px; font-weight:700; color:#2e8b57;">@Model.Sum(c => c.PaidAmount).ToString("N2")</div>
                    </div>
                    <div>
                        <span style="display:inline-block; width:10px; height:10px; background:#c94a42; border-radius:2px; margin-left:6px;"></span>
                        <span style="font-size:11px; color:#8a83a0;">المستحق</span>
                        <div style="font-size:18px; font-weight:700; color:#c94a42;">@Model.Sum(c => c.RemainingAmount).ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="athar-card" style="flex:1; min-width:280px;">
            <div style="font-size:12.5px; font-weight:600; margin-bottom:10px;">المساحة المنفَّذة</div>
            <div style="display:flex; align-items:center; justify-content:center; gap:28px; flex-wrap:wrap;">
                <div style="max-width:220px;">
                    <canvas id="areaDonut" height="150"></canvas>
                </div>
                <div style="display:flex; flex-direction:column; gap:10px;">
                    <div>
                        <span style="display:inline-block; width:10px; height:10px; background:#2e8b57; border-radius:2px; margin-left:6px;"></span>
                        <span style="font-size:11px; color:#8a83a0;">مساحة محصَّلة (م²)</span>
                        <div style="font-size:18px; font-weight:700; color:#2e8b57;">@settledArea.ToString("N2")</div>
                    </div>
                    <div>
                        <span style="display:inline-block; width:10px; height:10px; background:#c94a42; border-radius:2px; margin-left:6px;"></span>
                        <span style="font-size:11px; color:#8a83a0;">مساحة غير محصَّلة (م²)</span>
                        <div style="font-size:18px; font-weight:700; color:#c94a42;">@unsettledArea.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="athar-card" style="flex:1; min-width:280px;">
            <div style="font-size:12.5px; font-weight:600; margin-bottom:10px;">نسبة إعادة التصميم</div>
            <div style="display:flex; align-items:center; justify-content:center; gap:28px; flex-wrap:wrap;">
                <div style="max-width:220px;">
                    <canvas id="redesignDonut" height="150"></canvas>
                </div>
                <div style="display:flex; flex-direction:column; gap:10px;">
                    <div>
                        <span style="display:inline-block; width:10px; height:10px; background:#7b6bd6; border-radius:2px; margin-left:6px;"></span>
                        <span style="font-size:11px; color:#8a83a0;">القيمة الأصلية</span>
                        <div style="font-size:18px; font-weight:700; color:#7b6bd6;">@baseValueSum.ToString("N2")</div>
                    </div>
                    <div>
                        <span style="display:inline-block; width:10px; height:10px; background:#e8a33d; border-radius:2px; margin-left:6px;"></span>
                        <span style="font-size:11px; color:#8a83a0;">زيادة إعادة التصميم</span>
                        <div style="font-size:18px; font-weight:700; color:#e8a33d;">@redesignValueSum.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById('claimsDonut'), {
            type: 'doughnut',
            data: {
                labels: ['المحقق', 'المستحق'],
                datasets: [{
                    data: [@Model.Sum(c => c.PaidAmount).ToString(System.Globalization.CultureInfo.InvariantCulture), @Model.Sum(c => c.RemainingAmount).ToString(System.Globalization.CultureInfo.InvariantCulture)],
                    backgroundColor: ['#2e8b57', '#c94a42']
                }]
            },
            options: {
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: (ctx) => ctx.label + ': ' + ctx.raw.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) } }
                }
            }
        });

        new Chart(document.getElementById('areaDonut'), {
            type: 'doughnut',
            data: {
                labels: ['مساحة محصَّلة', 'مساحة غير محصَّلة'],
                datasets: [{
                    data: [@settledArea.ToString(System.Globalization.CultureInfo.InvariantCulture), @unsettledArea.ToString(System.Globalization.CultureInfo.InvariantCulture)],
                    backgroundColor: ['#2e8b57', '#c94a42']
                }]
            },
            options: {
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: (ctx) => ctx.label + ': ' + ctx.raw.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' م²' } }
                }
            }
        });

        new Chart(document.getElementById('redesignDonut'), {
            type: 'doughnut',
            data: {
                labels: ['القيمة الأصلية', 'زيادة إعادة التصميم'],
                datasets: [{
                    data: [@baseValueSum.ToString(System.Globalization.CultureInfo.InvariantCulture), @redesignValueSum.ToString(System.Globalization.CultureInfo.InvariantCulture)],
                    backgroundColor: ['#7b6bd6', '#e8a33d']
                }]
            },
            options: {
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: (ctx) => ctx.label + ': ' + ctx.raw.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) } }
                }
            }
        });
    </script>
}

<form method="post">
    @Html.AntiForgeryToken()

    @if (showProjectSpecificActions)
    {
        <div style="margin-bottom:8px; display:flex; gap:8px;">
            <button type="submit" formaction="@Url.Action("ExportClaimsSelectedPdf")" formmethod="post" formtarget="_blank" name="projectId" value="@projectId" class="btn-line btn-line-accent">📑 تصدير (PDF)</button>
            <input type="hidden" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="returnAction" value="Claims" />
            <a asp-action="Receipts" asp-route-projectId="@projectId" class="btn-line">🧾 سجل الإيصالات</a>
        </div>
    }

    <div class="data-table data-table-compact" style="--cols: @(showProjectSpecificActions ? "32px" : "0px") 55px 1fr 1fr 70px 75px 85px 65px 90px 80px 85px 230px">
        <div class="data-table-head">
            <div class="cell"></div>
            <div class="cell"><span>رقم المشروع</span></div>
            <div class="cell"><span>المشروع</span></div>
            <div class="cell"><span>بيان التكليف</span></div>
            <div class="cell"><span>مساحة التكليف</span></div>
            <div class="cell"><span>سعر متر البيع</span></div>
            <div class="cell"><span>قيمة البيع</span></div>
            <div class="cell"><span>نسبة إعادة التصميم</span></div>
            <div class="cell"><span>الإجمالي</span></div>
            <div class="cell"><span>المحقق</span></div>
            <div class="cell"><span>المستحق</span></div>
            <div class="cell"><span>الحالة</span></div>
        </div>

        @if (!Model.Any())
        {
            <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مطالبات مُرحَّلة بعد</div></div>
        }
        else
        {
            @foreach (var c in Model)
            {
                var remaining = c.RemainingAmount;
                <div class="data-table-row">
                    <div class="cell">
                        @if (showProjectSpecificActions)
                        {
                            <input type="checkbox" name="claimIds" value="@c.Id" />
                        }
                    </div>
                    <div class="cell cell-num">@(c.Project?.Code ?? "-")</div>
                    <div class="cell">@(c.Project?.Name ?? "-")</div>
                    <div class="cell">@(c.ProjectAssignment?.Stage?.Name ?? "-")</div>
                    <div class="cell cell-num">@(c.Area?.ToString("N2") ?? "-")</div>
                    <div class="cell cell-num">@(c.SalePricePerMeter?.ToString("N2") ?? "-")</div>
                    <div class="cell cell-num">@c.Value.ToString("N2")</div>
                    <div class="cell cell-num">@(c.RedesignIncreasePercentage?.ToString("N2") + "%" ?? "-")</div>
                    <div class="cell cell-num">@c.RealValue.ToString("N2")</div>
                    <div class="cell cell-num">@c.PaidAmount.ToString("N2")</div>
                    <div class="cell cell-num">@remaining.ToString("N2")</div>
                    <div class="cell">
                        <a asp-action="ClaimPaymentsHistory" asp-route-claimId="@c.Id" style="font-size:9px; display:block; margin-bottom:3px;">سجل الدفعات</a>
                        @if (c.IsClientSettled)
                        {
                            <span class="tag tag-success">تم التحصيل (@c.ClientSettledAt?.ToString("yyyy-MM-dd"))</span>
                        }
                        else
                        {
                            <div style="display:flex; gap:3px; align-items:center;">
                                <input type="number" step="0.01" min="0.01" max="@remaining.ToString(System.Globalization.CultureInfo.InvariantCulture)" name="amount_@c.Id" onkeydown="if(event.key==='Enter'){event.preventDefault();}" style="width:100px; height:28px; font-size:12px; padding:0 6px; border:1px solid #e4e2ec; border-radius:5px;" placeholder="مبلغ" />
                                <button type="submit" formaction="@Url.Action("RegisterClaimPayment", new { claimId = c.Id, projectId = c.ProjectId, returnAction = "Claims" })" formmethod="post" formtarget="_self" class="btn-line btn-line-accent" style="height:20px; padding:0 6px; font-size:8.5px;" onclick="return confirm('تأكيد تسجيل هذه الدفعة؟');">دفع</button>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</form>