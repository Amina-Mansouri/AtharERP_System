@{
    ViewData["Title"] = "تسجيل الدخول";
    ViewData["HideNav"] = true;
    ViewData["AuthTheme"] = "ds";
}

<div class="ds-auth-card">
    <img src="~/images/logo-icon.png" alt="أثر" class="ds-auth-logo" />
    <span class="ds-auth-brand">أثر</span>
    <span class="ds-auth-kicker">نظام إدارة المشاريع الهندسية</span>

    <form method="post" asp-controller="Account" asp-action="Login">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="ds-field">
            <label>البريد الإلكتروني</label>
            <input type="email" name="email" required autofocus />
        </div>

        <div class="ds-field">
            <label>كلمة المرور</label>
            <input type="password" name="password" required />
        </div>

        <div class="ds-auth-row">
            <label>
                <input type="checkbox" name="rememberMe" value="true" />
                <input type="hidden" name="rememberMe" value="false" />
                تذكّرني
            </label>
            <a asp-controller="Account" asp-action="ForgotPassword">نسيت كلمة المرور؟</a>
        </div>

        <button type="submit" class="ds-btn-gold-block">تسجيل الدخول</button>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="ds-alert-gold">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>@error.ErrorMessage</span>
                }
                <span class="ds-alert-sub">يُقفل الحساب بعد ٥ محاولات فاشلة</span>
            </div>
        }
    </form>

    <div class="ds-auth-footer">الحسابات غير النشطة لا تستطيع الدخول</div>
</div>