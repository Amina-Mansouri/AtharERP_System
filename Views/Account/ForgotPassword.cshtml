@{
    ViewData["Title"] = "نسيت كلمة المرور";
    ViewData["HideNav"] = true;
}

<div class="athar-auth-card">
    <partial name="_AuthLogo" />
    <p class="athar-auth-subtitle">استعادة كلمة المرور</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <p class="text-muted small">أدخل بريدك الإلكتروني المسجل وسنرسل لك رابطاً لإعادة تعيين كلمة المرور.</p>

    <form method="post" asp-controller="Account" asp-action="ForgotPassword">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">البريد الإلكتروني</label>
            <input type="email" name="email" class="form-control" required autofocus />
        </div>

        <button type="submit" class="btn athar-btn w-100">إرسال رابط إعادة التعيين</button>
        <a asp-controller="Account" asp-action="Login" class="btn athar-btn-outline w-100 mt-2">العودة لتسجيل الدخول</a>
    </form>
</div>