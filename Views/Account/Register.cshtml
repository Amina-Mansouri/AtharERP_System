@using AtharERP_System.Models.Entities
@{
    ViewData["Title"] = "إضافة مستخدم جديد";
    ViewData["HideNav"] = true;
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
}

<div class="athar-auth-card athar-auth-card-wide">
    <h1 class="athar-auth-title">أثر</h1>
    <p class="athar-auth-subtitle">إضافة مستخدم جديد</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-controller="Account" asp-action="Register">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">الاسم الكامل</label>
                <input type="text" name="fullName" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">البريد الإلكتروني</label>
                <input type="email" name="email" class="form-control" required />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">كلمة المرور</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">تأكيد كلمة المرور</label>
                <input type="password" name="confirmPassword" class="form-control" required />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">المسمى الوظيفي</label>
                <input type="text" name="jobTitle" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">القسم</label>
                <input type="text" name="department" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">درجة المهندس</label>
                <select name="engineerRank" class="form-select">
                    <option value="None">غير محدد</option>
                    <option value="Junior">مبتدئ</option>
                    <option value="MidLevel">متوسط</option>
                    <option value="Senior">خبير</option>
                    <option value="Lead">رئيسي</option>
                    <option value="Principal">استشاري</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">رقم الهاتف</label>
                <input type="tel" name="phoneNumber" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">الدور</label>
                <select name="role" class="form-select" required>
                    <option value="">-- اختر الدور --</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">نصف القطر المسموح (متر)</label>
                <input type="number" step="any" name="allowedRadiusMeters" class="form-control" value="100" />
            </div>
        </div>

        <div class="athar-map-section mb-3">
            <label class="form-label d-block">تحديد موقع الحضور المتوقع (اختياري)</label>
            <p class="athar-map-hint">انقر على الخريطة لتحديد الموقع، أو اسحب العلامة بعد وضعها لتعديل الموقع</p>

            <div class="mb-2">
                <label class="form-label">اسم الموقع</label>
                <input type="text" id="expectedLocationName" name="expectedLocationName" class="form-control"
                       placeholder="يُعبَّأ تلقائياً بعد اختيار نقطة على الخريطة، ويمكنك تعديله يدوياً" />
            </div>

            <div id="register-map" class="athar-map"></div>

            <div class="athar-coords-display mt-2" id="register-coords-display">لم يتم تحديد موقع بعد</div>

            <input type="hidden" id="expectedLatitude" name="expectedLatitude" />
            <input type="hidden" id="expectedLongitude" name="expectedLongitude" />
        </div>

        <button type="submit" class="btn athar-btn w-100">إنشاء المستخدم</button>
        <a asp-controller="Admin" asp-action="Users" class="btn athar-btn-outline w-100 mt-2">إلغاء</a>
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/location-picker.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initAtharLocationPicker({
                mapId: 'register-map',
                latInputId: 'expectedLatitude',
                lngInputId: 'expectedLongitude',
                nameInputId: 'expectedLocationName',
                coordsDisplayId: 'register-coords-display'
            });
        });
    </script>
}