@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
    ViewData["HideNav"] = true;
    var email = ViewBag.Email as string;
    var token = ViewBag.Token as string;
}

<div class="athar-auth-card">
    <partial name="_AuthLogo" />
    <p class="athar-auth-subtitle">تعيين كلمة مرور جديدة</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-controller="Account" asp-action="ResetPassword">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@email" />
        <input type="hidden" name="token" value="@token" />

        <div class="mb-3">
            <label class="form-label">كلمة المرور الجديدة</label>
            <input type="password" name="newPassword" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">تأكيد كلمة المرور الجديدة</label>
            <input type="password" name="confirmPassword" class="form-control" required />
        </div>

        <button type="submit" class="btn athar-btn w-100">تحديث كلمة المرور</button>
    </form>
</div>