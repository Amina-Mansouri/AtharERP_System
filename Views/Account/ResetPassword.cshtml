@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
    ViewData["HideNav"] = true;
    var email = ViewBag.Email as string;
    var token = ViewBag.Token as string;
}

<div class="athar-auth-card">
    <partial name="_AuthLogo" />
    <p class="athar-auth-subtitle">تعيين كلمة مرور جديدة</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-controller="Account" asp-action="ResetPassword">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@email" />
        <input type="hidden" name="token" value="@token" />

        <div class="mb-3">
            <label class="form-label">كلمة المرور الجديدة</label>
            <div class="pwd-wrap">
                <input type="password" name="newPassword" class="form-control" required style="padding-left:34px;" />
                <button type="button" tabindex="-1" class="pwd-toggle" onclick="togglePwd(this)">
                    <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <svg class="eye-off" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0112 20c-7 0-11-8-11-8a21.8 21.8 0 015.06-6.06M9.9 4.24A10.94 10.94 0 0112 4c7 0 11 8 11 8a21.77 21.77 0 01-3.22 4.53M14.12 14.12a3 3 0 11-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                </button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">تأكيد كلمة المرور الجديدة</label>
            <div class="pwd-wrap">
                <input type="password" name="confirmPassword" class="form-control" required style="padding-left:34px;" />
                <button type="button" tabindex="-1" class="pwd-toggle" onclick="togglePwd(this)">
                    <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <svg class="eye-off" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0112 20c-7 0-11-8-11-8a21.8 21.8 0 015.06-6.06M9.9 4.24A10.94 10.94 0 0112 4c7 0 11 8 11 8a21.77 21.77 0 01-3.22 4.53M14.12 14.12a3 3 0 11-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                </button>
            </div>
        </div>

        <button type="submit" class="btn athar-btn w-100">تحديث كلمة المرور</button>
    </form>
</div>