@using AtharERP_System.Models.Entities
@model List<ClientRedesignRequest>
@{
    var stage = ViewBag.Stage as ProjectStage;
    ViewData["Title"] = $"طلبات إعادة التصميم - {stage?.Name}";
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@stage?.Project?.Name</div>
        <h1 class="athar-page-title" style="margin-top:2px;">طلبات إعادة التصميم - @stage?.Name</h1>
    </div>
    <a asp-controller="Projects" asp-action="Details" asp-route-id="@stage?.ProjectId" class="btn-line">العودة للمشروع</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="data-table" style="--cols: 130px 90px 1fr 90px">
    <div class="data-table-head">
        <div class="cell">تاريخ الطلب</div>
        <div class="cell">نسبة الزيادة</div>
        <div class="cell">ملاحظات</div>
        <div class="cell">إجراءات</div>
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد طلبات إعادة تصميم مسجَّلة بعد</div></div>
    }
    else
    {
        @foreach (var r in Model)
        {
            <div class="data-table-row">
                <div class="cell cell-num">@r.RequestDate.ToString("yyyy-MM-dd")</div>
                <div class="cell cell-num">@r.IncreasePercentage.ToString("N2")%</div>
                <div class="cell">@(r.Notes ?? "-")</div>
                <div class="cell">
                    <form method="post" asp-action="Delete" asp-route-id="@r.Id" onsubmit="return confirm('حذف هذا الطلب؟');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-line" style="color:#c94a42;">حذف</button>
                    </form>
                </div>
            </div>
        }
    }
</div>

@{
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
}
<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px; margin-top:12px;">
    <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">تسجيل طلب إعادة تصميم جديد + إنشاء تكليفه</div>
    <form method="post" asp-action="Create" style="display:grid; gap:8px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ProjectStageId" value="@stage?.Id" />
        <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:8px;">
            <div>
                <label class="form-label" style="font-size:11px;">نسبة الزيادة (%)</label>
                <input type="number" step="0.01" name="IncreasePercentage" class="form-control form-control-sm" required />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">ملاحظات</label>
                <input type="text" name="Notes" class="form-control form-control-sm" />
            </div>
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">عنوان مهمة إعادة التصميم</label>
            <input type="text" name="redesignTaskTitle" class="form-control form-control-sm" required />
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">المهندسة المسؤولة</label>
            <select name="engineerIds" multiple required class="form-select form-select-sm" style="height:70px;">
                @foreach (var eng in engineers)
                {
                    <option value="@eng.Id">@eng.FullName</option>
                }
            </select>
        </div>
        <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:8px;">
            <div>
                <label class="form-label" style="font-size:11px;">تاريخ بداية التكليف</label>
                <input type="date" name="plannedStartDate" class="form-control form-control-sm" required />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">تاريخ نهاية التكليف</label>
                <input type="date" name="plannedEndDate" class="form-control form-control-sm" required />
            </div>
        </div>
        <button type="submit" class="btn-line btn-line-accent">+ تسجيل الطلب وإنشاء التكليف</button>
    </form>
</div>