@{
    ViewData["Title"] = "دخول المقاول";
    ViewData["HideNav"] = true;
    ViewData["AuthTheme"] = "ds";
}

<style>
    .athar-auth-wrapper.ds-auth-wrap {
        background: #f8f7fb !important;
    }

    .purple-auth-card {
        background: #fff;
        border: 1px solid #ecebf2;
        border-radius: 14px;
        padding: 38px 36px;
        width: 100%;
        max-width: 392px;
        box-shadow: 0 2px 10px rgba(36,31,51,.06);
    }

        .purple-auth-card img {
            display: block;
            margin: 0 auto 12px;
            max-height: 52px;
        }

        .purple-auth-card .brand {
            text-align: center;
            font-size: 19px;
            font-weight: 600;
            margin-bottom: 6px;
            color: #241f33;
        }

        .purple-auth-card .sub-brand {
            text-align: center;
            font-size: 11.5px;
            color: #8a83a0;
            margin-bottom: 24px;
        }

        .purple-auth-card .field {
            margin-bottom: 13px;
        }

            .purple-auth-card .field label {
                display: block;
                font-size: 11.5px;
                color: #5a5370;
                margin-bottom: 6px;
            }

            .purple-auth-card .field input {
                width: 100%;
                height: 38px;
                border: 1px solid #e4e2ec;
                border-radius: 9px;
                background: #faf9fd;
                padding: 0 12px;
                font-size: 12.5px;
                font-family: inherit;
            }

        .purple-auth-card .btn-purple {
            width: 100%;
            height: 40px;
            border: none;
            border-radius: 9px;
            background: #7b6bd6;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            margin-top: 7px;
        }

            .purple-auth-card .btn-purple:hover {
                background: #6455c4;
            }

        .purple-auth-card .alert-purple {
            margin-top: 14px;
            font-size: 11.5px;
            color: #c94a42;
            background: rgba(227,93,84,.07);
            border: 1px solid rgba(227,93,84,.3);
            border-radius: 8px;
            padding: 9px 11px;
        }
</style>

<div class="purple-auth-card">
    <img src="~/images/logo-full.png" alt="أثر" />
    <div class="brand">منظومة أثر</div>
    <div class="sub-brand">بوابة المقاولين</div>

    <form method="post" asp-controller="ContractorPortal" asp-action="Login">
        @Html.AntiForgeryToken()

        <div class="field">
            <label>البريد الإلكتروني</label>
            <input type="email" name="email" required autofocus style="direction:ltr; text-align:right;" />
        </div>

        <div class="field">
            <label>كلمة المرور</label>
            <div class="pwd-wrap">
                <input type="password" name="password" required style="padding-left:34px;" />
                <button type="button" tabindex="-1" class="pwd-toggle" onclick="togglePwd(this)">
                    <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <svg class="eye-off" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0112 20c-7 0-11-8-11-8a21.8 21.8 0 015.06-6.06M9.9 4.24A10.94 10.94 0 0112 4c7 0 11 8 11 8a21.77 21.77 0 01-3.22 4.53M14.12 14.12a3 3 0 11-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                </button>
            </div>
        </div>

        <button type="submit" class="btn-purple">تسجيل الدخول</button>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-purple">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }
    </form>
</div>