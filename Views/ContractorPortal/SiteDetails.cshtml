@using AtharERP_System.Models.Entities
@{
    var site = ViewBag.Site as Site;
    var correspondences = ViewBag.Correspondences as List<SiteCorrespondence> ?? new List<SiteCorrespondence>();
    ViewData["Title"] = site?.Name;

    string OpStatusLabel(OperationStatus s) => s switch
    {
        OperationStatus.NotStarted => "لم تبدأ",
        OperationStatus.InProgress => "قيد التنفيذ",
        OperationStatus.Completed => "مكتملة",
        OperationStatus.Delayed => "متأخرة",
        OperationStatus.OnHold => "متوقفة",
        _ => s.ToString()
    };

    string OpStatusTagClass(OperationStatus s) => s switch
    {
        OperationStatus.Completed => "tag-success",
        OperationStatus.Delayed => "tag-danger",
        OperationStatus.InProgress => "tag-accent",
        OperationStatus.OnHold => "tag-warning",
        _ => "tag-muted"
    };

    string StatusLabel(SiteCorrespondence c) => c.IsFromContractor
        ? (c.Status == CorrespondenceStatus.Pending ? "في انتظار الاعتماد" : "معتمد")
        : (c.Status == CorrespondenceStatus.Pending ? "في انتظار قبول الطلب" : "مقبول");

    string StatusTagClass(SiteCorrespondence c) => c.Status == CorrespondenceStatus.Resolved ? "tag-success" : "tag-accent";
}

<div style="max-width:1100px; margin:30px auto; padding:0 16px;">
    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
        <div>
            <div style="font-size:11px; color:var(--sys-text-light);">@site?.Code</div>
            <h1 class="athar-page-title" style="margin-top:2px;">@site?.Name</h1>
        </div>
        <a asp-controller="ContractorPortal" asp-action="Dashboard" class="btn-line">العودة لمواقعي</a>
    </div>

    <div style="font-size:13.5px; font-weight:600; margin:18px 0 8px;">مراحل العمل</div>
    <div class="data-table" style="--cols: 1.1fr 90px 70px 130px 130px;">
        <div class="data-table-head">
            <div class="cell">المرحلة</div>
            <div class="cell">الحالة</div>
            <div class="cell">%</div>
            <div class="cell">بدء فعلي</div>
            <div class="cell">انتهاء فعلي</div>
        </div>

        @if (site == null || !site.Operations.Any())
        {
            <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مراحل عمل مضافة بعد</div></div>
        }
        else
        {
            @foreach (var op in site.Operations.OrderBy(o => o.Sequence))
            {
                <div class="data-table-row">
                    <div class="cell">@op.Sequence. @op.Name</div>
                    <div class="cell"><span class="tag @OpStatusTagClass(op.Status)">@OpStatusLabel(op.Status)</span></div>
                    <div class="cell cell-num">@op.CompletionPercentage.ToString("N0")%</div>
                    <div class="cell cell-num">@(op.ActualStartDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                    <div class="cell cell-num">@(op.ActualEndDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                </div>
            }
        }
    </div>

    <div id="replyBanner" style="display:none; background:#f1eefc; border:1px solid var(--sys-border); border-radius:6px; padding:6px 10px; margin-bottom:8px; font-size:11.5px; display:flex; justify-content:space-between; align-items:center;">
        <span>سيُرسَل هذا كرد على الطلب المحدد</span>
        <button type="button" class="btn-line" style="font-size:10px; padding:2px 6px;" onclick="cancelReply()">إلغاء الرد</button>
    </div>
    <div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px;">
        <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">إرسال مراسلة للشركة</div>
        <form method="post" asp-controller="ContractorPortal" asp-action="SendCorrespondence" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:10px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site?.Id" />
            <input type="hidden" name="parentCorrespondenceId" id="parentCorrespondenceId" value="" />
            <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
                <div>
                    <label class="form-label" style="font-size:11px;">الأولوية</label>
                    <select name="priority" class="form-select form-select-sm">
                        <option value="Normal">عادية</option>
                        <option value="High">عالية</option>
                        <option value="Urgent">عاجلة</option>
                    </select>
                </div>
                <div>
                    <label class="form-label" style="font-size:11px;">تاريخ الرد المطلوب</label>
                    <input type="date" name="requiredResponseDate" class="form-control form-control-sm" />
                </div>
                <div>
                    <label class="form-label" style="font-size:11px;">المرفقات (يمكن اختيار أكثر من ملف)</label>
                    <input type="file" name="attachments" multiple class="form-control form-control-sm" />
                </div>
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">تفاصيل الاستفسار</label>
                <textarea name="detailedQuery" id="detailedQueryInput" class="form-control" rows="3" required></textarea>
            </div>
            <div>
                <button type="submit" class="btn-line btn-line-accent">+ إرسال</button>
            </div>
        </form>
    </div>

    <div id="replyBanner" style="display:none; background:#f1eefc; border:1px solid var(--sys-border); border-radius:6px; padding:6px 10px; margin-bottom:8px; font-size:11.5px; display:flex; justify-content:space-between; align-items:center;">
        <span>سيُرسَل هذا كرد على الطلب المحدد</span>
        <button type="button" class="btn-line" style="font-size:10px; padding:2px 6px;" onclick="cancelReply()">إلغاء الرد</button>
