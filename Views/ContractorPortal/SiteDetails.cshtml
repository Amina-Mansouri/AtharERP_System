@using AtharERP_System.Models.Entities
@{
    ViewData["Title"] = "الموقع";
    var site = ViewBag.Site as Site;
    var dailyReports = ViewBag.DailyReports as List<SiteDailyReport> ?? new List<SiteDailyReport>();
    var qualityChecks = ViewBag.QualityChecks as List<SiteQualityCheck> ?? new List<SiteQualityCheck>();
    var safetyChecks = ViewBag.SafetyChecks as List<SiteSafetyCheck> ?? new List<SiteSafetyCheck>();
    var supplyRequests = ViewBag.SupplyRequests as List<SiteSupplyRequest> ?? new List<SiteSupplyRequest>();
    ViewData["Title"] = site?.Name;
}

<div style="max-width:900px; margin:30px auto; padding:0 16px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <div>
            <div style="font-size:11px; color:#8a83a0;">@site?.Code</div>
            <h1 style="font-size:19px; font-weight:600; margin-top:2px;">@site?.Name</h1>
        </div>
        <a asp-controller="ContractorPortal" asp-action="Dashboard" style="font-size:12px;">العودة لمواقعي ←</a>
    </div>

    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; padding:14px 16px; margin-bottom:14px;">
        <div style="font-size:13px; font-weight:600; margin-bottom:8px;">تقرير يومي جديد</div>
        <form method="post" asp-controller="ContractorPortal" asp-action="CreateDailyReport">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site?.Id" />
            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:8px;">
                <input type="date" name="reportDate" class="form-control form-control-sm" style="max-width:150px;" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                <input type="text" name="weather" class="form-control form-control-sm" style="max-width:130px;" placeholder="حالة الطقس" />
                <input type="number" name="workersCount" class="form-control form-control-sm" style="max-width:110px;" placeholder="عدد العمال" min="0" value="0" />
            </div>
            <textarea name="workCompleted" class="form-control form-control-sm mb-2" rows="2" placeholder="الأعمال المنجزة"></textarea>
            <textarea name="issues" class="form-control form-control-sm mb-2" rows="2" placeholder="المشاكل والعوائق"></textarea>
            <button type="submit" class="btn-line btn-line-accent">+ حفظ التقرير</button>
        </form>
        @if (dailyReports.Any())
        {
            <div style="font-size:11px; color:#8a83a0; margin-top:10px;">آخر تقاريرك: @string.Join("، ", dailyReports.Take(5).Select(r => r.ReportDate.ToString("yyyy-MM-dd")))</div>
        }
    </div>

    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; padding:14px 16px; margin-bottom:14px;">
        <div style="font-size:13px; font-weight:600; margin-bottom:8px;">فحص جودة جديد</div>
        <form method="post" asp-controller="ContractorPortal" asp-action="CreateQualityCheck" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site?.Id" />
            <select name="qualityType" class="form-select form-select-sm">
                <option value="Technical">جودة فنية</option>
                <option value="Site" selected>جودة موقع</option>
                <option value="Financial">جودة مالية</option>
                <option value="Administrative">جودة إدارية</option>
            </select>
            <input type="text" name="checkType" class="form-control form-control-sm" placeholder="نوع الفحص" required />
            <input type="text" name="description" class="form-control form-control-sm" style="flex:1; min-width:180px;" placeholder="الوصف" />
            <button type="submit" class="btn-line btn-line-accent">+ إضافة</button>
        </form>
        @if (qualityChecks.Any(q => !q.IsApproved))
        {
            <div style="font-size:11px; color:#c9700f; margin-top:10px;">لديك @qualityChecks.Count(q => !q.IsApproved) فحص جودة بانتظار الاعتماد</div>
        }
    </div>

    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; padding:14px 16px; margin-bottom:14px;">
        <div style="font-size:13px; font-weight:600; margin-bottom:8px;">فحص سلامة جديد</div>
        <form method="post" asp-controller="ContractorPortal" asp-action="CreateSafetyCheck" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site?.Id" />
            <input type="text" name="checkType" class="form-control form-control-sm" placeholder="نوع الفحص" required />
            <input type="text" name="description" class="form-control form-control-sm" style="flex:1; min-width:180px;" placeholder="الوصف" />
            <button type="submit" class="btn-line btn-line-accent">+ إضافة</button>
        </form>
        @if (safetyChecks.Any(s => !s.IsApproved))
        {
            <div style="font-size:11px; color:#c9700f; margin-top:10px;">لديك @safetyChecks.Count(s => !s.IsApproved) فحص سلامة بانتظار الاعتماد</div>
        }
    </div>

    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; padding:14px 16px;">
        <div style="font-size:13px; font-weight:600; margin-bottom:8px;">طلب توريد جديد</div>
        <form method="post" asp-controller="ContractorPortal" asp-action="CreateSupplyRequest" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site?.Id" />
            <input type="text" name="materialName" class="form-control form-control-sm" placeholder="اسم المادة" required />
            <input type="text" name="dimensions" class="form-control form-control-sm" placeholder="الأبعاد" />
            <input type="number" step="0.01" min="0" name="quantity" class="form-control form-control-sm" style="max-width:100px;" placeholder="الكمية" required />
            <input type="text" name="unit" class="form-control form-control-sm" style="max-width:110px;" placeholder="الوحدة" required />
            <input type="text" name="notes" class="form-control form-control-sm" style="flex:1; min-width:150px;" placeholder="ملاحظات" />
            <button type="submit" class="btn-line btn-line-accent">+ إرسال</button>
        </form>
        @if (supplyRequests.Any())
        {
            <div style="font-size:11px; color:#8a83a0; margin-top:10px;">لديك @supplyRequests.Count(r => r.Status == SiteSupplyStatus.Pending) طلب معلّق</div>
        }
    </div>
</div>