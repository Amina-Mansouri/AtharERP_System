@using AtharERP_System.Models.Entities
@model List<SiteContractor>
@{
    ViewData["Title"] = "لوحة المقاول";
    ViewData["PlainPage"] = true;
    var contractorName = ViewBag.ContractorName as string;
}

<div style="max-width:1000px; margin:30px auto; padding:0 16px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <div>
            <div style="font-size:11px; color:var(--sys-text-light);">بوابة المقاولين</div>
            <h1 class="athar-page-title" style="margin-top:2px;">مرحباً، @contractorName</h1>
        </div>
        <form method="post" asp-controller="ContractorPortal" asp-action="Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-line">تسجيل الخروج</button>
        </form>
    </div>

    <div class="stat-strip stat-strip-text">
        <div class="stat-item"><span class="kicker">مواقعي</span><span class="stat-value">@Model.Count</span></div>
        <div class="stat-item"><span class="kicker">مواقع نشطة</span><span class="stat-value">@Model.Count(sa => sa.Site.Status == SiteStatus.Active)</span></div>
        <div class="stat-item"><span class="kicker">مواقع مكتملة</span><span class="stat-value">@Model.Count(sa => sa.Site.Status == SiteStatus.Completed)</span></div>
    </div>

    <div class="data-table" style="--cols: 90px 1.3fr 110px 1fr 90px;">
        <div class="data-table-head">
            <div class="cell">الرمز</div>
            <div class="cell">الموقع</div>
            <div class="cell">المشروع</div>
            <div class="cell">التخصص</div>
            <div class="cell">الحالة</div>
        </div>

        @if (!Model.Any())
        {
            <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مواقع مرتبطة بحسابك بعد</div></div>
        }
        else
        {
            @foreach (var sa in Model)
            {
                <a asp-controller="ContractorPortal" asp-action="SiteDetails" asp-route-siteId="@sa.SiteId" class="data-table-row" style="text-decoration:none; color:inherit;">
                    <div class="cell cell-num">@sa.Site.Code</div>
                    <div class="cell">@sa.Site.Name</div>
                    <div class="cell">@sa.Site.Project.Name</div>
                    <div class="cell">@(sa.Specialty ?? "-")</div>
                    <div class="cell">
                        <span class="tag @(sa.Site.Status == SiteStatus.Completed ? "tag-accent" : sa.Site.Status == SiteStatus.OnHold ? "tag-warning" : "tag-success")">
                            @(sa.Site.Status == SiteStatus.Active ? "نشط" : sa.Site.Status == SiteStatus.OnHold ? "متوقف" : "مكتمل")
                        </span>
                    </div>
                </a>
            }
        }
    </div>
</div>