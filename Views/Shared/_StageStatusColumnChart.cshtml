@model List<(string StageName, int New, int InProgress, int ClientReview, int Completed, int Delayed)>
@{
    const int maxBarHeight = 170;
    var maxTotal = Model.Any() ? Model.Max(x => x.New + x.InProgress + x.ClientReview + x.Completed + x.Delayed) : 0;
    var grandTotal = Model.Sum(x => x.New + x.InProgress + x.ClientReview + x.Completed + x.Delayed);
    var segments = new (string Key, string Label, string Color)[]
    {
        ("New", "جديدة", "#8a83a0"),
        ("InProgress", "قيد التنفيذ", "#7b6bd6"),
        ("ClientReview", "مراجعة العميل", "#5090b0"),
        ("Completed", "مكتملة", "#2f8a57"),
        ("Delayed", "متأخرة", "#c94a42"),
    };
}
@if (!Model.Any())
{
    <div style="font-size:12.5px; color:var(--sys-text-light); padding:20px 0;">لا توجد مراحل مسجَّلة بعد.</div>
}
else
{
    <div style="display:flex; align-items:flex-end; gap:20px; overflow-x:auto; padding:10px 4px 6px;">
        @foreach (var row in Model)
        {
            var total = row.New + row.InProgress + row.ClientReview + row.Completed + row.Delayed;
            var pct = grandTotal > 0 ? (decimal)total / grandTotal * 100m : 0m;
            var scale = maxTotal > 0 ? (decimal)maxBarHeight / maxTotal : 0;
            var counts = new Dictionary<string, int>
            {
                ["New"] = row.New,
                ["InProgress"] = row.InProgress,
                ["ClientReview"] = row.ClientReview,
                ["Completed"] = row.Completed,
                ["Delayed"] = row.Delayed
            };
            <div style="display:flex; flex-direction:column; align-items:center; min-width:92px; flex:none;">
                <div style="display:flex; align-items:baseline; gap:4px; margin-bottom:6px;">
                    <span style="font-size:13px; font-weight:700; color:var(--sys-text); font-variant-numeric:tabular-nums;">@total</span>
                    <span style="font-size:10.5px; font-weight:600; color:var(--sys-primary,#7b6bd6); font-variant-numeric:tabular-nums;">(@pct.ToString("N0")%)</span>
                </div>
                <div style="display:flex; flex-direction:column-reverse; gap:1px; width:38px; min-height:4px;">
                    @foreach (var seg in segments)
                    {
                        var cnt = counts[seg.Key];
                        if (cnt > 0)
                        {
                            var h = Math.Max(3m, cnt * scale);
                            <div title="@(seg.Label): @cnt" style="height:@(h.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))px; background:@seg.Color; border-radius:3px;"></div>
                        }
                    }
                </div>
                <div style="font-size:11px; color:var(--sys-text-light); font-weight:500; text-align:center; margin-top:8px; max-width:96px; line-height:1.4;">@row.StageName</div>
            </div>
        }
    </div>
    <div style="display:flex; gap:14px; flex-wrap:wrap; margin-top:10px; padding-top:10px; border-top:1px solid var(--sys-border);">
        @foreach (var seg in segments)
        {
            <div style="display:flex; align-items:center; gap:6px; font-size:11px;">
                <span style="width:10px; height:10px; border-radius:3px; background:@seg.Color; display:inline-block;"></span>
                <span style="color:var(--sys-text-light);">@seg.Label</span>
            </div>
        }
    </div>
}