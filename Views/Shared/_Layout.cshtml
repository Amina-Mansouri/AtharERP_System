@using AtharERP_System.Services
@using Microsoft.AspNetCore.Identity
@using AtharERP_System.Models.Entities
@inject PermissionService PermissionService
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - أثر لإدارة المشاريع الهندسية</title>
    <link rel="icon" type="image/png" href="~/images/logo-badge.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (ViewData["HideNav"] as bool? == true)
    {
        <div class="athar-auth-wrapper @(ViewData["AuthTheme"] as string == "ds" ? "ds-auth-wrap" : "")">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    }
    else if (ViewData["PlainPage"] as bool? == true)
    {
        <div style="background:var(--sys-bg); min-height:100vh; padding:24px 0;">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" style="max-width:1100px; margin:0 auto 12px;" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" style="max-width:1100px; margin:0 auto 12px;" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    }
    else
    {
        var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
        var currentRole = currentUser != null
            ? (await UserManager.GetRolesAsync(currentUser)).FirstOrDefault()
            : null;

        bool canUsers = User.IsInRole("مدير النظام");
        bool canRoles = canUsers;
        bool canDepartments = canUsers;
        bool canProjects = await PermissionService.HasPermissionAsync(User, "Projects.ViewOwn") || await PermissionService.HasPermissionAsync(User, "Projects.ViewAll");
        bool canClients = await PermissionService.HasPermissionAsync(User, "PR.Clients");
        bool canSites = await PermissionService.HasPermissionAsync(User, "Sites.View");
        bool canViewAssignments = await PermissionService.HasPermissionAsync(User, "Projects.Assignments.View");
        string activeSystem = ViewContext.RouteData.Values["controller"]?.ToString() switch
        {
            "Admin" => "sys01",
            "Projects" or "ProjectTasks" or "ProjectStages" => "sys02",
            "Sites" or "SiteContractors" or "Contractors" or "SiteChecks" or "SiteDailyReports" or "SiteDocuments" or "SiteMaintenance" or "SiteSupplyRequests" => "sys03",
            "Clients" => "sys07",
            _ => ""
        };

        <header class="app-topbar">
            <img src="~/images/logo-icon.png" alt="أثر" class="ds-logo" />
            <span class="ds-brand">منظومة أثر</span>
            <div class="topbar-spacer"></div>
            <div class="topbar-search-wrap">
                <input type="text" class="ds-search" placeholder="بحث شامل…" />
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20l-3.5-3.5"></path>
                </svg>
            </div>
            <a class="ds-bell" asp-controller="Notifications" asp-action="Index" title="الإشعارات">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                @await Component.InvokeAsync("NavCounters")
            </a>
            @if (currentUser != null)
            {
                <div class="ds-user-chip">
                    <div class="ds-user-text">
                        <span class="ds-user-name">@currentUser.FullName</span>
                        <span class="ds-role">@(currentRole ?? currentUser.Email)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(currentUser.ProfilePhotoPath))
                    {
                        <img src="@currentUser.ProfilePhotoPath" alt="@currentUser.FullName" class="ds-avatar" />
                    }
                    else
                    {
                        <div class="ds-avatar-placeholder">@(currentUser.FirstName.Length > 0 ? currentUser.FirstName.Substring(0, 1) : "")@(currentUser.LastName.Length > 0 ? currentUser.LastName.Substring(0, 1) : "")</div>
                    }
                </div>
            }
            else
            {
                <a class="btn-line" asp-controller="Account" asp-action="Login">دخول</a>
            }
        </header>

        <div class="app-body">
            <nav class="app-sidebar">
                <div class="sidebar-scroll sb">
                    <div class="nav-section-title">وصول سريع</div>
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">الرئيسية</a>
                @if (canProjects)
                {
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")"
                       asp-controller="Projects" asp-action="Index">المشاريع</a>
                }
                @if (canSites)
                {
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sites" ? "active" : "")"
                       asp-controller="Sites" asp-action="Index">المواقع</a>
                }
                @if (canUsers)
                {
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")"
                       asp-controller="Admin" asp-action="Users">الموظفون</a>
                }

                <div class="nav-quick-divider"></div>
                <div class="nav-section-title">الإدارات</div>

                @if (canUsers || canRoles || canDepartments)
                {
                    <div class="nav-group">
                        <button type="button" class="nav-group-header @(activeSystem == "sys01" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys01">
                            <span>الصلاحيات والمصادقة <span class="tag tag-success">كاملة</span></span>
                            <span class="nav-group-caret">▾</span>
                        </button>
                        <div class="collapse @(activeSystem == "sys01" ? "show" : "")" id="sys01">
                            <div class="nav-subgroup-title">الموظفون والصلاحيات</div>
                            @if (canUsers)
                            {
                                <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")"
                                   asp-controller="Admin" asp-action="Users">إدارة الموظفين</a>
                            }
                            @if (canRoles)
                            {
                                <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Roles" ? "active" : "")"
                                   asp-controller="Admin" asp-action="Roles">إدارة الأدوار والصلاحيات</a>
                            }
                            @if (canDepartments)
                            {
                                <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Departments" ? "active" : "")"
                                   asp-controller="Admin" asp-action="Departments">الإدارات والأقسام</a>
                            }
                        </div>
                    </div>
                }

                @if (canProjects)
                {
                    <div class="nav-group">
                        <button type="button" class="nav-group-header @(activeSystem == "sys02" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys02">
                            <span>المشاريع <span class="tag tag-success">كاملة</span></span>
                            <span class="nav-group-caret">▾</span>
                        </button>
                        <div class="collapse @(activeSystem == "sys02" ? "show" : "")" id="sys02">
                            <div class="nav-subgroup-title">المشاريع والتكليفات</div>
                            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")"
                               asp-controller="Projects" asp-action="Index">المشاريع</a>
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProjectStages" ? "active" : "")"
                                   asp-controller="ProjectStages" asp-action="Overview">مراحل المشروع</a>
                                @if (canViewAssignments)
                                {
                                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProjectAssignments" ? "active" : "")"
                                       asp-controller="ProjectAssignments" asp-action="Overview">تكليفات المشروع</a>
                                }
                                <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "MyAssignments" ? "active" : "")"
                                   asp-controller="ProjectAssignments" asp-action="MyAssignments">تكليفاتي</a>
                            <div class="nav-subgroup-title">التسليم والمتابعة</div>
                            <span class="nav-item disabled">المقترحات التصميمية <span class="tag tag-muted">قادمة</span></span>
                            <span class="nav-item disabled">الجدول الزمني العام <span class="tag tag-muted">قادمة</span></span>
                            <div class="nav-subgroup-title">الجودة والوثائق</div>
                            <span class="nav-item disabled">التدقيق والجودة <span class="tag tag-muted">قادمة</span></span>
                            <span class="nav-item disabled">ضبط الوثائق <span class="tag tag-muted">قادمة</span></span>
                        </div>
                    </div>
                }

                    @if (canSites)
                    {
                        <div class="nav-group">
                            <button type="button" class="nav-group-header @(activeSystem == "sys03" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys03">
                                <span>المواقع <span class="tag tag-success">كاملة</span></span>
                                <span class="nav-group-caret">▾</span>
                            </button>
                            <div class="collapse @(activeSystem == "sys03" ? "show" : "")" id="sys03">
                                <div class="nav-subgroup-title">المواقع والعمليات</div>
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sites" ? "active" : "")"
                                   asp-controller="Sites" asp-action="Index">إدارة المواقع</a>
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SiteContractors" ? "active" : "")"
                                   asp-controller="SiteContractors" asp-action="Index">المقاولون</a>
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contractors" ? "active" : "")"
                                   asp-controller="Contractors" asp-action="Index">حسابات دخول المقاولين</a>
                            </div>
                        </div>
                    }

                <div class="nav-group">
                    <button type="button" class="nav-group-header @(activeSystem == "sys04" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys04">
                        <span>المالية <span class="tag tag-warning">جزئية</span></span>
                        <span class="nav-group-caret">▾</span>
                    </button>
                    <div class="collapse @(activeSystem == "sys04" ? "show" : "")" id="sys04">
                        <span class="nav-item disabled">المطالبات المالية <span class="tag tag-muted">قادمة</span></span>
                        <div class="nav-subgroup-title">بقية النظام — لاحقاً</div>
                        <span class="nav-item disabled">جدول التكاليف العام <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">جدول البيع النهائي <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">الرواتب والمصاريف <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">الأرباح والخسائر <span class="tag tag-muted">قادمة</span></span>
                    </div>
                </div>

                <div class="nav-group">
                    <button type="button" class="nav-group-header @(activeSystem == "sys05" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys05">
                        <span>التوريدات <span class="tag tag-warning">جزئية</span></span>
                        <span class="nav-group-caret">▾</span>
                    </button>
                    <div class="collapse @(activeSystem == "sys05" ? "show" : "")" id="sys05">
                      
                        <span class="nav-item disabled">الموردون <span class="tag tag-muted">قادمة</span></span>
                        <div class="nav-subgroup-title">بقية النظام — لاحقاً</div>
                        <span class="nav-item disabled">المخازن والأصناف <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">أوامر الشراء والاستلام <span class="tag tag-muted">قادمة</span></span>
                    </div>
                </div>

                <div class="nav-group">
                    <button type="button" class="nav-group-header @(activeSystem == "sys06" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys06">
                        <span>الموارد البشرية <span class="tag tag-warning">جزئية</span></span>
                        <span class="nav-group-caret">▾</span>
                    </button>
                    <div class="collapse @(activeSystem == "sys06" ? "show" : "")" id="sys06">
                        <span class="nav-item disabled">لوحة الموارد البشرية <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">الشؤون الإدارية <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">العهد <span class="tag tag-muted">قادمة</span></span>
                        <div class="nav-subgroup-title">بقية النظام — لاحقاً</div>
                        <span class="nav-item disabled">الحضور والانصراف <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">الرواتب والخصومات <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">الإجازات <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">التقييم الوظيفي <span class="tag tag-muted">قادمة</span></span>
                    </div>
                </div>

                @if (canClients)
                {
                    <div class="nav-group">
                        <button type="button" class="nav-group-header @(activeSystem == "sys07" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys07">
                            <span>العلاقات العامة <span class="tag tag-warning">جزئية</span></span>
                            <span class="nav-group-caret">▾</span>
                        </button>
                        <div class="collapse @(activeSystem == "sys07" ? "show" : "")" id="sys07">
                            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clients" ? "active" : "")"
                               asp-controller="Clients" asp-action="Index">العملاء</a>
                            <div class="nav-subgroup-title">بقية النظام — لاحقاً</div>
                            <span class="nav-item disabled">واجهة الزبون <span class="tag tag-muted">قادمة</span></span>
                            <span class="nav-item disabled">المقايسات <span class="tag tag-muted">قادمة</span></span>
                            <span class="nav-item disabled">العقود القانونية <span class="tag tag-muted">قادمة</span></span>
                            <span class="nav-item disabled">الإعلانات والإعلام <span class="tag tag-muted">قادمة</span></span>
                        </div>
                    </div>
                }

                <div class="nav-group">
                    <button type="button" class="nav-group-header @(activeSystem == "sys08" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys08">
                        <span>التقارير <span class="tag tag-warning">جزئية</span></span>
                        <span class="nav-group-caret">▾</span>
                    </button>
                    <div class="collapse @(activeSystem == "sys08" ? "show" : "")" id="sys08">
                        <span class="nav-item disabled">تقارير المشاريع <span class="tag tag-muted">قادمة</span></span>
                        <div class="nav-subgroup-title">بقية النظام — لاحقاً</div>
                        <span class="nav-item disabled">الفواتير وسندات القبض <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">التقارير المالية <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">أداء الموظفين <span class="tag tag-muted">قادمة</span></span>
                    </div>
                </div>

                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="nav-logout">
                        <form method="post" asp-controller="Account" asp-action="Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-logout-btn">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path><path d="M16 17l5-5-5-5M21 12H9"></path></svg>
                                <span>تسجيل الخروج</span>
                            </button>
                            </form>
                        </div>
                    }
                </div>
            </nav>

            <div class="app-content">
                <div class="app-subbar">
                    <button type="button" class="btn-back" onclick="history.back()">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
                        رجوع
                    </button>
                    <div class="app-crumb">
                        @if (!string.IsNullOrEmpty(ViewData["Kicker"] as string))
                        {
                            <span>@ViewData["Kicker"]</span>
                            <span class="crumb-sep">/</span>
                        }
                        <span class="crumb-leaf">@(ViewData["PageTitle"] as string ?? ViewData["Title"] as string)</span>
                    </div>
                </div>
                <div class="app-content-body cs">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            $(function() {
                var d = document.getElementById('nav-counters-data');
                if (!d) return;
                function setBadge(id, val) {
                    var n = parseInt(val, 10);
                    if (n > 0) { $('#' + id).text(n).prop('hidden', false); }
                }
                setBadge('badge-unread', d.dataset.unread);
                setBadge('badge-approvals', d.dataset.approvals);
                setBadge('badge-missing-reports', d.dataset.missingReports);
                setBadge('badge-supply', d.dataset.supply);
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>