@using AtharERP_System.Services
@using Microsoft.AspNetCore.Identity
@using AtharERP_System.Models.Entities
@inject PermissionService PermissionService
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@functions {
    public class NavTrailEntry
    {
        public string Title { get; set; } = "";
        public string Url { get; set; } = "";
    }
}
@{
    var navTrail = new List<NavTrailEntry>();
    if (SignInManager.IsSignedIn(User) && Context.Request.Method == "GET" && ViewData["HideNav"] as bool? != true)
    {
        var currentUrl = Context.Request.Path + Context.Request.QueryString;
        var currentTitle = (ViewData["PageTitle"] as string) ?? (ViewData["Title"] as string) ?? "صفحة";

        var storedTrail = Context.Session.GetString("NavTrail");
        if (!string.IsNullOrEmpty(storedTrail))
        {
            try { navTrail = System.Text.Json.JsonSerializer.Deserialize<List<NavTrailEntry>>(storedTrail) ?? new List<NavTrailEntry>(); }
            catch { navTrail = new List<NavTrailEntry>(); }
        }

        var currentPath = Context.Request.Path.ToString();
        var existingIndex = navTrail.FindIndex(e => e.Url.Split('?')[0] == currentPath);
        if (existingIndex >= 0)
        {
            navTrail = navTrail.Take(existingIndex + 1).ToList();
        }
        else
        {
            navTrail.Add(new NavTrailEntry { Title = currentTitle, Url = currentUrl });
            if (navTrail.Count > 8)
            {
                navTrail = navTrail.Skip(navTrail.Count - 8).ToList();
            }
        }

        Context.Session.SetString("NavTrail", System.Text.Json.JsonSerializer.Serialize(navTrail));
    }
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - أثر لإدارة المشاريع الهندسية</title>
    <link rel="icon" type="image/png" href="~/images/logo-badge.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (ViewData["HideNav"] as bool? == true)
    {
        <div class="athar-auth-wrapper @(ViewData["AuthTheme"] as string == "ds" ? "ds-auth-wrap" : "")">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    }
    else if (ViewData["PlainPage"] as bool? == true)
    {
        <div style="background:var(--sys-bg); min-height:100vh; padding:24px 0;">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" style="max-width:1100px; margin:0 auto 12px;" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" style="max-width:1100px; margin:0 auto 12px;" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    }
    else
    {
        var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
        var currentRole = currentUser != null
            ? (await UserManager.GetRolesAsync(currentUser)).FirstOrDefault()
            : null;

        bool canUsers = User.IsInRole("مدير النظام");
        bool canRoles = canUsers;
        bool canDepartments = canUsers;
        bool canProjects = await PermissionService.HasPermissionAsync(User, "Projects.ViewOwn") || await PermissionService.HasPermissionAsync(User, "Projects.ViewAll");
        bool canClients = await PermissionService.HasPermissionAsync(User, "PR.Clients");
        bool canSites = await PermissionService.HasPermissionAsync(User, "Sites.View");
        bool isDesignEngineer = User.IsInRole("مهندس تصميم");
        bool canViewAssignments = await PermissionService.HasPermissionAsync(User, "Projects.Assignments.View");
        bool canFinance = await PermissionService.HasPermissionAsync(User, "Finance.View")
            || await PermissionService.HasPermissionAsync(User, "Finance.Costs.View")
            || await PermissionService.HasPermissionAsync(User, "Finance.Sales.View")
            || await PermissionService.HasPermissionAsync(User, "Finance.Claims.View")
            || await PermissionService.HasPermissionAsync(User, "Finance.Claims.Manage");
        bool canSupply = await PermissionService.HasPermissionAsync(User, "Supply.View");
        bool canSupplyApprove = await PermissionService.HasPermissionAsync(User, "Supply.Approve");
        bool canAttendance = await PermissionService.HasPermissionAsync(User, "HR.Attendance.View");
        string activeSystem = ViewContext.RouteData.Values["controller"]?.ToString() switch
        {
            "Admin" => "sys01",
            "Projects" or "ProjectTasks" or "ProjectStages" or "ProjectAssignments" or "ProjectDocuments" or "DesignProposals" => "sys02",
            "Sites" or "SiteContractors" or "Contractors" or "SiteChecks" or "SiteDailyReports" or "SiteDocuments" or "SiteMaintenance" => "sys03",
            "Clients" => "sys07",
            "Finance" or "ClientRedesignRequests" or "GeneralExpenses" => "sys04",
            "Vendors" or "Materials" or "SiteSupplyRequests" => "sys05",
            "Attendance" => "sys06",
            _ => ""
        };
        bool expensesSubActive = (ViewContext.RouteData.Values["controller"]?.ToString() == "Finance" && ViewContext.RouteData.Values["action"]?.ToString() == "Expenses")
    || ViewContext.RouteData.Values["controller"]?.ToString() == "GeneralExpenses";
        <header class="app-topbar">
            <img src="~/images/logo-icon.png" alt="أثر" class="ds-logo" />
            <span class="ds-brand">منظومة أثر</span>
            <div class="topbar-spacer"></div>
            <div class="topbar-search-wrap">
                <input type="text" class="ds-search" placeholder="بحث شامل…" />
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20l-3.5-3.5"></path>
                </svg>
            </div>
            @if (canProjects)
            {
                <a class="ds-icon-link" asp-controller="ProjectAssignments" asp-action="MyAssignments" title="تكليفاتي">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke-linecap="round" stroke-linejoin="round" />
                        <rect x="9" y="3" width="6" height="4" rx="1" />
                        <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    @await Component.InvokeAsync("NavCounters", new { slot = "assignments" })
                </a>
            }
            <a class="ds-bell" asp-controller="Notifications" asp-action="Index" asp-route-filter="unread" title="الإشعارات">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                @await Component.InvokeAsync("NavCounters", new { slot = "bell" })
            </a>
            @if (currentUser != null)
            {
                <a asp-controller="Profile" asp-action="Index" class="ds-user-chip" style="text-decoration:none; color:inherit; cursor:pointer;">
                    <div class="ds-user-text">
                        <span class="ds-user-name">@currentUser.FullName</span>
                        <span class="ds-role">@(currentRole ?? currentUser.Email)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(currentUser.ProfilePhotoPath))
                    {
                        <img src="@currentUser.ProfilePhotoPath" alt="@currentUser.FullName" class="ds-avatar" />
                    }
                    else
                    {
                        <div class="ds-avatar-placeholder">@(currentUser.FirstName.Length > 0 ? currentUser.FirstName.Substring(0, 1) : "")@(currentUser.LastName.Length > 0 ? currentUser.LastName.Substring(0, 1) : "")</div>
                    }
                </a>
            }
            else
            {
                <a class="btn-line" asp-controller="Account" asp-action="Login">دخول</a>
            }
        </header>

