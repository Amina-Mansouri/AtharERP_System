                           asp-controller="Sites" asp-action="Index">المواقع</a>
                    }
                @if (canUsers)
                {
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")"
                       asp-controller="Admin" asp-action="Users">الموظفون</a>
                }

                <div class="nav-quick-divider"></div>
