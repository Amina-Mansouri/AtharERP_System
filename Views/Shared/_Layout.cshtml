                                <span class="nav-group-caret">▾</span>
                            </button>
                            <div class="collapse @(activeSystem == "sys01" ? "show" : "")" id="sys01">
                                <div class="nav-subgroup-title">الموظفون والصلاحيات</div>
                                @if (canUsers)
                                {
                                    <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")"
                                       asp-controller="Admin" asp-action="Users">إدارة الموظفين</a>
                                }
                                @if (canRoles)
                                {
                                    <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Roles" ? "active" : "")"
                                       asp-controller="Admin" asp-action="Roles">إدارة الأدوار والصلاحيات</a>
                                }
                                @if (canDepartments)
