@using AtharERP_System.Services
@inject PermissionService PermissionService
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - أثر لإدارة المشاريع الهندسية</title>
    <link rel="icon" type="image/png" href="~/images/logo-badge.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (ViewData["HideNav"] as bool? != true)
    {
        <header>
            <nav class="navbar navbar-expand-lg athar-navbar">
                <div class="container-fluid">
                    <a class="navbar-brand athar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo-icon.png" alt="أثر" class="athar-navbar-logo" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#atharNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="atharNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Dashboard">لوحة التحكم</a>
                            </li>
                            @if (await PermissionService.HasPermissionAsync(User, "Projects.View"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Projects" asp-action="Index">المشاريع</a>
                                </li>
                            }
                            @if (await PermissionService.HasPermissionAsync(User, "Clients.View"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Clients" asp-action="Index">العملاء</a>
                                </li>
                            }
                            @if (User.IsInRole("مدير النظام"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">الإدارة</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">المستخدمون</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Roles">الأدوار والصلاحيات</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Departments">الأقسام</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="@(ViewData["HideNav"] as bool? == true ? "athar-auth-wrapper" : "container athar-content")">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @if (ViewData["HideNav"] as bool? != true)
    {
        <footer class="athar-footer text-center">
            <div class="container d-flex align-items-center justify-content-center gap-2">
                <img src="~/images/logo-icon.png" alt="أثر" class="athar-footer-logo" />
                <span>&copy; @DateTime.Now.Year - جميع الحقوق محفوظة لشركة أثر للتصاميم والاستشارات الهندسية</span>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>