                                       asp-controller="ProjectStages" asp-action="Overview">مراحل المشاريع</a>
                                }
                                @if (canViewAssignments)
                                {
                                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProjectAssignments" ? "active" : "")"
                                       asp-controller="ProjectAssignments" asp-action="Overview">تكليفات المشاريع</a>
                                }
                                @if (isDesignEngineer)
                                {
                                    <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "MyAssignments" ? "active" : "")"
                                       asp-controller="ProjectAssignments" asp-action="MyAssignments">التكليفات</a>
                                }
                            </div>
                        </div>
                    }

                    @if (canSites && !isDesignEngineer)
                    {
                        <div class="nav-group">
                            <button type="button" class="nav-group-header @(activeSystem == "sys03" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys03">
                                <span>المواقع <span class="tag tag-success">كاملة</span></span>
                                <span class="nav-group-caret">▾</span>
                            </button>
                            <div class="collapse @(activeSystem == "sys03" ? "show" : "")" id="sys03">
                                <div class="nav-subgroup-title">المواقع والعمليات</div>
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sites" ? "active" : "")"
                                   asp-controller="Sites" asp-action="Index">إدارة المواقع</a>
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SiteContractors" ? "active" : "")"
                                   asp-controller="SiteContractors" asp-action="Index">المقاولون</a>
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contractors" ? "active" : "")"
                                   asp-controller="Contractors" asp-action="Index">حسابات دخول المقاولين</a>
                            </div>
                        </div>
                    }

                    @if (canFinance)
                    {
                        <div class="nav-group">
                            <button type="button" class="nav-group-header @(activeSystem == "sys04" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys04">
                                <span>المالية <span class="tag tag-warning">قيد التنفيذ</span></span>
                                <span class="nav-group-caret">▾</span>
                            </button>
                            <div class="collapse @(activeSystem == "sys04" ? "show" : "")" id="sys04">
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Finance" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                                   asp-controller="Finance" asp-action="Dashboard">المالية</a>
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Finance" && ViewContext.RouteData.Values["action"]?.ToString() == "Claims" ? "active" : "")"
                                   asp-controller="Finance" asp-action="Claims">المطالبات المالية</a>

                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Finance" && ViewContext.RouteData.Values["action"]?.ToString() == "CostTable" ? "active" : "")"
                                   asp-controller="Finance" asp-action="CostTable">جدول التكاليف العام</a>
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Finance" && ViewContext.RouteData.Values["action"]?.ToString() == "SaleTable" ? "active" : "")"
                                   asp-controller="Finance" asp-action="SaleTable">جدول البيع النهائي</a>
                                <button type="button" class="nav-group-header @(expensesSubActive ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#expensesSubGroup" style="font-size:11.5px; font-weight:600; padding:7px 14px;">
                                    <span>المصروفات</span>
                                    <span class="nav-group-caret">▾</span>
                                </button>
                                <div class="collapse @(expensesSubActive ? "show" : "")" id="expensesSubGroup">
                                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Finance" && ViewContext.RouteData.Values["action"]?.ToString() == "Expenses" ? "active" : "")" style="padding-right:24px;"
                                       asp-controller="Finance" asp-action="Expenses">مصروفات مشاريع</a>
                                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "GeneralExpenses" ? "active" : "")" style="padding-right:24px;"
                                       asp-controller="GeneralExpenses" asp-action="Index">مصروفات عامة</a>
                                </div>     <span class="nav-item disabled">الرواتب <span class="tag tag-muted">قادمة</span></span>
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Finance" && ViewContext.RouteData.Values["action"]?.ToString() == "Profit" ? "active" : "")"
                                   asp-controller="Finance" asp-action="Profit">الأرباح والخسائر</a>
                            </div>
                        </div>
                    }

                    @if (canSupply)
                    {
                        <div class="nav-group">
                            <button type="button" class="nav-group-header @(activeSystem == "sys05" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys05">
                                <span>التوريدات <span class="tag tag-success">كاملة</span></span>
                                <span class="nav-group-caret">▾</span>
                            </button>
                            <div class="collapse @(activeSystem == "sys05" ? "show" : "")" id="sys05">
                                @if (canSupplyApprove)
                                {
                                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vendors" ? "active" : "")"
                                       asp-controller="Vendors" asp-action="Index">الموردون</a>
                                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Materials" ? "active" : "")"
                                       asp-controller="Materials" asp-action="Index">الأصناف</a>
                                }
                                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SiteSupplyRequests" && ViewContext.RouteData.Values["action"]?.ToString() == "AllRequests" ? "active" : "")"
                                   asp-controller="SiteSupplyRequests" asp-action="AllRequests">طلبات التوريد</a>
                            </div>
                        </div>
                    }

                    @if (canUsers || canAttendance)
                    {
                        <div class="nav-group">
                            <button type="button" class="nav-group-header @(activeSystem == "sys06" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys06">
                                <span>شؤون إدارية <span class="tag tag-warning">قيد التنفيذ</span></span>
                            <span class="nav-group-caret">▾</span>
                        </button>
                            <div class="collapse @(activeSystem == "sys06" ? "show" : "")" id="sys06">
                                <span class="nav-item disabled">الموارد البشرية <span class="tag tag-muted">قادمة</span></span>
                                <span class="nav-item disabled">العهد <span class="tag tag-muted">قادمة</span></span>            <div class="nav-subgroup-title">بقية النظام — لاحقاً</div>
                                @if (canAttendance)
                                {
                                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")"
                                       asp-controller="Attendance" asp-action="Index">الحضور والانصراف</a>
                                }
                               
                        <span class="nav-item disabled">الرواتب والخصومات <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">الإجازات <span class="tag tag-muted">قادمة</span></span>
                                <span class="nav-item disabled">التقييم الوظيفي <span class="tag tag-muted">قادمة</span></span>
                            </div>
                        </div>
                    }

                @if (canClients)
                {
                    <div class="nav-group">
                        <button type="button" class="nav-group-header @(activeSystem == "sys07" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys07">
                            <span>العلاقات العامة <span class="tag tag-warning">جزئية</span></span>
                            <span class="nav-group-caret">▾</span>
                        </button>
                        <div class="collapse @(activeSystem == "sys07" ? "show" : "")" id="sys07">
                            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clients" ? "active" : "")"
                               asp-controller="Clients" asp-action="Index">العملاء</a>
                            <div class="nav-subgroup-title">بقية النظام — لاحقاً</div>
                            <span class="nav-item disabled">واجهة الزبون <span class="tag tag-muted">قادمة</span></span>
                            <span class="nav-item disabled">المقايسات <span class="tag tag-muted">قادمة</span></span>
                            <span class="nav-item disabled">العقود القانونية <span class="tag tag-muted">قادمة</span></span>
                            <span class="nav-item disabled">الإعلانات والإعلام <span class="tag tag-muted">قادمة</span></span>
                        </div>
                    </div>
                }

                    @if (canUsers)
                    {
                        <div class="nav-group">
                            <button type="button" class="nav-group-header @(activeSystem == "sys08" ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sys08">
                                <span>التقارير <span class="tag tag-warning">جزئية</span></span>
                        <span class="nav-group-caret">▾</span>
                    </button>
                    <div class="collapse @(activeSystem == "sys08" ? "show" : "")" id="sys08">
                        <span class="nav-item disabled">تقارير المشاريع <span class="tag tag-muted">قادمة</span></span>
                        <div class="nav-subgroup-title">بقية النظام — لاحقاً</div>
                        <span class="nav-item disabled">الفواتير وسندات القبض <span class="tag tag-muted">قادمة</span></span>
                        <span class="nav-item disabled">التقارير المالية <span class="tag tag-muted">قادمة</span></span>
                                <span class="nav-item disabled">أداء الموظفين <span class="tag tag-muted">قادمة</span></span>
                            </div>
                        </div>
                    }

                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="nav-logout">
                        <form method="post" asp-controller="Account" asp-action="Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-logout-btn">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path><path d="M16 17l5-5-5-5M21 12H9"></path></svg>
                                <span>تسجيل الخروج</span>
                            </button>
                            </form>
                        </div>
                    }
                </div>
            </nav>

            <div class="app-content">
                <div class="app-subbar">
