@using Microsoft.AspNetCore.Identity
@using AtharERP_System.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto align-items-lg-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item me-lg-3">
            <span class="nav-link athar-user-greeting">مرحباً، @User.Identity?.Name</span>
        </li>
        <li class="nav-item">
            <form method="post" asp-controller="Account" asp-action="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn athar-btn-outline btn-sm">تسجيل الخروج</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn athar-btn-outline btn-sm" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
        </li>
    }
</ul>