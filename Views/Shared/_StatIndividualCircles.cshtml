@model List<(string Label, int Value, string Color)>
@{
    var total = Model.Sum(s => s.Value);
    const int radius = 22;
    var circumference = 2 * Math.PI * radius;
}
<div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:8px;">
    @foreach (var item in Model)
    {
        var pct = total > 0 ? (decimal)item.Value / total * 100m : 0m;
        var dash = (pct / 100m) * (decimal)circumference;
        var gapLen = (decimal)circumference - dash;
        var dashArray = dash.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + " " + gapLen.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        <div style="display:flex; align-items:center; gap:7px; background:var(--sys-surface); border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:8px 9px;">
            <svg width="38" height="38" viewBox="0 0 52 52" style="transform:rotate(-90deg); flex-shrink:0;">
                <circle cx="26" cy="26" r="@radius" fill="none" stroke="var(--sys-row-line)" stroke-width="6" />
                @if (item.Value > 0)
                {
                    <circle cx="26" cy="26" r="@radius" fill="none" stroke="@item.Color" stroke-width="6" stroke-linecap="round" stroke-dasharray="@dashArray" />
                }
            </svg>
            <div style="min-width:0;">
                <div style="display:flex; align-items:baseline; gap:4px; flex-wrap:wrap;">
                    <span style="font-size:14px; font-weight:700; color:var(--sys-text); font-variant-numeric:tabular-nums;">@item.Value</span>
                    <span style="font-size:10.5px; font-weight:600; color:@item.Color; font-variant-numeric:tabular-nums;">(@pct.ToString("N0")%)</span>
                </div>
                <div style="font-size:10px; color:var(--sys-text-light); font-weight:500; line-height:1.3;">@item.Label</div>
            </div>
        </div>
    }
</div>