@model List<(string Label, int Value, string Color)>
@{
    var total = Model.Sum(s => s.Value);
    const int radius = 26;
    var circumference = 2 * Math.PI * radius;
}
<div style="display:grid; grid-template-columns:repeat(2, 1fr); grid-template-rows:repeat(3, 1fr); gap:10px; flex:1; width:100%;">
    @foreach (var item in Model)
    {
        var pct = total > 0 ? (decimal)item.Value / total * 100m : 0m;
        var dash = (pct / 100m) * (decimal)circumference;
        var gapLen = (decimal)circumference - dash;
        var dashArray = dash.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + " " + gapLen.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        <div style="display:flex; align-items:center; justify-content:center; gap:9px; background:var(--sys-surface); border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:10px;">
            <svg width="46" height="46" viewBox="0 0 60 60" style="transform:rotate(-90deg); flex-shrink:0;">
                <circle cx="30" cy="30" r="@radius" fill="none" stroke="var(--sys-row-line)" stroke-width="7" />
                @if (item.Value > 0)
                {
                    <circle cx="30" cy="30" r="@radius" fill="none" stroke="@item.Color" stroke-width="7" stroke-linecap="round" stroke-dasharray="@dashArray" />
                }
            </svg>
            <div style="min-width:0;">
                <div style="display:flex; align-items:baseline; gap:4px; flex-wrap:wrap;">
                    <span style="font-size:16px; font-weight:700; color:var(--sys-text); font-variant-numeric:tabular-nums;">@item.Value</span>
                    <span style="font-size:11px; font-weight:600; color:@item.Color; font-variant-numeric:tabular-nums;">(@pct.ToString("N0")%)</span>
                </div>
                <div style="font-size:10.5px; color:var(--sys-text-light); font-weight:500; line-height:1.3;">@item.Label</div>
            </div>
        </div>
    }
</div>