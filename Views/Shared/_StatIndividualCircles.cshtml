@model List<(string Label, int Value, string Color)>
@{
    var total = Model.Sum(s => s.Value);
    const int radius = 30;
    var circumference = 2 * Math.PI * radius;
}
<div style="display:flex; gap:12px; flex-wrap:wrap; padding:4px 0 14px;">
    @foreach (var item in Model)
    {
        var pct = total > 0 ? (decimal)item.Value / total * 100m : 0m;
        var dash = (pct / 100m) * (decimal)circumference;
        var gapLen = (decimal)circumference - dash;
        var dashArray = dash.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + " " + gapLen.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        <div style="display:flex; align-items:center; gap:10px; background:var(--sys-surface); border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:9px 14px; min-width:152px;">
            <svg width="52" height="52" viewBox="0 0 68 68" style="transform:rotate(-90deg); flex-shrink:0;">
                <circle cx="34" cy="34" r="@radius" fill="none" stroke="var(--sys-row-line)" stroke-width="8" />
                @if (item.Value > 0)
                {
                    <circle cx="34" cy="34" r="@radius" fill="none" stroke="@item.Color" stroke-width="8" stroke-linecap="round" stroke-dasharray="@dashArray" />
                }
            </svg>
            <div>
                <div style="display:flex; align-items:baseline; gap:5px;">
                    <span style="font-size:17px; font-weight:700; color:var(--sys-text); font-variant-numeric:tabular-nums;">@item.Value</span>
                    <span style="font-size:11.5px; font-weight:600; color:@item.Color; font-variant-numeric:tabular-nums;">(@pct.ToString("N0")%)</span>
                </div>
                <div style="font-size:11px; color:var(--sys-text-light); font-weight:500; margin-top:1px;">@item.Label</div>
            </div>
        </div>
    }
</div>