@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<ComplaintRequest>
@{
    ViewData["Title"] = "الشكاوى";
    bool canManage = (bool)ViewBag.CanManage;
    var managedRequests = ViewBag.ManagedRequests as List<ComplaintRequest> ?? new List<ComplaintRequest>();
    var allEmployees = ViewBag.AllEmployees as List<ApplicationUser> ?? new List<ApplicationUser>();
    string? filterEmployeeId = ViewBag.FilterEmployeeId as string;
    DateTime? filterFrom = ViewBag.FilterFrom as DateTime?;
    DateTime? filterTo = ViewBag.FilterTo as DateTime?;
    string? filterStatus = ViewBag.FilterStatus as string;
    var typeLabels = EnumDisplayHelper.GetDisplayList<ComplaintType>();
    var statusLabels = EnumDisplayHelper.GetDisplayList<ComplaintStatus>();
}

<div class="page-head">
    <div>
        <span class="kicker">شؤون إدارية</span>
        <h1>الشكاوى</h1>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="athar-card" style="margin-bottom:12px; padding:12px 14px;">
    <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">تقديم شكوى</div>
    <form method="post" asp-action="Create" style="display:flex; flex-direction:column; gap:8px;">
        @Html.AntiForgeryToken()
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <div style="min-width:180px;">
                <label class="form-label" style="font-size:11px;">نوع الشكوى</label>
                <select name="type" class="form-select form-select-sm" required>
                    @foreach (var t in typeLabels)
                    {
                        <option value="@t.Value">@t.Label</option>
                    }
                </select>
            </div>
            <div style="flex:1; min-width:220px;">
                <label class="form-label" style="font-size:11px;">الموضوع</label>
                <input type="text" name="subject" class="form-control form-control-sm" required />
            </div>
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">التفاصيل</label>
            <textarea name="description" class="form-control form-control-sm" rows="3" required></textarea>
        </div>
        <div>
            <button type="submit" class="btn-line btn-line-accent">إرسال الشكوى</button>
        </div>
    </form>
</div>

<div class="athar-card" style="margin-bottom:12px;">
    <div class="nav-group-header collapsed" data-bs-toggle="collapse" data-bs-target="#myComplaintsSection" style="cursor:pointer; display:flex; justify-content:space-between; align-items:center; padding:10px 14px; font-size:12.5px; font-weight:600;">
        <span>طلباتي</span>
        <span class="nav-group-caret">▾</span>
    </div>
    <div class="collapse" id="myComplaintsSection">
        @if (!Model.Any())
        {
            <div style="padding:14px; font-size:12px; color:#8a83a0;">لا توجد شكاوى سابقة</div>
        }
        else
        {
            @foreach (var r in Model)
            {
                <div style="padding:12px 14px; border-top:1px solid #f1f0f6;">
                    <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:4px;">
                        <div style="font-size:12.5px; font-weight:600;">@r.Subject <span class="stat-sub">(@typeLabels.FirstOrDefault(x => x.Value == r.Type.ToString()).Label)</span></div>
                        <div>
                            @if (r.Status == ComplaintStatus.Pending)
                            {
                                <span class="tag tag-warning">بانتظار الرد</span>
                            }
                            else
                            {
                                <span class="tag tag-success">تم الرد</span>
                            }
                            @if (!string.IsNullOrEmpty(r.PdfFilePath))
                            {
                                <a href="/Complaints/Download/@r.Id" target="_blank" style="margin-right:6px; font-size:11px;">📄</a>
                            }
                        </div>
                    </div>
                    <div style="font-size:12px; color:#5a5370;">@r.Description</div>
                    @if (r.Status == ComplaintStatus.Resolved)
                    {
                        <div style="font-size:12px; margin-top:6px; padding:8px; background:#f6f4fb; border-radius:6px;"><strong>الرد:</strong> @r.ResolutionNotes</div>
                    }
                </div>
            }
        }
    </div>
</div>

@if (canManage)
{
    <div style="padding:6px 2px; font-size:12.5px; font-weight:700; color:#5a5370;">طلبات المهندسات</div>

    <div class="athar-card">
        <form method="get" asp-action="Index" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end; padding:10px 14px; border-bottom:1px solid #f1f0f6;">
            <div style="min-width:180px;">
                <label class="form-label" style="font-size:11px;">الموظفة</label>
                <select name="filterEmployeeId" class="form-select form-select-sm">
                    <option value="">-- الكل --</option>
                    @foreach (var u in allEmployees)
                    {
                        <option value="@u.Id" selected="@(u.Id == filterEmployeeId ? "selected" : null)">@u.FullName</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">من تاريخ</label>
                <input type="date" name="filterFrom" class="form-control form-control-sm" value="@(filterFrom?.ToString("yyyy-MM-dd"))" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">إلى تاريخ</label>
                <input type="date" name="filterTo" class="form-control form-control-sm" value="@(filterTo?.ToString("yyyy-MM-dd"))" />
            </div>
            <div style="min-width:160px;">
                <label class="form-label" style="font-size:11px;">الحالة</label>
                <select name="filterStatus" class="form-select form-select-sm">
                    <option value="">-- الكل --</option>
                    @foreach (var st in statusLabels)
                    {
                        <option value="@st.Value" selected="@(st.Value == filterStatus ? "selected" : null)">@st.Label</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-line btn-line-accent">تصفية</button>
            <a class="btn-line" asp-action="Index">إعادة تعيين</a>
        </form>
        @if (!managedRequests.Any())
        {
            <div style="padding:14px; font-size:12px; color:#8a83a0;">لا توجد شكاوى مطابقة</div>
        }
        else
        {
            @foreach (var r in managedRequests)
            {
                <div style="padding:12px 14px; border-bottom:1px solid #f1f0f6;">
                    <div style="font-size:12.5px; margin-bottom:4px;"><strong>@r.User?.FullName</strong> — @typeLabels.FirstOrDefault(x => x.Value == r.Type.ToString()).Label — @r.RequestedAt.ToString("yyyy-MM-dd")</div>
                    <div style="font-size:12px; font-weight:600; margin-bottom:4px;">@r.Subject</div>
                    <div style="font-size:12px; color:#5a5370; margin-bottom:8px;">@r.Description</div>
                    @if (r.Status == ComplaintStatus.Pending)
                    {
                        <form method="post" asp-action="Resolve" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <div style="flex:1; min-width:220px;">
                                <label class="form-label" style="font-size:11px;">الرد</label>
                                <input type="text" name="resolutionNotes" class="form-control form-control-sm" required />
                            </div>
                            <button type="submit" class="btn-line btn-line-accent" style="font-size:11px;">إرسال الرد</button>
                        </form>
                    }
                    else
                    {
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                            <div style="font-size:12px; padding:8px; background:#f6f4fb; border-radius:6px;"><strong>الرد:</strong> @r.ResolutionNotes</div>
                            @if (!string.IsNullOrEmpty(r.PdfFilePath))
                            {
                                <a href="/Complaints/Download/@r.Id" target="_blank" class="btn-line" style="font-size:10px;">PDF</a>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
}