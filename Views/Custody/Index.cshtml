@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<CustodyHandover>
@{
    ViewData["Title"] = "العهد";
    var categories = ViewBag.Categories as List<CustodyCategory> ?? new List<CustodyCategory>();
    var items = ViewBag.Items as List<CustodyItem> ?? new List<CustodyItem>();
    var users = ViewBag.Users as List<ApplicationUser> ?? new List<ApplicationUser>();
    var lineStatusLabels = EnumDisplayHelper.GetDisplayList<CustodyLineStatus>();
}

<div class="page-head">
    <div>
        <span class="kicker">شؤون إدارية</span>
        <h1>العهد</h1>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="athar-card" style="margin-bottom:12px; padding:12px 14px;">
    <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">إضافة تصنيف جديد</div>
    <form method="post" asp-action="CreateCategory" style="display:flex; gap:8px; align-items:end;">
        @Html.AntiForgeryToken()
        <input type="text" name="name" class="form-control form-control-sm" placeholder="اسم التصنيف" required style="max-width:220px;" />
        <button type="submit" class="btn-line btn-line-accent">إضافة</button>
    </form>
</div>

<div class="athar-card" style="margin-bottom:12px; padding:12px 14px;">
    <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">كتالوج مواد العهد</div>
    <form method="post" asp-action="CreateItem" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end; margin-bottom:12px;">
        @Html.AntiForgeryToken()
        <div>
            <label class="form-label" style="font-size:11px;">الرمز</label>
            <input type="text" name="code" class="form-control form-control-sm" required />
        </div>
        <div style="min-width:180px;">
            <label class="form-label" style="font-size:11px;">اسم المادة</label>
            <input type="text" name="name" class="form-control form-control-sm" required />
        </div>
        <div style="min-width:160px;">
            <label class="form-label" style="font-size:11px;">التصنيف</label>
            <select name="categoryId" class="form-select form-select-sm" required>
                <option value="">-- اختاري --</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" style="font-size:11px;">الكمية الإجمالية</label>
            <input type="number" name="totalQuantity" min="1" class="form-control form-control-sm" style="max-width:100px;" required />
        </div>
        <button type="submit" class="btn-line btn-line-accent">إضافة للكتالوج</button>
    </form>

    <div class="data-table data-table-compact" style="--cols: 90px 1.2fr 1fr 100px 100px">
        <div class="data-table-head">
            <div class="cell">الرمز</div>
            <div class="cell">المادة</div>
            <div class="cell">التصنيف</div>
            <div class="cell">الإجمالي</div>
            <div class="cell">المتاح</div>
        </div>
        @if (!items.Any())
        {
            <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مواد بالكتالوج بعد</div></div>
        }
        else
        {
            @foreach (var i in items)
            {
                <div class="data-table-row">
                    <div class="cell">@i.Code</div>
                    <div class="cell">@i.Name</div>
                    <div class="cell">@i.Category?.Name</div>
                    <div class="cell cell-num">@i.TotalQuantity</div>
                    <div class="cell cell-num" style="@(i.AvailableQuantity == 0 ? "color:#c94a42;" : "")">@i.AvailableQuantity</div>
                </div>
            }
        }
    </div>
</div>

<div class="athar-card" style="margin-bottom:12px; padding:12px 14px;">
    <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">تسليم عهدة جديدة</div>
    <form method="post" asp-action="CreateHandover" style="display:flex; flex-direction:column; gap:8px;">
        @Html.AntiForgeryToken()
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            <div style="min-width:200px;">
                <label class="form-label" style="font-size:11px;">الموظف المستلم</label>
                <select name="holderId" class="form-select form-select-sm" required>
                    <option value="">-- اختاري --</option>
                    @foreach (var u in users)
                    {
                        <option value="@u.Id">@u.FullName</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">تاريخ التسليم</label>
                <input type="date" name="handedDate" class="form-control form-control-sm" />
            </div>
        </div>

        <div id="handoverItemsContainer" style="display:flex; flex-direction:column; gap:8px;">
            <div class="handover-item-row" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end; border-bottom:1px dashed #e4e2ec; padding-bottom:8px;">
                <div style="min-width:220px;">
                    <label style="font-size:11px; color:#8a83a0;">المادة</label>
                    <select name="itemIds" class="form-select form-select-sm">
                        <option value="">-- اختاري مادة --</option>
                        @foreach (var i in items)
                        {
                            <option value="@i.Id">@i.Name (متاح: @i.AvailableQuantity)</option>
                        }
                    </select>
                </div>
                <div>
                    <label style="font-size:11px; color:#8a83a0;">الكمية</label>
                    <input type="number" name="quantities" min="1" class="form-control form-control-sm" style="max-width:90px;" />
                </div>
                <button type="button" class="btn-line" onclick="removeHandoverItemRow(this)" style="color:#c94a42;">حذف</button>
            </div>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:end;">
            <button type="button" class="btn-line" onclick="addHandoverItemRow()">+ إضافة مادة أخرى</button>
            <button type="submit" class="btn-line btn-line-accent">تسليم العهدة</button>
        </div>
    </form>
</div>

<div class="athar-card">
    <div style="padding:10px 14px; font-size:12.5px; font-weight:600; border-bottom:1px solid #f1f0f6;">سجل تسليم العهد</div>
    @if (!Model.Any())
    {
        <div style="padding:14px; font-size:12px; color:#8a83a0;">لا توجد عهد مسلَّمة بعد</div>
    }
    else
    {
        @foreach (var h in Model)
        {
            <div style="padding:12px 14px; border-bottom:1px solid #f1f0f6;">
                <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:8px;">
                    <div style="font-size:12.5px;"><strong>@h.Holder?.FullName</strong> — @h.HandedDate.ToString("yyyy-MM-dd")</div>
                    <div style="font-size:11px; color:#8a83a0;">
                        جهّزها: @h.CreatedBy?.FullName ·
                        @if (h.HolderConfirmed)
                        {
                            <span class="tag tag-success">تم تأكيد الاستلام (@h.HolderConfirmedAt?.ToString("yyyy-MM-dd"))</span>
                        }
                        else
                        {
                            <span class="tag tag-warning">بانتظار تأكيد الموظف</span>
                        }
                        @if (!string.IsNullOrEmpty(h.PdfFilePath))
                        {
                            <a href="/Custody/Download/@h.Id" target="_blank" style="margin-right:6px;">📄 PDF</a>
                        }
                    </div>
                </div>
                <div class="data-table data-table-compact" style="--cols: 1.5fr 90px 90px 1fr 120px">
                    <div class="data-table-head">
                        <div class="cell">المادة</div>
                        <div class="cell">المُسلَّم</div>
                        <div class="cell">المُعاد</div>
                        <div class="cell">الحالة</div>
                        <div class="cell">إجراء</div>
                    </div>
                    @foreach (var l in h.Lines)
                    {
                        <div class="data-table-row">
                            <div class="cell">@l.Item?.Name</div>
                            <div class="cell cell-num">@l.QuantityHanded</div>
                            <div class="cell cell-num">@l.QuantityReturned</div>
                            <div class="cell">@lineStatusLabels.FirstOrDefault(x => x.Value == l.Status.ToString()).Label</div>
                            <div class="cell">
                                @if (l.Status != CustodyLineStatus.Returned)
                                {
                                    <form method="post" asp-action="ReturnLine" style="display:flex; gap:4px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="lineId" value="@l.Id" />
                                        <input type="number" name="quantity" min="1" max="@(l.QuantityHanded - l.QuantityReturned)" class="form-control form-control-sm" style="max-width:70px;" required />
                                        <button type="submit" class="btn-line" style="font-size:10px;">استرجاع</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="stat-sub">-</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function addHandoverItemRow() {
            var container = document.getElementById('handoverItemsContainer');
            var first = container.querySelector('.handover-item-row');
            var clone = first.cloneNode(true);
            clone.querySelectorAll('input, select').forEach(function (el) {
                if (el.tagName === 'SELECT') { el.selectedIndex = 0; }
                else { el.value = ''; }
            });
            container.appendChild(clone);
        }
        function removeHandoverItemRow(btn) {
            var container = document.getElementById('handoverItemsContainer');
            if (container.querySelectorAll('.handover-item-row').length > 1) {
                btn.closest('.handover-item-row').remove();
            }
        }
    </script>
}