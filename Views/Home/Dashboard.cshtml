@using AtharERP_System.Models.Entities
@{
    ViewData["Title"] = "لوحة التحكم";
    var latestUsers = ViewBag.LatestUsers as List<ApplicationUser> ?? new List<ApplicationUser>();
    var deptDistribution = ViewBag.DepartmentDistribution as List<KeyValuePair<string, int>> ?? new List<KeyValuePair<string, int>>();
    var maxDept = deptDistribution.Any() ? deptDistribution.Max(d => d.Value) : 1;

    var canViewModule01 = ViewBag.CanViewModule01 as bool? ?? false;
    var canViewModule02 = ViewBag.CanViewModule02 as bool? ?? false;
    var canViewModule03 = ViewBag.CanViewModule03 as bool? ?? false;
    var projectsScopeIsAll = ViewBag.ProjectsScopeIsAll as bool? ?? false;
}

<div class="page-head">
    <div>
        <span class="kicker">الصلاحيات والمصادقة</span>
        <h1>لوحة المعلومات</h1>
    </div>
    @if (User.IsInRole("مدير النظام"))
    {
        <div class="page-head-actions">
            <a class="btn-line">تصدير</a>
            <a asp-controller="Admin" asp-action="Users" class="btn-line btn-line-accent">+ موظف</a>
        </div>
    }
</div>

@if (!canViewModule01 && !canViewModule02 && !canViewModule03)
{
    <div class="side-panel"><p class="mb-0">لا توجد إحصائيات لعرضها حسب صلاحياتك الحالية.</p></div>
}

@if (canViewModule01)
{
    <div class="stat-strip">
        <div class="stat-item"><span class="kicker">المستخدمون</span><span class="stat-value">@ViewBag.TotalUsers</span></div>
        <div class="stat-item"><span class="kicker">النشطون</span><span class="stat-value">@ViewBag.ActiveUsers</span></div>
        <div class="stat-item"><span class="kicker">الأدوار</span><span class="stat-value">@ViewBag.TotalRoles</span></div>
        <div class="stat-item"><span class="kicker">الصلاحيات</span><span class="stat-value">@ViewBag.TotalPermissions</span></div>
        <div class="stat-item"><span class="kicker">الأقسام</span><span class="stat-value">@ViewBag.TotalDepartments</span></div>
    </div>

    <div style="display:grid; grid-template-columns: 1.3fr 1fr; gap:12px; margin-bottom:16px;">
        <div class="data-table" style="--cols: 1fr 120px 90px 70px">
            <div class="data-table-head">
                <div class="cell">الاسم</div>
                <div class="cell">القسم</div>
                <div class="cell">الرتبة</div>
                <div class="cell">الحالة</div>
            </div>
            @if (!latestUsers.Any())
            {
                <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا يوجد مستخدمون بعد</div></div>
            }
            else
            {
                @foreach (var u in latestUsers)
                {
                    <div class="data-table-row">
                        <div class="cell">@u.FullName</div>
                        <div class="cell">@(u.Department?.Name ?? "-")</div>
                        <div class="cell">@u.Rank</div>
                        <div class="cell">
                            @if (u.IsActive)
                            {
                                <span class="tag tag-accent">نشط</span>
                            }
                            else
                            {
                                <span class="tag">غير نشط</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="side-panel">
            <div class="side-panel-title">التوزيع على الأقسام</div>
            @if (!deptDistribution.Any())
            {
                <p class="mb-0">لا توجد بيانات بعد</p>
            }
            else
            {
                @foreach (var d in deptDistribution)
                {
                    <div style="display:flex; align-items:center; justify-content:space-between; font-size:11.5px; margin-bottom:4px;">
                        <span>@d.Key</span>
                        <span class="cell-num">@d.Value</span>
                    </div>
                    <div class="progress-hair" style="height:4px; margin-bottom:8px;">
                        <span style="width:@(d.Value * 100 / maxDept)%"></span>
                    </div>
                }
                <a asp-controller="Admin" asp-action="Departments" class="btn-line btn-line-accent" style="margin-top:6px;">عرض الأقسام الـ@ViewBag.TotalDepartments</a>
            }
        </div>
    </div>
}

@if (canViewModule02)
{
    <div class="kicker" style="margin-top:8px;">إدارة المشاريع @(projectsScopeIsAll ? "" : "(مشاريعك)")</div>
    <div class="stat-strip">
        <div class="stat-item"><span class="kicker">@(projectsScopeIsAll ? "إجمالي المشاريع" : "مشاريعي")</span><span class="stat-value">@ViewBag.TotalProjects</span></div>
        <div class="stat-item"><span class="kicker">قيد التنفيذ</span><span class="stat-value">@ViewBag.ActiveProjects</span></div>
        <div class="stat-item"><span class="kicker">مكتملة</span><span class="stat-value">@ViewBag.CompletedProjects</span></div>
        <div class="stat-item"><span class="kicker">مهامي النشطة</span><span class="stat-value">@ViewBag.MyActiveTasks</span></div>
    </div>
}

@if (canViewModule03)
{
    <div class="kicker" style="margin-top:8px;">المواقع والعمليات @(projectsScopeIsAll ? "" : "(مواقع مشاريعك)")</div>
    <div class="stat-strip">
        <div class="stat-item"><span class="kicker">إجمالي المواقع</span><span class="stat-value">@ViewBag.TotalSites</span></div>
        <div class="stat-item"><span class="kicker">مواقع نشطة</span><span class="stat-value">@ViewBag.ActiveSites</span></div>
        <div class="stat-item"><span class="kicker">فحوصات معلقة</span><span class="stat-value">@ViewBag.PendingQualityChecks</span></div>
        <div class="stat-item"><span class="kicker">توريد معلق</span><span class="stat-value">@ViewBag.PendingSupplyRequests</span></div>
    </div>
}

@if (User.IsInRole("مدير النظام"))
{
    <div class="mt-3">
        <a asp-controller="Admin" asp-action="Users" class="btn-line">إدارة المستخدمين</a>
        <a asp-controller="Admin" asp-action="Roles" class="btn-line">إدارة الأدوار</a>
        <a asp-controller="Admin" asp-action="Departments" class="btn-line">إدارة الأقسام</a>
    </div>
}