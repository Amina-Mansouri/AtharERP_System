@{
    ViewData["Title"] = "الرئيسية";
}

<div class="athar-hero">
    <div class="athar-hero-inner text-center">
        <h1 class="athar-hero-title">أثر</h1>
        <p class="athar-hero-subtitle">نظام إدارة المشاريع الهندسية</p>
        <p class="athar-hero-text">
            منصة متكاملة لإدارة المشاريع، المواقع، التوريدات، الموارد المالية والبشرية،
            والعلاقات مع العملاء في مكان واحد.
        </p>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <div class="mt-4">
                <p class="athar-hero-welcome">مرحباً بعودتك، @User.Identity.Name</p>
                <a asp-controller="Home" asp-action="Dashboard" class="btn athar-btn-accent btn-lg me-2">الذهاب إلى لوحة التحكم</a>
                @if (User.IsInRole("مدير النظام"))
                {
                    <a asp-controller="Admin" asp-action="Users" class="btn athar-btn-outline btn-lg">إضافة موظف جديد</a>
                }
            </div>
        }
        else
        {
            <div class="mt-4">
                <a asp-controller="Account" asp-action="Login" class="btn athar-btn-accent btn-lg">تسجيل الدخول</a>
            </div>
        }
    </div>
</div>