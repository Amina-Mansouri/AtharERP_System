@using AtharERP_System.Models.Entities
@model List<SalaryPayment>
@{
    ViewData["Title"] = "سجل الرواتب المصروفة";
    string[] monthNames = { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
}

<div class="page-head">
    <div>
        <span class="kicker">الموارد البشرية</span>
        <h1>سجل الرواتب المصروفة</h1>
    </div>
    <div class="page-head-actions">
        <a asp-action="Index" class="btn-line">عودة لصرف الرواتب</a>
    </div>
</div>

<div class="data-table" style="--cols: minmax(0,1.2fr) 100px 100px 100px 90px 90px 100px 110px 1fr 100px">
    <div class="data-table-head">
        <div class="cell">الموظف</div>
        <div class="cell">الشهر</div>
        <div class="cell cell-num">الأساسي</div>
        <div class="cell cell-num">الإضافي</div>
        <div class="cell cell-num">الخصم العام</div>
        <div class="cell cell-num">خصم السلفة</div>
        <div class="cell cell-num">إجمالي الخصومات</div>
        <div class="cell cell-num">الصافي</div>
        <div class="cell">صرفه</div>
        <div class="cell"></div>
    </div>    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد رواتب مصروفة بعد</div></div>
    }
    else
    {
        @foreach (var p in Model)
        {
            <div class="data-table-row">
                <div class="cell">@p.User.FullName</div>
                <div class="cell">@monthNames[p.Month] @p.Year</div>
                <div class="cell cell-num">@p.BaseAmount.ToString("N2")</div>
                <div class="cell cell-num">@p.OvertimeAmount.ToString("N2")</div>
                <div class="cell cell-num">@p.Deduction.ToString("N2")</div>
                <div class="cell cell-num">@p.AdvanceDeduction.ToString("N2")</div>
                <div class="cell cell-num">@p.TotalDeduction.ToString("N2")</div>
                <div class="cell cell-num">@p.NetAmount.ToString("N2")</div>
                <div class="cell">@(p.PaidBy?.FullName ?? "-")</div>
                <div class="cell"><a asp-action="Receipt" asp-route-id="@p.Id" target="_blank" class="btn-line">طباعة</a></div>
            </div>
        }
    }
</div>