@using AtharERP_System.Models.Entities
@model List<StageTemplate>
@{
    ViewData["Title"] = "إدارة قوالب المراحل";
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px;">
    <div>
        <div style="font-size:11px; color:#8a83a0; font-weight:500;">المشاريع</div>
        <div style="font-size:19px; font-weight:600; margin-top:2px;">إدارة قوالب المراحل</div>
    </div>
    <div class="page-head-actions">
        <a asp-action="Create" class="btn-line btn-line-accent">+ قالب جديد</a>
    </div>
</div>

<div class="data-table" style="--cols: minmax(0,1.4fr) 90px 90px 90px">
    <div class="data-table-head">
        <div class="cell">اسم القالب</div>
        <div class="cell">المهام الافتراضية</div>
        <div class="cell">نشط</div>
        <div class="cell"></div>
    </div>
    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد قوالب بعد</div></div>
    }
    else
    {
        @foreach (var tpl in Model)
        {
            <div class="data-table-row">
                <div class="cell">@tpl.Name</div>
                <div class="cell cell-num">@tpl.DefaultTasks.Count</div>
                <div class="cell">
                    @if (tpl.IsActive)
                    {
                        <span class="tag tag-success">نشط</span>
                    }
                    else
                    {
                        <span class="tag">معطّل</span>
                    }
                </div>
                <div class="cell" style="display:flex; gap:8px;">
                    <a asp-action="Edit" asp-route-id="@tpl.Id" style="font-size:11px;">تعديل</a>
                    <form method="post" asp-action="Delete" asp-route-id="@tpl.Id" onsubmit="return confirm('حذف هذا القالب؟ لن يؤثر على المراحل التي فُعِّلت منه سابقاً.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-line" style="height:24px; padding:0 8px; font-size:10.5px; color:#c94a42;">حذف</button>
                    </form>
                </div>
            </div>
        }
    }
</div>