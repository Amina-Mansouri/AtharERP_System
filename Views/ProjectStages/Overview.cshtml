@using AtharERP_System.Services
@using AtharERP_System.Models.Entities
@model List<ProjectStage>
@{
    ViewData["Title"] = "تتبّع مراحل المشاريع";
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
    var subProjects = ViewBag.SubProjects as List<Project> ?? new List<Project>();
    var selectedProjectId = ViewBag.ProjectId as int?;
    var selectedSubProjectId = ViewBag.SubProjectId as int?;
    var stageTemplates = ViewBag.StageTemplates as List<StageTemplate> ?? new List<StageTemplate>();
    var stageStatusLabels = EnumDisplayHelper.GetDisplayList<StageStatus>();

    List<(string Label, int Value, string Color)>? stageSlices = null;
    {
        var totalStagesCountForChart = (int)ViewBag.TotalStages;
        var completedStagesCountForChart = (int)ViewBag.CompletedStages;
        var inProgressStagesCountForChart = (int)ViewBag.InProgressStages;
        var delayedStagesCountForChart = (int)ViewBag.DelayedStages;
        var notStartedStagesCountForChart = totalStagesCountForChart - completedStagesCountForChart - inProgressStagesCountForChart - delayedStagesCountForChart;
        stageSlices = new List<(string Label, int Value, string Color)>
        {
            ("لم تبدأ", notStartedStagesCountForChart, "#8a83a0"),
            ("قيد التنفيذ", inProgressStagesCountForChart, "#7b6bd6"),
            ("مكتملة", completedStagesCountForChart, "#2f8a57"),
            ("متأخرة", delayedStagesCountForChart, "#c94a42")
        };
    }

    string StageTagClass(StageStatus s) => s switch
    {
        StageStatus.Completed => "tag-success",
        StageStatus.Delayed => "tag-danger",
        StageStatus.InProgress => "tag-accent",
        _ => ""
    };
}

<div style="margin-bottom:14px;">
    <div style="font-size:11px; color:#8a83a0; font-weight:500;">المشاريع</div>
    <div style="font-size:19px; font-weight:600; margin-top:2px;">تتبّع مراحل المشاريع</div>
</div>

<div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:12px 16px; display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:12px;">
    <form method="get" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:8px;">
            <label style="font-size:10.5px; color:#8a83a0; white-space:nowrap;">المشروع</label>
            <select name="projectId" onchange="var sp=this.form.querySelector('[name=subProjectId]'); if(sp) sp.value=''; this.form.submit()" style="height:34px; border:1px solid #e4e2ec; border-radius:8px; padding:0 10px; font-size:11.5px; min-width:190px; background:#fff;">
                <option value="">-- عرض الكل --</option>
                @foreach (var p in projects)
                {
                    <option value="@p.Id" selected="@(selectedProjectId == p.Id)">@p.Code - @p.Name</option>
                }
            </select>
        </div>
        @if (selectedProjectId.HasValue && subProjects.Any())
        {
            <div style="display:flex; align-items:center; gap:8px;">
                <label style="font-size:10.5px; color:#8a83a0; white-space:nowrap;">المشروع الفرعي</label>
                <select name="subProjectId" onchange="this.form.submit()" style="height:34px; border:1px solid #e4e2ec; border-radius:8px; padding:0 10px; font-size:11.5px; min-width:190px; background:#fff;">
                    <option value="">-- المشروع الرئيسي نفسه --</option>
                    @foreach (var sp in subProjects)
                    {
                        <option value="@sp.Id" selected="@(selectedSubProjectId == sp.Id)">@sp.Code - @sp.Name</option>
                    }
                </select>
            </div>
        }
    </form>
    @if (stageSlices != null)
    {
        <div style="width:1px; align-self:stretch; background:#f1f0f6;"></div>
        <div style="display:inline-block;">
            @await Html.PartialAsync("_StatDonutChart", stageSlices)
        </div>
    }
</div>

<div class="stat-strip stat-strip-text">
    <div class="stat-item"><span class="kicker">عدد المراحل</span><span class="stat-value">@ViewBag.TotalStages</span></div>
    <div class="stat-item"><span class="kicker">إجمالي أوزان المراحل</span><span class="stat-value">@(((decimal)ViewBag.WeightSum).ToString("N0"))%</span></div>
    <div class="stat-item"><span class="kicker">نسبة الإنجاز الحالية</span><span class="stat-value">@(((decimal)ViewBag.WeightedCompletion).ToString("N1"))%</span></div>
</div>
<div class="data-table" style="--cols: 30px minmax(0,1fr) minmax(0,1fr) 56px 90px 128px 84px 104px 92px 84px">
    <div class="data-table-head">
        <div class="cell">ت</div>
        <div class="cell">المشروع</div>
        <div class="cell">المرحلة</div>
        <div class="cell">الوزن</div>
        <div class="cell">التخصص</div>
        <div class="cell">المهندس المشرف</div>
        <div class="cell">التكليفات</div>
        <div class="cell">نسبة الإنجاز</div>
        <div class="cell">الحالة</div>
        <div class="cell"></div>
    </div>
    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مراحل مضافة بعد</div></div>
    }
    else
    {
        @foreach (var stage in Model)
        {
            <div class="data-table-row">
                <div class="cell cell-num">@stage.Sequence</div>
                <div class="cell">@(stage.Project?.Name ?? "-")</div>
                <div class="cell">
                    @stage.Name
                    @if (stage.Assignments.Any(a => a.IsRedesign && a.Status != AssignmentStatus.Completed && a.Status != AssignmentStatus.Cancelled))
                    {
                        <span class="tag tag-accent" style="font-size:9px;">🔁</span>
                    }
                </div>
                <div class="cell cell-num">@stage.Weight.ToString("N0")%</div>
                <div class="cell">@(stageTemplates.FirstOrDefault(t => t.Name == stage.Name)?.Discipline?.Name ?? "-")</div>
                <div class="cell">@(stage.AssignedEngineer?.FullName ?? "-")</div>
                <div class="cell cell-num">@stage.Assignments.Count</div>
                <div class="cell cell-num">@stage.CompletionPercentage.ToString("N0")%</div>
                <div class="cell"><span class="tag @StageTagClass(stage.Status)">@stageStatusLabels.FirstOrDefault(x => x.Value == stage.Status.ToString()).Label</span></div>
                <div class="cell"><a asp-controller="Projects" asp-action="Details" asp-route-id="@stage.ProjectId" style="font-size:11px;">فتح المشروع</a></div>
            </div>
        }
    }
</div>
