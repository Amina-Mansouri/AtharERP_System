@using AtharERP_System.Models.Entities
@model ProjectStep
@{
    ViewData["Title"] = "تعديل الخطوة";
}

<h1 class="athar-page-title">تعديل الخطوة: @Model.Name</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="EditStep" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">اسم الخطوة</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الوزن داخل المرحلة</label>
                <input type="text" class="form-control" value="@Model.Weight.ToString("N2")%" disabled />
                <small class="text-muted">لا يمكن تعديل الوزن بعد الإنشاء</small>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="New" selected="@(Model.Status == ProjectStatus.New)">جديد</option>
                    <option value="InProgress" selected="@(Model.Status == ProjectStatus.InProgress)">قيد التنفيذ</option>
                    <option value="ClientReview" selected="@(Model.Status == ProjectStatus.ClientReview)">مراجعة العميل</option>
                    <option value="Completed" selected="@(Model.Status == ProjectStatus.Completed)">مكتمل</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">التكلفة الفعلية</label>
                <input type="number" step="0.01" min="0" name="ActualCost" class="form-control" value="@Model.ActualCost" />
            </div>
        </div>

        <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
        <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectStage.ProjectId" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>