@using AtharERP_System.Models.Entities
@model ProjectStage
@{
    ViewData["Title"] = "تعديل المرحلة";
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
}

<h1 class="athar-page-title">تعديل المرحلة: @Model.Name</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">اسم المرحلة</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الترتيب</label>
                <input type="number" name="Sequence" class="form-control" value="@Model.Sequence" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الوزن % من المشروع</label>
                <input type="text" class="form-control" value="@Model.Weight.ToString("N2")%" disabled />
                <small class="text-muted">لا يمكن تعديل الوزن بعد الإنشاء</small>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="New" selected="@(Model.Status == StageStatus.New)">جديدة</option>
                    <option value="InProgress" selected="@(Model.Status == StageStatus.InProgress)">قيد التنفيذ</option>
                    <option value="ClientReview" selected="@(Model.Status == StageStatus.ClientReview)">مراجعة العميل</option>
                    <option value="Completed" selected="@(Model.Status == StageStatus.Completed)">مكتملة</option>
                    <option value="Delayed" selected="@(Model.Status == StageStatus.Delayed)">متأخرة</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">التكلفة المخصصة</label>
                <input type="number" step="0.01" min="0" name="Cost" class="form-control" value="@Model.Cost" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">القسم</label>
                <select name="DepartmentId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var dept in departments)
                    {
                        <option value="@dept.Id" selected="@(Model.DepartmentId == dept.Id)">@dept.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">المهندس المسؤول</label>
                <select name="AssignedEngineerId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var eng in engineers)
                    {
                        <option value="@eng.Id" selected="@(Model.AssignedEngineerId == eng.Id)">@eng.FullName</option>
                    }
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء المخطط</label>
                <input type="date" name="PlannedStartDate" class="form-control" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء المخطط</label>
                <input type="date" name="PlannedEndDate" class="form-control" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء الفعلي</label>
                <input type="date" name="ActualStartDate" class="form-control" value="@(Model.ActualStartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء الفعلي</label>
                <input type="date" name="ActualEndDate" class="form-control" value="@(Model.ActualEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">توثيق العمل الدوري</label>
                <textarea name="WorkDocumentation" class="form-control" rows="3">@Model.WorkDocumentation</textarea>
            </div>
        </div>

        <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
        <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>