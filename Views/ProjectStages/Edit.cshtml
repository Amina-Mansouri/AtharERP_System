@using AtharERP_System.Models.Entities
@model ProjectStage
@{
    ViewData["Title"] = "تعديل المرحلة";
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
}

<h1 class="athar-page-title">تعديل المرحلة: @Model.Name</h1>

<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">اسم المرحلة</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الترتيب</label>
                <input type="number" name="Sequence" class="form-control" value="@Model.Sequence" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">الوزن % من المشروع</label>
                <input type="text" class="form-control" value="@Model.Weight.ToString("N2")%" disabled />
                <small class="text-muted">لا يمكن تعديل الوزن بعد الإنشاء</small>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">التخصص</label>
                <select name="Discipline" class="form-select">
                    <option value="">-- غير محدد --</option>
                    @foreach (var d in Enum.GetValues<DocumentClassification>())
                    {
                        <option value="@d" selected="@(Model.Discipline == d)">@d</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">وزن التخصص (KPI)</label>
                <input type="number" step="0.01" min="0" name="KpiWeight" class="form-control" value="@Model.KpiWeight" />
            </div>
            <div class="row">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">المساحة (م²)</label>
                        <input type="number" step="0.01" min="0" name="Area" class="form-control" value="@Model.Area" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">التكلفة الفعلية (من التكليفات)</label>
                        <input type="text" class="form-control" value="@Model.ActualCost.ToString("N2")" disabled />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">قيمة البيع (من التكليفات)</label>
                        <input type="text" class="form-control" value="@Model.SaleValue.ToString("N2")" disabled />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">النسبة اليدوية الأولى (%)</label>
                        <input type="number" step="0.01" name="SaleMarkupPercent1" class="form-control" value="@Model.SaleMarkupPercent1" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">النسبة اليدوية الثانية (%)</label>
                        <input type="number" step="0.01" name="SaleMarkupPercent2" class="form-control" value="@Model.SaleMarkupPercent2" />
                    </div>
                </div>
            </div>
        </div>

      

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">المهندس المسؤول</label>
                <select name="AssignedEngineerId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var eng in engineers)
                    {
                        <option value="@eng.Id" selected="@(Model.AssignedEngineerId == eng.Id)">@eng.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">الحالة (تلقائية)</label>
                <input type="text" class="form-control" value="@Model.Status" disabled />
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ البدء المخطط</label>
                <input type="date" name="PlannedStartDate" class="form-control" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">تاريخ الانتهاء المخطط</label>
                <input type="date" name="PlannedEndDate" class="form-control" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <label class="form-label">تاريخ التسليم الفعلي</label>
            <input type="date" name="ActualDeliveryDate" class="form-control" value="@(Model.ActualDeliveryDate?.ToString("yyyy-MM-dd"))" disabled="@(Model.Status != StageStatus.Completed)" />
        </div>
        <div class="col-md-3 mb-3">
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">توثيق العمل الدوري</label>
                <textarea name="WorkDocumentation" class="form-control" rows="3">@Model.WorkDocumentation</textarea>
            </div>
        </div>

        <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
        <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>