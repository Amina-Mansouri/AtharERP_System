@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteManager>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    var allStaff = ViewBag.AllStaff as List<ApplicationUser> ?? new List<ApplicationUser>();
    ViewData["Title"] = $"مديرو الموقع - {site?.Name}";
    var canManage = await PermissionService.HasPermissionAsync(User, "Sites.Manage");
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@site?.Code</div>
        <h1 class="athar-page-title" style="margin-top:2px;">مديرو الموقع - @site?.Name</h1>
    </div>
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn-line">العودة للموقع</a>
</div>

<div class="data-table" style="--cols: 1.2fr 1fr 150px @(canManage ? "120px" : "");">
    <div class="data-table-head">
        <div class="cell">الاسم</div>
        <div class="cell">ملاحظات</div>
        <div class="cell">تاريخ التكليف</div>
        @if (canManage)
        {
            <div class="cell">إجراءات</div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا يوجد مديرو موقع مكلَّفون بعد</div></div>
    }
    else
    {
        @foreach (var m in Model)
        {
            <div class="data-table-row">
                <div class="cell">@m.User.FullName</div>
                <div class="cell">@(m.Notes ?? "-")</div>
                <div class="cell cell-num">@m.AssignedAt.ToString("yyyy-MM-dd")</div>
                @if (canManage)
                {
                    <div class="cell">
                        <form method="post" asp-action="Delete" asp-route-id="@m.Id" onsubmit="return confirm('إلغاء تكليف هذا الموظف بإدارة الموقع؟');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-line" style="color:#c94a42;">إلغاء التكليف</button>
                        </form>
                    </div>
                }
            </div>
        }
    }
</div>

@if (canManage)
{
    <div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px; margin-top:12px;">
        <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">تكليف موظف بإدارة هذا الموقع</div>
        <form method="post" asp-action="Create" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site?.Id" />
            <div style="flex:1; min-width:200px;">
                <label class="form-label" style="font-size:11px;">الموظف</label>
                <select name="userId" class="form-select form-select-sm" required>
                    <option value="">-- اختاري --</option>
                    @foreach (var u in allStaff)
                    {
                        <option value="@u.Id">@u.FullName</option>
                    }
                </select>
            </div>
            <div style="flex:1; min-width:200px;">
                <label class="form-label" style="font-size:11px;">ملاحظات</label>
                <input type="text" name="notes" class="form-control form-control-sm" />
            </div>
            <button type="submit" class="btn-line btn-line-accent">+ تكليف</button>
        </form>
    </div>
}