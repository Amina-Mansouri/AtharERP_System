@using AtharERP_System.Models.Entities
@{
    var proposal = ViewBag.Proposal as DesignProposal;
    var currentUserName = ViewBag.CurrentUserName as string ?? "";
    var projectId = ViewBag.ProjectId as int?;
    var stageId = ViewBag.StageId as int?;
    var taskFilter = ViewBag.TaskFilter as string;
    ViewData["Title"] = "مراجعة المقترح";
}

<h1 class="athar-page-title">مراجعة المقترح: @proposal?.Name</h1>
<div class="stat-sub mb-2">المهمة: @proposal?.TaskTodo?.Task?.Title — المرحلة: @(proposal?.TaskTodo?.Task?.Stage?.Name ?? "-")</div>

<div class="athar-card mt-3">
    <form method="post" asp-action="Review" asp-route-id="@proposal?.Id" enctype="multipart/form-data" id="reviewForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectId" value="@projectId" />
        <input type="hidden" name="stageId" value="@stageId" />
        <input type="hidden" name="taskFilter" value="@taskFilter" />

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">التخصص</label>
                <input type="text" name="discipline" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">الحالة</label>
            <div class="d-flex gap-3 flex-wrap">
                <label><input type="radio" name="status" value="Approved" required /> معتمد</label>
                <label><input type="radio" name="status" value="ApprovedWithModification" /> معتمد مع تعديل</label>
                <label><input type="radio" name="status" value="Resubmission" /> إعادة تقديم</label>
                <label><input type="radio" name="status" value="Redesign" /> إعادة تصميم</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">الملاحظات</label>
            <textarea name="notes" class="form-control" rows="3"></textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-label">بيانات المراجع</div>
                <input type="text" name="reviewerName" class="form-control mb-2" placeholder="اسم المراجع" value="@currentUserName" required />
                <input type="text" name="reviewerPosition" class="form-control mb-2" placeholder="الوظيفة" />
                <div class="stat-sub mb-1">التوقيع</div>
                <canvas id="reviewerSigPad" width="380" height="130" style="border:1px solid #e4e2ec; border-radius:8px; touch-action:none; background:#fff;"></canvas>
                <div><button type="button" class="btn-line mt-1" onclick="clearPad('reviewerSigPad')">مسح التوقيع</button></div>
                <input type="file" id="reviewerSignatureInput" name="reviewerSignature" style="display:none" />
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-label">بيانات المشرف المباشر</div>
                <input type="text" name="supervisorName" class="form-control mb-2" placeholder="اسم المشرف المباشر" />
                <input type="text" name="supervisorPosition" class="form-control mb-2" placeholder="الوظيفة" />
                <div class="stat-sub mb-1">التوقيع</div>
                <canvas id="supervisorSigPad" width="380" height="130" style="border:1px solid #e4e2ec; border-radius:8px; touch-action:none; background:#fff;"></canvas>
                <div><button type="button" class="btn-line mt-1" onclick="clearPad('supervisorSigPad')">مسح التوقيع</button></div>
                <input type="file" id="supervisorSignatureInput" name="supervisorSignature" style="display:none" />
            </div>
        </div>

        <button type="submit" class="btn athar-btn">إرسال المراجعة</button>
        <a asp-controller="ProjectAssignments" asp-action="Overview" asp-route-projectId="@projectId" asp-route-stageId="@stageId" asp-route-taskFilter="@taskFilter" class="btn athar-btn-outline">إلغاء</a>
    </form>
</div>

<script>
    function setupPad(canvasId) {
        var canvas = document.getElementById(canvasId);
        var ctx = canvas.getContext('2d');
        ctx.lineWidth = 2;
        ctx.lineCap = 'round';
        var drawing = false;

        function pos(e) {
            var rect = canvas.getBoundingClientRect();
            var clientX = e.touches ? e.touches[0].clientX : e.clientX;
            var clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return { x: clientX - rect.left, y: clientY - rect.top };
        }

        function start(e) { drawing = true; var p = pos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); }
        function move(e) { if (!drawing) return; var p = pos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); e.preventDefault(); }
        function end() { drawing = false; }

        canvas.addEventListener('mousedown', start);
        canvas.addEventListener('mousemove', move);
        canvas.addEventListener('mouseup', end);
        canvas.addEventListener('mouseleave', end);
        canvas.addEventListener('touchstart', start);
        canvas.addEventListener('touchmove', move);
        canvas.addEventListener('touchend', end);
    }

    function clearPad(canvasId) {
        var canvas = document.getElementById(canvasId);
        canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
    }

    function canvasToFile(canvas, filename) {
        return new Promise(function(resolve) {
            canvas.toBlob(function(blob) {
                if (!blob) { resolve(null); return; }
                resolve(new File([blob], filename, { type: 'image/png' }));
            }, 'image/png');
        });
    }

    setupPad('reviewerSigPad');
    setupPad('supervisorSigPad');

    document.getElementById('reviewForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var form = this;

        Promise.all([
            canvasToFile(document.getElementById('reviewerSigPad'), 'reviewer-signature.png'),
            canvasToFile(document.getElementById('supervisorSigPad'), 'supervisor-signature.png')
        ]).then(function(files) {
            if (files[0]) {
                var dt1 = new DataTransfer();
                dt1.items.add(files[0]);
                document.getElementById('reviewerSignatureInput').files = dt1.files;
            }
            if (files[1]) {
                var dt2 = new DataTransfer();
                dt2.items.add(files[1]);
                document.getElementById('supervisorSignatureInput').files = dt2.files;
            }
            form.submit();
        });
    });
</script>