@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model ProjectTask
@{
    ViewData["Title"] = "تعديل المهمة";
    var canManage = ViewBag.CanManage as bool? ?? false;
    var canEditDates = ViewBag.CanEditDates as bool? ?? false;
    var isSysAdmin = User.IsInRole("مدير النظام");
    var statusLabels = EnumDisplayHelper.GetDisplayList<ProjectTaskStatus>();
    var priorityLabels = EnumDisplayHelper.GetDisplayList<TaskPriority>();
    var proposals = ViewBag.Proposals as List<DesignProposal> ?? new List<DesignProposal>();
    var isCompleted = Model.Status == ProjectTaskStatus.Completed;

    string ProposalTagClass(ProposalStatus s) => (s == ProposalStatus.Approved || s == ProposalStatus.ApprovedWithModification) ? "tag-success" : ((s == ProposalStatus.Resubmission || s == ProposalStatus.Redesign) ? "tag-danger" : "tag-warning");
    string ProposalLabel(ProposalStatus s) => s switch
    {
        ProposalStatus.Approved => "معتمد",
        ProposalStatus.ApprovedWithModification => "معتمد مع تعديل",
        ProposalStatus.Resubmission => "إعادة تقديم",
        ProposalStatus.Redesign => "إعادة تصميم",
        _ => "بانتظار الاعتماد"
    };
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px;">
    <div>
        <div style="font-size:11px; color:#8a83a0; font-weight:500;">@Model.Stage?.Project?.Name — @Model.Stage?.Name</div>
        <div style="font-size:19px; font-weight:600; margin-top:2px;">@Model.Title</div>
    </div>
    <a asp-controller="ProjectAssignments" asp-action="MyAssignments" class="btn-line">رجوع لتكليفاتي</a>
</div>

<div class="stat-strip stat-strip-text">
    <div class="stat-item"><span class="kicker">الحالة</span><span class="stat-value">@statusLabels.FirstOrDefault(x => x.Value == Model.Status.ToString()).Label</span></div>
    <div class="stat-item"><span class="kicker">نسبة الإنجاز</span><span class="stat-value">@Model.CompletionPercentage.ToString("N0")%</span></div>
    <div class="stat-item"><span class="kicker">الوزن</span><span class="stat-value">@Model.Weight.ToString("N0")%</span></div>
    @if (Model.DelayDays > 0)
    {
        <div class="stat-item"><span class="kicker">التأخير</span><span class="stat-value" style="color:#c94a42;">@Model.DelayDays يوم</span></div>
    }
    @if (Model.EarlyDeliveryDays > 0)
    {
        <div class="stat-item"><span class="kicker">تسليم مبكر</span><span class="stat-value" style="color:#2f8a57;">@Model.EarlyDeliveryDays يوم</span></div>
    }
    @if (isCompleted && Model.ActualDeliveryDate.HasValue)
    {
        <div class="stat-item"><span class="kicker">تاريخ التسليم الفعلي</span><span class="stat-value" style="color:#2f8a57;">@Model.ActualDeliveryDate.Value.ToString("yyyy-MM-dd")</span></div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.ReviewComment))
{
    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; padding:10px 14px; margin-bottom:12px; font-size:11.5px;">
        <span style="color:#8a83a0;">تعليق آخر مراجعة:</span> @Model.ReviewComment
    </div>
}

<div class="tabs" role="tablist">
    <a class="tab-item active" data-bs-toggle="tab" href="#pane-task-data">بيانات المهمة</a>
    <a class="tab-item" data-bs-toggle="tab" href="#pane-task-proposals">مقترحات التصميم (@proposals.Count)</a>
</div>

<div class="tab-content">
    <div class="tab-pane fade show active" id="pane-task-data">
        <div style="display:grid; grid-template-columns:1.4fr 1fr; gap:12px; margin-bottom:12px;">
            <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
                <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">بيانات المهمة</div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                @if (Model.ProjectAssignment != null)
                {
                    var asg = Model.ProjectAssignment;
                    <div style="border:1px solid #ecebf2; border-radius:9px; padding:10px 12px; margin-bottom:10px; background:#faf9fd;">
                        <div style="font-size:11.5px; font-weight:700; margin-bottom:8px;">بيانات التكليف</div>
                        <form method="post" asp-controller="ProjectAssignments" asp-action="EditDates" style="display:grid; grid-template-columns:1fr 1fr 1fr auto; gap:8px; align-items:end;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@asg.Id" />
                            <input type="hidden" name="taskId" value="@Model.Id" />
                            <div>
                                <label style="font-size:10.5px; color:#8a83a0;">بيان التكليف</label>
                                <input type="text" name="CostType" value="@asg.CostType" disabled="@(!isSysAdmin)" style="width:100%; height:30px; border:1px solid #e4e2ec; border-radius:7px; padding:0 8px; font-size:11.5px;" />
                            </div>
                            <div>
                                <label style="font-size:10.5px; color:#8a83a0;">تاريخ بداية التكليف</label>
                                <input type="date" name="PlannedStartDate" value="@(asg.PlannedStartDate?.ToString("yyyy-MM-dd"))" disabled="@(!isSysAdmin)" style="width:100%; height:30px; border:1px solid #e4e2ec; border-radius:7px; padding:0 8px; font-size:11.5px;" />
                            </div>
                            <div>
                                <label style="font-size:10.5px; color:#8a83a0;">تاريخ نهاية التكليف</label>
                                <input type="date" name="PlannedEndDate" value="@(asg.PlannedEndDate?.ToString("yyyy-MM-dd"))" disabled="@(!isSysAdmin)" style="width:100%; height:30px; border:1px solid #e4e2ec; border-radius:7px; padding:0 8px; font-size:11.5px;" />
                            </div>
                            @if (isSysAdmin)
                            {
                                <button type="submit" class="btn-line btn-line-accent" style="height:30px;">حفظ</button>
                            }
                        </form>
                    </div>
                }

                <div style="border:1px solid #ecebf2; border-radius:9px; padding:10px 12px; margin-bottom:10px; background:#faf9fd;">
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
                        <div style="font-size:11.5px; font-weight:700; color:#5a5370;">+ رفع مستند جديد لهذا البند</div>
                        <span class="tag @(proposals.Any() ? "tag-success" : "tag-warning")">@(proposals.Any() ? "مرفَق مستند" : "بانتظار الرفع")</span>
                    </div>
                    <form method="post" asp-controller="DesignProposals" asp-action="Upload" enctype="multipart/form-data" style="display:grid; grid-template-columns:1fr 1fr 1fr auto; gap:8px; align-items:end;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <div>
                            <label style="font-size:10.5px; color:#8a83a0;">التصنيف</label>
                            <select name="classification" required style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:11.5px;">
                                <option value="">--</option>
                                <option value="AA">معماري (AA)</option>
                                <option value="IN">ديكور داخلي (IN)</option>
                                <option value="SE">إنشائي (SE)</option>
                                <option value="ME">ميكانيكي (ME)</option>
                                <option value="EE">كهربائي (EE)</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-size:10.5px; color:#8a83a0;">نوع الملف</label>
                            <select name="fileCategory" required style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:11.5px;">
                                <option value="">--</option>
                                <option value="DG">لوحات أوتوكاد (DG)</option>
                                <option value="PH">صور (PH)</option>
                                <option value="RE">تقرير (RE)</option>
                                <option value="REQ">طلب (REQ)</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-size:10.5px; color:#8a83a0;">الملف</label>
                            <input type="file" name="file" required style="width:100%; height:32px; font-size:11px;" />
                        </div>
                        <button type="submit" style="height:32px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:11.5px; font-weight:600; padding:0 14px; white-space:nowrap;">رفع</button>
                    </form>
                </div>

                <form method="post" asp-action="Edit" asp-route-id="@Model.Id" id="taskEditForm">
                    @Html.AntiForgeryToken()
                    <div style="display:grid; grid-template-columns:2fr 1fr; gap:8px; margin-bottom:8px;">
                        <div>
                            <label style="font-size:11px; color:#8a83a0;">العنوان</label>
                            <input type="text" name="Title" value="@Model.Title" required disabled="@(!canManage)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                        </div>
                        <div>
                            <label style="font-size:11px; color:#8a83a0;">الأولوية</label>
                            <select name="Priority" disabled="@(!canManage)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                                @foreach (var pr in priorityLabels)
                                {
                                    <option value="@pr.Value" selected="@(Model.Priority.ToString() == pr.Value)">@pr.Label</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div style="margin-bottom:8px;">
                        <label style="font-size:11px; color:#8a83a0;">الوصف</label>
                        <textarea name="Description" rows="2" disabled="@(!canManage)" style="width:100%; border:1px solid #e4e2ec; border-radius:8px; padding:6px 8px; font-size:12px;">@Model.Description</textarea>
                    </div>

                    <div style="border:1px solid #ecebf2; border-radius:9px; padding:10px 12px; margin-bottom:8px; background:#faf9fd;">
                        <div style="font-size:11px; font-weight:700; color:#5a5370; margin-bottom:8px;">تواريخ هذه المهمة (ضمن نطاق تاريخ التكليف)</div>
                        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px;">
                            <div>
                                <label style="font-size:11px; color:#8a83a0;">تاريخ البداية</label>
                                <input type="date" name="PlannedStartDate" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" disabled="@(!canEditDates)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                            </div>
                            <div>
                                <label style="font-size:11px; color:#8a83a0;">تاريخ النهاية</label>
                                <input type="date" name="PlannedEndDate" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" disabled="@(!canEditDates)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                            </div>
                            <div>
                                <label style="font-size:11px; color:#8a83a0;">تسليم فعلي</label>
                                <input type="date" name="ActualDeliveryDate" value="@(Model.ActualDeliveryDate?.ToString("yyyy-MM-dd"))" disabled="@(!canEditDates)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                            </div>
                        </div>
                    </div>

                    <div style="display:flex; align-items:center; gap:6px; margin-bottom:8px;">
                        <input type="checkbox" class="chk-gold" name="IsUrgent" value="true" disabled="@(!canManage)" checked="@Model.IsUrgent" />
                        <input type="hidden" name="IsUrgent" value="false" />
                        <label style="font-size:11.5px;">عاجلة</label>
                    </div>

                    @if (canManage)
                    {
                        <div style="margin-bottom:8px;">
                            <label style="font-size:11px; color:#8a83a0;">الوزن (% من المرحلة)</label>
                            <input type="number" step="0.01" min="0" max="100" name="Weight" value="@Model.Weight" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="Title" value="@Model.Title" />
                        <input type="hidden" name="Priority" value="@Model.Priority" />
                        <input type="hidden" name="Weight" value="@Model.Weight" />
                    }
                </form>

                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px; padding-top:12px; border-top:1px solid #f1f0f6;">
                    @if (canManage || canEditDates)
                    {
                        <button type="submit" form="taskEditForm" style="height:34px; padding:0 18px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:12.5px; font-weight:600;">حفظ التعديلات</button>
                    }
                    else
                    {
                        <span></span>
                    }
                    @if (canManage)
                    {
                        var blockButtonColor = Model.Status == ProjectTaskStatus.Blocked ? "#2f8a57" : "#c94a42";
                        var blockButtonLabel = Model.Status == ProjectTaskStatus.Blocked ? "إلغاء الحظر" : "حظر المهمة";
                        <form method="post" asp-action="ToggleBlocked" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" style="height:34px; padding:0 18px; border:1px solid #e4e2ec; border-radius:8px; background:#fff; font-size:12.5px; font-weight:600; color:@blockButtonColor;">@blockButtonLabel</button>
                        </form>
                    }
                </div>
            </div>

            <div style="display:flex; flex-direction:column; gap:12px;">
                <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
                    <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">المهندسات معك (نفس التكليف)</div>
                    @if (Model.ProjectAssignment == null || !Model.ProjectAssignment.Engineers.Any())
                    {
                        <div class="stat-sub">لا يوجد آخرون، أو المهمة غير مرتبطة بتكليف بعد</div>
                    }
                    else
                    {
                        <div style="display:flex; gap:6px; flex-wrap:wrap;">
                            @foreach (var eng in Model.ProjectAssignment.Engineers)
                            {
                                <span style="background:#f3f1fb; border:1px solid #e1defa; color:#5a5370; border-radius:20px; padding:4px 10px; font-size:11.5px;">@eng.User.FullName</span>
                            }
                        </div>
                    }
                </div>

                <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
                    <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">قائمة To-Do (تقود نسبة الإنجاز والحالة تلقائياً)</div>
                    @if (!Model.Todos.Any())
                    {
                        <div class="stat-sub" style="margin-bottom:10px;">لا توجد بنود بعد</div>
                    }
                    else
                    {
                        <div style="display:grid; gap:6px; margin-bottom:10px;">
                            @foreach (var todo in Model.Todos)
                            {
                                <div style="display:flex; align-items:center; justify-content:space-between; border:1px solid #f1f0f6; border-radius:8px; padding:6px 10px;">
                                    <form method="post" asp-action="ToggleTodo" style="display:flex; align-items:center; gap:8px; flex:1;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@todo.Id" />
                                        <input type="hidden" name="taskId" value="@Model.Id" />
                                        <input type="checkbox" class="chk-gold" onchange="this.form.submit()" checked="@todo.IsCompleted" />
                                        <span style="font-size:11.5px; @(todo.IsCompleted ? "text-decoration:line-through; color:#8a83a0;" : "")">@todo.Item</span>
                                    </form>
                                    <form method="post" asp-action="RemoveTodo" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@todo.Id" />
                                        <input type="hidden" name="taskId" value="@Model.Id" />
                                        <button type="submit" style="border:none; background:none; color:#c94a42; font-size:10px; cursor:pointer;">حذف</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                    <form method="post" asp-action="AddTodo" style="display:flex; gap:8px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <input type="text" name="item" placeholder="بند جديد" required style="flex:1; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                        <button type="submit" style="height:32px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:11.5px; padding:0 14px;">+ إضافة بند</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="pane-task-proposals">
        <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
            <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">مقترحات التصميم المرفوعة لهذه المهمة</div>

            <div style="background:#f3f1fb; border:1px solid #e1defa; border-radius:10px; padding:10px 14px; margin-bottom:12px; display:flex; gap:8px; align-items:flex-start;">
                <div style="font-size:14px; line-height:1;">🔒</div>
                <div style="font-size:11px; line-height:1.7; color:#4a4360;">
                    حالة المهمة تُحسب تلقائياً من نتيجة مراجعة مستنداتها ولا تُحدَّد يدوياً — <span style="color:#ff9130; font-weight:600;">بانتظار الاعتماد</span> بعد الرفع، ولا تصبح المهمة <span style="color:#2f8a57; font-weight:600;">مكتملة</span> إلا بعد اعتماد مستنداتها كلها. لرفع مستند جديد استخدمي تبويب «بيانات المهمة».
                </div>
            </div>

            @if (!proposals.Any())
            {
                <div class="stat-sub" style="margin-bottom:10px;">لا توجد مقترحات مرفوعة بعد</div>
            }
            else
            {
                <div style="display:grid; gap:8px; margin-bottom:10px;">
                    @foreach (var p in proposals)
                    {
                        var pTagClass = ProposalTagClass(p.Status);
                        var pLabel = ProposalLabel(p.Status);
                        <div style="border:1px solid #f1f0f6; border-radius:8px; padding:8px 12px;">
                            <div style="display:flex; align-items:center; justify-content:space-between;">
                                <a href="@p.FilePath" target="_blank" style="font-size:11.5px; font-weight:600;">@p.Code — @p.Name (نسخة @p.Revision)</a>
                                <span class="tag @pTagClass">@pLabel</span>
                            </div>
                            <div class="stat-sub" style="margin-top:2px;">@p.SubmittedDate?.ToString("yyyy-MM-dd")</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tab-persist.js" asp-append-version="true"></script>
}