@using AtharERP_System.Models.Entities
@model ProjectTask
@{
    ViewData["Title"] = "تعديل المهمة";
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
    var availableTasks = ViewBag.AvailableTasksForDependency as List<ProjectTask> ?? new List<ProjectTask>();
    var canManage = ViewBag.CanManage as bool? ?? false;
    var assignments = ViewBag.Assignments as List<ProjectAssignment> ?? new List<ProjectAssignment>();
    string StatusLabel(ProjectTaskStatus s) => s switch
    {
        ProjectTaskStatus.NotStarted => "لم تبدأ",
        ProjectTaskStatus.InProgress => "قيد التنفيذ",
        ProjectTaskStatus.Completed => "مكتملة",
        ProjectTaskStatus.Blocked => "محظورة",
        _ => s.ToString()
    };
}

<h1 class="athar-page-title">تعديل المهمة: @Model.Title</h1>
<div class="athar-card mt-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <strong>الحالة الحالية:</strong>
            <span class="badge athar-status-badge athar-status-@Model.Status">@StatusLabel(Model.Status)</span>
        </div>
        <form method="post" asp-action="UpdateStatus" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <select name="status" class="form-select form-select-sm">
                <option value="NotStarted" selected="@(Model.Status == ProjectTaskStatus.NotStarted)">لم تبدأ</option>
                <option value="InProgress" selected="@(Model.Status == ProjectTaskStatus.InProgress)">قيد التنفيذ</option>
                <option value="Completed" selected="@(Model.Status == ProjectTaskStatus.Completed)">مكتملة</option>
                <option value="Blocked" selected="@(Model.Status == ProjectTaskStatus.Blocked)">محظورة</option>
            </select>
            <button type="submit" class="btn btn-sm athar-btn">تحديث الحالة</button>
        </form>
    </div>
</div>
<div class="athar-card mt-3">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    @if (canManage)
    {
        <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">العنوان</label>
                    <input type="text" name="Title" class="form-control" value="@Model.Title" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">الوصف</label>
                    <input type="text" name="Description" class="form-control" value="@Model.Description" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">تاريخ الاستحقاق</label>
                    <input type="date" name="DueDate" class="form-control" value="@(Model.DueDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">تاريخ البدء المخطط</label>
                    <input type="date" name="PlannedStartDate" class="form-control" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">تاريخ الانتهاء المخطط</label>
                    <input type="date" name="PlannedEndDate" class="form-control" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">تاريخ التسليم الفعلي</label>
                    <input type="date" name="ActualDeliveryDate" class="form-control" value="@(Model.ActualDeliveryDate?.ToString("yyyy-MM-dd"))" />
                </div>
            </div>

            @if (Model.DelayDays > 0)
            {
                <p class="text-danger small">متأخرة @Model.DelayDays يوم</p>
            }
            else if (Model.EarlyDeliveryDays > 0)
            {
                <p class="text-success small">تسليم مبكر بـ @Model.EarlyDeliveryDays يوم</p>
            }

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">الأولوية</label>
                    <select name="Priority" class="form-select">
                        <option value="Low" selected="@(Model.Priority == TaskPriority.Low)">منخفضة</option>
                        <option value="Medium" selected="@(Model.Priority == TaskPriority.Medium)">متوسطة</option>
                        <option value="High" selected="@(Model.Priority == TaskPriority.High)">عالية</option>
                        <option value="Critical" selected="@(Model.Priority == TaskPriority.Critical)">حرجة</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3 form-check form-switch mt-4">
                    <input type="checkbox" name="IsUrgent" value="true" class="form-check-input" id="isUrgent" checked="@Model.IsUrgent" />
                    <input type="hidden" name="IsUrgent" value="false" />
                    <label class="form-check-label" for="isUrgent">عاجلة (مستقلة عن الأولوية)</label>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">نسبة الإنجاز % (تُحسب تلقائياً من To-Do)</label>
                    <input type="text" class="form-control" value="@Model.CompletionPercentage.ToString("N1")%" disabled />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">التكليف المرتبط</label>
                    <select name="ProjectAssignmentId" class="form-select">
                        <option value="">-- بلا تكليف --</option>
                        @foreach (var a in assignments)
                        {
                            <option value="@a.Id" selected="@(Model.ProjectAssignmentId == a.Id)">@a.CostType</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">القيمة التقديرية (تُجمع مع بقية مهام المرحلة، ولا يجوز أن يتجاوز المجموع سقف المرحلة)</label>
                    <input type="number" step="0.01" min="0" name="EstimatedValue" class="form-control" value="@Model.EstimatedValue" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">مبلغ المكافأة</label>
                    <input type="number" step="0.01" min="0" name="BonusAmount" class="form-control" value="@Model.BonusAmount" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">مبلغ الغرامة</label>
                    <input type="number" step="0.01" min="0" name="PenaltyAmount" class="form-control" value="@Model.PenaltyAmount" />
                </div>
            </div>

            <button type="submit" class="btn athar-btn">حفظ التعديلات</button>
            <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn athar-btn-outline">إلغاء</a>
        </form>
    }
     else
    {
         <div class="mb-3">
              <p><strong>الوصف:</strong> @(Model.Description ?? "-")</p>
              <p><strong>تاريخ الاستحقاق:</strong> @(Model.DueDate?.ToString("yyyy-MM-dd") ?? "-")</p>
            <p><strong>نسبة الإنجاز:</strong> @Model.CompletionPercentage.ToString("N1")%</p>
               @if (Model.DelayDays > 0)
             {
                     <p class="text-danger">متأخرة @Model.DelayDays يوم</p>
                    }
       
    </div>
         <a asp-controller="ProjectTasks" asp-action="MyTasks" class="btn athar-btn-outline">العودة لمهامي</a>
       }

    <hr />
    <h5>قائمة To-Do (تقود نسبة الإنجاز تلقائياً)</h5>
    @if (Model.Todos.Any())
    {
        <ul class="list-group mb-3">
            @foreach (var todo in Model.Todos)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <form method="post" asp-action="ToggleTodo" class="d-flex align-items-center gap-2 flex-grow-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@todo.Id" />
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <input type="checkbox" class="form-check-input" onchange="this.form.submit()" checked="@todo.IsCompleted" />
                        <span class="@(todo.IsCompleted ? "text-decoration-line-through text-muted" : "")">@todo.Item</span>
                    </form>
                    <form method="post" asp-action="RemoveTodo" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@todo.Id" />
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                    </form>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">لا توجد بنود بعد</p>
    }
    <form method="post" asp-action="AddTodo" class="row g-2 align-items-end mb-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="taskId" value="@Model.Id" />
        <div class="col-md-9">
            <input type="text" name="item" class="form-control" placeholder="بند جديد" required />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn athar-btn w-100">+ إضافة بند</button>
        </div>
    </form>

    @if (canManage)
    {
        <hr />
        <h5>المكلَّفون بالمهمة (تعدد المهندسين مع نسبة المساهمة)</h5>
        @if (Model.Assignees.Any())
        {
            <ul class="list-group mb-3">
                @foreach (var a in Model.Assignees)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @a.User.FullName <span class="text-muted small">مساهمة: @a.ContributionPercentage.ToString("N0")%</span>
                        <form method="post" asp-action="RemoveAssignee" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <input type="hidden" name="taskId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">إزالة</button>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">لا يوجد مكلَّفون بعد</p>
        }
        <form method="post" asp-action="AddAssignee" class="row g-2 align-items-end mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="taskId" value="@Model.Id" />
            <div class="col-md-6">
                <select name="userId" class="form-select">
                    @foreach (var eng in engineers)
                    {
                        <option value="@eng.Id">@eng.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input type="number" step="0.01" min="0" max="100" name="contributionPercentage" class="form-control" value="100" placeholder="نسبة المساهمة %" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn athar-btn w-100">+ إضافة مكلَّف</button>
            </div>
        </form>

        <hr />
        <h5>التبعيات (المهام التي يجب إكمالها أولاً)</h5>
        @if (Model.Dependencies.Any())
        {
            <ul class="list-group mb-3">
                @foreach (var dep in Model.Dependencies)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @dep.DependsOnTask.Title
                        <form method="post" asp-action="RemoveDependency" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@dep.Id" />
                            <input type="hidden" name="taskId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">إزالة</button>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">لا توجد تبعيات حالياً</p>
        }
        
        @if (availableTasks.Any())
        {
            <form method="post" asp-action="AddDependency" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskId" value="@Model.Id" />
                <div class="col-md-8">
                    <label class="form-label">إضافة تبعية على مهمة</label>
                    <select name="dependsOnTaskId" class="form-select">
                        @foreach (var t in availableTasks)
                        {
                            <option value="@t.Id">@t.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn athar-btn w-100">+ إضافة تبعية</button>
                </div>
            </form>
        }
        else
        {
            <p class="text-muted small">لا توجد مهام أخرى في هذا المشروع يمكن اعتماد هذه المهمة عليها حالياً</p>
        }
    }
</div>