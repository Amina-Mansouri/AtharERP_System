@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model ProjectTask
@{
    ViewData["Title"] = "تعديل المهمة";
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
    var availableTasks = ViewBag.AvailableTasksForDependency as List<ProjectTask> ?? new List<ProjectTask>();
    var canManage = ViewBag.CanManage as bool? ?? false;
    var assignments = ViewBag.Assignments as List<ProjectAssignment> ?? new List<ProjectAssignment>();
    var statusLabels = EnumDisplayHelper.GetDisplayList<ProjectTaskStatus>();
    var priorityLabels = EnumDisplayHelper.GetDisplayList<TaskPriority>();
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px;">
    <div>
        <div style="font-size:11px; color:#8a83a0; font-weight:500;">@Model.Stage?.Project?.Name — @Model.Stage?.Name</div>
        <div style="font-size:19px; font-weight:600; margin-top:2px;">@Model.Title</div>
    </div>
    <a asp-controller="ProjectAssignments" asp-action="MyAssignments" class="btn-line">رجوع لتكليفاتي</a>
</div>

<div class="stat-strip stat-strip-text">
    <div class="stat-item"><span class="kicker">الحالة</span><span class="stat-value">@statusLabels.FirstOrDefault(x => x.Value == Model.Status.ToString()).Label</span></div>
    <div class="stat-item"><span class="kicker">نسبة الإنجاز</span><span class="stat-value">@Model.CompletionPercentage.ToString("N0")%</span></div>
    <div class="stat-item"><span class="kicker">القيمة التقديرية</span><span class="stat-value">@Model.EstimatedValue.ToString("N0")</span></div>
    @if (Model.DelayDays > 0)
    {
        <div class="stat-item"><span class="kicker">التأخير</span><span class="stat-value" style="color:#c94a42;">@Model.DelayDays يوم</span></div>
    }
</div>

<div style="display:grid; grid-template-columns:1.4fr 1fr; gap:12px; margin-bottom:12px;">
    <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
        <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">بيانات المهمة</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <div style="display:grid; grid-template-columns:2fr 1fr; gap:8px; margin-bottom:8px;">
                <div>
                    <label style="font-size:11px; color:#8a83a0;">العنوان</label>
                    <input type="text" name="Title" value="@Model.Title" required disabled="@(!canManage)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                </div>
                <div>
                    <label style="font-size:11px; color:#8a83a0;">الأولوية</label>
                    <select name="Priority" disabled="@(!canManage)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                        @foreach (var pr in priorityLabels)
                        {
                            <option value="@pr.Value" selected="@(Model.Priority.ToString() == pr.Value)">@pr.Label</option>
                        }
                    </select>
                </div>
            </div>

            <div style="margin-bottom:8px;">
                <label style="font-size:11px; color:#8a83a0;">الوصف</label>
                <textarea name="Description" rows="2" disabled="@(!canManage)" style="width:100%; border:1px solid #e4e2ec; border-radius:8px; padding:6px 8px; font-size:12px;">@Model.Description</textarea>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:8px; margin-bottom:8px;">
                <div>
                    <label style="font-size:11px; color:#8a83a0;">تاريخ الاستحقاق</label>
                    <input type="date" name="DueDate" value="@(Model.DueDate?.ToString("yyyy-MM-dd"))" disabled="@(!canManage)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                </div>
                <div>
                    <label style="font-size:11px; color:#8a83a0;">بدء مخطط</label>
                    <input type="date" name="PlannedStartDate" value="@(Model.PlannedStartDate?.ToString("yyyy-MM-dd"))" disabled="@(!canManage)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                </div>
                <div>
                    <label style="font-size:11px; color:#8a83a0;">انتهاء مخطط</label>
                    <input type="date" name="PlannedEndDate" value="@(Model.PlannedEndDate?.ToString("yyyy-MM-dd"))" disabled="@(!canManage)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                </div>
                <div>
                    <label style="font-size:11px; color:#8a83a0;">تسليم فعلي</label>
                    <input type="date" name="ActualDeliveryDate" value="@(Model.ActualDeliveryDate?.ToString("yyyy-MM-dd"))" disabled="@(!canManage)" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                </div>
            </div>

            <div style="display:flex; align-items:center; gap:6px; margin-bottom:8px;">
                <input type="checkbox" class="chk-gold" name="IsUrgent" value="true" disabled="@(!canManage)" checked="@Model.IsUrgent" />
                <input type="hidden" name="IsUrgent" value="false" />
                <label style="font-size:11.5px;">عاجلة</label>
            </div>

            @if (canManage)
            {
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                    <div>
                        <label style="font-size:11px; color:#8a83a0;">مبلغ المكافأة</label>
                        <input type="number" step="0.01" min="0" name="BonusAmount" value="@Model.BonusAmount" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                    </div>
                    <div>
                        <label style="font-size:11px; color:#8a83a0;">مبلغ الغرامة</label>
                        <input type="number" step="0.01" min="0" name="PenaltyAmount" value="@Model.PenaltyAmount" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                    </div>
                </div>
                <div style="margin-bottom:8px;">
                    <label style="font-size:11px; color:#8a83a0;">التكليف المرتبط</label>
                    <select name="ProjectAssignmentId" style="width:100%; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                        <option value="">-- بلا تكليف --</option>
                        @foreach (var a in assignments)
                        {
                            <option value="@a.Id" selected="@(Model.ProjectAssignmentId == a.Id)">@a.CostType</option>
                        }
                    </select>
                </div>
                <button type="submit" style="height:34px; padding:0 18px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:12.5px; font-weight:600;">حفظ التعديلات</button>
            }
        </form>

        <div style="border-top:1px solid #f1f0f6; margin-top:14px; padding-top:12px;">
            <div style="font-size:12px; font-weight:600; margin-bottom:8px;">القيمة التقديرية (يحددها المكلَّف)</div>
            <form method="post" asp-action="UpdateEstimatedValue" style="display:flex; gap:8px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="number" step="0.01" min="0" name="estimatedValue" value="@Model.EstimatedValue" style="flex:1; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
                <button type="submit" style="height:32px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:11.5px; padding:0 14px;">حفظ القيمة</button>
            </form>
        </div>

        <div style="border-top:1px solid #f1f0f6; margin-top:14px; padding-top:12px;">
            <div style="font-size:12px; font-weight:600; margin-bottom:8px;">تحديث الحالة</div>
            <form method="post" asp-action="UpdateStatus" style="display:flex; gap:8px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <select name="status" style="flex:1; height:32px; border:1px solid #e4e2ec; border-radius:8px; font-size:12px;">
                    @foreach (var st in statusLabels)
                    {
                        <option value="@st.Value" selected="@(Model.Status.ToString() == st.Value)">@st.Label</option>
                    }
                </select>
                <button type="submit" style="height:32px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:11.5px; padding:0 14px;">تحديث</button>
            </form>
        </div>
    </div>

    <div style="display:flex; flex-direction:column; gap:12px;">
        <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
            <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">المهندسات معك (نفس التكليف)</div>
            @if (Model.ProjectAssignment == null || !Model.ProjectAssignment.Engineers.Any())
            {
                <div class="stat-sub">لا يوجد آخرون، أو المهمة غير مرتبطة بتكليف بعد</div>
            }
            else
            {
                @foreach (var eng in Model.ProjectAssignment.Engineers)
                {
                    <div style="font-size:11.5px; margin-bottom:4px;">• @eng.User.FullName</div>
                }
            }
        </div>

        @if (canManage)
        {
            <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
                <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">المكلَّفون بالمهمة (نسبة مساهمة)</div>
                @foreach (var a in Model.Assignees)
                {
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;">
                        <span style="font-size:11.5px;">@a.User.FullName <span class="stat-sub">(@a.ContributionPercentage.ToString("N0")%)</span></span>
                        <form method="post" asp-action="RemoveAssignee" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <input type="hidden" name="taskId" value="@Model.Id" />
                            <button type="submit" style="border:none; background:none; color:#c94a42; font-size:10px; cursor:pointer;">إزالة</button>
                        </form>
                    </div>
                }
                <form method="post" asp-action="AddAssignee" style="display:flex; gap:4px; margin-top:6px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" value="@Model.Id" />
                    <select name="userId" style="flex:1; height:28px; border:1px solid #e4e2ec; border-radius:6px; font-size:10.5px;">
                        @foreach (var eng in engineers)
                        {
                            <option value="@eng.Id">@eng.FullName</option>
                        }
                    </select>
                    <input type="number" step="0.01" min="0" max="100" name="contributionPercentage" value="100" style="width:60px; height:28px; border:1px solid #e4e2ec; border-radius:6px; font-size:10.5px;" />
                    <button type="submit" style="height:28px; border:none; border-radius:6px; background:#7b6bd6; color:#fff; font-size:10.5px; padding:0 8px;">+</button>
                </form>
            </div>

            <div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
                <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">التبعيات</div>
                @foreach (var dep in Model.Dependencies)
                {
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;">
                        <span style="font-size:11.5px;">@dep.DependsOnTask.Title</span>
                        <form method="post" asp-action="RemoveDependency" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@dep.Id" />
                            <input type="hidden" name="taskId" value="@Model.Id" />
                            <button type="submit" style="border:none; background:none; color:#c94a42; font-size:10px; cursor:pointer;">إزالة</button>
                        </form>
                    </div>
                }
                @if (availableTasks.Any())
                {
                    <form method="post" asp-action="AddDependency" style="display:flex; gap:4px; margin-top:6px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <select name="dependsOnTaskId" style="flex:1; height:28px; border:1px solid #e4e2ec; border-radius:6px; font-size:10.5px;">
                            @foreach (var t in availableTasks)
                            {
                                <option value="@t.Id">@t.Title</option>
                            }
                        </select>
                        <button type="submit" style="height:28px; border:none; border-radius:6px; background:#7b6bd6; color:#fff; font-size:10.5px; padding:0 8px;">+</button>
                    </form>
                }
            </div>
        }
    </div>
</div>

<div style="background:#fff; border:1px solid #ecebf2; border-radius:11px; box-shadow:0 1px 2px rgba(36,31,51,.04); padding:14px 16px;">
    <div style="font-size:13.5px; font-weight:600; margin-bottom:10px;">قائمة To-Do (تقود نسبة الإنجاز تلقائياً)</div>
    @if (!Model.Todos.Any())
    {
        <div class="stat-sub" style="margin-bottom:10px;">لا توجد بنود بعد</div>
    }
    else
    {
        <div style="display:grid; gap:6px; margin-bottom:10px;">
            @foreach (var todo in Model.Todos)
            {
                <div style="display:flex; align-items:center; justify-content:space-between; border:1px solid #f1f0f6; border-radius:8px; padding:6px 10px;">
                    <form method="post" asp-action="ToggleTodo" style="display:flex; align-items:center; gap:8px; flex:1;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@todo.Id" />
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <input type="checkbox" class="chk-gold" onchange="this.form.submit()" checked="@todo.IsCompleted" />
                        <span style="font-size:11.5px; @(todo.IsCompleted ? "text-decoration:line-through; color:#8a83a0;" : "")">@todo.Item</span>
                    </form>
                    <form method="post" asp-action="RemoveTodo" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@todo.Id" />
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <button type="submit" style="border:none; background:none; color:#c94a42; font-size:10px; cursor:pointer;">حذف</button>
                    </form>
                </div>
            }
        </div>
    }
    <form method="post" asp-action="AddTodo" style="display:flex; gap:8px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="taskId" value="@Model.Id" />
        <input type="text" name="item" placeholder="بند جديد" required style="flex:1; height:32px; border:1px solid #e4e2ec; border-radius:8px; padding:0 8px; font-size:12px;" />
        <button type="submit" style="height:32px; border:none; border-radius:8px; background:#7b6bd6; color:#fff; font-size:11.5px; padding:0 14px;">+ إضافة بند</button>
    </form>
</div>