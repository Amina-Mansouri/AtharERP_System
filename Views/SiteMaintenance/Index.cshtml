@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteMaintenance>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
    ViewData["Title"] = $"الصيانة - {site?.Name}";
    var canManage = await PermissionService.HasPermissionAsync(User, "Sites.Manage");

    string StatusLabel(MaintenanceStatus s) => s switch
    {
        MaintenanceStatus.Pending => "معلق",
        MaintenanceStatus.InProgress => "قيد التنفيذ",
        MaintenanceStatus.Completed => "مكتمل",
        _ => s.ToString()
    };

    string StatusTagClass(MaintenanceStatus s) => s switch
    {
        MaintenanceStatus.Completed => "tag-success",
        MaintenanceStatus.InProgress => "tag-accent",
        _ => "tag-muted"
    };
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@site?.Code</div>
        <h1 class="athar-page-title" style="margin-top:2px;">طلبات الصيانة - @site?.Name</h1>
    </div>
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn-line">العودة للموقع</a>
</div>

<div class="data-table" style="--cols: 1.2fr 110px 100px 1fr 100px @(canManage ? "150px" : "");">
    <div class="data-table-head">
        <div class="cell">نوع الصيانة</div>
        <div class="cell">الحالة</div>
        <div class="cell">التكلفة</div>
        <div class="cell">المسؤول</div>
        <div class="cell">تاريخ الطلب</div>
        @if (canManage)
        {
            <div class="cell">إجراءات</div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد طلبات صيانة بعد</div></div>
    }
    else
    {
        @foreach (var m in Model)
        {
            <div class="data-table-row">
                <div class="cell">@m.MaintenanceType</div>
                <div class="cell"><span class="tag @StatusTagClass(m.Status)">@StatusLabel(m.Status)</span></div>
                <div class="cell cell-num">@(m.Cost?.ToString("N2") ?? "-")</div>
                <div class="cell">@(m.Responsible?.FullName ?? "-")</div>
                <div class="cell cell-num">@m.RequestDate.ToString("yyyy-MM-dd")</div>
                @if (canManage)
                {
                    <div class="cell" style="display:flex; gap:6px;">
                        <a asp-action="Edit" asp-route-id="@m.Id" class="btn-line">تعديل</a>
                        <form method="post" asp-action="Delete" asp-route-id="@m.Id" onsubmit="return confirm('حذف طلب الصيانة هذا؟');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-line" style="color:#c94a42;">حذف</button>
                        </form>
                    </div>
                }
            </div>
        }
    }
</div>

@if (canManage)
{
    <div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px; margin-top:12px;">
        <div style="font-size:12.5px; font-weight:600; margin-bottom:8px;">طلب صيانة جديد</div>
        <form method="post" asp-action="Create" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SiteId" value="@site?.Id" />
            <div>
                <label class="form-label" style="font-size:11px;">نوع الصيانة</label>
                <input type="text" name="MaintenanceType" class="form-control form-control-sm" required />
            </div>
            <div style="flex:1; min-width:180px;">
                <label class="form-label" style="font-size:11px;">الوصف</label>
                <input type="text" name="Description" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label" style="font-size:11px;">المسؤول</label>
                <select name="ResponsibleId" class="form-select form-select-sm">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var eng in engineers)
                    {
                        <option value="@eng.Id">@eng.FullName</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-line btn-line-accent">+ إضافة</button>
        </form>
    </div>
}