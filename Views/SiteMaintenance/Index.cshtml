@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteMaintenance>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
    ViewData["Title"] = $"الصيانة - {site?.Name}";
    var canManage = await PermissionService.HasPermissionAsync(User, "Sites.Manage");

    string StatusLabel(MaintenanceStatus s) => s switch
    {
        MaintenanceStatus.Pending => "معلق",
        MaintenanceStatus.InProgress => "قيد التنفيذ",
        MaintenanceStatus.Completed => "مكتمل",
        _ => s.ToString()
    };
}

<h1 class="athar-page-title">طلبات الصيانة - @site?.Name</h1>

<div class="athar-card mt-3">
    <div class="table-responsive">
        <table class="table athar-table align-middle">
            <thead>
                <tr>
                    <th>نوع الصيانة</th>
                    <th>الحالة</th>
                    <th>التكلفة</th>
                    <th>المسؤول</th>
                    <th>تاريخ الطلب</th>
                    @if (canManage)
                    {
                        <th>إجراءات</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">لا توجد طلبات صيانة بعد</td></tr>
                }
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.MaintenanceType</td>
                        <td><span class="badge athar-status-badge athar-status-@m.Status">@StatusLabel(m.Status)</span></td>
                        <td>@(m.Cost?.ToString("N2") ?? "-")</td>
                        <td>@(m.Responsible?.FullName ?? "-")</td>
                        <td>@m.RequestDate.ToString("yyyy-MM-dd")</td>
                        @if (canManage)
                        {
                            <td>
                                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm athar-btn-outline">تعديل</a>
                                <form method="post" asp-action="Delete" asp-route-id="@m.Id" class="d-inline"
                                      onsubmit="return confirm('حذف طلب الصيانة هذا؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (canManage)
    {
        <hr />
        <h6>طلب صيانة جديد</h6>
        <form method="post" asp-action="Create" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SiteId" value="@site?.Id" />
            <div class="col-md-3">
                <label class="form-label">نوع الصيانة</label>
                <input type="text" name="MaintenanceType" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">الوصف</label>
                <input type="text" name="Description" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label">المسؤول</label>
                <select name="ResponsibleId" class="form-select form-select-sm">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var eng in engineers)
                    {
                        <option value="@eng.Id">@eng.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm athar-btn w-100">+ إضافة</button>
            </div>
        </form>
    }
</div>

<div class="mt-3">
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn athar-btn-outline">العودة للموقع</a>
</div>