@using AtharERP_System.Models.Entities
@model SiteMaintenance
@{
    ViewData["Title"] = "تعديل طلب الصيانة";
    var engineers = ViewBag.Engineers as List<ApplicationUser> ?? new List<ApplicationUser>();
}

<h1 class="athar-page-title">تعديل طلب الصيانة: @Model.MaintenanceType</h1>

<div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:16px; margin-top:12px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">نوع الصيانة</label>
                <input type="text" name="MaintenanceType" class="form-control" value="@Model.MaintenanceType" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="Pending" selected="@(Model.Status == MaintenanceStatus.Pending)">معلق</option>
                    <option value="InProgress" selected="@(Model.Status == MaintenanceStatus.InProgress)">قيد التنفيذ</option>
                    <option value="Completed" selected="@(Model.Status == MaintenanceStatus.Completed)">مكتمل</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">الوصف</label>
            <textarea name="Description" class="form-control" rows="2">@Model.Description</textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">التكلفة</label>
                <input type="number" step="0.01" min="0" name="Cost" class="form-control" value="@Model.Cost" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">المسؤول</label>
                <select name="ResponsibleId" class="form-select">
                    <option value="">-- لا يوجد --</option>
                    @foreach (var eng in engineers)
                    {
                        <option value="@eng.Id" selected="@(Model.ResponsibleId == eng.Id)">@eng.FullName</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">ملاحظات</label>
            <textarea name="Notes" class="form-control" rows="2">@Model.Notes</textarea>
        </div>

        <button type="submit" class="btn-line btn-line-accent">حفظ التعديلات</button>
        <a asp-action="Index" asp-route-siteId="@Model.SiteId" class="btn-line">إلغاء</a>
    </form>
</div>