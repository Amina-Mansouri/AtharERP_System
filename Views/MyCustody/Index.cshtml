@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<CustodyHandover>
@{
    ViewData["Title"] = "عهدتي";
    var lineStatusLabels = EnumDisplayHelper.GetDisplayList<CustodyLineStatus>();
    var mySignaturePath = ViewBag.MySignaturePath as string;
}

<div class="page-head">
    <div>
        <span class="kicker">شؤون إدارية</span>
        <h1>عهدتي</h1>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="athar-card" style="padding:14px; font-size:12px; color:#8a83a0;">لا توجد عهد مسجَّلة باسمك حالياً</div>
}
else
{
    @foreach (var h in Model)
    {
        <div class="athar-card" style="margin-bottom:12px;">
            <div style="padding:12px 14px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; border-bottom:1px solid #f1f0f6;">
                <div style="font-size:12.5px; font-weight:600;">تسليم بتاريخ @h.HandedDate.ToString("yyyy-MM-dd")</div>
                @if (h.HolderConfirmed)
                {
                    <span class="tag tag-success">تم تأكيد الاستلام</span>
                }
                else
                {
                    <span class="tag tag-warning">بانتظار تأكيدك</span>
                }
            </div>
            <div class="data-table data-table-compact" style="--cols: 1.5fr 90px 90px 1fr">
                <div class="data-table-head">
                    <div class="cell">المادة</div>
                    <div class="cell">الكمية</div>
                    <div class="cell">المُعاد</div>
                    <div class="cell">الحالة</div>
                </div>
                @foreach (var l in h.Lines)
                {
                    <div class="data-table-row">
                        <div class="cell">@l.Item?.Name <span class="stat-sub">(@l.Item?.Category?.Name)</span></div>
                        <div class="cell cell-num">@l.QuantityHanded</div>
                        <div class="cell cell-num">@l.QuantityReturned</div>
                        <div class="cell">@lineStatusLabels.FirstOrDefault(x => x.Value == l.Status.ToString()).Label</div>
                    </div>
                }
            </div>
            <div style="padding:10px 14px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                <div style="font-size:11px; color:#8a83a0;">جهّزها: @h.CreatedBy?.FullName</div>
                @if (!h.HolderConfirmed)
                {
                    <form method="post" asp-action="Confirm" onsubmit="return confirm('بتأكيدك، أنت تقرّين باستلام المواد أعلاه. متابعة؟');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@h.Id" />
                        <button type="submit" class="btn-line btn-line-accent">تأكيد الاستلام</button>
                    </form>
                }
                else if (!string.IsNullOrEmpty(mySignaturePath))
                {
                    <img src="@mySignaturePath" alt="التوقيع" style="height:40px;" />
                }
            </div>
        </div>
    }
}