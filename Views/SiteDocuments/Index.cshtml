@using AtharERP_System.Models.Entities
@using AtharERP_System.Services
@model List<SiteDocument>
@inject PermissionService PermissionService
@{
    var site = ViewBag.Site as Site;
    ViewData["Title"] = $"مستندات الموقع - {site?.Name}";
    var canManage = await PermissionService.HasPermissionAsync(User, "Sites.Manage");

    string TypeLabel(SiteDocumentType t) => t switch
    {
        SiteDocumentType.ApprovedMap => "خريطة معتمدة",
        SiteDocumentType.ContractorContract => "عقد مقاول",
        SiteDocumentType.QualityReport => "تقرير جودة",
        SiteDocumentType.SafetyReport => "تقرير سلامة",
        SiteDocumentType.DailyReport => "تقرير يومي",
        SiteDocumentType.Other => "أخرى",
        _ => t.ToString()
    };
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@site?.Code</div>
        <h1 class="athar-page-title" style="margin-top:2px;">مستندات الموقع - @site?.Name</h1>
    </div>
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn-line">العودة للموقع</a>
</div>

@if (canManage)
{
    <div style="background:#fff; border:1px solid var(--sys-border); border-radius:var(--sys-radius-card); box-shadow:var(--sys-shadow); padding:12px 16px; margin-bottom:12px;">
        <form method="post" asp-action="Upload" enctype="multipart/form-data" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="siteId" value="@site?.Id" />
            <div>
                <label class="form-label" style="font-size:11px;">نوع المستند</label>
                <select name="documentType" class="form-select form-select-sm">
                    <option value="ApprovedMap">خريطة معتمدة</option>
                    <option value="ContractorContract">عقد مقاول</option>
                    <option value="QualityReport">تقرير جودة</option>
                    <option value="SafetyReport">تقرير سلامة</option>
                    <option value="DailyReport">تقرير يومي</option>
                    <option value="Other" selected>أخرى</option>
                </select>
            </div>
            <input type="file" name="file" class="form-control form-control-sm" style="max-width:240px;" required />
            <input type="text" name="description" class="form-control form-control-sm" style="max-width:200px;" placeholder="الوصف" />
            <button type="submit" class="btn-line btn-line-accent">+ رفع</button>
        </form>
    </div>
}

<div class="data-table" style="--cols: 1.3fr 130px 1fr 100px 150px;">
    <div class="data-table-head">
        <div class="cell">الملف</div>
        <div class="cell">النوع</div>
        <div class="cell">الوصف</div>
        <div class="cell">تاريخ الرفع</div>
        <div class="cell">إجراءات</div>
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مستندات مرفوعة بعد</div></div>
    }
    else
    {
        @foreach (var d in Model)
        {
            <div class="data-table-row">
                <div class="cell"><a href="@d.FilePath" target="_blank">@d.FileName</a></div>
                <div class="cell">@TypeLabel(d.DocumentType)</div>
                <div class="cell">@(d.Description ?? "-")</div>
                <div class="cell cell-num">@d.UploadedAt.ToString("yyyy-MM-dd")</div>
                <div class="cell" style="display:flex; gap:6px;">
                    <a href="@d.FilePath" download class="btn-line">تنزيل</a>
                    @if (canManage)
                    {
                        <form method="post" asp-action="Delete" asp-route-id="@d.Id" onsubmit="return confirm('حذف هذا المستند؟');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-line" style="color:#c94a42;">حذف</button>
                        </form>
                    }
                </div>
            </div>
        }
    }
</div>