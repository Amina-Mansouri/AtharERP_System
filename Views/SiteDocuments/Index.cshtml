@using AtharERP_System.Models.Entities
@model List<ProjectDocument>
@{
    var site = ViewBag.Site as Site;
    ViewData["Title"] = $"مستندات المشروع - {site?.Name}";
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
        <div style="font-size:11px; color:var(--sys-text-light); font-weight:500;">@site?.Code</div>
        <h1 class="athar-page-title" style="margin-top:2px;">مستندات المشروع - @site?.Name</h1>
    </div>
    <a asp-controller="Sites" asp-action="Details" asp-route-id="@site?.Id" class="btn-line">العودة للموقع</a>
</div>

<div class="data-table" style="--cols: 1.6fr 1.4fr 1fr 130px;">
    <div class="data-table-head">
        <div class="cell">الملف</div>
        <div class="cell">الوصف</div>
        <div class="cell">رفعه</div>
        <div class="cell">تاريخ الرفع</div>
    </div>

    @if (!Model.Any())
    {
        <div class="data-table-row"><div class="cell" style="grid-column:1/-1">لا توجد مستندات لهذا المشروع بعد</div></div>
    }
    else
    {
        @foreach (var d in Model)
        {
            <div class="data-table-row">
                <div class="cell"><a href="@d.FilePath" target="_blank">@d.FileName</a></div>
                <div class="cell">@(d.Description ?? "-")</div>
                <div class="cell">@(d.UploadedBy?.FullName ?? "-")</div>
                <div class="cell cell-num">@d.UploadedAt.ToString("yyyy-MM-dd")</div>
            </div>
        }
    }
</div>